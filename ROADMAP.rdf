        <rdfs:label xml:lang="en">clinical trial number</rdfs:label>
        <rdfs:label xml:lang="es">número de ensayo clínico</rdfs:label>
        <rdfs:label xml:lang="zh">临床试验编号</rdfs:label>
        <skos:definition xml:lang="en">A clinical trial identifier or URI, such as issued by ClinicalTrials.gov.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03624 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03624">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00067"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00514"/>
            </owl:Restriction>
        </rdfs:subClassOf>
