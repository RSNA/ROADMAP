                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00572"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Identifies the peer-reviewed publication that describes the AI resource - the article about the resource, not the resource itself. Supports findability of the associated literature. A pointer to the resource itself is a &apos;link&apos;.</rdfs:comment>
        <rdfs:label xml:lang="es">identificador de resultados publicados</rdfs:label>
        <rdfs:label xml:lang="en">published results identifier</rdfs:label>
        <rdfs:label xml:lang="zh">已发表结果标识符</rdfs:label>
        <skos:definition xml:lang="en">A unique reference ID such as Digital Object Identifier or PubMed Identifier.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03625 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03625">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00074"/>
        <rdfs:label xml:lang="en">SNOMED code</rdfs:label>
        <rdfs:label xml:lang="zh">SNOMED代码</rdfs:label>
        <rdfs:label xml:lang="es">código SNOMED</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://browser.ihtsdotools.org/"/>
        <rdfs:seeAlso rdf:resource="https://www.nlm.nih.gov/research/umls/Snomed/snomed_browsers.html"/>
        <skos:altLabel xml:lang="en">SNOMED CT code</skos:altLabel>
        <skos:altLabel xml:lang="en">SNOMED indexing code</skos:altLabel>
        <skos:definition xml:lang="en">A term identified from the Systematized Nomenclature of Medicine (SNOMED) Clinical Terms; e.g., 19943007 for &quot;Cirrhosis of liver (disorder).&quot;</skos:definition>
    </owl:Class>
    


