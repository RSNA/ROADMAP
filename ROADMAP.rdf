        <skos:exactMatch rdf:resource="http://mimi.case.edu/ontologies/2009/1/UnitsOntology#day"/>
        <skos:exactMatch rdf:resource="http://qudt.org/vocab/unit/DAY"/>
    </owl:NamedIndividual>
    


