        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00219"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00221"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00290"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00621"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00622"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00643"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00644"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Indicate the number of annotators (total, per exam, etc.), the instructions given to them, their qualifications, and the scope of annotation.</rdfs:comment>
        <rdfs:label xml:lang="en">annotator</rdfs:label>
        <rdfs:label xml:lang="es">descripción del etiquetador de anotaciones</rdfs:label>
        <rdfs:label xml:lang="zh">标注者描述</rdfs:label>
        <skos:altLabel xml:lang="en">annotation labeler</skos:altLabel>
        <skos:altLabel xml:lang="en">annotation labeler description</skos:altLabel>
        <skos:altLabel xml:lang="en">annotator description</skos:altLabel>
        <skos:definition xml:lang="en">Information about the people who applied the annotation labels.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03369 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03369">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00129"/>
        <rdfs:label xml:lang="en">burned-in PHI present</rdfs:label>
        <rdfs:label xml:lang="es">información de salud protegida presente</rdfs:label>
        <rdfs:label xml:lang="zh">嵌入式受保护健康信息存在</rdfs:label>
        <skos:definition xml:lang="en">Protected Health Information (PHI), such as a patient identifier, is &quot;burned in&quot; to the image&apos;s pixel data.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03370 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03370">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00129"/>
        <rdfs:label xml:lang="en">burned-in PHI absent</rdfs:label>
        <rdfs:label xml:lang="es">información de salud protegida ausente</rdfs:label>
        <rdfs:label xml:lang="zh">嵌入式受保护健康信息缺失</rdfs:label>
        <skos:definition xml:lang="en">Protected Health Information (PHI), such as a patient identifier, is not included in the image&apos;s pixel data.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03371 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03371">
