        <dcterms:source rdf:resource="https://doi.org/10.1093/jamia/ocaa088"/>
        <rdfs:label xml:lang="en">MINIMAR</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.equator-network.org/reporting-guidelines/minimar-minimum-information-for-medical-ai-reporting-developing-reporting-standards-for-artificial-intelligence-in-health-care/"/>
        <skos:altLabel xml:lang="en">Minimum Information for Medical AI Reporting</skos:altLabel>
        <skos:definition xml:lang="en">Minimum Information for Medical AI Reporting (MINIMAR) is a collaborative initiative that establishes standardized reporting guidelines for studies developing or evaluating artificial intelligence in medicine. It aims to enhance transparency, reproducibility, and clinical trust in AI research by defining essential data and methodological disclosures for publication and regulatory review.</skos:definition>
    </owl:NamedIndividual>
    


