        <rdfs:label xml:lang="zh">腹部放射学</rdfs:label>
        <skos:altLabel xml:lang="en">AB</skos:altLabel>
        <skos:altLabel xml:lang="en">Abdominal Radiology</skos:altLabel>
        <skos:definition xml:lang="en">Content code for Abdominal Radiology.</skos:definition>
        <skos:exactMatch rdf:resource="http://www.radlex.org/RID/RID50608"/>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04138 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04138">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Verification (C-ECHO)</rdfs:label>
        <skos:definition xml:lang="en">Confirms application-level communication between two DICOM application entities.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04139 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04139">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Storage SCP (C-STORE)</rdfs:label>
        <skos:definition xml:lang="en">Accepts, as Service Class Provider, DICOM instances sent via the Storage Service Class.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04140 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04140">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Storage SCU (C-STORE)</rdfs:label>
        <skos:definition xml:lang="en">Sends, as Service Class User, DICOM instances via the Storage Service Class.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04141 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04141">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Storage Commitment</rdfs:label>
        <skos:definition xml:lang="en">Confirms that a receiving system has taken responsibility for safely storing transferred DICOM instances.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04142 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04142">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Query/Retrieve (C-FIND)</rdfs:label>
        <skos:definition xml:lang="en">Queries a remote DICOM application entity for matching studies, series, or instances.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04143 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04143">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Query/Retrieve (C-MOVE)</rdfs:label>
        <skos:definition xml:lang="en">Requests that a remote DICOM application entity transfer matching instances to a third destination.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04144 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04144">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Query/Retrieve (C-GET)</rdfs:label>
        <skos:definition xml:lang="en">Requests that a remote DICOM application entity transfer matching instances directly to the requester.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04145 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04145">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Modality Worklist</rdfs:label>
        <skos:definition xml:lang="en">Retrieves scheduled procedure step information from a worklist provider.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04146 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04146">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Modality Performed Procedure Step</rdfs:label>
        <skos:definition xml:lang="en">Reports the status and details of a procedure step as it is performed.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04147 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04147">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Unified Procedure Step (UPS)</rdfs:label>
        <skos:definition xml:lang="en">Manages a general work item, such as a processing or reporting task, through creation, progress, and completion.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04148 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04148">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04137"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">Instance Availability Notification</rdfs:label>
        <skos:definition xml:lang="en">Notifies a receiver that specified DICOM instances are available for retrieval.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04150 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04150">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04149"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part18.html"/>
        <rdfs:label xml:lang="en">QIDO-RS</rdfs:label>
        <skos:definition xml:lang="en">Query based on ID for DICOM Objects: a RESTful service for searching studies, series, and instances by attribute.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04151 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04151">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04149"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part18.html"/>
        <rdfs:label xml:lang="en">WADO-RS</rdfs:label>
        <skos:definition xml:lang="en">Web Access to DICOM Objects (RESTful): retrieves DICOM instances, frames, and metadata over HTTP.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04152 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04152">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04149"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part18.html"/>
        <rdfs:label xml:lang="en">WADO-URI</rdfs:label>
        <skos:definition xml:lang="en">Web Access to DICOM Objects (URI-based): retrieves a single DICOM instance or rendered image via an HTTP GET request with query parameters.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04153 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04153">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04149"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part18.html"/>
        <rdfs:label xml:lang="en">STOW-RS</rdfs:label>
        <skos:definition xml:lang="en">Store Over the Web: a RESTful service for storing DICOM instances to a remote system.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04154 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04154">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04149"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part18.html"/>
        <rdfs:label xml:lang="en">UPS-RS</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://rsna.org/roadmap/04147"/>
        <skos:definition xml:lang="en">Unified Procedure Step (RESTful): manages UPS work items over a RESTful interface.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04156 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04156">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04155"/>
        <dcterms:source rdf:resource="https://www.hl7.org/implement/standards/product_brief.cfm?product_id=185"/>
        <rdfs:label xml:lang="en">ADT</rdfs:label>
        <skos:altLabel xml:lang="en">Admission Discharge Transfer</skos:altLabel>
        <skos:altLabel xml:lang="en">Admit / Discharge / Transfer</skos:altLabel>
        <skos:definition xml:lang="en">Admit/Discharge/Transfer: conveys patient demographic and encounter events.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04157 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04157">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04155"/>
        <dcterms:source rdf:resource="https://www.hl7.org/implement/standards/product_brief.cfm?product_id=185"/>
        <rdfs:label xml:lang="en">ORM</rdfs:label>
        <skos:definition xml:lang="en">General order message: conveys a request for a service or procedure.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04158 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04158">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04155"/>
        <dcterms:source rdf:resource="https://www.hl7.org/implement/standards/product_brief.cfm?product_id=185"/>
        <rdfs:label xml:lang="en">OMI</rdfs:label>
        <skos:definition xml:lang="en">Imaging order message: conveys a request for an imaging procedure.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04159 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04159">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04155"/>
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://www.hl7.org/implement/standards/product_brief.cfm?product_id=185"/>
        <rdfs:label xml:lang="en">ORU</rdfs:label>
        <skos:altLabel xml:lang="en">HL7 v2 ORU message</skos:altLabel>
        <skos:definition xml:lang="en">Observation result: conveys observation or report results.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04160 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04160">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04155"/>
        <dcterms:source rdf:resource="https://www.hl7.org/implement/standards/product_brief.cfm?product_id=185"/>
        <rdfs:label xml:lang="en">MDM</rdfs:label>
        <skos:altLabel xml:lang="en">Medical Document Management</skos:altLabel>
        <skos:definition xml:lang="en">Medical Document Management: conveys the creation, status, or content of a clinical document.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04161 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04161">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04155"/>
        <dcterms:source rdf:resource="https://www.hl7.org/implement/standards/product_brief.cfm?product_id=185"/>
        <rdfs:label xml:lang="en">SIU</rdfs:label>
        <skos:definition xml:lang="en">Scheduling Information Unsolicited: conveys scheduling events such as appointment booking or cancellation.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04163 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04163">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdfs:label xml:lang="en">ImagingStudy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/imagingstudy.html"/>
        <skos:definition xml:lang="en">Represents the content of a DICOM imaging study, including its series and instances, as a FHIR resource.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04164 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04164">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdfs:label xml:lang="en">ImagingSelection</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/imagingselection.html"/>
        <skos:definition xml:lang="en">Represents a selection of images or other content, with or without annotations, for a specific purpose such as referencing key images.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04165 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04165">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <rdfs:label xml:lang="en">DiagnosticReport</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/diagnosticreport.html"/>
        <skos:altLabel xml:lang="en">FHIR DiagnosticReport</skos:altLabel>
        <skos:definition xml:lang="en">Represents the findings and interpretation of diagnostic tests, including imaging studies.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04166 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04166">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <rdfs:label xml:lang="en">Observation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/observation.html"/>
        <skos:altLabel xml:lang="en">FHIR Observation</skos:altLabel>
        <skos:definition xml:lang="en">Represents a measurement or assertion made about a patient, such as a model-derived finding or score.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04167 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04167">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdfs:label xml:lang="en">ServiceRequest</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/servicerequest.html"/>
        <skos:definition xml:lang="en">Represents a request for a procedure or service to be performed, such as an imaging study or an AI analysis.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04168 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04168">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdfs:label xml:lang="en">Task</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/task.html"/>
        <skos:definition xml:lang="en">Represents a piece of work, such as an AI processing job, tracked through its lifecycle.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04169 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04169">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdfs:label xml:lang="en">DocumentReference</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/documentreference.html"/>
        <skos:definition xml:lang="en">Represents metadata about and access to a document, such as a report or encapsulated result.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04170 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04170">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdfs:label xml:lang="en">Binary</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/binary.html"/>
        <skos:definition xml:lang="en">Represents a resource containing raw binary content, such as an encapsulated image or PDF.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04171 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04171">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <rdfs:label xml:lang="en">Subscription</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/subscription.html"/>
        <skos:definition xml:lang="en">Represents a request to be notified when data matching specified criteria becomes available.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04172 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04172">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04162"/>
        <dcterms:source rdf:resource="https://fhircast.org/"/>
        <rdfs:label xml:lang="en">FHIRcast</rdfs:label>
        <skos:definition xml:lang="en">A companion specification to FHIR for real-time, session-based context synchronization between clinical applications, such as sharing the patient or study currently in view.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04174 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04174">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <dcterms:source rdf:resource="https://www.ihe.net/uploadedFiles/Documents/Radiology/IHE_RAD_Suppl_AIR.pdf"/>
        <rdfs:label xml:lang="en">AIR (AI Results)</rdfs:label>
        <skos:definition xml:lang="en">Specifies how AI results are encoded, communicated, and integrated into radiology workflow.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04175 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04175">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <dcterms:source rdf:resource="https://www.ihe.net/uploadedFiles/Documents/Radiology/IHE_RAD_Suppl_AIW-I.pdf"/>
        <rdfs:label xml:lang="en">AIW-I (AI Workflow for Imaging)</rdfs:label>
        <skos:definition xml:lang="en">Specifies workflow steps for invoking and tracking AI processing of imaging studies.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04176 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04176">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">SWF.b (Scheduled Workflow.b)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/SWF.b/index.html"/>
        <skos:definition xml:lang="en">Specifies the departmental workflow for scheduling, performing, and tracking imaging procedures.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04177 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04177">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">IOCM (Imaging Object Change Management)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/IOCM/index.html"/>
        <skos:definition xml:lang="en">Specifies how corrections, rejections, and other changes to imaging objects are communicated.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04178 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04178">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">XDS-I.b (Cross-Enterprise Document Sharing for Imaging)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/XDS-I.b/index.html"/>
        <skos:definition xml:lang="en">Specifies cross-enterprise sharing of imaging documents and studies.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04179 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04179">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">IID (Invoke Image Display)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/IID/index.html"/>
        <skos:definition xml:lang="en">Specifies how an external application invokes a display of relevant prior and current images for a patient.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04180 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04180">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">MRRT (Management of Radiology Report Templates)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/MRRT/index.html"/>
        <skos:definition xml:lang="en">Specifies the format and management of structured radiology report templates.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04181 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04181">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">SINR (Simple Image and Numeric Report)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/SINR/index.html"/>
        <skos:definition xml:lang="en">Specifies a simple structured report format combining images and numeric measurements.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04182 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04182">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">PDI (Portable Data for Imaging)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/PDI/index.html"/>
        <skos:definition xml:lang="en">Specifies the content of interchange media, such as CD or USB, for portable imaging data.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04183 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04183">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">REM (Radiation Exposure Monitoring)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/REM/index.html"/>
        <skos:definition xml:lang="en">Specifies collection and communication of radiation exposure information from imaging procedures.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04184 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04184">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">EBIW (Encounter-Based Imaging Workflow)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/RAD/EBIW/index.html"/>
        <skos:definition xml:lang="en">Specifies imaging workflow driven by a clinical encounter rather than a traditional order.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04185 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04185">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">PIX (Patient Identifier Cross-Referencing)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/ITI/PIX/index.html"/>
        <skos:definition xml:lang="en">Specifies cross-referencing of patient identifiers across multiple identifier domains.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04186 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04186">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <rdfs:label xml:lang="en">PDQ (Patient Demographics Query)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://profiles.ihe.net/ITI/PDQ/index.html"/>
        <skos:definition xml:lang="en">Specifies querying for patient demographic information across systems.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04188 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04188">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part16.html"/>
        <rdfs:label xml:lang="en">DICOM Structured Report (TID 1500)</rdfs:label>
        <skos:definition xml:lang="en">A DICOM Structured Report encoded using TID 1500 (Measurement Report), the standard template for quantitative measurements.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04189 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04189">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part16.html"/>
        <rdfs:label xml:lang="en">DICOM Structured Report (other template)</rdfs:label>
        <skos:definition xml:lang="en">A DICOM Structured Report encoded using a template other than TID 1500.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04190 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04190">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part03.html"/>
        <rdfs:label xml:lang="en">DICOM Segmentation (SEG)</rdfs:label>
        <skos:definition xml:lang="en">A DICOM Segmentation object encoding one or more labeled regions of an image.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04191 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04191">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part03.html"/>
        <rdfs:label xml:lang="en">DICOM Parametric Map</rdfs:label>
        <skos:definition xml:lang="en">A DICOM Parametric Map object encoding a derived pixel-wise quantitative map, such as an ADC or perfusion map.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04192 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04192">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part03.html"/>
        <rdfs:label xml:lang="en">DICOM Grayscale Softcopy Presentation State (GSPS)</rdfs:label>
        <skos:definition xml:lang="en">A DICOM object encoding display parameters and graphical annotations to be applied to referenced images.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04193 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04193">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part03.html"/>
        <rdfs:label xml:lang="en">DICOM Secondary Capture</rdfs:label>
        <skos:definition xml:lang="en">A DICOM object encoding an image converted from a non-DICOM source, such as a screen capture or scanned document.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04194 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04194">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part03.html"/>
        <rdfs:label xml:lang="en">DICOM Key Object Selection</rdfs:label>
        <skos:definition xml:lang="en">A DICOM object identifying a set of key images or other objects selected for a specific purpose, such as significant findings.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04195 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04195">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part03.html"/>
        <rdfs:label xml:lang="en">DICOM Encapsulated PDF</rdfs:label>
        <skos:definition xml:lang="en">A DICOM object encapsulating a PDF document, such as a rendered report, within a DICOM-compliant wrapper.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04196 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04196">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part03.html"/>
        <rdfs:label xml:lang="en">DICOM RT Structure Set</rdfs:label>
        <skos:definition xml:lang="en">A DICOM Radiotherapy Structure Set object encoding contoured anatomical or target regions for radiotherapy planning.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04197 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04197">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <rdfs:label xml:lang="en">Worklist priority flag</rdfs:label>
        <skos:definition xml:lang="en">A flag or field written to a reading worklist to indicate priority based on the model&apos;s output, without transmitting a separate result object.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04198 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04198">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <rdfs:label xml:lang="en">Notification or alert</rdfs:label>
        <skos:definition xml:lang="en">A push notification or alert (e.g. secure message, pager, mobile app push) conveying the model&apos;s result outside a structured clinical object.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04199 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04199">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <rdfs:label xml:lang="en">Report text insertion</rdfs:label>
        <skos:definition xml:lang="en">Text generated by the model that is inserted into a report, such as a draft finding or measurement, typically via a reporting or dictation platform integration.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04200 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04200">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <rdfs:label xml:lang="en">Vendor API or webhook</rdfs:label>
        <skos:definition xml:lang="en">A proprietary application programming interface or webhook callback used to deliver the model&apos;s result.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04201 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04201">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04187"/>
        <rdfs:label xml:lang="en">Proprietary viewer or dashboard</rdfs:label>
        <skos:definition xml:lang="en">A vendor-specific viewer or dashboard application through which the model&apos;s result is displayed, outside a standards-based object.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04203 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04203">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04202"/>
        <rdfs:label xml:lang="en">Automatic on study arrival</rdfs:label>
        <skos:definition xml:lang="en">The model is triggered automatically when a new study arrives at the system, without a separate scheduling or ordering step.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04204 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04204">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04202"/>
        <rdfs:label xml:lang="en">Modality worklist triggered</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://rsna.org/roadmap/04145"/>
        <skos:definition xml:lang="en">The model is triggered by a scheduled procedure step entry retrieved via DICOM Modality Worklist.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04205 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04205">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04202"/>
        <rdfs:label xml:lang="en">UPS worklist triggered</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://rsna.org/roadmap/04147"/>
        <skos:definition xml:lang="en">The model is triggered by a work item created or updated via the DICOM Unified Procedure Step service.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04206 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04206">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04202"/>
        <rdfs:label xml:lang="en">On-demand by user</rdfs:label>
        <skos:definition xml:lang="en">The model is triggered manually by a user action, such as a button click in a viewer or worklist.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04207 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04207">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04202"/>
        <rdfs:label xml:lang="en">Scheduled batch</rdfs:label>
        <skos:definition xml:lang="en">The model is triggered on a recurring schedule, processing a batch of accumulated cases rather than individual arrivals.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04208 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04208">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04202"/>
        <rdfs:label xml:lang="en">Prefetch-based</rdfs:label>
        <skos:definition xml:lang="en">The model is triggered as part of a prefetch process that retrieves relevant prior studies or data in advance of anticipated need.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04209 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04209">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04202"/>
        <rdfs:label xml:lang="en">API call</rdfs:label>
        <skos:definition xml:lang="en">The model is triggered by an explicit application programming interface call from another system.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04212 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04212">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04211"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part02.html"/>
        <rdfs:label xml:lang="en">DICOM Conformance Statement</rdfs:label>
        <skos:definition xml:lang="en">A document, conforming to DICOM PS3.2, describing a system&apos;s implementation of DICOM network and media services.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04213 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04213">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04211"/>
        <dcterms:source rdf:resource="https://www.ihe.net/resources/technical_frameworks/"/>
        <rdfs:label xml:lang="en">IHE Integration Statement</rdfs:label>
        <skos:definition xml:lang="en">A document describing the IHE integration profiles and actors a system supports.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04214 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04214">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04211"/>
        <rdfs:label xml:lang="en">FHIR CapabilityStatement</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hl7.org/fhir/capabilitystatement.html"/>
        <skos:definition xml:lang="en">A FHIR resource documenting a system&apos;s supported FHIR capabilities, such as resources, operations, and search parameters.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04215 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04215">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04211"/>
        <dcterms:source rdf:resource="https://www.hl7.org/implement/standards/product_brief.cfm?product_id=185"/>
        <rdfs:label xml:lang="en">HL7 v2 interface specification</rdfs:label>
        <skos:definition xml:lang="en">A document describing a system&apos;s implementation of specific HL7 v2 message types, triggers, and fields.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04217 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04217">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">PACS</rdfs:label>
        <skos:definition xml:lang="en">Picture Archiving and Communication System: stores, retrieves, manages, and displays medical images.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04218 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04218">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">VNA</rdfs:label>
        <skos:definition xml:lang="en">Vendor Neutral Archive: a standards-based archive for clinical images and documents, decoupled from any single PACS vendor.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04219 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04219">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">RIS</rdfs:label>
        <skos:definition xml:lang="en">Radiology Information System: manages radiology scheduling, orders, reporting, and billing workflow.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04220 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04220">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">EHR</rdfs:label>
        <skos:definition xml:lang="en">Electronic Health Record system: manages a patient&apos;s longitudinal clinical record across an organization.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04221 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04221">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">Reporting or dictation platform</rdfs:label>
        <skos:definition xml:lang="en">A system used by clinicians to dictate, structure, and finalize diagnostic reports.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04222 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04222">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">AI orchestration platform</rdfs:label>
        <skos:definition xml:lang="en">A system that routes studies to one or more AI models, manages their execution, and aggregates or forwards their results.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04223 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04223">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">Image exchange platform</rdfs:label>
        <skos:definition xml:lang="en">A system used to share images and related data across organizational boundaries, such as a cloud-based exchange network.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04224 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04224">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">Modality</rdfs:label>
        <skos:definition xml:lang="en">An imaging acquisition device, such as a CT, MRI, or ultrasound scanner.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04225 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04225">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">Worklist manager</rdfs:label>
        <skos:definition xml:lang="en">A system that manages and prioritizes work lists, such as reading worklists, across one or more clinical systems.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/04226 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/04226">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04216"/>
        <rdfs:label xml:lang="en">Dose monitoring system</rdfs:label>
        <skos:definition xml:lang="en">A system that collects and analyzes radiation dose information from imaging procedures.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

