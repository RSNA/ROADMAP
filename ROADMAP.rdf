        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">tiempo de entrenamiento del modelo</rdfs:label>
        <rdfs:label xml:lang="en">time to train model</rdfs:label>
        <rdfs:label xml:lang="zh">模型训练时间</rdfs:label>
        <skos:definition xml:lang="en">The amount of time required to train an AI model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03378 -->

