            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">age range</rdfs:label>
        <rdfs:label xml:lang="es">rango de edad</rdfs:label>
        <rdfs:label xml:lang="zh">年龄范围</rdfs:label>
        <skos:definition xml:lang="en">Lower and upper bounds of age values.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03463 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03463">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasDecimalValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">age value</rdfs:label>
        <rdfs:label xml:lang="es">valor de edad</rdfs:label>
        <rdfs:label xml:lang="zh">年龄值</rdfs:label>
        <skos:definition xml:lang="en">An Age value consists of an decimal number and an age unit (e.g., years).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03467 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03467">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03872"/>
        <rdfs:label xml:lang="en">age unit</rdfs:label>
        <rdfs:label xml:lang="es">unidad de edad</rdfs:label>
        <rdfs:label xml:lang="zh">年龄单位</rdfs:label>
        <skos:definition xml:lang="en">The unit of time to describe the patient&apos;s age, e.g., days, months, or years.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03471 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03471">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00071"/>
        <rdfs:comment xml:lang="en">Ideally should link to a unique identifier such as the ORCID identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">contributor</rdfs:label>
        <rdfs:label xml:lang="es">contribuyente</rdfs:label>
        <rdfs:label xml:lang="zh">贡献者</rdfs:label>
        <skos:definition xml:lang="en">An individual contributor to the development, evaluation, and/or deployment of the resource.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03472 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03472">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00666"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasCount"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00055"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">For example, if a Partition has 500 male patients and 600 female patients, one could list two Subsets to indicate those two groups. One also could indicate a Subset of 1100 patients to cover the entire Partition.

                                         A Subset has one of more Count values (e.g., number of patients, number of images) and one or more Patient descriptors (age, sex, etc.)</rdfs:comment>
        <rdfs:label xml:lang="es">subconjunto</rdfs:label>
        <rdfs:label xml:lang="en">subset</rdfs:label>
        <rdfs:label xml:lang="zh">子集</rdfs:label>
        <skos:definition xml:lang="en">A subset is all or part of a dataset or partition: it is used to describe the demographics of the entity of which it&apos;s a part.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03477 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03477">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03422"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00212"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00285"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00305"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00310"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00311"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00577"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00583"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Criteria (described as text) include:
                                         - Reference standard (&quot;ground truth&quot;) value
                                         - Imaging finding
                                         - Geographic group
                                         - Image source
                                         - Risk factor</rdfs:comment>
        <rdfs:label xml:lang="es">criterio de subconjunto</rdfs:label>
        <rdfs:label xml:lang="en">subset criterion</rdfs:label>
        <rdfs:label xml:lang="zh">子集标准</rdfs:label>
        <skos:definition xml:lang="en">A criterion other than Age, Sex, and Demograpic Group (race / ethnicity) by which to define a dataset, partition, or subset theireof.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03479 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03479">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00051"/>
        <rdfs:label xml:lang="es">anotación a nivel de píxel</rdfs:label>
        <rdfs:label xml:lang="en">pixel-level annotation</rdfs:label>
        <rdfs:label xml:lang="zh">像素级注释</rdfs:label>
        <skos:altLabel xml:lang="en">pixel annotation</skos:altLabel>
        <skos:altLabel xml:lang="en">pixel label</skos:altLabel>
        <skos:altLabel xml:lang="en">pixel-level label</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to one or more pixels of an image, either as a segmentation or as a simple geometric shape such a rectangle (bounding box).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03480 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03480">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03479"/>
        <rdfs:label xml:lang="es">anotación de cuadro delimitador</rdfs:label>
        <rdfs:label xml:lang="en">bounding box annotation</rdfs:label>
        <rdfs:label xml:lang="zh">边界框标注</rdfs:label>
        <skos:altLabel xml:lang="en">bounding box</skos:altLabel>
        <skos:altLabel xml:lang="en">bounding box label</skos:altLabel>
        <skos:altLabel xml:lang="en">bounding-box annotation</skos:altLabel>
        <skos:altLabel xml:lang="en">bounding-box label</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to a bounding box, which is a rectangular area, defined by its coordinates, that encloses an object in an image or a 3D space.</skos:definition>
    </owl:Class>
    


