        <rdfs:comment xml:lang="en">Specify the disease or condition for which the model is intended to be used as an array of pointers to SNOMED and/or ICD terms.</rdfs:comment>
        <rdfs:label xml:lang="es">indicación de uso</rdfs:label>
        <rdfs:label xml:lang="en">indication for use</rdfs:label>
        <rdfs:label xml:lang="zh">使用适应症</rdfs:label>
        <skos:altLabel xml:lang="en">indicated condition</skos:altLabel>
        <skos:altLabel xml:lang="en">indicated disease</skos:altLabel>
        <skos:altLabel xml:lang="en">indicated setting</skos:altLabel>
        <skos:altLabel xml:lang="en">indication</skos:altLabel>
        <skos:definition xml:lang="en">The indications for use describe: (1) the disease or condition that the AI system will diagnose, treat, prevent, cure, or mitigate; (2) the intended patient population; and (3) the intended use environment (e.g., ICU, step-down unit, home).</skos:definition>
    </owl:Class>
    


