        <rdfs:label xml:lang="en">MINIMAR item</rdfs:label>
        <skos:definition xml:lang="en">An item from the MINIMAR guideline.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00492 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00492">
