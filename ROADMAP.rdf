        <skos:definition xml:lang="en">A principle from the OECD AI framework.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00473 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00473">
