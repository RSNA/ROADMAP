                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00610"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://www.fda.gov/media/184856/download"/>
        <rdfs:label xml:lang="es">limitaciones</rdfs:label>
        <rdfs:label xml:lang="en">limitations</rdfs:label>
        <rdfs:label xml:lang="zh">局限性</rdfs:label>
        <skos:altLabel xml:lang="en">caution</skos:altLabel>
        <skos:altLabel xml:lang="en">caveat</skos:altLabel>
        <skos:altLabel xml:lang="en">limitation</skos:altLabel>
        <skos:definition xml:lang="en">Describes concerns specific to the use of the AI model, such as limitations in model development or performance evaluation.</skos:definition>
    </owl:Class>
    


