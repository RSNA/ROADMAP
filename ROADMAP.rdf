        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00579"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00580"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00581"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00582"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00583"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00584"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00585"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00586"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00587"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00588"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00589"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00590"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00591"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00592"/>
        <dcterms:source rdf:resource="https://doi.org/10.1136/bmj-2022-070904"/>
        <rdfs:label xml:lang="en">DECIDE-AI</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.equator-network.org/reporting-guidelines/reporting-guideline-for-the-early-stage-clinical-evaluation-of-decision-support-systems-driven-by-artificial-intelligence-decide-ai/"/>
        <skos:altLabel xml:lang="en">Developmental and Exploratory Clinical Investigations of DEcision support systems driven by Artificial Intelligence</skos:altLabel>
        <skos:definition xml:lang="en">DECIDE-AI is a stage specific reporting guideline for the early, small scale and live clinical evaluation of decision support systems based on artificial intelligence.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00487 -->

