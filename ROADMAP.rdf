        <dcterms:publisher xml:lang="en">Radiological Society of North America</dcterms:publisher>
        <dcterms:source rdf:resource="https://doi.org/10.1148/ryai.260069"/>
        <dcterms:title xml:lang="en">Radiology Ontology of AI Datasets, Models and Projects</dcterms:title>
        <owl:versionInfo>2026-11</owl:versionInfo>
    </owl:Ontology>
    


