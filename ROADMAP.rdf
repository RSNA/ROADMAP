    <!-- https://rsna.org/roadmap/03647 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/03647">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03467"/>
        <rdfs:label xml:lang="en">days of gestation</rdfs:label>
        <rdfs:label xml:lang="es">días de gestación</rdfs:label>
        <rdfs:label xml:lang="zh">妊娠天数</rdfs:label>
        <skos:closeMatch rdf:resource="http://mimi.case.edu/ontologies/2009/1/UnitsOntology#day"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/unit/DAY"/>
        <skos:definition xml:lang="en">Unit for Gestational age, as measured in days from the onset of the mother&apos;s last menstrual period. To simplify comparison, gestational age should be converted from the weeks / days format.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/03813 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/03813">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03809"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00474"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00475"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00476"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00477"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00478"/>
        <dcterms:publisher rdf:resource="https://www.oecd.org/"/>
        <dcterms:publisher xml:lang="en">Organisation for Economic Co-operation and Development</dcterms:publisher>
        <dcterms:source rdf:resource="https://www.oecd.org/en/topics/sub-issues/ai-principles.html"/>
        <rdfs:comment xml:lang="en">The OECD AI Principles are the first intergovernmental standard on AI. They promote innovative, trustworthy AI that respects human rights and democratic values. Adopted in 2019 and updated in 2024, they are composed of five values-based principles and five recommendations that provide practical and flexible guidance for policymakers and AI actors [from OECD web site].</rdfs:comment>
        <rdfs:label xml:lang="en">OECD AI Principles</rdfs:label>
        <skos:definition xml:lang="en">The OECD AI Principles are a framework adopted in 2019 by the Organisation for Economic Co-operation and Development to promote trustworthy and human-centered artificial intelligence. They guide governments and organizations in developing, deploying, and managing AI systems that are fair, transparent, and accountable. The OECD AI Principles identify five complementary values-based principles for the responsible stewardship of trustworthy AI.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/03814 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/03814">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03809"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00479"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00480"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00481"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00482"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00483"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00484"/>
        <dcterms:publisher rdf:resource="https://www.who.int/"/>
        <dcterms:publisher xml:lang="en">World Health Organization</dcterms:publisher>
        <dcterms:source rdf:resource="https://www.who.int/publications/i/item/9789240029200"/>
        <rdfs:label xml:lang="en">World Health Organization Guidance on Ethics and Governance of AI for Health</rdfs:label>
        <skos:altLabel xml:lang="en">WHO AI principles</skos:altLabel>
        <skos:altLabel xml:lang="en">WHO framework</skos:altLabel>
        <skos:definition xml:lang="en">The key ethical principles for use of artificial intelligence for health, as defined by the World Health Organization.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/03815 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/03815">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03809"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00170"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00171"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00172"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00173"/>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/sdata.2016.18"/>
        <rdfs:label xml:lang="en">FAIR Guiding Principles</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.go-fair.org/fair-principles/"/>
        <skos:altLabel xml:lang="en">FAIR</skos:altLabel>
        <skos:altLabel xml:lang="en">FAIR principles</skos:altLabel>
        <skos:definition xml:lang="en">Guiding principles that stress the findability, accessibility, interoperability, and reusability of scientific data.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/03816 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/03816">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03809"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00253"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00254"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00255"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00256"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00257"/>
        <hasEthicalPrinciple rdf:resource="https://rsna.org/roadmap/00258"/>
        <dcterms:source rdf:resource="https://doi.org/10.1136/bmj-2024-081554"/>
        <rdfs:label xml:lang="en">FUTURE-AI</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://future-ai.eu/"/>
        <skos:definition xml:lang="en">FUTURE-AI is an international, multi-stakeholder initiative for defining and maintaining concrete guidelines that will facilitate the design, development, validation and deployment of trustworthy AI solutions in medicine and healthcare based on six guiding principles: Fairness, Universality, Traceability, Usability, Robustness and Explainability.</skos:definition>
    </owl:NamedIndividual>
    


