    <owl:Class rdf:about="https://rsna.org/roadmap/03421">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00065"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00531"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00584"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">fecha de actualización</rdfs:label>
        <rdfs:label xml:lang="en">update date</rdfs:label>
        <rdfs:label xml:lang="zh">更新日期</rdfs:label>
        <skos:definition xml:lang="en">The date on which an AI resource was updated.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03422 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03422">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03381"/>
        <rdfs:label xml:lang="es">descriptor del paciente</rdfs:label>
        <rdfs:label xml:lang="en">patient descriptor</rdfs:label>
        <rdfs:label xml:lang="zh">患者描述符</rdfs:label>
        <skos:definition xml:lang="en">Information that describes a single patient or a cohort, such as age, sex, and other factors.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03423 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03423">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03565"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00547"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/03467"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">age</rdfs:label>
        <rdfs:label xml:lang="es">edad</rdfs:label>
        <rdfs:label xml:lang="zh">年龄</rdfs:label>
        <skos:altLabel xml:lang="en">patient age</skos:altLabel>
        <skos:definition xml:lang="en">Chronological age of an individual.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/424144002"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03424 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03424">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03565"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasValue"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03428"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00548"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">sex</rdfs:label>
        <rdfs:label xml:lang="es">sexo</rdfs:label>
        <rdfs:label xml:lang="zh">性别</rdfs:label>
        <skos:altLabel xml:lang="en">patient sex</skos:altLabel>
        <skos:definition xml:lang="en">The biological classification of an individual as male or female; may specify the sex assigned at birth, recorded sex, or sex parameter for clinical use.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/184100006"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03425 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03425">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03426"/>
        <rdfs:comment xml:lang="en">Birth Sex
                                         Applicable Vocabulary Standard(s)

                                         Birth sex must be coded in accordance with HL7 Version 3 (V3) Standard, Value Sets for AdministrativeGender and NullFlavor attributed as follows:

                                         Female. F
                                         Male. M
                                         Unknown. nullFlavor UNK
                                         Adopted at 45 CFR 170.207(n)</rdfs:comment>
        <rdfs:label xml:lang="en">sex assigned at birth</rdfs:label>
        <rdfs:label xml:lang="es">sexo asignado al nacer</rdfs:label>
        <rdfs:label xml:lang="zh">出生时指定的性别</rdfs:label>
        <skos:altLabel xml:lang="en">ASAB</skos:altLabel>
        <skos:altLabel xml:lang="en">SAAB</skos:altLabel>
        <skos:altLabel xml:lang="en">birth sex</skos:altLabel>
        <skos:altLabel xml:lang="en">sex at birth</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/621591000124103"/>
        <skos:definition xml:lang="en">The patient&apos;s sex, recorded based on visual inspection of genitalia at birth, as coded in accordance with HL7 Version 3 (V3) Standard.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03426 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03426">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03424"/>
        <dcterms:source rdf:resource="http://hl7.org/fhir/StructureDefinition/individual-recordedSexOrGender"/>
        <rdfs:label xml:lang="en">recorded sex or gender</rdfs:label>
        <rdfs:label xml:lang="es">sexo o género registrado</rdfs:label>
        <rdfs:label xml:lang="zh">记录的性别</rdfs:label>
        <skos:altLabel xml:lang="en">RSG</skos:altLabel>
        <skos:altLabel xml:lang="en">RSoG</skos:altLabel>
        <skos:altLabel xml:lang="en">recorded sex</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/831191000124103"/>
        <skos:definition xml:lang="en">From HL7/FHIR: Recorded sex or gender (RSG) information includes the various sex and gender concepts that are often used in existing systems but are known NOT to represent a gender identity, sex parameter for clinical use, or attributes related to sexuality, such as sexual orientation, sexual activity, or sexual attraction. Examples of recorded sex or gender concepts include administrative gender, administrative sex, and sex assigned at birth.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03427 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03427">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03424"/>
        <dcterms:source rdf:resource="http://hl7.org/fhir/StructureDefinition/patient-sexParameterForClinicalUse"/>
        <rdfs:label xml:lang="en">sex parameter for clinical use</rdfs:label>
        <rdfs:label xml:lang="es">sexo para uso clínico</rdfs:label>
        <rdfs:label xml:lang="zh">临床用途的性别</rdfs:label>
        <skos:altLabel xml:lang="en">SFCU</skos:altLabel>
        <skos:altLabel xml:lang="en">SPCU</skos:altLabel>
        <skos:altLabel xml:lang="en">clinical sex</skos:altLabel>
        <skos:altLabel xml:lang="en">sex for clinical use</skos:altLabel>
        <skos:definition xml:lang="en">The Sex Parameter for Clinical Use (SPCU) is a context-dependent, actionable data element used in healthcare IT to guide clinical decisions, such as selecting appropriate lab reference ranges or diagnostic procedures, based on physiological characteristics (e.g., organ inventory, hormone levels) rather than solely on gender identity or sex assigned at birth.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03428 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03428">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03422"/>
        <rdfs:comment xml:lang="en">Matched to SNOMED CT concepts of &quot;Finding related to biological sex.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">sex value</rdfs:label>
        <rdfs:label xml:lang="es">valor de sexo</rdfs:label>
        <rdfs:label xml:lang="zh">性别值</rdfs:label>
        <skos:definition xml:lang="en">A patient&apos;s biological sex..</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/429019009"/>
        <skos:exactMatch rdf:resource="http://www.radlex.org/RID/RID5652"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03432 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03432">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03564"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03565"/>
        <rdfs:comment xml:lang="en">A value set -- male, female, nonbinary, exploring or questioning, another not listed, choose not to disclose, unknown -- is the USCDI value set, which differs from the SNOMED CT value set carried below: USCDI has &apos;exploring or questioning&apos; and &apos;choose not to disclose&apos; but no transgender or gender non-conforming values, while the SNOMED set has the reverse. Reconciling the two is an open issue; a fairness evaluation stratified by gender identity will give different subgroups depending on which is used.</rdfs:comment>
        <rdfs:comment xml:lang="en">Values for gender identity should include male, female, nonbinary, exploring or questioning, another not listed (specify), choose not to disclose, and unknown. CSTE recommends that the terms transgender, female to male and transgender male to female be deprecated.</rdfs:comment>
        <rdfs:label xml:lang="en">gender identity</rdfs:label>
        <rdfs:label xml:lang="es">identidad de género</rdfs:label>
        <rdfs:label xml:lang="zh">性别认同</rdfs:label>
        <skos:altLabel xml:lang="en">gender</skos:altLabel>
        <skos:altLabel xml:lang="en">patient gender</skos:altLabel>
        <skos:definition xml:lang="en">Gender identity is an individual&apos;s personal sense of being a male gender (man, boy), female gender (woman, girl), another gender(s), or no gender, that is not necessarily visible to others and must be declared by the person. [SNOMED CT]</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/33821000087103"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03441 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03441">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01011"/>
        <rdfs:comment xml:lang="en">Standard values for U.S.: 
+ Asian
+ Black or African American
+ Hispanic or Latino
+ Middle Eastern or North African
+ Native Hawaiian or Pacific Islander
+ White</rdfs:comment>
        <rdfs:label xml:lang="en">race / ethnicity</rdfs:label>
        <rdfs:label xml:lang="es">raza / etnicidad</rdfs:label>
        <rdfs:label xml:lang="zh">种族/民族</rdfs:label>
        <skos:altLabel xml:lang="en">demographic group</skos:altLabel>
        <skos:altLabel xml:lang="en">ethnic group</skos:altLabel>
        <skos:altLabel xml:lang="en">ethnicity</skos:altLabel>
        <skos:altLabel xml:lang="en">race</skos:altLabel>
        <skos:altLabel xml:lang="en">racial group</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/103579009"/>
        <skos:closeMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/397731000"/>
        <skos:definition xml:lang="en">Demographic descriptor that specifies the socially-defined characteristics of &quot;race&quot; and/or &quot;ethnicity&quot;.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03449 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03449">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03462"/>
        <rdfs:comment xml:lang="en">Age groups are asserted using restrictions as [lower, upper) -- that is, inclusive lower age value, exclusive upper age value. For example, adult 45 - 64 years has age &gt;= 45 and &lt; 65.</rdfs:comment>
        <rdfs:comment xml:lang="en">MeSH descriptor: Age Groups (D009273)</rdfs:comment>
        <rdfs:label xml:lang="en">age group</rdfs:label>
        <rdfs:label xml:lang="es">grupo de edad</rdfs:label>
        <rdfs:label xml:lang="zh">年龄组</rdfs:label>
        <skos:definition xml:lang="en">A predefined age range, in accordance with the U.S. National Library of Medicine&apos;s Medical Subject Headings (MeSH) vocabulary.</skos:definition>
        <skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/M0014447"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03450 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03450">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03449"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03470"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03449"/>
        <rdfs:comment xml:lang="en">MeSH definition: A person having attained full growth or maturity. Adults are of 19 through 44 years of age. For a person between 19 and 24 years of age, YOUNG ADULT is available.</rdfs:comment>
        <rdfs:comment xml:lang="en">MeSH descriptor: Adult (D000328), 19 to 44 years</rdfs:comment>
        <rdfs:label xml:lang="zh">19-44岁成人</rdfs:label>
        <rdfs:label xml:lang="en">adult 19 - 44 years</rdfs:label>
        <rdfs:label xml:lang="es">adulto de 19 a 44 años</rdfs:label>
        <skos:definition xml:lang="en">An individual of age 19 to 44 years.</skos:definition>
        <skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/M0000504"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03451 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03451">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03449"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03470"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03449"/>
        <rdfs:comment xml:lang="en">MeSH definition: A person 6 to 12 years of age. An individual 2 to 5 years old is CHILD, PRESCHOOL.</rdfs:comment>
        <rdfs:comment xml:lang="en">MeSH descriptor: Child (D002648), 6 to 12 years</rdfs:comment>
        <rdfs:label xml:lang="zh">6-12 岁儿童</rdfs:label>
        <rdfs:label xml:lang="en">child 6 - 12 years</rdfs:label>
        <rdfs:label xml:lang="es">niño de 6 a 12 años</rdfs:label>
        <skos:altLabel xml:lang="en">child</skos:altLabel>
        <skos:altLabel xml:lang="es">niño</skos:altLabel>
        <skos:altLabel xml:lang="en">school-age child</skos:altLabel>
        <skos:altLabel xml:lang="en">schoolchild</skos:altLabel>
        <skos:altLabel xml:lang="zh">儿童</skos:altLabel>
        <skos:definition xml:lang="en">An individual of age 6 - 12 years.</skos:definition>
        <skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/M0004045"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03452 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03452">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03449"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03468"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">730</xsd:maxExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03469"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</xsd:maxExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03470"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0833</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:maxExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03449"/>
        <rdfs:comment xml:lang="en">Coded as: [29,730) days or [1,24) months or [0.08333,2) years</rdfs:comment>
