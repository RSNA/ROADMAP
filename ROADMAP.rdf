    <!-- https://rsna.org/roadmap/00253 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00253">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00249"/>
        <rdfs:comment xml:lang="en">The U in FUTURE-AI: AI solutions should be developed and validated on diverse, representative populations to ensure broad applicability.</rdfs:comment>
        <rdfs:label xml:lang="en">universality</rdfs:label>
        <skos:altLabel xml:lang="en">universal</skos:altLabel>
        <skos:altLabel xml:lang="en">universality principle</skos:altLabel>
        <skos:definition xml:lang="en">The universality principle states that a medical AI tool should be generalizable outside the controlled environment where it was built. Specifically, the AI tool should be able to generalize to new patients and users, and when applicable, to new clinical sites.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00254 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00254">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00249"/>
        <rdfs:comment xml:lang="en">The T in FUTURE-AI: AI solutions should be transparent, with full documentation of data, methods, and results to support auditability.</rdfs:comment>
        <rdfs:label xml:lang="en">traceability</rdfs:label>
        <skos:altLabel xml:lang="en">traceability principle</skos:altLabel>
        <skos:altLabel xml:lang="en">traceable</skos:altLabel>
        <skos:definition xml:lang="en">The traceability principle states that medical AI tools should be developed together with mechanisms for documenting and monitoring the complete trajectory of the AI tool, from development and validation to deployment and usage.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00255 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00255">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00249"/>
        <rdfs:comment xml:lang="en">The E in FUTURE-AI: AI solutions should provide explanations that are clinically meaningful and understandable to end users.</rdfs:comment>
        <rdfs:label xml:lang="en">explainability</rdfs:label>
        <skos:altLabel xml:lang="en">explainability principle</skos:altLabel>
        <skos:altLabel xml:lang="en">explainable</skos:altLabel>
        <skos:definition xml:lang="en">The explainability principle states that medical AI tools should provide clinically meaningful information about the logic behind the AI decisions.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00256 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00256">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00249"/>
        <rdfs:comment xml:lang="en">The U(s) in FUTURE-AI: AI solutions should be designed for practical, effective use in real clinical workflows.</rdfs:comment>
        <rdfs:label xml:lang="en">usability</rdfs:label>
        <skos:altLabel xml:lang="en">usability principle</skos:altLabel>
        <skos:altLabel xml:lang="en">usable</skos:altLabel>
        <skos:definition xml:lang="en">The usability principle states that the end users should be able to use an AI tool to achieve a clinical goal efficiently and safely in their real world environment.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00257 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00257">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00249"/>
        <rdfs:comment xml:lang="en">The R in FUTURE-AI: AI solutions should perform reliably and safely across diverse clinical settings and patient populations.</rdfs:comment>
        <rdfs:label xml:lang="en">robustness</rdfs:label>
        <skos:altLabel xml:lang="en">robust</skos:altLabel>
        <skos:altLabel xml:lang="en">robustness principle</skos:altLabel>
        <skos:definition xml:lang="en">The robustness principle refers to the ability of a medical AI tool to maintain its performance and accuracy under expected or unexpected variations in the input data.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00258 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00258">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00249"/>
        <rdfs:comment xml:lang="en">The F in FUTURE-AI: AI solutions should perform equitably across demographic subgroups and avoid discriminatory outcomes.</rdfs:comment>
        <rdfs:label xml:lang="en">fairness</rdfs:label>
        <skos:altLabel xml:lang="en">equitable</skos:altLabel>
        <skos:altLabel xml:lang="en">equity</skos:altLabel>
        <skos:altLabel xml:lang="en">fair</skos:altLabel>
        <skos:altLabel xml:lang="en">fairness principle</skos:altLabel>
        <skos:definition xml:lang="en">The fairness principle states that medical AI tools should maintain the same performance across individuals and groups of individuals.</skos:definition>
    </owl:NamedIndividual>
    


