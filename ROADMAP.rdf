        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:label xml:lang="en">STARD-AI item 36</rdfs:label>
        <skos:definition xml:lang="en">Registration number and name of registry.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00322 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00322">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <rdfs:label xml:lang="en">STARD-AI item 37</rdfs:label>
        <skos:definition xml:lang="en">Where the full study protocol can be accessed.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00323 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00323">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:label xml:lang="en">STARD-AI item 38</rdfs:label>
        <skos:definition xml:lang="en">Sources of funding and other support; role of funders.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00324 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00324">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:label xml:lang="en">STARD-AI item 39</rdfs:label>
        <skos:definition xml:lang="en">Commercial interests, if applicable.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00325 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00325">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:label xml:lang="en">STARD-AI item 40a</rdfs:label>
        <skos:definition xml:lang="en">Availability of datasets and code; detailing any restrictions on their reuse and repurposing.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00326 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00326">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:label xml:lang="en">STARD-AI item 40b</rdfs:label>
        <skos:definition xml:lang="en">Whether outputs are stored, auditable and available for evaluation, if necessary.</skos:definition>
    </owl:NamedIndividual>
    


