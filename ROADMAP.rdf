        <dcterms:source rdf:resource="https://www.fda.gov/media/184856/download"/>
        <rdfs:label xml:lang="en">known bias or failure mode</rdfs:label>
        <rdfs:label xml:lang="es">sesgo o modo de fallo conocido</rdfs:label>
        <rdfs:label xml:lang="zh">已知偏差或故障模式</rdfs:label>
        <skos:altLabel xml:lang="en">bias</skos:altLabel>
        <skos:altLabel xml:lang="en">biases</skos:altLabel>
        <skos:altLabel xml:lang="en">failure mode</skos:altLabel>
        <skos:altLabel xml:lang="en">failure modes</skos:altLabel>
        <skos:altLabel xml:lang="en">known bias</skos:altLabel>
        <skos:altLabel xml:lang="en">known biases</skos:altLabel>
        <skos:altLabel xml:lang="en">known biases or failure modes</skos:altLabel>
        <skos:altLabel xml:lang="en">known failure mode</skos:altLabel>
        <skos:altLabel xml:lang="en">known failure modes</skos:altLabel>
        <skos:definition xml:lang="en">Known circumstances where the device input will not align with the data used in development and validation.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03630 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03630">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03621"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00313"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00314"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00424"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00450"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00519"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00596"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00616"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00638"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://www.fda.gov/media/184856/download"/>
        <rdfs:label xml:lang="es">brecha conocida en la caracterización de los datos</rdfs:label>
        <rdfs:label xml:lang="en">known data-characterization gap</rdfs:label>
        <rdfs:label xml:lang="zh">已知数据特征描述差距</rdfs:label>
        <skos:definition xml:lang="en">Known gaps in the data characterization, such as patient populations that are not well represented in development (e.g., training) or testing datasets, and therefore, may be at risk of bias.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03631 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03631">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00015"/>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="en">other use</rdfs:label>
        <rdfs:label xml:lang="es">otro uso</rdfs:label>
        <rdfs:label xml:lang="zh">其他用途</rdfs:label>
        <skos:definition xml:lang="en">Use other than one of the predefined classes; should be specified as text.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03632 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03632">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03343"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/34.232073"/>
        <rdfs:label xml:lang="en">95th percentile Hausdorff distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia de Hausdorff del percentil 95</rdfs:label>
        <rdfs:label xml:lang="zh">第95百分位豪斯多夫距离</rdfs:label>
        <skos:altLabel xml:lang="en">95HD</skos:altLabel>
        <skos:altLabel xml:lang="en">HD95</skos:altLabel>
        <skos:definition xml:lang="en">The 95th percentile Hausdorff distance measures the distance threshold below which 95% of the closest point distances between two boundaries fall, reducing sensitivity to extreme outliers. It evaluates boundary alignment while mitigating the influence of isolated segmentation errors. This metric is widely adopted in medical imaging tasks for robust surface distance assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03633 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03633">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1073083.1073135"/>
        <rdfs:label xml:lang="en">BLEU</rdfs:label>
        <rdfs:label xml:lang="es">BLEU</rdfs:label>
        <rdfs:label xml:lang="zh">双语评估替补</rdfs:label>
        <skos:altLabel xml:lang="zh">BLEU</skos:altLabel>
        <skos:altLabel xml:lang="en">BLEU score</skos:altLabel>
        <skos:altLabel xml:lang="en">Bilingual Evaluation Understudy</skos:altLabel>
        <skos:definition xml:lang="en">BLEU is an automatic, language-independent metric for assessing the quality of machine-generated text, most commonly machine translation, by comparing a candidate output with one or more human reference texts. It aggregates modified n-gram precisions across multiple n-gram sizes and applies a brevity penalty, yielding a standardized, inexpensive corpus-level score that correlates strongly with human judgments. BLEU primarily reflects surface n-gram precision between system and reference texts and does not directly evaluate semantic meaning.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03634 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03634">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://aclanthology.org/W04-1013/"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <rdfs:label xml:lang="en">ROUGE</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE 指标</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE is a set of metrics used to evaluate the quality of machine-generated text, particularly summaries, by comparing it to human-written reference texts. It measures content similarity using overlapping units such as n-grams, sequences, and word pairs, with a primary focus on recall, complemented by precision and F-measure. ROUGE is widely applied for summarization evaluation due to its correlation with human judgment and its ability to incorporate multiple reference summaries.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03637 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03637">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03314"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasXAxis"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03322"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasYAxis"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03339"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">análisis de la curva característica operativa del receptor</rdfs:label>
        <rdfs:label xml:lang="en">receiver operating characteristic analysis</rdfs:label>
        <rdfs:label xml:lang="zh">受试者工作特征分析</rdfs:label>
        <skos:altLabel xml:lang="en">ROC</skos:altLabel>
        <skos:altLabel xml:lang="en">ROC analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">ROC curve</skos:altLabel>
        <skos:altLabel xml:lang="en">receiver operating characteristic</skos:altLabel>
        <skos:altLabel xml:lang="en">receiver operating characteristic curve</skos:altLabel>
        <skos:definition xml:lang="en">Receiver Operating Characteristic (ROC) analysis is a graphical plot that illustrates the diagnostic ability of a binary classifier system as its discrimination threshold varies. It plots the true positive rate (sensitivity) against the false positive rate (1-specificity) at various threshold settings. The area under the ROC curve (AUC) provides an aggregate measure of performance across all classification thresholds.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03638 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03638">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04062"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03759"/>
        <rdfs:label xml:lang="en">calibration metric</rdfs:label>
        <skos:definition xml:lang="en">A metric that measures calibration performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03639 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03639">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:comment xml:lang="en">It is useful to provide the URL to the FDA clearance statement regarding the predicate device.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de referencia</rdfs:label>
        <rdfs:label xml:lang="en">predicate device</rdfs:label>
        <rdfs:label xml:lang="zh">对照器械</rdfs:label>
        <skos:definition xml:lang="en">A predicate device is an FDA-cleared medical device used as point of comparison for new medical devices seeking approval through FDA’s 510(k) pre-market clearance pathway.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03640 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03640">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03778"/>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:label xml:lang="en">matrix metric</rdfs:label>
        <rdfs:label xml:lang="es">métrica matricial del rendimiento del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">模型性能的矩阵度量</rdfs:label>
        <skos:altLabel xml:lang="en">matrix metric of model performance</skos:altLabel>
        <skos:altLabel xml:lang="en">matrix model performance data</skos:altLabel>
        <skos:altLabel xml:lang="en">matrix model performance metric</skos:altLabel>
        <skos:altLabel xml:lang="en">model performance matrix</skos:altLabel>
        <skos:definition xml:lang="en">Model performance metric presented as a matrix, such as a confusion matrix or 2x2 contingency table.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03641 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03641">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03778"/>
        <rdfs:label xml:lang="en">graphical metric</rdfs:label>
        <rdfs:label xml:lang="es">métrica gráfica del rendimiento del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">模型性能的图形度量</rdfs:label>
        <skos:altLabel xml:lang="en">graphical metric of model performance</skos:altLabel>
        <skos:altLabel xml:lang="en">graphical model performance data</skos:altLabel>
        <skos:altLabel xml:lang="en">graphical model performance metric</skos:altLabel>
        <skos:altLabel xml:lang="en">model performance graph</skos:altLabel>
        <skos:definition xml:lang="en">Model performance metric presented as a graphical object, such as a histogram or an ROC curve.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03642 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03642">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00659"/>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/04043"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/ryai.260070"/>
        <rdfs:label xml:lang="en">metric</rdfs:label>
        <rdfs:label xml:lang="es">métrica de rendimiento del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">模型性能指标</rdfs:label>
        <skos:altLabel xml:lang="en">metric of model performance</skos:altLabel>
        <skos:altLabel xml:lang="en">model performance data</skos:altLabel>
        <skos:altLabel xml:lang="en">model performance information</skos:altLabel>
        <skos:altLabel xml:lang="en">model performance metric</skos:altLabel>
        <skos:altLabel xml:lang="en">performance data</skos:altLabel>
        <skos:altLabel xml:lang="en">performance metric</skos:altLabel>
        <skos:definition xml:lang="en">Information that describes how well that model performs at its given task; includes graphical (e.g., ROC curves), matrix (e.g., confusion matrix), and scalar metrics (e.g., recall).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03643 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03643">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasXAxis"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03339"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasYAxis"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03324"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/radiol.220182"/>
        <rdfs:label xml:lang="es">curva precisión-exhaustividad</rdfs:label>
        <rdfs:label xml:lang="en">precision-recall curve</rdfs:label>
        <rdfs:label xml:lang="zh">精确率-召回率曲线</rdfs:label>
        <skos:altLabel xml:lang="en">P-R curve</skos:altLabel>
        <skos:altLabel xml:lang="en">PR curve</skos:altLabel>
        <skos:altLabel xml:lang="en">precision recall curve</skos:altLabel>
        <skos:altLabel xml:lang="en">precision-recall analysis</skos:altLabel>
        <skos:definition xml:lang="en">The precision–recall curve (PRC) plots precision on the y-axis against recall on the x-axis at varying thresholds.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000695"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03653 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03653">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12916-019-1466-7"/>
        <rdfs:label xml:lang="en">calibration slope</rdfs:label>
        <rdfs:label xml:lang="es">pendiente de calibración</rdfs:label>
        <rdfs:label xml:lang="zh">校准斜率</rdfs:label>
        <skos:definition xml:lang="en">The calibration slope assesses the spread of predicted probabilities by evaluating whether predictions are too extreme or too moderate. It is calculated as the slope in a logistic regression of observed outcomes on predicted log-odds, regardless of the method used to generate the predictions. A value of 1 indicates perfect calibration; values less than 1 suggest overconfident predictions, while values greater than 1 indicate underconfident predictions.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000687"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03654 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03654">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12916-019-1466-7"/>
        <rdfs:label xml:lang="en">calibration intercept</rdfs:label>
        <rdfs:label xml:lang="es">ordenada en el origen de la calibración</rdfs:label>
        <rdfs:label xml:lang="zh">校准截距</rdfs:label>
        <skos:definition xml:lang="en">The calibration intercept is obtained from a logistic regression of observed outcomes on predicted log-odds and measures systematic bias in predicted probabilities, regardless of the method used to generate the predictions. An intercept of zero indicates perfect agreement; negative values indicate overestimation of risk, while positive values indicate underestimation.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000688"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03655 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03655">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.jclinepi.2015.12.005"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">calibración global</rdfs:label>
        <rdfs:label xml:lang="en">calibration-in-the-large</rdfs:label>
        <rdfs:label xml:lang="zh">全局校准</rdfs:label>
        <skos:altLabel xml:lang="en">calibration in the large</skos:altLabel>
        <skos:definition xml:lang="en">Calibration-in-the-large measures the overall agreement between predicted probabilities and observed event rates by comparing their means. It reflects systematic bias in predictions: a value near zero indicates no global overestimation or underestimation of risk. Large positive values suggest underprediction, while large negative values indicate overprediction.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03656 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03656">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2210.07810"/>
        <rdfs:label xml:lang="es">error de calibración esperado con estimación de densidad de núcleo</rdfs:label>
        <rdfs:label xml:lang="en">expected calibration error with kernel density estimate</rdfs:label>
        <rdfs:label xml:lang="zh">基于核密度估计的预期校准误差</rdfs:label>
        <skos:altLabel xml:lang="en">ECE-KDE</skos:altLabel>
        <skos:altLabel xml:lang="en">expected calibration error - kernel density estimate</skos:altLabel>
        <skos:definition xml:lang="en">Expected calibration error with kernel density estimate evaluates calibration by replacing binning with a kernel-based smoothing approach. It estimates the difference between predicted probabilities and observed outcomes across the entire probability space, providing a continuous measure of canonical calibration. Smaller values indicate closer alignment between predicted and true probabilities.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03658 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03658">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1609/aaai.v29i1.9602"/>
        <rdfs:label xml:lang="es">error máximo de calibración</rdfs:label>
        <rdfs:label xml:lang="en">maximum calibration error</rdfs:label>
        <rdfs:label xml:lang="zh">最大校准误差</rdfs:label>
        <skos:definition xml:lang="en">Maximum calibration error identifies the largest absolute difference between predicted probabilities and observed event frequencies across all bins. It provides a worst-case measure of local miscalibration, making it particularly relevant for high-stakes decision-making.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03659 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03659">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01040"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.patrec.2008.08.010"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="en">macro average mean probability rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de probabilidad media promedio macro</rdfs:label>
        <rdfs:label xml:lang="zh">宏平均平均概率率</rdfs:label>
        <skos:altLabel xml:lang="en">MAPR</skos:altLabel>
        <skos:altLabel xml:lang="en">macro average probability rate</skos:altLabel>
        <skos:definition xml:lang="en">The macro average mean probability rate is a probabilistic performance metric for multi-class classification tasks where models output probability scores. It is calculated by averaging, across all classes, the mean predicted probability assigned to the true class for each instance, ensuring that each class contributes equally regardless of frequency. It provides a probability-based generalization of balanced accuracy, reflecting how well predicted probabilities align with true class membership, though it is sensitive to class imbalance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03662 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03662">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01058"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0272989X06295361"/>
        <rdfs:label xml:lang="es">beneficio neto</rdfs:label>
        <rdfs:label xml:lang="en">net benefit</rdfs:label>
        <rdfs:label xml:lang="zh">净收益</rdfs:label>
        <skos:altLabel xml:lang="en">NB</skos:altLabel>
        <skos:definition xml:lang="en">Net benefit expresses the clinical utility of a prediction model by weighing the benefit of true positives against the harm of false positives under a chosen risk threshold. It reflects the net proportion of correct positive decisions after adjusting for unnecessary interventions. This metric is commonly used in decision-analytic frameworks.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03663 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03663">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01056"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03641"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016%2FS0140-6736%2886%2990837-8"/>
        <dcterms:source rdf:resource="https://doi.org/10.11613/BM.2015.015"/>
        <rdfs:label xml:lang="en">Bland-Altman analysis</rdfs:label>
        <rdfs:label xml:lang="zh">Bland-Altman 分析</rdfs:label>
        <rdfs:label xml:lang="es">análisis de Bland-Altman</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Bland%E2%80%93Altman_plot"/>
        <skos:altLabel xml:lang="en">B&amp;A</skos:altLabel>
        <skos:altLabel xml:lang="en">B&amp;A plot</skos:altLabel>
        <skos:altLabel xml:lang="en">Bland-Altman plot</skos:altLabel>
        <skos:altLabel xml:lang="en">Tukey mean-difference plot</skos:altLabel>
        <skos:altLabel xml:lang="en">difference plot</skos:altLabel>
        <skos:altLabel xml:lang="en">mean-difference plot</skos:altLabel>
        <skos:definition xml:lang="en">A Bland–Altman plot (difference plot) in biomedicine is a method of data plotting used in analyzing the agreement between two different tests. It is identical to a Tukey mean-difference plot.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03666 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03666">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2022.0741"/>
        <rdfs:label xml:lang="en">diagnostic yield</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento diagnóstico</rdfs:label>
        <rdfs:label xml:lang="zh">诊断检出率</rdfs:label>
        <skos:altLabel xml:lang="en">DY</skos:altLabel>
        <skos:altLabel xml:lang="en">detection rate</skos:altLabel>
        <skos:definition xml:lang="en">Diagnostic yield represents the proportion of patients in a study cohort who are correctly identified as having the target condition by the test under evaluation. It is calculated as the number of true positive cases divided by the total number of individuals examined. This metric provides a clinically relevant estimate of how often a test detects the disease within the tested population, particularly useful in screening or diagnostic studies where negative cases are not fully verified.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03667 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03667">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="en">point inside mask/box/approximation</rdfs:label>
        <rdfs:label xml:lang="es">punto dentro de la máscara/caja/aproximación</rdfs:label>
        <rdfs:label xml:lang="zh">掩码/框/近似区域内的点</rdfs:label>
        <skos:definition xml:lang="en">Point inside mask/box/approximation verifies whether a predicted point falls within the spatial bounds of a reference region, bounding box, or geometric approximation. It provides a binary outcome and does not account for proximity to boundaries or the degree of inclusion. This metric is primarily employed for coarse localization validation in detection systems.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03668 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03668">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-642-17711-8_23"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="en">center distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia al centro</rdfs:label>
        <rdfs:label xml:lang="zh">中心距离</rdfs:label>
        <skos:definition xml:lang="en">Center distance measures the spatial difference between the predicted center point of an object and its reference center, typically using Euclidean distance. The center can be defined as the geometric center of a bounding box, the centroid of a binary mask, or the intensity-weighted center of mass within an image. Lower values indicate closer alignment between predicted and reference positions, and predictions may be considered correct if the distance falls below a predefined threshold.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03669 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03669">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/jmi.12186"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">distancia media de la superficie</rdfs:label>
        <rdfs:label xml:lang="en">mean average surface distance</rdfs:label>
        <rdfs:label xml:lang="zh">平均表面距离</rdfs:label>
        <skos:altLabel xml:lang="en">MASD</skos:altLabel>
        <skos:altLabel xml:lang="en">mean absolute surface distance</skos:altLabel>
        <skos:definition xml:lang="en">Mean average surface distance measures the average of minimum distances from boundary points of one segmentation to another, aggregated in both directions. Unlike symmetric measures, it emphasizes the mean discrepancy across the entire contour rather than extreme deviations. It is typically applied to quantify contour-level differences in segmentation tasks.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03670 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03670">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01053"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0077089"/>
        <rdfs:label xml:lang="en">contrast-to-noise ratio</rdfs:label>
        <rdfs:label xml:lang="es">relación contraste-ruido</rdfs:label>
        <rdfs:label xml:lang="zh">对比噪声比</rdfs:label>
        <skos:altLabel xml:lang="en">CNR</skos:altLabel>
        <skos:altLabel xml:lang="en">contrast to noise</skos:altLabel>
        <skos:altLabel xml:lang="en">contrast to noise ratio</skos:altLabel>
        <skos:definition xml:lang="en">Contrast-to-noise ratio measures the ability to distinguish two regions of interest by comparing the difference in their signal intensities relative to the level of noise. It reflects the detectability of contrast features in the presence of noise, providing a more task-specific quality metric than signal-to-noise ratio. Higher contrast-to-noise ratio values indicate better contrast discrimination under noisy conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03671 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03671">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01045"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1109/TIP.2003.819861"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/TIP.2011.2173206"/>
        <rdfs:label xml:lang="en">structural similarity index measure</rdfs:label>
        <rdfs:label xml:lang="es">índice de similitud estructural</rdfs:label>
        <rdfs:label xml:lang="zh">结构相似性指数度量</rdfs:label>
        <skos:altLabel xml:lang="en">SSIM</skos:altLabel>
        <skos:definition xml:lang="en">The structural similarity index measure is a full-reference image quality metric that quantifies the similarity between two images by jointly comparing luminance, contrast, and structural information. It is computed locally over image patches, with values typically averaged to produce a global score between 0 and 1, where higher values indicate greater structural fidelity. Unlike error-based measures, the structural similarity index is designed to align with human perception by emphasizing preservation of spatial patterns and structural relationships.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03672 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03672">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.1904.09675"/>
        <rdfs:label xml:lang="en">BERTScore</rdfs:label>
        <rdfs:label xml:lang="es">BERTScore</rdfs:label>
        <rdfs:label xml:lang="zh">BERT评分</rdfs:label>
        <skos:altLabel xml:lang="en">BERT score</skos:altLabel>
        <skos:altLabel xml:lang="en">BERT-Score</skos:altLabel>
        <skos:definition xml:lang="en">BERTScore is an automatic metric for evaluating text generation quality by measuring semantic similarity between a candidate text and a reference text using contextualized embeddings from pre-trained language models such as BERT or RoBERTa. It computes pairwise cosine similarity between token embeddings, applies greedy matching to identify the most similar tokens in each direction, and aggregates these similarities into precision, recall, and F1 scores, with the F1 score commonly used as the default. By relying on meaning-based vector representations rather than exact token or n-gram matches, BERTScore captures paraphrases and long-range dependencies, making it more robust to surface variation and better aligned with human judgments; the specific score depends on the choice of underlying language model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03673 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03673">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01051"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.21236/ADA006655"/>
        <rdfs:label xml:lang="en">Flesch reading ease score</rdfs:label>
        <rdfs:label xml:lang="zh">Flesch 阅读易读性分数</rdfs:label>
        <rdfs:label xml:lang="es">Índice de legibilidad de Flesch</rdfs:label>
        <skos:altLabel xml:lang="en">Flesch reading ease</skos:altLabel>
        <skos:altLabel xml:lang="en">Flesch‐Kincaid readability index</skos:altLabel>
        <skos:altLabel xml:lang="en">Flesch‐Kincaid readability score</skos:altLabel>
        <skos:altLabel xml:lang="en">RE</skos:altLabel>
        <skos:definition xml:lang="en">The Flesch reading ease score is a readability metric that rates text on a scale from 0 to 100, where higher scores indicate easier comprehension. It is calculated from the average sentence length in words and the average number of syllables per word, producing values that can be mapped to approximate U.S. school grade levels. The score is widely used to assess how easily a general audience can read and understand written material.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03674 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03674">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01051"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.21236/ADA006655"/>
        <rdfs:label xml:lang="en">Flesch-Kincaid grade level</rdfs:label>
        <rdfs:label xml:lang="zh">Flesch-Kincaid 年级水平</rdfs:label>
        <rdfs:label xml:lang="es">nivel de grado Flesch-Kincaid</rdfs:label>
        <skos:altLabel xml:lang="en">F-K grade level</skos:altLabel>
        <skos:altLabel xml:lang="en">F-K reading grade level</skos:altLabel>
        <skos:altLabel xml:lang="en">FKGL</skos:altLabel>
        <skos:altLabel xml:lang="en">Flesch-Kincaid reading grade level</skos:altLabel>
        <skos:altLabel xml:lang="en">Flesch–Kincaid reading level</skos:altLabel>
        <skos:definition xml:lang="en">The Flesch–Kincaid Grade Level is a readability metric that estimates the U.S. school grade level required to understand a text. It is calculated from the average sentence length in words and the average number of syllables per word, producing a direct numerical grade level without the need for conversion from another scale. The metric is widely used to match written material to the reading abilities of a target audience.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03676 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03676">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1093/bioinformatics/btu080"/>
        <rdfs:label xml:lang="es">intersección sobre referencia</rdfs:label>
        <rdfs:label xml:lang="en">intersection over reference</rdfs:label>
        <rdfs:label xml:lang="zh">交集与参考集之比</rdfs:label>
        <skos:altLabel xml:lang="en">IoR</skos:altLabel>
        <skos:altLabel xml:lang="en">pixel-level sensitivity</skos:altLabel>
        <skos:definition xml:lang="en">Intersection over reference measures the fraction of the reference region that overlaps with the prediction by normalizing the intersection size to the reference size. It reflects how completely the target structure is captured without penalizing for excessive prediction beyond the reference boundary. This metric is useful when coverage of the reference anatomy is more critical than minimizing false positives.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03678 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03678">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.5194/gmd-15-5481-2022"/>
        <rdfs:label xml:lang="es">raíz del error cuadrático medio</rdfs:label>
        <rdfs:label xml:lang="en">root mean squared error</rdfs:label>
        <rdfs:label xml:lang="zh">均方根误差</rdfs:label>
        <skos:altLabel xml:lang="en">RMSE</skos:altLabel>
        <skos:altLabel xml:lang="en">root mean square error</skos:altLabel>
        <skos:definition xml:lang="en">Root mean squared error is a statistical measure that quantifies the average magnitude of prediction errors by taking the square root of the mean of squared differences between observed and predicted values. It expresses errors in the same units as the original data, which makes the metric directly interpretable as a typical deviation. It penalizes larger errors more heavily than smaller ones, and under the assumption of normally distributed independent errors, minimizing it corresponds to finding the most likely model fit.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03679 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03679">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1098/rsta.2008.0043"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="en">area under the predictive receiver operating characteristic curve</rdfs:label>
        <rdfs:label xml:lang="es">área bajo la curva característica operativa del receptor predictivo</rdfs:label>
        <rdfs:label xml:lang="zh">预测接收者操作特征曲线下的面积</rdfs:label>
        <skos:altLabel xml:lang="en">AUC-PROC</skos:altLabel>
        <skos:altLabel xml:lang="en">AUPROC</skos:altLabel>
        <skos:definition xml:lang="en">The area under the predictive receiver operating characteristic curve evaluates the overall quality of probabilistic predictions in binary classification by plotting positive predictive value against negative predictive value across thresholds. Unlike the traditional receiver operating characteristic curve, this approach conditions on the predicted outcome and incorporates the prevalence of the condition in the population. The area under this curve reflects the model’s average predictive validity across different decision thresholds and is particularly useful when the focus is on the reliability of predictions rather than classification accuracy.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03680 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03680">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03314"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.patrec.2005.10.010"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">AUC de cada clase frente a cada una de las otras k-1 clases</rdfs:label>
        <rdfs:label xml:lang="en">AUC of each class vs. each of the other k-1 classes</rdfs:label>
        <rdfs:label xml:lang="zh">每个类别与其余 k-1 个类别之间的 AUC</rdfs:label>
        <skos:altLabel xml:lang="en">AU1P</skos:altLabel>
        <skos:altLabel xml:lang="en">AU1U</skos:altLabel>
        <skos:definition xml:lang="en">This metric extends the area under the receiver operating characteristic curve to multi-class classification by computing the AUC for each class against every other class in a pairwise manner and then averaging the results. It can be calculated as an unweighted mean of all pairwise AUCs (AU1U) or as a weighted mean based on class prevalence (AU1P). This approach provides a comprehensive measure of a model’s discriminative ability across all classes while accounting for potential class imbalance when using the weighted version.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03681 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03681">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03314"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.patrec.2008.08.010"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">AUC de cada clase frente al resto combinadas</rdfs:label>
        <rdfs:label xml:lang="en">AUC of each class vs. the rest combined</rdfs:label>
        <rdfs:label xml:lang="zh">每个类别与其余所有类别组合之间的 AUC</rdfs:label>
        <skos:altLabel xml:lang="en">AUNP</skos:altLabel>
        <skos:altLabel xml:lang="en">AUNU</skos:altLabel>
        <skos:definition xml:lang="en">This metric generalizes the area under the receiver operating characteristic curve to multi-class classification by computing the AUC for each class treated as positive against all remaining classes combined as negative, then averaging these values. It can be calculated as an unweighted mean assuming equal class importance (AUNU) or as a weighted mean based on class prevalence (AUNP). This approach provides an overall assessment of a model’s ability to discriminate each class from all others while offering flexibility to account for true class distribution when using the weighted version.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03682 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03682">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03637"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.jacr.2009.06.001"/>
        <rdfs:label xml:lang="es">análisis de la curva característica operativa del receptor de localización</rdfs:label>
        <rdfs:label xml:lang="en">localization receiver operating characteristic analysis</rdfs:label>
        <rdfs:label xml:lang="zh">定位受试者工作特征分析</rdfs:label>
        <skos:altLabel xml:lang="en">LROC</skos:altLabel>
        <skos:altLabel xml:lang="en">localization ROC</skos:altLabel>
        <skos:altLabel xml:lang="en">localization ROC curve</skos:altLabel>
        <skos:altLabel xml:lang="en">location ROC</skos:altLabel>
        <skos:definition xml:lang="en">Localization ROC (LROC) curve plots location recall (i.e., rate of true positive decisions with correct localization) values against the false positive rate (1 − specificity) as the classification threshold varies. The area under the LROC curve provides an overall measure of performance across all thresholds.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03683 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03683">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.acra.2005.05.013"/>
        <rdfs:label xml:lang="en">Obuchowski index</rdfs:label>
        <rdfs:label xml:lang="zh">Obuchowski 指数</rdfs:label>
        <rdfs:label xml:lang="es">índice de Obuchowski</rdfs:label>
        <skos:altLabel xml:lang="en">weighted average of AUROC</skos:altLabel>
        <skos:definition xml:lang="en">The Obuchowski index is a nonparametric measure of diagnostic accuracy that generalizes the area under the ROC curve (AUC) to settings where the reference standard is continuous, ordinal, or nominal. It estimates the probability that a subject with a higher reference standard value receives a higher test score, averaging results from all relevant category or value pairs with optional weighting and penalties to reflect the clinical importance of different misclassifications. When the reference standard is binary, the Obuchowski index reduces to the conventional ROC AUC.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03684 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03684">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03637"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03222"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2021.0223"/>
        <rdfs:comment xml:lang="en">The summary metrics include AUROC at each time point and an integrated AUC (iAUC), which is a mathematical integration of multiple time-dependent AUC values across the follow-up period.</rdfs:comment>
        <rdfs:label xml:lang="es">análisis de la curva ROC dependiente del tiempo</rdfs:label>
        <rdfs:label xml:lang="en">time-dependent receiver operating characteristic analysis</rdfs:label>
        <rdfs:label xml:lang="zh">时间依赖性受试者工作特征分析</rdfs:label>
        <skos:altLabel xml:lang="en">time-dependent ROC analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">time-dependent ROC curve</skos:altLabel>
        <skos:definition xml:lang="en">Time-dependent receiver operating characteristic (ROC) analysis refers to a set of ROC analyses performed at specific follow-up time points in time-to-event prediction. It typically involves multiple ROC analyses, each corresponding to a distinct time point during the follow-up period. For each time point, a separate ROC curve and its corresponding area under the curve (AUC) are generated. As a result, the ROC curves and their AUC values are provided as a function of time.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03687 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03687">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1128/AAC.48.8.2787-2792.2004"/>
        <rdfs:label xml:lang="es">cociente de riesgos</rdfs:label>
        <rdfs:label xml:lang="en">hazard ratio</rdfs:label>
        <rdfs:label xml:lang="zh">风险比</rdfs:label>
        <skos:altLabel xml:lang="en">HR</skos:altLabel>
        <skos:definition xml:lang="en">The hazard ratio is a measure of relative risk that compares the hazard, or instantaneous event rate, between two groups in time-to-event analysis. It expresses the ratio of the likelihood that an event will occur at a given time point in one group relative to another, typically estimated using the Cox proportional hazards model. A hazard ratio greater than one indicates a higher event rate in the treatment group, less than one indicates a lower rate, and equal to one indicates no difference, under the assumption that the ratio remains constant over time.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000677"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03688 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03688">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03223"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03572"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2021.0223"/>
        <rdfs:label xml:lang="en">Kaplan-Meier estimator</rdfs:label>
        <rdfs:label xml:lang="es">estimador de Kaplan-Meier</rdfs:label>
        <rdfs:label xml:lang="zh">卡普兰 - 迈耶估计量</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Kaplan%E2%80%93Meier_estimator"/>
        <skos:altLabel xml:lang="en">K-M curve</skos:altLabel>
        <skos:altLabel xml:lang="en">K-M plot</skos:altLabel>
        <skos:altLabel xml:lang="zh">KM估计量</skos:altLabel>
        <skos:altLabel xml:lang="en">Kaplan-Meier curve</skos:altLabel>
        <skos:altLabel xml:lang="en">Kaplan-Meier plot</skos:altLabel>
        <skos:definition xml:lang="en">The Kaplan–Meier estimator, also known as the product limit estimator, is a non-parametric statistic used to estimate the survival function from lifetime data. In medical research, it is often used to measure the fraction of patients living for a certain amount of time after treatment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03689 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03689">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:label xml:lang="es">modelo de riesgo paramétrico</rdfs:label>
        <rdfs:label xml:lang="en">parametric hazard model</rdfs:label>
        <rdfs:label xml:lang="zh">参数风险模型</rdfs:label>
        <skos:definition xml:lang="en">Parametric hazard models are survival analysis techniques that assume a specific, underlying probability distribution (e.g., Weibull, exponential) for event times. Unlike nonparametric methods (Kaplan-Meier), they define a smooth hazard function, allowing for efficient estimation of parameters, prediction of future survival, and better handling of complex patterns.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03690 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03690">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01057"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">fracción de casos con ajuste por parte del usuario</rdfs:label>
        <rdfs:label xml:lang="en">fraction of cases with user adjustment</rdfs:label>
        <rdfs:label xml:lang="zh">用户调整病例的比例</rdfs:label>
        <skos:definition xml:lang="en">Fraction of cases with user adjustment measures the proportion of outputs from an algorithm that require manual correction by a human operator. It serves as an indicator of the algorithm’s practical accuracy and reliability from a user perspective. Lower values suggest greater autonomy of the system.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03691 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03691">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01057"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">tiempo para el ajuste por parte del usuario</rdfs:label>
        <rdfs:label xml:lang="en">time for user adjustment</rdfs:label>
        <rdfs:label xml:lang="zh">用户调整时间</rdfs:label>
        <skos:definition xml:lang="en">Time for user adjustment reflects the duration required to manually review and modify an algorithm’s outputs before acceptance. It provides insight into the usability and efficiency of the system in a clinical setting. Longer times may indicate higher interaction burden or workflow inefficiency.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03692 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03692">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01057"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">incertidumbre asociada a la interacción con el usuario</rdfs:label>
        <rdfs:label xml:lang="en">uncertainty associated with user interaction</rdfs:label>
        <rdfs:label xml:lang="zh">与用户交互相关的不确定性</rdfs:label>
        <skos:definition xml:lang="en">Uncertainty associated with user interaction describes the additional variability introduced when manual adjustments or user decisions affect an algorithm’s output. This measure accounts for operator-dependent factors in performance evaluation. It highlights the combined impact of algorithmic and human components on overall reliability.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03693 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03693">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.patter.2023.100802"/>
        <rdfs:label xml:lang="en">RadCliQ</rdfs:label>
        <rdfs:label xml:lang="es">RadCliQ</rdfs:label>
        <rdfs:label xml:lang="zh">放射学报告临床质量</rdfs:label>
        <skos:altLabel xml:lang="en">RadCliQ-v1</skos:altLabel>
        <skos:altLabel xml:lang="en">Radiology Report Clinical Quality</skos:altLabel>
        <skos:altLabel xml:lang="en">Radiology Report Clinical Quality Metric</skos:altLabel>
        <skos:definition xml:lang="en">RadCliQ is a composite metric for evaluating automatically generated radiology reports, designed to align closely with radiologists’ assessments of report quality. It combines normalized scores from BLEU, BERTScore, CheXbert vector similarity, and RadGraph F1 using a constrained linear regression model that weights each metric to predict the total number of clinically significant and insignificant errors in a report. The resulting score reflects an interpretable, clinically oriented measure of report accuracy, with lower values indicating fewer predicted errors.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03696 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03696">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2004.09167"/>
        <rdfs:label xml:lang="en">SembScore</rdfs:label>
        <rdfs:label xml:lang="es">SembScore</rdfs:label>
        <rdfs:label xml:lang="zh">SembScore 语义评分</rdfs:label>
        <skos:altLabel xml:lang="en">CheXbert labeler vector similarity</skos:altLabel>
        <skos:definition xml:lang="en">SembScore is a radiology-specific evaluation metric that measures the similarity of clinical findings between a generated report and a reference report. It uses the CheXbert labeler to extract a 14-dimensional indicator vector representing predefined pathologies from each report, then computes the cosine similarity between these vectors. The resulting score reflects the degree of alignment in reported medical conditions, providing a clinically focused assessment that is robust to differences in wording.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03697 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03697">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.patter.2023.100802"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2106.14463"/>
        <rdfs:label xml:lang="en">RadGraph-F1</rdfs:label>
        <rdfs:label xml:lang="es">RadGraph-F1</rdfs:label>
        <rdfs:label xml:lang="zh">放射报告图谱 F1 分数</rdfs:label>
        <skos:altLabel xml:lang="en">F1-RadGraph</skos:altLabel>
        <skos:altLabel xml:lang="en">F1RadGraph</skos:altLabel>
        <skos:altLabel xml:lang="en">RadGraph F1</skos:altLabel>
        <skos:definition xml:lang="en">RadGraph F1 is a clinically oriented evaluation metric for radiology report generation that measures the overlap of medical entities and their relations between a generated report and a reference report. Both reports are parsed into structured knowledge graphs, where nodes represent clinical concepts and edges represent semantic relations, and matching is determined by identical token spans, entity types, and relation types. The final score is the average of the F1 scores for entity and relation matches, providing an assessment of both the content and structural accuracy of the generated report’s clinical information.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03698 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03698">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2406.16845"/>
        <rdfs:label xml:lang="en">RaTEScore</rdfs:label>
        <rdfs:label xml:lang="es">RaTEScore</rdfs:label>
        <rdfs:label xml:lang="zh">放射学报告文本评估分数</rdfs:label>
        <skos:altLabel xml:lang="en">radiological report text evaluation metric</skos:altLabel>
        <skos:altLabel xml:lang="en">radiological report text evaluation score</skos:altLabel>
        <skos:definition xml:lang="en">RaTEScore is an entity-aware metric for assessing the quality of automatically generated radiology reports. It evaluates alignment with reference reports by extracting clinically relevant entities, mapping synonyms into a shared semantic space, and weighting matches by clinical importance while accounting for negation differences. The score is computed as the harmonic mean of precision-like and recall-like measures over matched entities, providing a modality- and anatomy-agnostic assessment that is robust to terminology variation and sensitive to clinically significant distinctions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03699 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03699">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2405.03595"/>
        <rdfs:label xml:lang="en">GREEN</rdfs:label>
        <rdfs:label xml:lang="es">GREEN</rdfs:label>
        <rdfs:label xml:lang="zh">绿色</rdfs:label>
        <skos:altLabel xml:lang="en">GREEN metric</skos:altLabel>
        <skos:altLabel xml:lang="en">GREEN score</skos:altLabel>
        <skos:altLabel xml:lang="en">Generative Radiology Report Evaluation and Error Notation</skos:altLabel>
        <skos:definition xml:lang="en">GREEN is an automated metric for assessing the factual accuracy of radiology reports by comparing a candidate report to a reference. It uses a language model to identify matched findings, detect and categorize clinically significant errors, and generate both a numerical score ranging from 0 to 1 and an explanatory summary. The score increases with more correct matches and fewer significant errors, while the summary provides interpretable feedback to support model evaluation and improvement.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03700 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03700">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2405.20613"/>
        <rdfs:label xml:lang="en">FineRadScore</rdfs:label>
        <rdfs:label xml:lang="es">FineRadScore</rdfs:label>
        <rdfs:label xml:lang="zh">精细放射评分</rdfs:label>
        <skos:definition xml:lang="en">FineRadScore is a large language model–based metric for evaluating AI-generated chest X-ray reports by comparing them to reference reports through minimal line-by-line corrections. It identifies the smallest set of insertions, deletions, or substitutions needed to match the reference, assigns each correction a severity rating reflecting clinical urgency, and classifies the type of error. The metric produces fine-grained, interpretable outputs that capture both textual accuracy and clinical significance, enabling detailed assessment beyond a single aggregate score.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03703 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03703">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01051"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.21236/ADA006655"/>
        <rdfs:label xml:lang="en">Gunning Fog index</rdfs:label>
        <rdfs:label xml:lang="zh">Gunning Fog 指数</rdfs:label>
        <rdfs:label xml:lang="es">índice de Gunning Fog</rdfs:label>
        <skos:altLabel xml:lang="en">Fog index</skos:altLabel>
        <skos:altLabel xml:lang="en">Fog score</skos:altLabel>
        <skos:altLabel xml:lang="en">GF</skos:altLabel>
        <skos:altLabel xml:lang="en">GFOG</skos:altLabel>
        <skos:altLabel xml:lang="en">Gunning Fog</skos:altLabel>
        <skos:altLabel xml:lang="en">Gunning Fog score</skos:altLabel>
        <skos:definition xml:lang="en">The Gunning Fog index is a readability metric that estimates the U.S. school grade level needed to understand a text on first reading. It is calculated from the average sentence length in words and the percentage of complex words—defined as those with three or more syllables, excluding proper nouns, compound words, familiar jargon, and common suffix forms. Higher scores indicate greater reading difficulty, with values of 8–10 considered appropriate for general audiences and values above 17 indicating very complex material.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03704 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03704">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01051"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00156"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Fry graph</rdfs:label>
        <rdfs:label xml:lang="zh">Fry 可读性图表</rdfs:label>
        <rdfs:label xml:lang="es">gráfico de Fry</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Fry_readability_formula"/>
        <skos:altLabel xml:lang="en">Fry readability formula</skos:altLabel>
        <skos:altLabel xml:lang="en">Fry readability graph</skos:altLabel>
        <skos:definition xml:lang="en">The Fry readability graph is a readability metric for English texts.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03705 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03705">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01051"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1080/19325037.2008.10599016"/>
        <dcterms:source rdf:resource="https://www.jstor.org/stable/40011226"/>
        <rdfs:label xml:lang="en">SMOG index</rdfs:label>
        <rdfs:label xml:lang="zh">SMOG指数</rdfs:label>
        <rdfs:label xml:lang="es">índice SMOG</rdfs:label>
        <skos:altLabel xml:lang="en">McLaughlin SMOG index</skos:altLabel>
        <skos:altLabel xml:lang="en">SMOG</skos:altLabel>
        <skos:altLabel xml:lang="en">SMOG score</skos:altLabel>
        <skos:altLabel xml:lang="en">simple measure of gobbledygook</skos:altLabel>
        <skos:definition xml:lang="en">The SMOG index is a readability metric that estimates the years of formal education required for full comprehension of a text. It is calculated by counting the number of polysyllabic words in a 30-sentence sample, taking the square root of this count, and adding three to yield the SMOG grade level. Developed for accuracy and simplicity, it is widely used in health communication to ensure written materials are accessible to target audiences.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03706 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03706">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01051"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1002/pits.21740"/>
        <rdfs:label xml:lang="en">FORCAST readability estimate</rdfs:label>
        <rdfs:label xml:lang="zh">FORCAST 可读性估计</rdfs:label>
        <rdfs:label xml:lang="es">estimación de legibilidad de FORCAST</rdfs:label>
        <skos:altLabel xml:lang="en">FORCAST</skos:altLabel>
        <skos:altLabel xml:lang="en">FORCAST readability formula</skos:altLabel>
        <skos:definition xml:lang="en">The FORCAST readability formula estimates the reading grade level of a text based on the number of single-syllable words in a 150-word sample. It is designed for materials that may not contain complete sentences, such as lists, instructions, or technical documents, and does not incorporate sentence length or syntactic complexity. The formula produces grade-level estimates of 5 or higher, making it most applicable to adult-oriented, non-narrative content such as manuals, forms, and questionnaires.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03707 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03707">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.aci.2018.08.003"/>
        <rdfs:comment xml:lang="en">MK = PPV + NPV - 1</rdfs:comment>
        <rdfs:comment xml:lang="en">Note that the altLabel &quot;MK&quot; was removed to avoid collision with the MK content code.</rdfs:comment>
        <rdfs:label xml:lang="es">marcabilidad</rdfs:label>
        <rdfs:label xml:lang="en">markedness</rdfs:label>
        <rdfs:label xml:lang="zh">标记度 </rdfs:label>
        <skos:altLabel xml:lang="en">delta P</skos:altLabel>
        <skos:altLabel xml:lang="en">delta-P</skos:altLabel>
        <skos:altLabel xml:lang="en">deltaP</skos:altLabel>
        <skos:altLabel xml:lang="en">Δp</skos:altLabel>
        <skos:definition xml:lang="en">Markedness is a metric that quantifies the reliability of predictions by combining positive predictive value and negative predictive value. It is defined as the sum of these two predictive values minus one, producing a score that ranges from –1 to +1. A value of +1 indicates perfectly trustworthy predictions, 0 corresponds to chance-level performance, and negative values indicate systematically misleading predictions; however, the measure is sensitive to class prevalence and can be unstable in imbalanced datasets.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03708 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03708">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.aci.2018.08.003"/>
        <rdfs:label xml:lang="en">balanced error rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de error equilibrada</rdfs:label>
        <rdfs:label xml:lang="zh">平衡错误率</rdfs:label>
        <skos:altLabel xml:lang="en">BER</skos:altLabel>
        <skos:altLabel xml:lang="en">HTER</skos:altLabel>
        <skos:altLabel xml:lang="en">half total error rate</skos:altLabel>
        <skos:definition xml:lang="en">Balanced error rate measures the average of the false positive rate and the false negative rate, giving equal weight to both types of errors. It is conceptually the counterpart of the balanced accuracy (balanced classification rate), emphasizing error rather than correct classification, and is particularly useful for imbalanced datasets where overall accuracy can be misleading. Lower values indicate better performance, with zero representing perfect classification and one representing the worst case.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03721 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03721">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00074"/>
        <rdfs:comment xml:lang="en">[ZH translation by Kahn]</rdfs:comment>
        <rdfs:label xml:lang="en">keyword</rdfs:label>
        <rdfs:label xml:lang="es">palabra clave</rdfs:label>
        <rdfs:label xml:lang="zh">关键词</rdfs:label>
        <skos:altLabel xml:lang="en">key word</skos:altLabel>
        <skos:definition xml:lang="en">An unstructured text word or phrase used to index an AI resource.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03723 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03723">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00170"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00180"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00181"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00254"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00322"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00325"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00369"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00413"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00455"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00456"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00461"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00502"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00503"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00565"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00591"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasURI"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">enlace</rdfs:label>
        <rdfs:label xml:lang="en">link</rdfs:label>
        <rdfs:label xml:lang="zh">网址</rdfs:label>
        <skos:altLabel xml:lang="en">repo link</skos:altLabel>
        <skos:altLabel xml:lang="en">repository link</skos:altLabel>
        <skos:altLabel xml:lang="en">repository site</skos:altLabel>
        <skos:altLabel xml:lang="en">web link</skos:altLabel>
        <skos:definition xml:lang="en">Uniform Resource Identifier (URI) of the site where the resource (model, dataset, or project) can be obtained.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03758 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03758">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="es">detección y diagnóstico</rdfs:label>
        <rdfs:label xml:lang="en">detection and diagnosis</rdfs:label>
        <rdfs:label xml:lang="zh">检测和诊断</rdfs:label>
        <skos:altLabel xml:lang="en">CADe/x</skos:altLabel>
        <skos:altLabel xml:lang="en">computer-assisted detection/diagnosis</skos:altLabel>
        <skos:altLabel xml:lang="en">diagnosis / detection</skos:altLabel>
        <skos:definition xml:lang="en">Use of an AI system to detect and/or diagnose one or more conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03759 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03759">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03642"/>
        <rdfs:label xml:lang="en">metric (grouped by criterion)</rdfs:label>
        <skos:definition xml:lang="en">Metrics groups by performance criteria: e.g., &quot;calibration metric.&quot;</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03760 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03760">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03642"/>
        <rdfs:label xml:lang="en">metric (grouped by form)</rdfs:label>
        <skos:definition xml:lang="en">Metrics groups by &quot;form&quot;: i.e., graph, matrix, scalar.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03761 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03761">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">FNR = FN / (FN + TP) = 1 - sensitivity</rdfs:comment>
        <rdfs:label xml:lang="en">false negative rate</rdfs:label>
        <skos:altLabel xml:lang="en">FNR</skos:altLabel>
        <skos:altLabel xml:lang="en">beta</skos:altLabel>
        <skos:altLabel xml:lang="en">type 2 error rate</skos:altLabel>
        <skos:altLabel xml:lang="en">type II error rate</skos:altLabel>
        <skos:altLabel xml:lang="en">β</skos:altLabel>
        <skos:definition xml:lang="en">The false negative rate measures how often actual positives are missed.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000220"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03762 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03762">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:comment xml:lang="en">For predictive modeling of non-continuous variables, the mean calibration is a measure of calibration that is the average of a function of the difference between the expected probabilities and the observed frequencies. The expected values may be computed (as in predictive models) or may be derived from reference data (as typical for a measurement device). 

When the function is the square of the difference and the variables are binary (0 or 1), the measure is called the Brier score.</rdfs:comment>
        <rdfs:label xml:lang="en">mean calibration</rdfs:label>
        <skos:definition xml:lang="en">A measure of calibration that is the average of a function of the difference between the expected values and the observed values.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000686"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03763 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03763">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03381"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00212"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00257"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00435"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">dataset role</rdfs:label>
        <skos:altLabel xml:lang="en">role</skos:altLabel>
        <skos:definition xml:lang="en">Describes the role of a dataset or partition.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03764 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03764">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03763"/>
        <rdfs:label xml:lang="es">entrenamiento</rdfs:label>
        <rdfs:label xml:lang="en">training</rdfs:label>
        <skos:definition xml:lang="en">The broad process of adjusting a model&apos;s parameters (weights) by exposing it to data and minimizing a loss function, typically via gradient descent. It covers every learning phase, including pretraining and fine-tuning.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03765 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03765">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03763"/>
        <rdfs:comment xml:lang="en">Deep learning systems often use the term &quot;validation,&quot; but in medical applications, it can be confused with clinical validation. Hence, &quot;optimization&quot; is preferred.</rdfs:comment>
        <rdfs:label xml:lang="es">optimización</rdfs:label>
        <rdfs:label xml:lang="en">optimization</rdfs:label>
        <rdfs:label xml:lang="zh">优化</rdfs:label>
        <skos:altLabel xml:lang="en">optimisation</skos:altLabel>
        <skos:altLabel xml:lang="en">tuning</skos:altLabel>
        <skos:altLabel xml:lang="en">validation</skos:altLabel>
        <skos:definition xml:lang="en">Optimization is the algorithmic process (e.g., SGD, Adam) of updating weights to reduce error, while validation uses a held-out dataset during development to tune hyperparameters, choose between model versions, and detect overfitting.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03766 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03766">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03763"/>
        <rdfs:label xml:lang="es">prueba</rdfs:label>
        <rdfs:label xml:lang="en">testing</rdfs:label>
        <rdfs:label xml:lang="zh">测试</rdfs:label>
        <skos:altLabel xml:lang="en">test</skos:altLabel>
        <skos:definition xml:lang="en">The process of assessing a model&apos;s performance. Testing can be &quot;internal&quot; (using a partition of the original dataset) or &quot;external&quot; (from another dataset or institution).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03767 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03767">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03766"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00523"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03768"/>
        <rdfs:comment xml:lang="en">Often, internal testing data are a partition of the original (internal) dataset used to train and optimize a model.</rdfs:comment>
        <rdfs:label xml:lang="en">internal testing</rdfs:label>
        <rdfs:label xml:lang="es">pruebas internas</rdfs:label>
        <rdfs:label xml:lang="zh">内部测试</rdfs:label>
        <skos:altLabel xml:lang="en">internal test</skos:altLabel>
        <skos:definition xml:lang="en">Evaluation of an AI model&apos;s performance using data from the same institution and setting as the training and/or optimization datasets.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03768 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03768">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03766"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00236"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00314"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00523"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00647"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The term &quot;external testing&quot; is preferred over &quot;external validation,&quot; as the term &quot;validation&quot; can be ambiguous.</rdfs:comment>
        <rdfs:label xml:lang="en">external testing</rdfs:label>
        <rdfs:label xml:lang="es">pruebas externas</rdfs:label>
        <rdfs:label xml:lang="zh">外部测试</rdfs:label>
        <skos:altLabel xml:lang="en">external test</skos:altLabel>
        <skos:altLabel xml:lang="en">external validation</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of an AI model&apos;s performance on data from another source, institution, or setting. Evaluation by parties outside the developer, such as independent auditors, third-party red-teamers, researchers, government safety institutes, or beta users. It provides an independent check and surfaces issues internal teams may miss.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03771 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03771">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00665"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03764"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">training partition</rdfs:label>
        <skos:definition xml:lang="en">A dataset partition on which an AI model is trained.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03772 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03772">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00665"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03765"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Deep learning systems often use the term &quot;validation,&quot; but in medical applications, it can be confused with clinical validation. Hence, &quot;optimization&quot; is preferred.</rdfs:comment>
        <rdfs:label xml:lang="en">optimization partition</rdfs:label>
        <skos:definition xml:lang="en">A dataset partition used to &quot;tune&quot; or optimize the performance of an AI model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03773 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03773">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00665"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03766"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">testing partition</rdfs:label>
        <skos:altLabel xml:lang="en">test partition</skos:altLabel>
        <skos:definition xml:lang="en">A dataset partition on which a model&apos;s performance is assessed. Can be &quot;internal&quot; (a partition of the original dataset) or &quot;external&quot; (from another dataset or institution).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03774 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03774">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03773"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03767"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">internal testing partition</rdfs:label>
        <skos:altLabel xml:lang="en">internal test partition</skos:altLabel>
        <skos:definition xml:lang="en">A dataset partition on which a model&apos;s performance is assessed that is a partition of the original dataset.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03775 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03775">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03773"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03768"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">external testing partition</rdfs:label>
        <skos:altLabel xml:lang="en">external test partition</skos:altLabel>
        <skos:definition xml:lang="en">A dataset partition on which a model&apos;s performance is assessed.that is from another dataset or institution.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03778 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03778">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03760"/>
        <rdfs:label xml:lang="en">non-scalar metric</rdfs:label>
        <skos:definition xml:lang="en">A graphical or matrix metric.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03788 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03788">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00658"/>
        <rdfs:comment xml:lang="en">Excludes evaluation entities (metrics, performance values) and governance entities (guidelines, ethical principles), which describe assessment and compliance rather than the resource itself.</rdfs:comment>
        <rdfs:label xml:lang="en">AI resource metadata</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-dcat-3/"/>
        <skos:definition xml:lang="en">Information that describes or characterises an AI resource (project, model, or dataset), including generic descriptors applicable to any resource and properties specific to models or datasets. AI resource metadata support the discovery, identification, and appropriate reuse of the resource it describes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03798 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03798">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00672"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/confidenceLevel"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.99</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">99% confidence interval</rdfs:label>
        <skos:altLabel xml:lang="en">99% CI</skos:altLabel>
        <skos:altLabel xml:lang="en">CI 99</skos:altLabel>
        <skos:altLabel xml:lang="en">CI-99</skos:altLabel>
        <skos:altLabel xml:lang="en">CI99</skos:altLabel>
        <skos:definition xml:lang="en">A confidence interval which covers 99% of the sampling distribution.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000127"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03800 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03800">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00015"/>
        <rdfs:label xml:lang="en">defined use</rdfs:label>
        <skos:definition xml:lang="en">A type of model use that has been defined; it is intended to be disjoint from &apos;other use&apos;.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03805 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03805">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00248"/>
        <rdfs:label xml:lang="en">specific ethical principle</rdfs:label>
        <skos:definition xml:lang="en">The FAIR and FUTURE-AI principles are specific. The ontology uses &apos;supports&apos; to relate a metadata entity or guideline item to a specific ethical principle that it helps satisfy, operationalize, or support.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03806 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03806">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00248"/>
        <rdfs:label xml:lang="en">general ethical principle</rdfs:label>
        <skos:definition xml:lang="en">The OECD and WHO principles are general and are meant to be taken as a whole.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03808 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03808">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00231"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00232"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00240"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00241"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00257"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00279"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00302"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00316"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00360"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00400"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00444"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00464"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00524"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00526"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00582"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00603"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00653"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/evaluatesPerformanceOn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/03832"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">For a scalar metric, the subclass links to that metric, its observed decimal value, and an optional confidence interval. For a non-scalar metric (a graph or matrix), the corresponding subclass links to a URI that points to an image, table, or other resource.</rdfs:comment>
        <rdfs:label xml:lang="en">model performance</rdfs:label>
        <skos:definition xml:lang="en">A tuple of entities that specifies the performance of an AI model on a particular set of data. The evaluation dataset identifies the specific data on which performance was measured, and is part of the tuple for scalar and/or non-scalar measurements.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03809 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03809">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00660"/>
        <rdfs:label xml:lang="en">ethical framework</rdfs:label>
        <skos:definition xml:lang="en">A set of overarching ethical principles, such as FUTURE-AI, to guide development, use, and evaluation of AI systems.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03830 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03830">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00254"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00374"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00452"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">authorship information</rdfs:label>
        <skos:altLabel xml:lang="en">authorship</skos:altLabel>
        <skos:definition xml:lang="en">Information that describes the author(s), contributor(s), and/or organization(s) that developed the AI resource.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03832 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03832">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00236"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00253"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00257"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00309"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Usually a pointer (e.g., URI) to a dataset or some other reference. A model may have more than one evaluation set used to report various metrics.</rdfs:comment>
        <rdfs:label xml:lang="en">evaluation dataset</rdfs:label>
        <skos:altLabel xml:lang="en">assessment dataset</skos:altLabel>
        <skos:altLabel xml:lang="en">eval set</skos:altLabel>
        <skos:definition xml:lang="en">The specific data on which the model&apos;s performance is assessed.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03837 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03837">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00029"/>
        <dcterms:source rdf:resource="https://arxiv.org/abs/1801.00868"/>
        <rdfs:label xml:lang="en">panoptic segmentation</rdfs:label>
        <skos:definition xml:lang="en">Panoptic segmentation combines both semantic and instance segmentation. Like semantic segmentation, panoptic segmentation is an approach that identifies, for every pixel, the belonging class. Moreover, like in instance segmentation, panoptic segmentation distinguishes different instances of the same class.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03850 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03850">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03449"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03470"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03449"/>
        <rdfs:comment xml:lang="en">MeSH descriptor: Octogenarians (D000087742), 80 to 89 years</rdfs:comment>
        <rdfs:label xml:lang="en">octogenarian</rdfs:label>
        <skos:definition xml:lang="en">An individual of age 80 to 89 years.</skos:definition>
        <skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/M0000567"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03851 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03851">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03449"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03470"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03449"/>
        <rdfs:comment xml:lang="en">MeSH descriptor: Nonagenarians (D000088642), 90 to 99 years</rdfs:comment>
        <rdfs:label xml:lang="en">nonagenarian</rdfs:label>
        <skos:definition xml:lang="en">An individual of age 90 to 99 years.</skos:definition>
        <skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/M000742081"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03852 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03852">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03449"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03470"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03449"/>
        <rdfs:comment xml:lang="en">MeSH descriptor: Centenarians (D000087662), 100 years and older</rdfs:comment>
        <rdfs:label xml:lang="en">centenarian</rdfs:label>
        <skos:definition xml:lang="en">An individual of age 100 years or more.</skos:definition>
        <skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/M0000565"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03867 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03867">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03449"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03470"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03449"/>
        <rdfs:label xml:lang="en">adult</rdfs:label>
        <rdfs:label xml:lang="es">adulto</rdfs:label>
        <rdfs:label xml:lang="zh">成人</rdfs:label>
        <skos:definition xml:lang="en">An individual of age 19 years or more; it aggregates the relevant MeSH categories.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03870 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03870">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasMetric"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/03302"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasConfidenceInterval"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/00672"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/scalarMetricObservedValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03871"/>
        <rdfs:label xml:lang="en">model performance by scalar metric</rdfs:label>
        <skos:definition xml:lang="en">A tuple of entities to describe the model&apos;s performance on a specific dataset. 

* evaluation dataset:  the specific data on which performance was measured (specified in &quot;model performance&quot; parent class)
* scalar metric: the measurement used, such as Dice similarity coefficient
* metric value: the observed scalar value
* (optional) confidence interval: a 3-tuple of lower &amp; upper confidence limits with the confidence level (e.g., 0.95)</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03871 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03871">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasMetric"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/03778"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/nonScalarMetricObservedValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">model performance by non-scalar metric</rdfs:label>
        <skos:definition xml:lang="en">A tuple of entities to describe the model&apos;s performance on a specific dataset. 

* evaluation dataset:  the specific data on which performance was measured (specified in &quot;model performance&quot; parent class)
* non-scalar metric: a graph or matrix
* metric value: a URI of an image, table, or other resource</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03872 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03872">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00001"/>
        <rdfs:label xml:lang="es">unidad</rdfs:label>
        <rdfs:label xml:lang="en">unit</rdfs:label>
        <rdfs:label xml:lang="zh">单位</rdfs:label>
        <skos:definition xml:lang="en">A unit of measurement.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03873 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03873">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03449"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03469"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">228</xsd:maxExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasAgeUnit"/>
                                        <owl:hasValue rdf:resource="https://rsna.org/roadmap/03470"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperAgeValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</xsd:maxExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03449"/>
        <rdfs:label xml:lang="en">child</rdfs:label>
        <skos:altLabel xml:lang="en">child 2 - 18 years</skos:altLabel>
        <skos:altLabel xml:lang="es">niño</skos:altLabel>
        <skos:altLabel xml:lang="zh">儿童</skos:altLabel>
        <skos:definition xml:lang="en">An individual of age 2 to 18 years. Aggregates MeSH terms preschool child, &quot;child&quot; (really school-age child), and adolescent. Note that this definition excludes neonates and infants.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03875 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03875">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03886"/>
        <rdfs:comment xml:lang="en">Identifier Format: K followed by 6 digits (e.g., K234567).</rdfs:comment>
        <rdfs:comment xml:lang="en">May have a boolean value (true/false) or the date on which FDA clearance was obtained.</rdfs:comment>
        <rdfs:label xml:lang="en">510(k)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://doi.org/10.3390/electronics13030498"/>
        <skos:altLabel xml:lang="en">510(k) Premarket Notification</skos:altLabel>
        <skos:altLabel xml:lang="en">510(k) clearance</skos:altLabel>
        <skos:altLabel xml:lang="en">FDA clearance</skos:altLabel>
        <skos:altLabel xml:lang="en">FDA cleared</skos:altLabel>
        <skos:altLabel xml:lang="en">FDA-cleared</skos:altLabel>
        <skos:altLabel xml:lang="en">US FDA clearance</skos:altLabel>
        <skos:altLabel xml:lang="en">US FDA cleared</skos:altLabel>
        <skos:altLabel xml:lang="es">autorización FDA</skos:altLabel>
        <skos:altLabel xml:lang="es">autorización de la FDA</skos:altLabel>
        <skos:definition xml:lang="en">Indicates whether a model has received U.S. Food and Drug Administration clearance. The most common pathway for medical AI, accounting for roughly 95% of clearances. It requires demonstrating &quot;substantial equivalence&quot; to an existing legal predicate.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03876 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03876">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03886"/>
        <rdfs:comment xml:lang="en">Identifier Format: DEN followed by 6 digits (e.g., DEN220034)</rdfs:comment>
        <rdfs:label xml:lang="en">de novo</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://pmc.ncbi.nlm.nih.gov/articles/PMC11410966/"/>
        <skos:altLabel xml:lang="en">de novo authorization</skos:altLabel>
        <skos:altLabel xml:lang="en">de novo clearance</skos:altLabel>
        <skos:altLabel xml:lang="en">de novo device approval</skos:altLabel>
        <skos:definition xml:lang="en">A US FDA pathway for novel, low-to-moderate-risk AI software that lacks an established market predicate. This authorization establishes new &quot;Special Controls&quot; and product codes for future 510(k) entries.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03877 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03877">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03886"/>
        <rdfs:comment xml:lang="en">Identifier Format: P followed by 6 digits (e.g., P210012).</rdfs:comment>
        <rdfs:label xml:lang="en">PMA</rdfs:label>
        <skos:altLabel xml:lang="en">Premarket Approval</skos:altLabel>
        <skos:definition xml:lang="en">US FDA Premarket Approval (PMA) is reserved for the highest-risk, life-sustaining, or autonomous diagnostic AI systems. It requires independent, rigorous clinical trial evidence.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03880 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03880">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03886"/>
        <dcterms:source rdf:resource="https://doi.org/10.1258/jrsm.2012.120036"/>
        <rdfs:comment xml:lang="en">May have a boolean value (true/false) or the date on which CE mark was applied.</rdfs:comment>
        <rdfs:label xml:lang="en">CE mark</rdfs:label>
        <skos:altLabel xml:lang="en">CE</skos:altLabel>
        <skos:altLabel xml:lang="en">CE marked</skos:altLabel>
        <skos:altLabel xml:lang="en">CE marking</skos:altLabel>
        <skos:altLabel xml:lang="es">Conformidad Europea</skos:altLabel>
        <skos:altLabel xml:lang="fr">Conformité Européenne</skos:altLabel>
        <skos:altLabel xml:lang="es">marcado CE</skos:altLabel>
        <skos:altLabel xml:lang="zh">歐洲合格認證</skos:altLabel>
        <skos:definition xml:lang="en">The CE mark (&quot;Conformité Européenne&quot;) is a mandatory, self-declared compliance marking that indicates that a product meets essential EU health, safety, and environmental regulations, allowing it to be sold throughout the European Economic Area (EEA).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03883 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03883">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03886"/>
        <rdfs:label xml:lang="en">UKCA mark</rdfs:label>
        <skos:altLabel xml:lang="en">UK Conformity Assessed Mark</skos:altLabel>
        <skos:altLabel xml:lang="en">UKCA</skos:altLabel>
        <skos:altLabel xml:lang="en">UKCA marked</skos:altLabel>
        <skos:altLabel xml:lang="en">UKCA marking</skos:altLabel>
        <skos:definition xml:lang="en">A mark that indicates conformity with United Kingdom&apos;s medical device regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03884 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03884">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03886"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41746-024-01254-x"/>
        <rdfs:label xml:lang="en">NMPA</rdfs:label>
        <skos:altLabel xml:lang="en">China / NMPA authorization</skos:altLabel>
        <skos:altLabel xml:lang="en">China / National Medical Products Administration authorization</skos:altLabel>
        <skos:altLabel xml:lang="en">NMPA authorization</skos:altLabel>
        <skos:definition xml:lang="en">China&apos;s authority for medical device regulation.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03886 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03886">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:comment xml:lang="en">Examples: 510(k), De Novo, PMA, PMA supplement, HDE, Breakthrough Device designation, CE / MDR, CE / IVDR, CE / MDD (legacy), UKCA, International Reliance, Medical Device Licence, MDEL, ARTG inclusion, Shonin, Ninsho, Sakigake designation, NMPA registration, MFDS approval, ANVISA registration, CDSCO licence, AMAR registration, HSA registration, Other, Not applicable</rdfs:comment>
        <rdfs:comment xml:lang="en">Note that the subclasses specified here are not an exhaustive list.</rdfs:comment>
        <rdfs:label xml:lang="en">regulatory pathway</rdfs:label>
        <skos:definition xml:lang="en">A pathway under which a jurisdiction grants regulatory approval of a medical device.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03889 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03889">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasDateValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">regulatory date</rdfs:label>
        <skos:definition xml:lang="en">The date on which the regulatory body granted the authorization or upon which it became effective.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03890 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03890">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <dcterms:source rdf:resource="https://www.iso.org/iso-3166-country-codes.html"/>
        <rdfs:label xml:lang="en">jurisdiction</rdfs:label>
        <skos:altLabel xml:lang="en">regulatory jurisdiction</skos:altLabel>
        <skos:definition xml:lang="en">A national or multinational government that regulates AI systems. Uses the 2-character ISO 3166-1 alpha-2 country code, except EU (European Union, an economic area) and UK-NI (Northern Ireland, which follows EU MDR under the Windsor Framework).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03902 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03902">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:comment xml:lang="en">Examples include: &quot;FDA&quot;, &quot;Notified Body&quot;, &quot;MHRA&quot;, &quot;Approved Body&quot;, &quot;Swissmedic&quot;, &quot;Health Canada&quot;, &quot;TGA&quot;, &quot;Medsafe&quot;, &quot;PMDA&quot;, &quot;MHLW&quot;, &quot;NMPA&quot;, &quot;MFDS&quot;, &quot;CDSCO&quot;, &quot;ANVISA&quot;, &quot;AMAR&quot;, &quot;HSA&quot;, &quot;SFDA&quot;, &quot;SAHPRA&quot;, &quot;Other&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">authority</rdfs:label>
        <skos:altLabel xml:lang="en">regulatory authority</skos:altLabel>
        <skos:definition xml:lang="en">The government agency or designated organization that evaluates the AI system. In the US, the authority is the Food and Drug Administration (FDA). In the EU, a Notified Body grants the CE Mark.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03903 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03903">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:label xml:lang="en">authority identifier</rdfs:label>
        <skos:definition xml:lang="en">Four-digit Notified Body or Approved Body number where applicable, e.g. &apos;0123&apos;.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03904 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03904">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasURI"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">registry link</rdfs:label>
        <skos:altLabel xml:lang="en">registry URL</skos:altLabel>
        <skos:definition xml:lang="en">Deep link to the public registry entry, where one exists.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03905 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03905">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:label xml:lang="en">risk class</rdfs:label>
        <skos:definition xml:lang="en">Jurisdiction-specific risk category; not comparable across jurisdictions. US: I, II, III. EU MDR: I, IIa, IIb, III. Canada: I-IV. China/Korea: I, II, III. Interpret only together with Jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03906 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03906">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03889"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasDateValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">submission date</rdfs:label>
        <skos:definition xml:lang="en">Date on which the regulatory application was submitted.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03907 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03907">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03889"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasDateValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">decision date</rdfs:label>
        <skos:definition xml:lang="en">Effective date of regulatory decision.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03908 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03908">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03889"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasDateValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">expiration date</rdfs:label>
        <skos:altLabel xml:lang="en">expiry date</skos:altLabel>
        <skos:definition xml:lang="en">Date on which the regulatory approval expires.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03909 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03909">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:label xml:lang="en">change control</rdfs:label>
        <rdfs:label xml:lang="en">change control plan</rdfs:label>
        <skos:altLabel xml:lang="en">PCCP</skos:altLabel>
        <skos:altLabel xml:lang="en">predetermined change control plan</skos:altLabel>
        <skos:definition xml:lang="en">Predetermined change control. Cross-jurisdiction: FDA PCCP, MHRA PCCP, EU AI Act Annex IV point 2(f).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04003 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04003">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03624"/>
        <rdfs:comment xml:lang="en">&quot;Designed to be used by humans as well as machines, DOIs identify objects persistently. They allow things to be uniquely identified and accessed reliably. You know what you have, where it is, and others can track it too.&quot;</rdfs:comment>
        <rdfs:comment xml:lang="en">For example, a valid DOI is &quot;10.1148/ryai.240200&quot;. The corresponding URL is obtained by prepending &quot;https://doi.org/&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">digital object identifier</rdfs:label>
        <rdfs:label xml:lang="es">identificador de objeto digital</rdfs:label>
        <rdfs:label xml:lang="zh">数字对象标识符</rdfs:label>
        <skos:altLabel xml:lang="en">DOI</skos:altLabel>
        <skos:definition xml:lang="en">A digital identifier of a physical, digital, or abstract object, used here to refer to a publication such as a journal article.</skos:definition>
        <skos:exactMatch rdf:resource="http://vocab.fairdatacollective.org/gdmt/DOI"/>
        <pattern rdf:resource="https://doi.org/$"/>
        <regex>[0-9]+\.[0-9]+(\.[0-9]+)?\/.*</regex>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04004 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04004">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03624"/>
        <rdfs:label xml:lang="en">PubMed identifier</rdfs:label>
        <rdfs:label xml:lang="zh">PubMed标识符</rdfs:label>
        <rdfs:label xml:lang="es">identificador de PubMed</rdfs:label>
        <skos:altLabel xml:lang="en">PMID</skos:altLabel>
        <skos:altLabel xml:lang="en">PubMed ID</skos:altLabel>
        <skos:definition xml:lang="en">The unique identifier of an article available through PubMed. For example, the identifier &quot;38809149&quot; specifies the URL https://pubmed.ncbi.nlm.nih.gov/38809149/.</skos:definition>
        <pattern rdf:resource="https://pubmed.ncbi.nlm.nih.gov/$"/>
        <regex>[0-9]+</regex>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04005 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04005">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03391"/>
        <rdfs:label xml:lang="en">surgical video</rdfs:label>
        <rdfs:label xml:lang="es">vídeo quirúrgico</rdfs:label>
        <rdfs:label xml:lang="zh">手术视频</rdfs:label>
        <skos:altLabel xml:lang="en">operative video</skos:altLabel>
        <skos:altLabel xml:lang="en">procedural video</skos:altLabel>
        <skos:altLabel xml:lang="en">surgery video</skos:altLabel>
        <skos:definition xml:lang="en">Video images of surgical procedure.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04006 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04006">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03634"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1073445.1073465"/>
        <rdfs:label xml:lang="en">ROUGE-N</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE-N</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE-N</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation - N-gram Co-Occurrence Statistics</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE-N calculates the recall of n-gram overlaps between a candidate summary and a set of reference summaries. It is computed as the ratio of the total number of matching n-grams to the total number of n-grams in the reference summaries, favoring summaries that align with the consensus among references. Higher-order n-grams capture more word order information, while unigrams focus on content coverage.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04007 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04007">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04006"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1073445.1073465"/>
        <rdfs:label xml:lang="en">ROUGE-1</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE-1</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE-1</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation – Unigram Co-Occurrence Statistics</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE-1 evaluates the similarity between a generated text and a reference text based on the overlap of unigrams. It calculates recall, precision, and F-measure using individual word matches to quantify content coverage.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04008 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04008">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04006"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1073445.1073465"/>
        <rdfs:label xml:lang="en">ROUGE-2</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE-2</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE-2</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation – Bigram Co-Occurrence Statistics</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE-2 evaluates the similarity between a generated text and a reference text based on the overlap of bigrams. It measures matching two-word sequences to capture both content and limited word order information, reporting recall, precision, and F-measure.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04009 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04009">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03634"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1218955.1219032"/>
        <rdfs:label xml:lang="en">ROUGE-L</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE-L</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE-L</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation - Longest Common Subsequence</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE-L measures similarity based on the Longest Common Subsequence (LCS) between candidate and reference texts. It accounts for word order without requiring consecutive matches, capturing sentence-level structure naturally. Scores are computed using LCS-based recall and precision combined into an F-measure, making ROUGE-L robust to variations in word placement while rewarding in-sequence matches.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04010 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04010">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04009"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1218955.1219032"/>
        <rdfs:label xml:lang="en">ROUGE-W</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE-W</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE-W</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation - Weighted Longest Common Subsequence</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE-W is an extension of ROUGE-L that applies Weighted Longest Common Subsequence to emphasize consecutive matches. By assigning higher scores to longer uninterrupted sequences, ROUGE-W distinguishes summaries with contiguous phrases from those with fragmented word order, improving sensitivity to fluent expression while maintaining structural evaluation.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04011 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04011">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03634"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1218955.1219032"/>
        <rdfs:label xml:lang="en">ROUGE-S</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE-S</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE-S</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation - Skip-Bigram Co-Occurrence Statistic</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE-S evaluates similarity using skip-bigrams, which are pairs of words in correct order but not necessarily adjacent, allowing for flexible gaps. This approach captures both lexical content and approximate word order, offering more nuanced matching than fixed n-gram methods. Scores are based on the overlap of skip-bigrams and can be adjusted with constraints on maximum skip distance to reduce spurious matches.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04012 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04012">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04011"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1218955.1219032"/>
        <rdfs:label xml:lang="en">ROUGE-SU</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE-SU</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE-SU</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation - Skip‑Bigram plus Unigram</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE-SU extends ROUGE-S by incorporating unigram matches in addition to skip-bigrams. This ensures that even when skip-bigram matches are absent, partial credit is awarded for individual word matches, making it suitable for very short or structurally varied summaries.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04013 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04013">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03624"/>
        <rdfs:label xml:lang="en">PubMed Central identifier</rdfs:label>
        <rdfs:label xml:lang="zh">PubMed Central标识符</rdfs:label>
        <rdfs:label xml:lang="es">identificador de PubMed Central</rdfs:label>
        <skos:altLabel xml:lang="en">PMC ID</skos:altLabel>
        <skos:altLabel xml:lang="en">PMCID</skos:altLabel>
        <skos:altLabel xml:lang="en">PubMed Central ID</skos:altLabel>
        <skos:definition xml:lang="en">The identifier of an article submitted and available through PubMed Central. For example, the identifier &quot;PMC11304031&quot; is part of the URL https://pmc.ncbi.nlm.nih.gov/articles/PMC11304031.</skos:definition>
        <pattern rdf:resource="https://pmc.ncbi.nlm.nih.gov/articles/$"/>
        <regex>PMC[0-9]+</regex>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04014 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04014">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03624"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasURI"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">localizador uniforme de recursos</rdfs:label>
        <rdfs:label xml:lang="en">uniform resource locator</rdfs:label>
        <rdfs:label xml:lang="zh">统一资源定位符</rdfs:label>
        <skos:altLabel xml:lang="en">URL</skos:altLabel>
        <skos:definition xml:lang="en">The unique, web-addressable location on the internet of a published results document, such as a journal article.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04016 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04016">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01051"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://apps.dtic.mil/sti/html/tr/AD0667273/"/>
        <dcterms:source rdf:resource="https://readable.com/readability/automated-readability-index/"/>
        <rdfs:label xml:lang="en">automated readability index</rdfs:label>
        <rdfs:label xml:lang="es">índice de lecturabilidad automatizado</rdfs:label>
        <rdfs:label xml:lang="zh">自动可读性指数</rdfs:label>
        <skos:altLabel xml:lang="en">ARI</skos:altLabel>
        <skos:definition xml:lang="en">The automated readability index is a readability metric designed to estimate the U.S. grade level required to understand a text. It calculates readability using two variables: the average number of characters per word and the average number of words per sentence, with longer words and sentences indicating greater complexity. It produces a numerical score corresponding to an educational grade level, providing a quick, automated measure of text comprehensibility without relying on syllable counts.

                                         ARI = 4.71 (characters / words) + 0.5 (words / sentences) - 21.43</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04017 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04017">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://aclanthology.org/W05-0909.pdf"/>
        <rdfs:label xml:lang="en">METEOR</rdfs:label>
        <rdfs:label xml:lang="es">METEOR</rdfs:label>
        <rdfs:label xml:lang="zh">显式排序机器翻译评价指标</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/METEOR"/>
        <skos:altLabel xml:lang="zh">METEOR 指标</skos:altLabel>
        <skos:altLabel xml:lang="en">Metric for Evaluation of Translation with Explicit ORdering</skos:altLabel>
        <skos:altLabel xml:lang="en">metric for evaluation of translation with explicit ordering score</skos:altLabel>
        <skos:definition xml:lang="en">METEOR is an automatic evaluation metric for machine translation that scores a candidate translation against one or more reference translations based on unigram matches. It combines precision and recall in a recall-weighted harmonic mean, applies a penalty for fragmented word order, and supports multiple matching strategies including exact matches, stemming, and synonymy. The metric is designed to improve correlation with human judgments by directly incorporating recall, accounting for linguistic variation, and providing meaningful scores at both sentence and corpus levels.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04018 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04018">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1121/1.2016299"/>
        <rdfs:label xml:lang="es">perplejidad</rdfs:label>
        <rdfs:label xml:lang="en">perplexity</rdfs:label>
        <rdfs:label xml:lang="zh">困惑度</rdfs:label>
        <skos:definition xml:lang="en">Perplexity quantifies the level of uncertainty or effective choice in predicting sequences, such as words or phonemes in speech or text. It is defined as the exponential of entropy, meaning it represents the average number of equally likely alternatives the model faces at each prediction step. Lower perplexity values indicate that a model assigns higher probability to the observed data, reflecting stronger predictive performance, while higher values signal greater uncertainty and weaker alignment with the actual sequence.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04019 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04019">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03307"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12859-015-0564-6"/>
        <rdfs:label xml:lang="es">precisión estricta</rdfs:label>
        <rdfs:label xml:lang="en">strict accuracy</rdfs:label>
        <rdfs:label xml:lang="zh">严格准确性</rdfs:label>
        <skos:altLabel xml:lang="en">SACC</skos:altLabel>
        <skos:definition xml:lang="en">Strict accuracy is an evaluation metric that measures the proportion of questions or instances answered exactly correctly according to a reference standard. In question answering, it requires that the system’s top response matches the expected answer precisely, without credit for synonyms, partial matches, or alternate valid forms. It is most often applied to binary or factoid-style tasks, where correctness is defined in absolute terms.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04020 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04020">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03526"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-642-41230-1_36"/>
        <rdfs:label xml:lang="es">precisión entre los 5 mejores</rdfs:label>
        <rdfs:label xml:lang="en">top-5 accuracy</rdfs:label>
        <rdfs:label xml:lang="zh">前 5 名准确率</rdfs:label>
        <skos:definition xml:lang="en">Top-5 accuracy measures the proportion of instances where the true class label appears within the top 5 predicted class labels, regardless of their order.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04021 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04021">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01050"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12859-015-0564-6"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2203.07544"/>
        <rdfs:label xml:lang="en">mean reciprocal rank</rdfs:label>
        <rdfs:label xml:lang="es">rango recíproco medio</rdfs:label>
        <rdfs:label xml:lang="zh">平均倒数排名</rdfs:label>
        <skos:altLabel xml:lang="en">MRR</skos:altLabel>
        <skos:definition xml:lang="en">Mean reciprocal rank is a metric used to evaluate the effectiveness of systems that return ranked lists of results. For each query, it considers the position of the first relevant item in the ranked list and computes its reciprocal rank, assigning higher scores when the correct result appears earlier. The final score is the mean of these reciprocal ranks across all queries, making the measure particularly suited for tasks where identifying the earliest relevant answer is most important. It emphasizes early precision but accounts only for the first relevant item rather than all relevant results.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04022 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04022">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01041"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03339"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s10489-021-02635-5"/>
        <rdfs:label xml:lang="es">micro-exhaustividad</rdfs:label>
        <rdfs:label xml:lang="en">micro-recall</rdfs:label>
        <rdfs:label xml:lang="zh">微平均召回率</rdfs:label>
        <skos:altLabel xml:lang="en">global recall</skos:altLabel>
        <skos:altLabel xml:lang="en">miR</skos:altLabel>
        <skos:altLabel xml:lang="en">micro average recall</skos:altLabel>
        <skos:altLabel xml:lang="en">micro recall</skos:altLabel>
        <skos:altLabel xml:lang="en">micro-average recall</skos:altLabel>
        <skos:altLabel xml:lang="en">sample-averaged recall</skos:altLabel>
        <skos:definition xml:lang="en">Micro-recall is the recall value computed by aggregating the true positives and false negatives across all classes before calculating the proportion. It represents the fraction of correctly identified positive instances out of all actual positives in the dataset. Because it gives equal weight to each individual instance, micro-recall reflects overall system performance but can be influenced by majority classes in imbalanced data.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04023 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04023">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01040"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03339"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s10489-021-02635-5"/>
        <rdfs:label xml:lang="es">macro-exhaustividad</rdfs:label>
        <rdfs:label xml:lang="en">macro-recall</rdfs:label>
        <rdfs:label xml:lang="zh">宏观召回率</rdfs:label>
        <skos:altLabel xml:lang="en">balanced recall</skos:altLabel>
        <skos:altLabel xml:lang="en">maR</skos:altLabel>
        <skos:altLabel xml:lang="en">macro averaged recall</skos:altLabel>
        <skos:altLabel xml:lang="en">macro recall</skos:altLabel>
        <skos:altLabel xml:lang="en">macro-averaged recall</skos:altLabel>
        <skos:altLabel xml:lang="en">unweighted average recall</skos:altLabel>
        <skos:definition xml:lang="en">Macro-recall is the unweighted average of recall values calculated separately for each class in a multiclass classification problem. Each class contributes equally to the final score, regardless of how many instances it contains. This metric provides a balanced view of performance across all classes, making it especially useful when evaluating classifiers on imbalanced datasets.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04024 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04024">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01041"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03324"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s10489-021-02635-5"/>
        <rdfs:label xml:lang="en">micro-precision</rdfs:label>
        <rdfs:label xml:lang="es">micro-precisión</rdfs:label>
        <rdfs:label xml:lang="zh">微平均精确率</rdfs:label>
        <skos:altLabel xml:lang="en">miP</skos:altLabel>
        <skos:altLabel xml:lang="en">micro precision</skos:altLabel>
        <skos:altLabel xml:lang="en">micro-averaged precision</skos:altLabel>
        <skos:definition xml:lang="en">Micro-precision is a measure of predictive accuracy in multi-class classification that aggregates the counts of true positives and false positives across all classes before calculating precision. It gives equal weight to every individual instance, making the score dominated by performance on majority classes in imbalanced datasets.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04025 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04025">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01040"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03324"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s10489-021-02635-5"/>
        <rdfs:label xml:lang="en">macro-precision</rdfs:label>
        <rdfs:label xml:lang="es">macro-precisión</rdfs:label>
        <rdfs:label xml:lang="zh">宏观精确率</rdfs:label>
        <skos:altLabel xml:lang="en">maP</skos:altLabel>
        <skos:altLabel xml:lang="en">macro precision</skos:altLabel>
        <skos:altLabel xml:lang="en">macro-averaged precision</skos:altLabel>
        <skos:definition xml:lang="en">Macro-precision is the unweighted average of the precision scores computed separately for each class in a multi-class setting. By treating all classes equally regardless of size, it emphasizes performance across minority classes and provides a balanced view of predictive accuracy in the presence of class imbalance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04026 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04026">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01040"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s10489-021-02635-5"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.1911.03347"/>
        <rdfs:label xml:lang="en">macro-F1</rdfs:label>
        <rdfs:label xml:lang="es">macro-F1</rdfs:label>
        <rdfs:label xml:lang="zh">宏观 F1</rdfs:label>
        <skos:altLabel xml:lang="en">macro F1</skos:altLabel>
        <skos:altLabel xml:lang="en">macro F1 score</skos:altLabel>
        <skos:altLabel xml:lang="en">macro-F1 score</skos:altLabel>
        <skos:definition xml:lang="en">The macro-F1 score is the unweighted mean of the F1 scores computed separately for each class in a classification task, giving all classes equal influence regardless of their frequency. It can be reported in two distinct ways: (1) as the arithmetic mean of the per-class F1 scores, or (2) as the harmonic mean of the average per-class precision and average per-class recall (“F1 of averages”), with the latter generally producing higher values when class-specific precision and recall differ. Macro-F1 is particularly useful for evaluating performance on imbalanced datasets, as it emphasizes minority-class performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04027 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04027">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01041"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s10489-021-02635-5"/>
        <rdfs:label xml:lang="en">micro-F1</rdfs:label>
        <rdfs:label xml:lang="es">micro-F1</rdfs:label>
        <rdfs:label xml:lang="zh">微平均F1分数</rdfs:label>
        <skos:altLabel xml:lang="en">micro F1</skos:altLabel>
        <skos:altLabel xml:lang="en">micro F1 score</skos:altLabel>
        <skos:altLabel xml:lang="en">micro-F1 score</skos:altLabel>
        <skos:definition xml:lang="en">The micro-F1 score is calculated by aggregating the total true positives, false positives, and false negatives across all classes before computing a single F1 score from these global counts. This approach weights each sample equally, meaning that in multi-class classification it is numerically equivalent to overall accuracy. Micro-F1 favors performance on classes with more samples and is best suited for scenarios where each instance is considered equally important regardless of its class.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04028 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04028">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04006"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1073445.1073465"/>
        <rdfs:label xml:lang="en">ROUGE-3</rdfs:label>
        <rdfs:label xml:lang="es">ROUGE-3</rdfs:label>
        <rdfs:label xml:lang="zh">ROUGE-3</rdfs:label>
        <skos:altLabel xml:lang="en">Recall-Oriented Understudy for Gisting Evaluation – Trigram Co-Occurrence Statistics</skos:altLabel>
        <skos:definition xml:lang="en">ROUGE-3 evaluates the similarity between a generated text and a reference text based on the overlap of trigrams. It uses matching three-word sequences to assess content alignment while incorporating a greater degree of word order sensitivity than lower-order n-grams.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04032 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04032">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.1506.05439"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.1701.07875"/>
        <rdfs:label xml:lang="en">Wasserstein loss</rdfs:label>
        <rdfs:label xml:lang="zh">Wasserstein 损失</rdfs:label>
        <rdfs:label xml:lang="es">pérdida de Wasserstein</rdfs:label>
        <skos:definition xml:lang="en">Wasserstein loss is a distributional loss function derived from the theory of optimal transport, which measures the minimal “cost” of transforming one probability distribution into another given a ground distance between their elements. Unlike standard divergences such as cross-entropy, it incorporates semantic relationships between labels, penalizing errors proportionally to their distance in the label space. Through entropic regularization and efficient approximations, it can be optimized in large-scale learning tasks, making it useful for applications such as structured prediction, segmentation, and generative modeling where preserving semantic similarity is important.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04033 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04033">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1023/A:1026543900054"/>
        <rdfs:label xml:lang="es">distancia de movimiento de tierra</rdfs:label>
        <rdfs:label xml:lang="en">earth mover&apos;s distance</rdfs:label>
        <rdfs:label xml:lang="zh">推土机距离</rdfs:label>
        <skos:altLabel xml:lang="en">EMD</skos:altLabel>
        <skos:altLabel xml:lang="en">earth mover distance</skos:altLabel>
        <skos:altLabel xml:lang="en">earth-mover distance</skos:altLabel>
        <skos:altLabel xml:lang="en">earth-mover&apos;s distance</skos:altLabel>
        <skos:definition xml:lang="en">The earth mover’s distance is a measure of dissimilarity between two distributions that represents the minimum effort required to transform one distribution into the other. It is defined as the optimal total “cost” of moving distribution mass, where cost is determined by the amount of mass moved multiplied by the distance it is transported. Formally expressed as a transportation problem in linear programming, it yields a normalized value that captures how far apart two distributions are in terms of both magnitude and spatial arrangement.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04034 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04034">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1145/375360.375365"/>
        <rdfs:label xml:lang="es">distancia de edición</rdfs:label>
        <rdfs:label xml:lang="en">edit distance</rdfs:label>
        <rdfs:label xml:lang="zh">编辑距离</rdfs:label>
        <skos:definition xml:lang="en">The edit distance is a general measure of dissimilarity between two strings, defined as the minimum number of character-level operations required to transform one string into the other. Depending on the variant, the allowed operations include insertion, deletion, substitution, and sometimes adjacent transposition. Distances are symmetric and bounded according to the chosen operation set.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04035 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04035">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04034"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/375360.375365"/>
        <rdfs:label xml:lang="en">Levenshtein distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia de Levenshtein</rdfs:label>
        <rdfs:label xml:lang="zh">莱文斯坦距离</rdfs:label>
        <skos:definition xml:lang="en">The Levenshtein distance is a classical edit distance that allows insertion, deletion, and substitution operations, each with unit cost. It is defined as the minimum number of such edits required to transform one string into another and is symmetric with values ranging from zero up to the length of the longer string.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04036 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04036">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01043"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/IRI62200.2024.00065"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.1703.06856"/>
        <rdfs:label xml:lang="en">counterfactual fairness</rdfs:label>
        <rdfs:label xml:lang="es">equidad contrafactual</rdfs:label>
        <rdfs:label xml:lang="zh">反事实公平性</rdfs:label>
        <skos:definition xml:lang="en">Counterfactual fairness is a causal definition of fairness that requires a predictive model to give the same output for an individual in both the actual world and in a counterfactual world where the individual’s protected attribute (such as race or gender) had been different. Formally, a predictor is counterfactually fair if its distribution of outputs remains unchanged when only the sensitive attribute is altered while all other characteristics are held constant. This criterion ensures that model predictions are not causally influenced by protected attributes, providing an individual-level measure of fairness grounded in causal inference.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04037 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04037">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">See also: negative log likelihood.</rdfs:comment>
        <rdfs:label xml:lang="en">cross-entropy</rdfs:label>
        <rdfs:label xml:lang="es">entropía cruzada</rdfs:label>
        <rdfs:label xml:lang="zh">交叉熵</rdfs:label>
        <skos:altLabel xml:lang="en">cross entropy</skos:altLabel>
        <skos:definition xml:lang="en">Cross-entropy is a generalization of log loss to multi-class classification problems; it quantifies the difference between two probability distributions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04038 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04038">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04034"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/375360.375365"/>
        <rdfs:label xml:lang="en">longest common subsequence</rdfs:label>
        <rdfs:label xml:lang="es">subsecuencia común más larga</rdfs:label>
        <rdfs:label xml:lang="zh">最长公共子序列</rdfs:label>
        <skos:altLabel xml:lang="en">LCS</skos:altLabel>
        <skos:definition xml:lang="en">The longest common subsequence distance measures dissimilarity by counting the number of insertions and deletions required to transform one string into another. It is based on the longest sequence of characters appearing in the same order in both strings and ranges from zero to the sum of the string lengths.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04039 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04039">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04034"/>
        <dcterms:source rdf:resource="https://doi.org/10.1002/j.1538-7305.1950.tb00463.x"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/375360.375365"/>
        <rdfs:label xml:lang="en">Hamming distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia Hamming</rdfs:label>
        <rdfs:label xml:lang="zh">汉明距离</rdfs:label>
        <skos:definition xml:lang="en">The Hamming distance is defined for two strings of equal length and counts the number of positions at which the corresponding characters differ. It is a metric commonly used in coding theory to measure error detection and correction capability, with values ranging from zero to the string length.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04040 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04040">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04034"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/363958.363994"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/375360.375365"/>
        <rdfs:label xml:lang="en">Damerau-Levenshtein distance</rdfs:label>
        <rdfs:label xml:lang="zh">Damerau–Levenshtein 距离</rdfs:label>
        <rdfs:label xml:lang="es">distancia Damerau–Levenshtein</rdfs:label>
        <skos:altLabel xml:lang="en">Damerau–Levenshtein distance</skos:altLabel>
        <skos:altLabel xml:lang="es">distancia de Damerau-Levenshtein</skos:altLabel>
        <skos:definition xml:lang="en">The Damerau–Levenshtein distance extends the standard edit distance by including adjacent transposition as a primitive operation, in addition to insertion, deletion, and substitution. It reflects the minimum number of these edits needed to transform one string into another, making it particularly suitable for modeling common human typing errors.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04041 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04041">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1080/01621459.1989.10478785"/>
        <rdfs:label xml:lang="en">Jaro distance</rdfs:label>
        <rdfs:label xml:lang="zh">Jaro距离</rdfs:label>
        <rdfs:label xml:lang="es">distancia Jaro</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Jaro%E2%80%93Winkler_distance"/>
        <skos:definition xml:lang="en">Jaro distance = 1 - Jaro similarity</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04042 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04042">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03572"/>
        <dcterms:source rdf:resource="https://doi.org/10.1001/jama.1982.03320430047030"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0962280216680245"/>
        <rdfs:label xml:lang="zh">Harrell C 指数</rdfs:label>
        <rdfs:label xml:lang="en">Harrell&apos;s C-index</rdfs:label>
        <rdfs:label xml:lang="es">índice C de Harrell</rdfs:label>
        <skos:altLabel xml:lang="en">Harrell C index</skos:altLabel>
        <skos:altLabel xml:lang="en">Harrell C-index</skos:altLabel>
        <skos:altLabel xml:lang="en">Harrell’s C index</skos:altLabel>
        <skos:definition xml:lang="en">Harrell’s C-index extends the C-index to censored survival data by evaluating only comparable subject pairs—those in which the shorter observed time corresponds to an actual event. It is calculated as the proportion of such usable pairs where the subject with the earlier event had been assigned a higher predicted risk. Because it excludes incomparable pairs, the statistic depends on the censoring distribution and may not consistently estimate the underlying concordance probability.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04043 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04043">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00659"/>
        <rdfs:label xml:lang="es">criterio de rendimiento</rdfs:label>
        <rdfs:label xml:lang="en">performance criterion</rdfs:label>
        <rdfs:label xml:lang="zh">性能标准</rdfs:label>
        <skos:altLabel xml:lang="en">assessment criterion</skos:altLabel>
        <skos:altLabel xml:lang="en">evaluation criterion</skos:altLabel>
        <skos:altLabel xml:lang="en">metric type</skos:altLabel>
        <skos:altLabel xml:lang="en">objective function</skos:altLabel>
        <skos:definition xml:lang="en">The characteristic, such as classification or image segmentation, on which an AI model&apos;s performance is evaluated.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04045 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04045">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03572"/>
        <dcterms:source rdf:resource="https://doi.org/10.1002/sim.4154"/>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2021.0223"/>
        <rdfs:label xml:lang="zh">Uno C 指数</rdfs:label>
        <rdfs:label xml:lang="en">Uno&apos;s C-index</rdfs:label>
        <rdfs:label xml:lang="es">índice C de Uno</rdfs:label>
        <skos:altLabel xml:lang="en">Uno C index</skos:altLabel>
        <skos:altLabel xml:lang="en">Uno C-index</skos:altLabel>
        <skos:altLabel xml:lang="en">Uno&apos;s C index</skos:altLabel>
        <skos:definition xml:lang="en">Uno’s C-index is a censoring-adjusted version designed to provide a consistent estimate of the concordance probability up to a prespecified time horizon. It uses inverse probability of censoring weighting to include all pairs and correct for censoring, rather than discarding information. This formulation yields a robust, nonparametric measure of survival model discrimination that remains valid under a variety of censoring schemes and model specifications.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04046 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04046">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03572"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0962280216680245"/>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2021.0223"/>
        <rdfs:label xml:lang="en">Efron&apos;s C-index</rdfs:label>
        <rdfs:label xml:lang="es">índice C de Efron</rdfs:label>
        <rdfs:label xml:lang="zh">埃弗龙 C 指数</rdfs:label>
        <skos:altLabel xml:lang="en">Efron C index</skos:altLabel>
        <skos:altLabel xml:lang="en">Efron C-index</skos:altLabel>
        <skos:altLabel xml:lang="en">Efron&apos;s C index</skos:altLabel>
        <skos:definition xml:lang="en">Efron’s C-index estimates the probability that a subject from one group survives longer than a subject from another group in the presence of censoring. It is computed using Kaplan–Meier survival curves and targets the group-level concordance probability directly, though the original estimator can be biased under administrative censoring. A modified version provides stable, time-truncated estimates and is often reported across follow-up horizons for fair group comparisons.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04047 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04047">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2405.17878"/>
        <rdfs:label xml:lang="en">information difference index</rdfs:label>
        <rdfs:label xml:lang="es">índice de diferencia de información</rdfs:label>
        <rdfs:label xml:lang="zh">信息差异指数</rdfs:label>
        <skos:altLabel xml:lang="en">IDI</skos:altLabel>
        <skos:definition xml:lang="en">The information difference index is an information-theoretic metric designed to evaluate the effectiveness of machine unlearning. It quantifies the amount of residual information about the data to be forgotten that remains in a model’s intermediate representations, by comparing mutual information between those features and the forget labels against a reference retrained model. The index is normalized such that values near one indicate no unlearning, values near zero indicate effective unlearning comparable to retraining, and negative values indicate over-unlearning, making it a robust white-box measure that complements output-based black-box metrics.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04048 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04048">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1093/rpd/ncp305"/>
        <dcterms:source rdf:resource="https://doi.org/10.1118/1.596358"/>
        <rdfs:label xml:lang="en">area under the alternative free-response operating characteristic curve</rdfs:label>
        <rdfs:label xml:lang="es">área bajo la curva característica de funcionamiento de respuesta libre alternativa</rdfs:label>
        <rdfs:label xml:lang="zh">替代自由响应工作特征曲线下的面积</rdfs:label>
        <skos:altLabel xml:lang="en">AUAFROC</skos:altLabel>
        <skos:altLabel xml:lang="en">AUC_AFROC</skos:altLabel>
        <skos:altLabel xml:lang="en">area under AFROC curve</skos:altLabel>
        <skos:altLabel xml:lang="en">area under the AFROC curve</skos:altLabel>
        <skos:definition xml:lang="en">The area under the alternative free-response operating characteristic curve is a figure of merit used to quantify observer performance in free-response diagnostic imaging studies. It is derived from the alternative free-response operating characteristic curve, which plots the lesion localization fraction against the false-positive fraction, providing a bounded, case-based representation of detection and localization accuracy. It reflects the probability that a correctly localized lesion receives a higher confidence rating than a false-positive mark, and serves as a single, standardized summary measure of localization-based diagnostic accuracy.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04049 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04049">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1111/lnc3.12196"/>
        <rdfs:label xml:lang="es">sorpresa</rdfs:label>
        <rdfs:label xml:lang="en">surprisal</rdfs:label>
        <rdfs:label xml:lang="zh">意外性</rdfs:label>
        <skos:definition xml:lang="en">Surprisal is a measure of the unexpectedness of an event, defined as the logarithm of the reciprocal of its probability. In language processing, it represents the difficulty of comprehending a word given its preceding context, with less probable words yielding higher surprisal values. Surprisal predicts that more unexpected words impose greater processing effort, and has been widely linked to behavioral and neural measures of comprehension difficulty.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04050 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04050">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/lnc3.12196"/>
        <rdfs:label xml:lang="en">entropy reduction</rdfs:label>
        <rdfs:label xml:lang="es">reducción de entropía</rdfs:label>
        <rdfs:label xml:lang="zh">熵减</rdfs:label>
        <skos:definition xml:lang="en">Entropy reduction is an information-theoretic metric that quantifies processing difficulty as the decrease in uncertainty about possible interpretations when new input is encountered. It is defined as the difference between the entropy of possible derivations before and after observing a word or structure, reflecting how much ambiguity has been resolved. Larger reductions correspond to greater computational work by the parser, while increases in entropy indicate that uncertainty has not been reduced.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04051 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04051">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03556"/>
        <dcterms:source rdf:resource="https://doi.org/10.1002/j.1538-7305.1948.tb01338.x"/>
        <rdfs:label xml:lang="en">conditional entropy</rdfs:label>
        <rdfs:label xml:lang="es">entropía condicional</rdfs:label>
        <rdfs:label xml:lang="zh">条件熵</rdfs:label>
        <skos:definition xml:lang="en">Conditional entropy quantifies the remaining uncertainty about one random variable when the value of another related variable is known. It represents the expected amount of information needed to describe the outcome of a variable given prior knowledge of another. Conditional entropy is always less than or equal to the entropy of the variable alone, with equality occurring when the variables are independent.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04052 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04052">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://www.jstor.org/stable/2236703"/>
        <rdfs:label xml:lang="zh">KL散度(即相对熵) or“库尔贝克 - 莱布勒散度”</rdfs:label>
        <rdfs:label xml:lang="en">Kullback-Leibler divergence</rdfs:label>
        <rdfs:label xml:lang="es">divergencia de Kullback-Leibler</rdfs:label>
        <skos:altLabel xml:lang="en">KL</skos:altLabel>
        <skos:altLabel xml:lang="en">KLD</skos:altLabel>
        <skos:altLabel xml:lang="en">relative entropy</skos:altLabel>
        <skos:definition xml:lang="en">Kullback–Leibler divergence is a measure of how one probability distribution differs from a second, reference distribution. It is defined as the expected logarithmic ratio of the probabilities under the two distributions, with the expectation taken over the first distribution. The divergence is non-negative, equals zero only when the two distributions are identical almost everywhere, and is generally asymmetric, meaning the divergence from P to Q is not the same as from Q to P.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04053 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04053">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1109/TIT.2004.838101"/>
        <rdfs:label xml:lang="es">distancia de información normalizada</rdfs:label>
        <rdfs:label xml:lang="en">normalized information distance</rdfs:label>
        <rdfs:label xml:lang="zh">归一化信息距离</rdfs:label>
        <skos:altLabel xml:lang="en">NID</skos:altLabel>
        <skos:definition xml:lang="en">Normalized information distance is a theoretical measure of similarity between two objects based on Kolmogorov complexity. It quantifies the maximum amount of information required to transform one object into the other, normalized by the larger of their individual complexities, resulting in a value between zero and one. This measure is universal in that it captures all effective similarities, but it is not computable in practice due to the incomputability of Kolmogorov complexity.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04054 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04054">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04058"/>
        <rdfs:comment xml:lang="en">If the dataset is imbalanced (some classes have significantly more instances than others), a micro-averaged metric can be misleading if the model performs poorly on minority classes but well on the majority class.</rdfs:comment>
        <rdfs:label xml:lang="en">micro-averaged classification performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de clasificación micro-promediada</rdfs:label>
        <rdfs:label xml:lang="zh">微平均分类</rdfs:label>
        <skos:altLabel xml:lang="es">clasificación micro-promediada</skos:altLabel>
        <skos:altLabel xml:lang="en">micro average classification</skos:altLabel>
        <skos:altLabel xml:lang="en">micro averaged classification</skos:altLabel>
        <skos:altLabel xml:lang="en">micro-average classification</skos:altLabel>
        <skos:altLabel xml:lang="en">micro-averaged classification</skos:altLabel>
        <skos:altLabel xml:lang="zh">微平均分类指标</skos:altLabel>
        <skos:definition xml:lang="en">The performance of a classifier using a micro-averaged metric, one that aggregates data from all classes before calculation; thus, the metric is the aggregate across all classes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04055 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04055">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04058"/>
        <rdfs:comment xml:lang="en">A macro-averaged metric gives equal weight to each class, so it can be more sensitive to a model&apos;s performance on minority classes in imbalanced datasets.</rdfs:comment>
        <rdfs:label xml:lang="en">macro-averaged classification performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de clasificación macro-promediada</rdfs:label>
        <rdfs:label xml:lang="zh">宏观平均分类</rdfs:label>
        <skos:altLabel xml:lang="es">clasificación macro-promediada</skos:altLabel>
        <skos:altLabel xml:lang="en">macro average classification</skos:altLabel>
        <skos:altLabel xml:lang="en">macro averaged classification</skos:altLabel>
        <skos:altLabel xml:lang="en">macro-average classification</skos:altLabel>
        <skos:altLabel xml:lang="en">macro-averaged classification</skos:altLabel>
        <skos:altLabel xml:lang="zh">宏平均分类指标</skos:altLabel>
        <skos:definition xml:lang="en">The performance of a classifier using a macro-averaged metric, that is, the unweighted average of the metric score calculated for each class independently.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04056 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04056">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="es">contenido de información</rdfs:label>
        <rdfs:label xml:lang="en">information content</rdfs:label>
        <rdfs:label xml:lang="zh">信息内容</rdfs:label>
        <skos:altLabel xml:lang="en">information-theoretic metric</skos:altLabel>
        <skos:definition xml:lang="en">A metric, such as entropy, derived from information theory.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04057 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04057">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">readability performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de lecturabilidad</rdfs:label>
        <rdfs:label xml:lang="zh">可读性</rdfs:label>
        <skos:altLabel xml:lang="es">lecturabilidad</skos:altLabel>
        <skos:altLabel xml:lang="en">readability</skos:altLabel>
        <skos:definition xml:lang="en">Readability measures the ease with which users can read a text; it may measure the level of education required to read the subject text.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04058 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04058">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">classification performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de clasificación</rdfs:label>
        <rdfs:label xml:lang="zh">分类</rdfs:label>
        <skos:altLabel xml:lang="es">clasificación</skos:altLabel>
        <skos:altLabel xml:lang="en">classification</skos:altLabel>
        <skos:definition xml:lang="en">How well a system distinguishes various classes of items: can be binary (e.g., normal vs. abnormal) or multiclass.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04059 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04059">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="es">rendimiento de análisis de texto</rdfs:label>
        <rdfs:label xml:lang="en">text analysis performance</rdfs:label>
        <rdfs:label xml:lang="zh">文本分析</rdfs:label>
        <skos:altLabel xml:lang="es">análisis de texto</skos:altLabel>
        <skos:altLabel xml:lang="en">text analysis</skos:altLabel>
        <skos:definition xml:lang="en">A metric used to judge the performance of a text-analysis system.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04060 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04060">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">image segmentation performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de segmentación de imágenes</rdfs:label>
        <rdfs:label xml:lang="zh">图像分割性能</rdfs:label>
        <skos:altLabel xml:lang="en">image-segmentation performance</skos:altLabel>
        <skos:definition xml:lang="en">The quality of segmentation of image data.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04061 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04061">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">prediction performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de predicción</rdfs:label>
        <rdfs:label xml:lang="zh">预测</rdfs:label>
        <skos:altLabel xml:lang="es">predicción</skos:altLabel>
        <skos:altLabel xml:lang="en">prediction</skos:altLabel>
        <skos:definition xml:lang="en">How well an AI model performs in making predictions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04062 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04062">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">calibration performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de calibración</rdfs:label>
        <rdfs:label xml:lang="zh">校准</rdfs:label>
        <skos:altLabel xml:lang="es">calibración</skos:altLabel>
        <skos:altLabel xml:lang="en">calibration</skos:altLabel>
        <skos:definition xml:lang="en">An AI model&apos;s calibration is the agreement between observed outcomes and estimated values from the model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04063 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04063">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="es">rendimiento de análisis de señales</rdfs:label>
        <rdfs:label xml:lang="en">signal analysis performance</rdfs:label>
        <rdfs:label xml:lang="zh">信号分析</rdfs:label>
        <skos:altLabel xml:lang="es">análisis de señales</skos:altLabel>
        <skos:altLabel xml:lang="en">signal analysis</skos:altLabel>
        <skos:definition xml:lang="en">The performance of an AI model in terms of signal analysis.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04064 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04064">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">fairness performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de equidad</rdfs:label>
        <rdfs:label xml:lang="zh">公平性</rdfs:label>
        <skos:altLabel xml:lang="es">rendimiento de justicia</skos:altLabel>
        <skos:definition xml:lang="en">A measure of the fairness of a model&apos;s performance across a certain category.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04065 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04065">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="es">utilidad</rdfs:label>
        <rdfs:label xml:lang="en">utility</rdfs:label>
        <rdfs:label xml:lang="zh">效用</rdfs:label>
        <skos:definition xml:lang="en">The performance of an AI model in terms of utility, such as economic benefit or QALYs.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04066 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04066">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="es">rendimiento de respuesta del usuario</rdfs:label>
        <rdfs:label xml:lang="en">user response performance</rdfs:label>
        <rdfs:label xml:lang="zh">用户响应</rdfs:label>
        <skos:altLabel xml:lang="es">respuesta del usuario</skos:altLabel>
        <skos:altLabel xml:lang="en">user response</skos:altLabel>
        <skos:definition xml:lang="en">The performance of an AI model in terms of user response.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04067 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04067">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="es">rendimiento de acuerdo del usuario</rdfs:label>
        <rdfs:label xml:lang="en">user agreement performance</rdfs:label>
        <rdfs:label xml:lang="zh">用户协议</rdfs:label>
        <skos:altLabel xml:lang="es">acuerdo del usuario</skos:altLabel>
        <skos:altLabel xml:lang="en">user agreement</skos:altLabel>
        <skos:definition xml:lang="en">The performance of an AI model in terms of user agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04068 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04068">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03364"/>
        <rdfs:label xml:lang="es">anotación de volumen de interés</rdfs:label>
        <rdfs:label xml:lang="en">volume-of-interest annotation</rdfs:label>
        <rdfs:label xml:lang="zh">感兴趣体积标注</rdfs:label>
        <skos:altLabel xml:lang="en">VOI annotation</skos:altLabel>
        <skos:altLabel xml:lang="en">VOI label</skos:altLabel>
        <skos:altLabel xml:lang="en">volume of interest annotation</skos:altLabel>
        <skos:altLabel xml:lang="en">volume of interest label</skos:altLabel>
        <skos:altLabel xml:lang="en">volume-of-interest label</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to a three-dimensional (3D) dataset, with the contours or surfaces outlining an object in a volume.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04069 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04069">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03548"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasOutcomeCount"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/04091"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasOutcomeCount"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/04092"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasOutcomeCount"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/04093"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasOutcomeCount"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://rsna.org/roadmap/04094"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">binary confusion matrix</rdfs:label>
        <rdfs:label xml:lang="es">matriz de confusión binaria</rdfs:label>
        <rdfs:label xml:lang="zh">二元混淆矩阵</rdfs:label>
        <skos:altLabel xml:lang="en">2x2 contingency table</skos:altLabel>
        <skos:definition xml:lang="en">A confusion matrix for two classes, such as normal or abnormal.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04070 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04070">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03548"/>
        <rdfs:label xml:lang="es">matriz de confusión multiclase</rdfs:label>
        <rdfs:label xml:lang="en">multi-class confusion matrix</rdfs:label>
        <rdfs:label xml:lang="zh">多分类混淆矩阵</rdfs:label>
        <skos:definition xml:lang="en">An N x N confusion matrix, where N &gt; 2.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04073 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04073">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/S0895-4356(03)00177-X"/>
        <rdfs:label xml:lang="es">cociente de probabilidades diagnóstico</rdfs:label>
        <rdfs:label xml:lang="en">diagnostic odds ratio</rdfs:label>
        <rdfs:label xml:lang="zh">诊断优势比</rdfs:label>
        <skos:altLabel xml:lang="en">DOR</skos:altLabel>
        <skos:definition xml:lang="en">The diagnostic odds ratio is a single summary measure of diagnostic test accuracy, defined as the ratio of the odds of a positive test result in diseased individuals to the odds of a positive result in non-diseased individuals. It combines sensitivity and specificity into one statistic, making it mathematically equivalent to the ratio of positive to negative likelihood ratios. A value of 1 indicates no discriminatory ability, values greater than 1 reflect increasing diagnostic accuracy, and values less than 1 suggest systematic misclassification, while remaining independent of disease prevalence.

                                         DOR = ⁠LR+ / LR−</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000679"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04074 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04074">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.2307/2288117"/>
        <rdfs:label xml:lang="en">Fowlkes-Mallows index</rdfs:label>
        <rdfs:label xml:lang="es">índice de Fowlkes-Mallows</rdfs:label>
        <rdfs:label xml:lang="zh">福尔克斯 - 马洛指数</rdfs:label>
        <skos:altLabel xml:lang="en">FM</skos:altLabel>
        <skos:altLabel xml:lang="zh">FM 指数</skos:altLabel>
        <skos:altLabel xml:lang="en">FMI</skos:altLabel>
        <skos:altLabel xml:lang="en">Fowlkes Mallows index</skos:altLabel>
        <skos:definition xml:lang="en">The Fowlkes–Mallows index measures the similarity between two data clusterings by comparing how object pairs are grouped. It is defined as the number of pairs placed in the same cluster in both partitions divided by the geometric mean of the number of pairs in the same cluster in each partition separately. The index ranges from 0 (no shared pairwise groupings) to 1 (identical pairwise groupings) and can be applied to both fixed-k partitions and hierarchical clustering comparisons.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04075 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04075">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:comment xml:lang="en">Examples:
                                         - Mean Absolute Error (MAE)
                                         - Mean Squared Error (MSE)
                                         - Root Mean Squared Error (RMSE)
                                         - R² (R-Squared)</rdfs:comment>
        <rdfs:label xml:lang="en">regression performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de regresión</rdfs:label>
        <rdfs:label xml:lang="zh">回归</rdfs:label>
        <skos:altLabel xml:lang="es">regresión</skos:altLabel>
        <skos:altLabel xml:lang="en">regression</skos:altLabel>
        <skos:definition xml:lang="en">Regression models have continuous output; a regression metric measures some sort of distance between predictions and reference standard.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04077 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04077">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">image processing performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de procesamiento de imágenes</rdfs:label>
        <rdfs:label xml:lang="zh">图像处理性能</rdfs:label>
        <skos:altLabel xml:lang="en">image-processing performance</skos:altLabel>
        <skos:definition xml:lang="en">The quality of image manipulation, such as reconstruction, compression, noise reduction, or signal enhancement.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04078 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04078">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03593"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.2214/AJR.25.34340"/>
        <rdfs:comment xml:lang="en">Enhanced Detection Rate (EDR) can be measured in two ways: relative EDR (EDRr) and absolute EDR (EDRa). The key difference lies in the denominator, while both metrics share the same numerator—the number of exams (retrospective metric) detected by the AI model but not reported in the radiology report.

For EDRr, the denominator is the total number of exams detected by the radiologist, representing the relative percentage improvement in sensitivity for the &quot;average radiologist.&quot; The denominator for the EDRa is the total number of exams reviewed.  

                                         - Nina Kottler</rdfs:comment>
        <rdfs:comment xml:lang="en">The absolute enhanced detection rate is the proportion of true positive findings uniquely detected by artificial intelligence out of the total number of examinations in the evaluated cohort. It provides a population-level perspective by quantifying the overall increase in diagnostic yield attributable to artificial intelligence. This measure is especially relevant in public health and screening contexts.

aEDR = (number of positive cases not detected by human alone) / (total number of cases)

It indicates the potential of AI to increase radiologist detection of positive cases relative to all examined cases.</rdfs:comment>
        <rdfs:label xml:lang="en">absolute enhanced detection rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa absoluta de detección mejorada</rdfs:label>
        <rdfs:label xml:lang="zh">绝对增强检出率</rdfs:label>
        <skos:altLabel xml:lang="en">EDRa</skos:altLabel>
        <skos:altLabel xml:lang="en">aEDR</skos:altLabel>
        <skos:altLabel xml:lang="en">absolute EDR</skos:altLabel>
        <skos:definition xml:lang="en">The absolute enhanced detection rate is defined as the ratio of the number of AI-enhanced detection cases (i.e., the number of cases detected only by AI) and total number of cases.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04079 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04079">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03593"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.2214/AJR.25.34340"/>
        <rdfs:comment xml:lang="en">Enhanced Detection Rate (EDR) can be measured in two ways: relative EDR (EDRr) and absolute EDR (EDRa). The key difference lies in the denominator, while both metrics share the same numerator—the number of exams (retrospective metric) detected by the AI model but not reported in the radiology report.

For EDRr, the denominator is the total number of exams detected by the radiologist, representing the relative percentage improvement in sensitivity for the &quot;average radiologist.&quot; The denominator for the EDRa is the total number of exams reviewed.  

- Nina Kottler</rdfs:comment>
        <rdfs:comment xml:lang="en">The relative enhanced detection rate is defined as the ratio between the number of enhanced detection cases and number of radiologist true-positive cases (i.e., potential of AI to increase radiologist detection of positive cases relative to radiologist true-positives without AI assistance).

rEDR = (number of positive cases not detected by human alone) / (number of positive human-detected cases)</rdfs:comment>
        <rdfs:label xml:lang="en">relative enhanced detection rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa relativa de detección mejorada</rdfs:label>
        <rdfs:label xml:lang="zh">相对增强检测率</rdfs:label>
        <skos:altLabel xml:lang="en">EDRr</skos:altLabel>
        <skos:altLabel xml:lang="en">rEDR</skos:altLabel>
        <skos:altLabel xml:lang="en">relative EDR</skos:altLabel>
        <skos:definition xml:lang="en">The relative enhanced detection rate expresses the proportion of true positive findings uniquely identified by artificial intelligence in relation to the number of positive findings detected by the human reader. It provides a radiologist-centered perspective by quantifying the percentage improvement in sensitivity when artificial intelligence is added. This metric is particularly suited to comparing the benefit of artificial intelligence relative to individual or average radiologist performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04080 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04080">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1186/1471-2105-9-303"/>
        <rdfs:label xml:lang="en">false discovery rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de descubrimiento falso</rdfs:label>
        <rdfs:label xml:lang="zh">错误发现率</rdfs:label>
        <skos:altLabel xml:lang="en">FDR</skos:altLabel>
        <skos:definition xml:lang="en">The false discovery rate is the expected proportion of false positives among all test results deemed significant or positive. Unlike more conservative measures such as the family-wise error rate, it controls the proportion rather than the absolute occurrence of false positives, making it particularly useful in large-scale or high-dimensional testing contexts. It serves as a key measure for balancing discovery power with error control in statistical inference and diagnostic decision-making.

                                         FDR = FP / (TP + FP) = 1 - PPV</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04081 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04081">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.ijid.2021.04.004"/>
        <rdfs:label xml:lang="en">false omission rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de falsas omisiones</rdfs:label>
        <rdfs:label xml:lang="zh">漏检率</rdfs:label>
        <skos:altLabel xml:lang="en">FOR</skos:altLabel>
        <skos:definition xml:lang="en">The false omission rate is the proportion of individuals with negative test results who are in fact positive for the condition being tested. It is mathematically defined as one minus the negative predictive value, representing the probability that a negative result is incorrect. It is sensitive to disease prevalence, remaining low when prevalence is low but increasing substantially when prevalence is high, thereby quantifying the risk of false reassurance from negative outcomes.

                                         FOR = FN / (TN + FN) = 1 - NPV</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04082 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04082">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03526"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-642-41230-1_36"/>
        <rdfs:label xml:lang="es">precisión entre los 10 mejores</rdfs:label>
        <rdfs:label xml:lang="en">top-10 accuracy</rdfs:label>
        <rdfs:label xml:lang="zh">前 10 名准确率</rdfs:label>
        <skos:definition xml:lang="en">Top-10 accuracy measures the proportion of instances where the true class label appears within the top 10 predicted class labels, regardless of their order.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04086 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04086">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2021.0223"/>
        <rdfs:label xml:lang="en">log-risk score</rdfs:label>
        <rdfs:label xml:lang="es">puntuación de riesgo logarítmico</rdfs:label>
        <rdfs:label xml:lang="zh">对数风险评分</rdfs:label>
        <skos:altLabel xml:lang="en">log risk score</skos:altLabel>
        <skos:definition xml:lang="en">The log-risk score is a time-independent linear predictor derived from the Cox proportional hazards model that represents an individual’s overall risk of experiencing an event, such as death or disease recurrence. It is computed as the weighted sum of patient covariates, where the weights are regression coefficients estimated from the model. Higher log-risk scores correspond to higher event risk, and while the score itself is not a probability, it can be transformed into time-dependent survival probabilities when combined with baseline survival estimates.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04087 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04087">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/sj.bjc.6601118"/>
        <rdfs:label xml:lang="es">probabilidad de supervivencia</rdfs:label>
        <rdfs:label xml:lang="en">survival probability</rdfs:label>
        <rdfs:label xml:lang="zh">生存概率</rdfs:label>
        <skos:definition xml:lang="en">Survival probability is the probability that an individual remains free of a specified event, such as death or relapse, beyond a given time point measured from the study origin. It is expressed by the survival function, which represents the cumulative likelihood of continuing survival up to time t, and forms the foundation of survival analysis. This measure is typically estimated with methods such as the Kaplan–Meier estimator, accommodates censoring, and provides clinically interpretable outcomes including median survival and fixed-time survival rates.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04088 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04088">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2021.0223"/>
        <rdfs:label xml:lang="en">cumulative hazard</rdfs:label>
        <rdfs:label xml:lang="es">riesgo acumulado</rdfs:label>
        <rdfs:label xml:lang="zh">累积风险</rdfs:label>
        <skos:altLabel xml:lang="en">CHF</skos:altLabel>
        <skos:altLabel xml:lang="en">cumulative hazard function</skos:altLabel>
        <skos:definition xml:lang="en">The cumulative hazard is a time-dependent function in survival analysis that represents the total risk of an event occurring up to a given time point. It accumulates the instantaneous hazard over time and serves as the mathematical basis for deriving survival probabilities. Many survival models, including proportional hazards models and random survival forests, estimate cumulative hazard as a primary output, which can then be used directly for risk assessment or transformed into survival probabilities and summary measures for model evaluation.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04090 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04090">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00659"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasIntegerValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="es">número de resultados</rdfs:label>
        <rdfs:label xml:lang="en">outcome count</rdfs:label>
        <rdfs:label xml:lang="zh">结果计数</rdfs:label>
        <skos:definition xml:lang="en">A statistical metric derived from the confusion matrix that counts the outcomes of a given type produced by a classification model on an evaluation dataset. Unlike rates, outcome counts are unnormalised and therefore scale with dataset size; they are the primitives from which classification rates such as sensitivity, specificity, and predictive value are computed.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#outcome_count"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04091 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04091">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="es">número de verdaderos positivos</rdfs:label>
        <rdfs:label xml:lang="en">true positive count</rdfs:label>
        <rdfs:label xml:lang="zh">真阳性计数</rdfs:label>
        <skos:altLabel xml:lang="en">TP</skos:altLabel>
        <skos:altLabel xml:lang="en">hits</skos:altLabel>
        <skos:altLabel xml:lang="en">number of true positives</skos:altLabel>
        <skos:definition xml:lang="en">The number of cases that are positive according to the reference standard and are predicted positive by the model. True positives are the correctly detected cases, and together with false negatives they partition the condition positive cases.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#true_positive_count"/>
        <symbol>TP</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04092 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04092">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="en">false positive count</rdfs:label>
        <rdfs:label xml:lang="es">número de falsos positivos</rdfs:label>
        <rdfs:label xml:lang="zh">假阳性计数</rdfs:label>
        <skos:altLabel xml:lang="en">FP</skos:altLabel>
        <skos:altLabel xml:lang="en">false alarms</skos:altLabel>
        <skos:altLabel xml:lang="en">number of false positives</skos:altLabel>
        <skos:altLabel xml:lang="en">type I errors</skos:altLabel>
        <skos:definition xml:lang="en">The number of cases that are negative according to the reference standard but are predicted positive by the model. Also called type I errors or false alarms. In screening applications the false positive count determines the downstream burden of unnecessary confirmatory workup.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#false_positive_count"/>
        <symbol>FP</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04093 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04093">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="es">número de verdaderos negativos</rdfs:label>
        <rdfs:label xml:lang="en">true negative count</rdfs:label>
        <rdfs:label xml:lang="zh">真阴性计数</rdfs:label>
        <skos:altLabel xml:lang="en">TN</skos:altLabel>
        <skos:altLabel xml:lang="en">correct rejections</skos:altLabel>
        <skos:altLabel xml:lang="en">number of true negatives</skos:altLabel>
        <skos:definition xml:lang="en">The number of cases that are negative according to the reference standard and are predicted negative by the model. Also called correct rejections.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#true_negative_count"/>
        <symbol>TN</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04094 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04094">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="en">false negative count</rdfs:label>
        <rdfs:label xml:lang="es">número de falsos negativos</rdfs:label>
        <rdfs:label xml:lang="zh">假阴性计数</rdfs:label>
        <skos:altLabel xml:lang="en">FN</skos:altLabel>
        <skos:altLabel xml:lang="en">misses</skos:altLabel>
        <skos:altLabel xml:lang="en">number of false negatives</skos:altLabel>
        <skos:altLabel xml:lang="en">type II errors</skos:altLabel>
        <skos:definition xml:lang="en">The number of cases that are positive according to the reference standard but are predicted negative by the model. Also called type II errors or misses. In diagnostic applications false negatives correspond to missed disease and typically carry the greatest clinical cost.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#false_negative_count"/>
        <symbol>FN</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04095 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04095">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="es">condición positiva</rdfs:label>
        <rdfs:label xml:lang="en">condition positive count</rdfs:label>
        <rdfs:label xml:lang="zh">实际阳性数</rdfs:label>
        <skos:altLabel xml:lang="en">P</skos:altLabel>
        <skos:altLabel xml:lang="en">actual positives</skos:altLabel>
        <skos:altLabel xml:lang="en">condition positive</skos:altLabel>
        <skos:altLabel xml:lang="en">reference standard positive count</skos:altLabel>
        <skos:definition xml:lang="en">The number of cases in an evaluation dataset that are positive according to the reference standard, irrespective of what the model predicted. Condition positive is a property of the evaluation dataset rather than of the model.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#condition_positive"/>
        <formula>TP + FN</formula>
        <symbol>P</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04096 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04096">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="es">condición negativa</rdfs:label>
        <rdfs:label xml:lang="en">condition negative count</rdfs:label>
        <rdfs:label xml:lang="zh">实际阴性数</rdfs:label>
        <skos:altLabel xml:lang="en">N</skos:altLabel>
        <skos:altLabel xml:lang="en">actual negatives</skos:altLabel>
        <skos:altLabel xml:lang="en">condition negative</skos:altLabel>
        <skos:altLabel xml:lang="en">reference standard negative count</skos:altLabel>
        <skos:definition xml:lang="en">The number of cases in an evaluation dataset that are negative according to the reference standard, irrespective of what the model predicted. Condition negative is a property of the evaluation dataset rather than of the model.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#condition_negative"/>
        <formula>TN + FP</formula>
        <symbol>N</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04097 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04097">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="es">predicción positiva</rdfs:label>
        <rdfs:label xml:lang="en">prediction positive count</rdfs:label>
        <rdfs:label xml:lang="zh">预测阳性数</rdfs:label>
        <skos:altLabel xml:lang="en">PP</skos:altLabel>
        <skos:altLabel xml:lang="en">predicted positive count</skos:altLabel>
        <skos:altLabel xml:lang="en">prediction positive</skos:altLabel>
        <skos:definition xml:lang="en">The number of cases a model predicts as positive, irrespective of the reference standard. Prediction positive is the denominator of positive predictive value and of the false discovery rate.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#prediction_positive"/>
        <formula>TP + FP</formula>
        <symbol>PP</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04098 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04098">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="es">predicción negativa</rdfs:label>
        <rdfs:label xml:lang="en">prediction negative count</rdfs:label>
        <rdfs:label xml:lang="zh">预测阴性数</rdfs:label>
        <skos:altLabel xml:lang="en">PN</skos:altLabel>
        <skos:altLabel xml:lang="en">predicted negative count</skos:altLabel>
        <skos:altLabel xml:lang="en">prediction negative</skos:altLabel>
        <skos:definition xml:lang="en">The number of cases a model predicts as negative, irrespective of the reference standard. Prediction negative is the denominator of negative predictive value and of the false omission rate.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#prediction_negative"/>
        <formula>TN + FN</formula>
        <symbol>PN</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04099 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04099">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04090"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:label xml:lang="es">número total de resultados</rdfs:label>
        <rdfs:label xml:lang="en">total outcome count</rdfs:label>
        <rdfs:label xml:lang="zh">结果总数</rdfs:label>
        <skos:altLabel xml:lang="en">evaluation sample size</skos:altLabel>
        <skos:altLabel xml:lang="en">total number of outcomes</skos:altLabel>
        <skos:definition xml:lang="en">The total number of cases evaluated, counting outcomes of every type. It is the denominator of accuracy, prevalence, and the prediction rates, and it is the quantity that determines the precision of every other metric reported for the evaluation.

n = TP + FP + TN + FN = P + N = PP + PN</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#total_outcome_count"/>
        <formula>P + N</formula>
        <formula>PP + PN</formula>
        <formula>TP + FP + TN + FN</formula>
        <symbol>Total</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04100 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04100">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:comment xml:lang="en">Metrics reported without the prevalence of the evaluation set cannot be re-derived for a population with a different case mix.</rdfs:comment>
        <rdfs:label xml:lang="en">prevalence</rdfs:label>
        <rdfs:label xml:lang="es">prevalencia</rdfs:label>
        <rdfs:label xml:lang="zh">患病率</rdfs:label>
        <skos:altLabel xml:lang="en">PREV</skos:altLabel>
        <skos:altLabel xml:lang="en">base rate</skos:altLabel>
        <skos:altLabel xml:lang="en">prior probability of disease</skos:altLabel>
        <skos:altLabel xml:lang="es">tasa base</skos:altLabel>
        <skos:definition xml:lang="en">Prevalence is the proportion of evaluated cases that are positive according to the reference standard. It is a property of the evaluation dataset rather than of the model, and it governs the behaviour of the prevalence-sensitive metrics: positive predictive value and false discovery rate deteriorate as prevalence falls, while negative predictive value and false omission rate deteriorate as prevalence rises. Reporting prevalence alongside predictive values is therefore necessary for a performance claim to transfer to a new setting.

PREV = P / n</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000412"/>
        <formula>P / n</formula>
        <symbol>PREV</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04101 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04101">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:comment xml:lang="en">FMO uses the symbol PR, which is unavailable in ROADMAP: PR is an altLabel of :00107 (Professionalism). PPR is used here instead.</rdfs:comment>
        <rdfs:comment xml:lang="en">PPR = PP / n = (TP + FP) / n</rdfs:comment>
        <rdfs:label xml:lang="en">positive prediction rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de predicción positiva</rdfs:label>
        <rdfs:label xml:lang="zh">阳性预测率</rdfs:label>
        <skos:altLabel xml:lang="en">PPR</skos:altLabel>
        <skos:altLabel xml:lang="en">predicted positive rate</skos:altLabel>
        <skos:altLabel xml:lang="en">selection rate</skos:altLabel>
        <skos:altLabel xml:lang="es">tasa de selección</skos:altLabel>
        <skos:definition xml:lang="en">The positive prediction rate is the proportion of evaluated cases that a model predicts as positive, whether or not those predictions are correct. Because it depends only on the model&apos;s outputs and not on the reference standard, it can be computed where ground truth is unavailable. It is the quantity compared across protected groups by demographic parity and by disparate impact.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#positive_prediction_rate"/>
        <formula>(TP + FP) / n</formula>
        <formula>PP / n</formula>
        <symbol>PPR</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04102 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04102">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04058"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1145/3514094.3534137"/>
        <rdfs:comment xml:lang="en">FMO uses the symbol NR, which is unavailable in ROADMAP: NR is an altLabel of :00101 (Neuroradiology). NPR is used here instead.</rdfs:comment>
        <rdfs:comment xml:lang="en">NPR = PN / n = (TN + FN) / n = 1 - PPR</rdfs:comment>
        <rdfs:label xml:lang="en">negative prediction rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de predicción negativa</rdfs:label>
        <rdfs:label xml:lang="zh">阴性预测率</rdfs:label>
        <skos:altLabel xml:lang="en">NPR</skos:altLabel>
        <skos:altLabel xml:lang="en">predicted negative rate</skos:altLabel>
        <skos:definition xml:lang="en">The negative prediction rate is the proportion of evaluated cases that a model predicts as negative, whether or not those predictions are correct. Like the positive prediction rate it is computable without a reference standard.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#negative_prediction_rate"/>
        <formula>(TN + FN) / n</formula>
        <formula>1 - PPR</formula>
        <formula>PN / n</formula>
        <symbol>NPR</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04103 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04103">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1097/EDE.0b013e31821b506e"/>
        <rdfs:comment xml:lang="en">FP:FN = FP / FN</rdfs:comment>
        <rdfs:label xml:lang="en">error type ratio</rdfs:label>
        <rdfs:label xml:lang="es">razón de tipos de error</rdfs:label>
        <rdfs:label xml:lang="zh">错误类型比</rdfs:label>
        <skos:altLabel xml:lang="en">FP:FN</skos:altLabel>
        <skos:altLabel xml:lang="en">false positive to false negative ratio</skos:altLabel>
        <skos:definition xml:lang="en">The error type ratio is the number of false positive outcomes divided by the number of false negative outcomes. It characterises how a model distributes its errors between the two error types, independently of the total error magnitude, and so distinguishes models with equal accuracy but different failure profiles. Equalizing this ratio across protected groups is the fairness notion known as treatment equality.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#error_type_ratio"/>
        <formula>FP / FN</formula>
        <symbol>FP:FN</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04104 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04104">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-031-47745-4_18"/>
        <rdfs:label xml:lang="en">expected value</rdfs:label>
        <rdfs:label xml:lang="es">valor esperado</rdfs:label>
        <rdfs:label xml:lang="zh">期望值</rdfs:label>
        <skos:altLabel xml:lang="en">EV</skos:altLabel>
        <skos:altLabel xml:lang="es">esperanza matemática</skos:altLabel>
        <skos:altLabel xml:lang="en">mean of a distribution</skos:altLabel>
        <skos:definition xml:lang="en">The expected value is the probability-weighted mean of a random variable over its distribution. Applied to a regression model it denotes the mean predicted output, and comparing this quantity between protected groups yields statistical parity for regression and the group mean difference.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#expected_value"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04105 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04105">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01058"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-031-47745-4_18"/>
        <rdfs:comment xml:lang="en">Proposed as a parent class for :03309 expected cost, :04037 cross-entropy, and :04032 Wasserstein loss. Reparenting those three is a separate edit, not included here.</rdfs:comment>
        <rdfs:label xml:lang="en">loss</rdfs:label>
        <rdfs:label xml:lang="es">pérdida</rdfs:label>
        <rdfs:label xml:lang="zh">损失</rdfs:label>
        <skos:altLabel xml:lang="en">cost function</skos:altLabel>
        <skos:altLabel xml:lang="es">función de pérdida</skos:altLabel>
        <skos:altLabel xml:lang="en">loss function</skos:altLabel>
        <skos:definition xml:lang="en">A loss is a function mapping a model&apos;s predicted value and the corresponding reference value onto a real number representing the cost of the discrepancy between them. Model fitting proceeds by minimizing the loss over the training data, and the expectation of the loss over a distribution is the risk. Bounding the per-group loss is the fairness notion known as bounded group loss.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#loss"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04106 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04106">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01048"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-031-47745-4_18"/>
        <rdfs:comment xml:lang="en">Can be used to measure model drift: the two-sample form of this statistic is a standard test for distributional drift.</rdfs:comment>
        <rdfs:label xml:lang="en">Kolmogorov-Smirnov distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia de Kolmogórov-Smirnov</rdfs:label>
        <rdfs:label xml:lang="zh">柯尔莫哥洛夫-斯米尔诺夫距离</rdfs:label>
        <skos:altLabel xml:lang="en">KS distance</skos:altLabel>
        <skos:altLabel xml:lang="en">KS statistic</skos:altLabel>
        <skos:altLabel xml:lang="en">Kolmogorov–Smirnov distance</skos:altLabel>
        <skos:definition xml:lang="en">The Kolmogorov–Smirnov distance is the supremum of the absolute difference between two cumulative distribution functions, most often the empirical distribution function of a sample and the cumulative distribution function of a reference distribution. It is the test statistic of the Kolmogorov–Smirnov test, and applied to the score distributions of two protected groups it yields the fairness metric KS statistical parity.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#KS_distance"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04107 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04107">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-031-47745-4_18"/>
        <rdfs:label xml:lang="es">diferencia por pares</rdfs:label>
        <rdfs:label xml:lang="en">pairwise difference</rdfs:label>
        <rdfs:label xml:lang="zh">成对差异</rdfs:label>
        <skos:definition xml:lang="en">The pairwise difference is the mean of the differences between paired samples drawn from two groups. It is the base quantity for the pairwise fairness metrics used in regression and ranking, where fairness is assessed over pairs of subjects rather than over group-level aggregates.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#pairwise_difference"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04108 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04108">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00659"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/2090236.2090255"/>
        <rdfs:label xml:lang="en">difference metric</rdfs:label>
        <rdfs:label xml:lang="es">métrica de diferencia</rdfs:label>
        <rdfs:label xml:lang="zh">差异度量</rdfs:label>
        <skos:altLabel xml:lang="en">dissimilarity metric</skos:altLabel>
        <skos:altLabel xml:lang="en">Δ</skos:altLabel>
        <skos:definition xml:lang="en">A difference metric is a function computing the dissimilarity between two values on a normalised scale, where identical values give 0 and maximally dissimilar values give 1. Difference metrics are the primitives of individual fairness, which is stated as a Lipschitz condition relating the difference between two model outputs to the difference between the two corresponding inputs.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#difference_metric"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04109 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04109">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04108"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/2090236.2090255"/>
        <rdfs:label xml:lang="en">input difference metric</rdfs:label>
        <rdfs:label xml:lang="es">métrica de diferencia de entrada</rdfs:label>
        <rdfs:label xml:lang="zh">输入差异度量</rdfs:label>
        <skos:altLabel xml:lang="en">task-specific similarity metric</skos:altLabel>
        <skos:altLabel xml:lang="en">Δˣ</skos:altLabel>
        <skos:definition xml:lang="en">An input difference metric computes the dissimilarity between two individuals in the input space, quantifying how alike two subjects are with respect to the task at hand. The choice of input difference metric is the central modelling commitment of individual fairness, since the requirement that similar individuals be treated similarly is well defined only relative to a stated notion of similarity.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#input_difference_metric"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04110 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04110">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04108"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/2090236.2090255"/>
        <rdfs:label xml:lang="es">métrica de diferencia de salida</rdfs:label>
        <rdfs:label xml:lang="en">output difference metric</rdfs:label>
        <rdfs:label xml:lang="zh">输出差异度量</rdfs:label>
        <skos:altLabel xml:lang="en">Δʸ</skos:altLabel>
        <skos:definition xml:lang="en">An output difference metric computes the dissimilarity between two model outputs, quantifying how differently a model treated two subjects. Individual fairness holds when the output difference between any two subjects does not exceed their input difference.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#output_difference_metric"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04112 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04112">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04113"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-031-47745-4_18"/>
        <rdfs:label xml:lang="en">average distance from the center</rdfs:label>
        <rdfs:label xml:lang="es">distancia media al centroide</rdfs:label>
        <rdfs:label xml:lang="zh">到聚类中心的平均距离</rdfs:label>
        <skos:altLabel xml:lang="en">average within-cluster distance</skos:altLabel>
        <skos:definition xml:lang="en">The mean, taken over all points in a clustering, of each point&apos;s distance from the centroid of its assigned cluster. It summarises cluster compactness and serves as the objective minimised by centroid-based clustering algorithms.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#average_distance_from_the_center"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04113 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04113">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.1802.05733"/>
        <rdfs:label xml:lang="en">clustering objective cost</rdfs:label>
        <rdfs:label xml:lang="es">coste objetivo de agrupamiento</rdfs:label>
        <rdfs:label xml:lang="zh">聚类目标代价</rdfs:label>
        <skos:altLabel xml:lang="en">clustering cost</skos:altLabel>
        <skos:altLabel xml:lang="en">cost of a clustering</skos:altLabel>
        <skos:definition xml:lang="en">The value of the objective function that a clustering algorithm minimises, computed according to whichever clustering objective is in force, such as k-means, k-median, or k-center. Because the objective differs between algorithms, costs are comparable only between clusterings produced under the same objective.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#cluster_objective_cost"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04114 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04114">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04113"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-031-47745-4_18"/>
        <rdfs:label xml:lang="en">average cohort clustering objective cost</rdfs:label>
        <rdfs:label xml:lang="es">coste objetivo de agrupamiento medio por cohorte</rdfs:label>
        <rdfs:label xml:lang="zh">队列平均聚类目标代价</rdfs:label>
        <skos:definition xml:lang="en">The mean clustering objective cost taken over the points belonging to one cohort of a dataset. Comparing this quantity across cohorts is what the social fairness cost and the egalitarian and utilitarian clustering objectives measure: a clustering can be good on average while serving one cohort substantially worse than another.</skos:definition>
        <skos:exactMatch rdf:resource="https://purl.org/twc/fmo#average_cohort_clustering_objective_cost"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04115 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04115">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">cybersecurity measures</rdfs:label>
        <skos:definition xml:lang="en">Describes cybersecurity measures put in place for the AI model, such as access controls, vulnerability management, or secure update mechanisms.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04116 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04116">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:label xml:lang="en">harmonized standards applied</rdfs:label>
        <skos:altLabel xml:lang="en">harmonised standards applied</skos:altLabel>
        <skos:definition xml:lang="en">Lists the harmonized standards, common specifications, or other technical standards applied in developing and evaluating the model, or the solutions adopted to meet the applicable requirements in their absence.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04117 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04117">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">distribution form</rdfs:label>
        <skos:definition xml:lang="en">The form(s) in which the model is placed on the market or put into service, such as software embedded in hardware, a software download, an API, or a cloud service.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04118 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04118">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">deployer user interface description</rdfs:label>
        <skos:definition xml:lang="en">A basic description of the user interface provided to the deployer for interacting with the model&apos;s outputs.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04119 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04119">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03376"/>
        <rdfs:label xml:lang="en">computational resources</rdfs:label>
        <skos:definition xml:lang="en">Describes the computational resources (e.g., processor type and count, memory, accelerators) used to develop, train, test, and validate the model, as distinct from the resources needed to apply it (see roadmap:03379, required processors).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04120 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04120">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">local acceptance-test procedure</rdfs:label>
        <skos:definition xml:lang="en">A recommended procedure by which a receiving site can verify the model&apos;s performance on local data before deployment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04121 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04121">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">operating range</rdfs:label>
        <skos:altLabel xml:lang="en">performance floor</skos:altLabel>
        <skos:definition xml:lang="en">A declared expected performance range or minimum performance floor, used to detect when the model&apos;s real-world performance has fallen outside acceptable bounds.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04122 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04122">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">suspend-use condition</rdfs:label>
        <skos:altLabel xml:lang="en">stop rule</skos:altLabel>
        <skos:definition xml:lang="en">A condition, such as a specific performance decline or an operational change, under which use of the model should be suspended.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04123 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04123">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:label xml:lang="en">performance provenance</rdfs:label>
        <skos:definition xml:lang="en">Indicates whether a reported performance value is claimed (self-reported by the developer, e.g. from internal or external testing) or observed (derived from real-world, deployed use, e.g. registry-reported concordance).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04124 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04124">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:label xml:lang="en">metric justification</rdfs:label>
        <skos:definition xml:lang="en">Explains why the metric(s) reported are appropriate measures of performance for this specific model and its intended use.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04125 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04125">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03482"/>
        <rdfs:label xml:lang="en">output type</rdfs:label>
        <skos:definition xml:lang="en">The general category of the value produced by the model as output, such as prediction, classification, recommendation, evaluation, or analysis.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04126 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04126">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">bias mitigation approach</rdfs:label>
        <skos:definition xml:lang="en">Describes the approach taken during model development to identify, manage, reduce, or eliminate bias, and to help ensure the model&apos;s output is fair across relevant subgroups.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04127 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04127">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">clinical risk level</rdfs:label>
        <skos:definition xml:lang="en">A declared level of clinical risk associated with use of the model, such as a risk classification scheme used by the developer or a relevant regulatory framework.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04128 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04128">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00122"/>
        <rdfs:label xml:lang="en">acquisition characteristic</rdfs:label>
        <skos:definition xml:lang="en">Describes the imaging acquisition equipment and parameters used to obtain a dataset&apos;s images, such as scanner manufacturer, model, field strength, detector configuration, slice thickness, or reconstruction kernel.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04129 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04129">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04128"/>
        <rdfs:label xml:lang="en">scanner manufacturer</rdfs:label>
        <skos:definition xml:lang="en">The manufacturer of the imaging equipment used to acquire the images, e.g. GE HealthCare, Siemens Healthineers, Philips, or Canon Medical.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04130 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04130">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04128"/>
        <rdfs:label xml:lang="en">scanner model</rdfs:label>
        <skos:definition xml:lang="en">The specific model of the imaging equipment used to acquire the images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04131 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04131">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04128"/>
        <rdfs:label xml:lang="en">field strength</rdfs:label>
        <skos:definition xml:lang="en">The static magnetic field strength of the MRI scanner used to acquire the images, typically expressed in tesla (T).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04132 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04132">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04128"/>
        <rdfs:label xml:lang="en">detector configuration</rdfs:label>
        <skos:definition xml:lang="en">The detector configuration of the imaging equipment used to acquire the images, such as the number of detector rows for CT.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04133 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04133">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04128"/>
        <rdfs:label xml:lang="en">slice thickness</rdfs:label>
        <skos:definition xml:lang="en">The thickness of the reconstructed image slices.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04134 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04134">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04128"/>
        <rdfs:label xml:lang="en">reconstruction kernel</rdfs:label>
        <skos:definition xml:lang="en">The reconstruction kernel or algorithm applied to raw acquisition data to produce the reconstructed images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04135 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04135">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">integration</rdfs:label>
        <skos:definition xml:lang="en">How an AI model is integrated into an imaging environment, expressed as interface standards (e.g. DICOM, DICOMweb, HL7, FHIR, IHE profiles) rather than named vendor products.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04136 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04136">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04135"/>
        <rdfs:label xml:lang="en">interfaces</rdfs:label>
        <skos:definition xml:lang="en">The interface standards a model supports for receiving input, being queried, and transporting data and results within an imaging environment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04137 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04137">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04136"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part04.html"/>
        <rdfs:label xml:lang="en">DICOM network service</rdfs:label>
        <skos:definition xml:lang="en">A DICOM network service that a model supports as an association requester or acceptor, as defined by the DICOM Standard PS3.4 (Service Class Specifications) and PS3.7 (Message Exchange).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04149 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04149">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04136"/>
        <dcterms:source rdf:resource="https://dicom.nema.org/medical/dicom/current/output/html/part18.html"/>
        <rdfs:label xml:lang="en">DICOMweb service</rdfs:label>
        <skos:definition xml:lang="en">A RESTful web service defined by the DICOMweb family of standards (DICOM PS3.18, Web Services) for querying, retrieving, or storing DICOM instances and metadata over HTTP.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04155 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04155">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04136"/>
        <dcterms:source rdf:resource="https://www.hl7.org/implement/standards/product_brief.cfm?product_id=185"/>
        <rdfs:label xml:lang="en">HL7 v2 message type</rdfs:label>
        <skos:definition xml:lang="en">A Health Level Seven Version 2 (HL7 v2) message type used to exchange clinical, administrative, or order/result data between systems.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04162 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04162">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04136"/>
        <dcterms:source rdf:resource="https://hl7.org/fhir/"/>
        <rdfs:label xml:lang="en">FHIR resource</rdfs:label>
        <skos:definition xml:lang="en">An HL7 FHIR (Fast Healthcare Interoperability Resources) resource type or related specification used to represent or exchange imaging AI-relevant data.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04173 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04173">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04136"/>
        <dcterms:source rdf:resource="https://www.ihe.net/resources/technical_frameworks/"/>
        <rdfs:label xml:lang="en">IHE Radiology integration profile</rdfs:label>
        <skos:definition xml:lang="en">An IHE (Integrating the Healthcare Enterprise) integration profile relevant to radiology and imaging AI workflows, specifying how systems use established standards to solve a specific interoperability problem.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04187 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04187">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04135"/>
        <rdfs:label xml:lang="en">result delivery channel</rdfs:label>
        <skos:definition xml:lang="en">A channel or object type by which an AI model&apos;s results are returned to the clinical environment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04202 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04202">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04135"/>
        <rdfs:label xml:lang="en">invocation trigger</rdfs:label>
        <skos:definition xml:lang="en">How execution of an AI model is triggered within an imaging workflow.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04210 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04210">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04135"/>
        <rdfs:label xml:lang="en">conformance statement</rdfs:label>
        <skos:definition xml:lang="en">A pointer to formal documentation describing a system&apos;s or model&apos;s conformance to an interoperability standard, preferred over prose description of interface support.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04211 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04211">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04210"/>
        <rdfs:label xml:lang="en">conformance statement type</rdfs:label>
        <skos:definition xml:lang="en">The type of formal conformance documentation describing a system&apos;s implementation of an interoperability standard.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04216 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04216">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04135"/>
        <rdfs:label xml:lang="en">clinical system type</rdfs:label>
        <skos:definition xml:lang="en">A category of clinical system with which an AI model exchanges data within an imaging environment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04227 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04227">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04135"/>
        <rdfs:label xml:lang="en">validated system</rdfs:label>
        <skos:definition xml:lang="en">A named product against which a model&apos;s integration has actually been tested.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04228 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04228">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03764"/>
        <rdfs:label xml:lang="en">pretraining</rdfs:label>
        <skos:altLabel xml:lang="en">pre-training</skos:altLabel>
        <skos:definition xml:lang="en">Pretraining: The initial, large-scale phase where a model learns general patterns (e.g., language structure, world knowledge) from massive unlabeled datasets, usually through self-supervised objectives like predicting the next token. This produces a general-purpose foundation model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04229 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04229">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03764"/>
        <rdfs:label xml:lang="en">fine-tuning</rdfs:label>
        <skos:definition xml:lang="en">Fine-tuning: Further training of a pretrained model on a smaller, task-specific or curated dataset to adapt it to a particular domain, task, or behavior. Examples include instruction tuning and reinforcement learning from human feedback (RLHF).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04230 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04230">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:comment xml:lang="en">Examples: convolutional neural network, vision transformer, large language model, diffusion model, foundation model, traditional machine learning, ensemble, hybrid.</rdfs:comment>
        <rdfs:label xml:lang="en">model class</rdfs:label>
        <skos:definition xml:lang="en">The general architectural or algorithmic category of a model (e.g. convolutional neural network, vision transformer, large language model), as a coarse, queryable category distinct from a free-text architecture description.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04231 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04231">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">foundation model</rdfs:label>
        <skos:definition xml:lang="en">A large pretrained model that a given model is built upon, fine-tuned from, or otherwise directly incorporates.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04232 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04232">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">third-party component</rdfs:label>
        <skos:definition xml:lang="en">A third-party or pretrained software component incorporated into a model, other than a foundation model captured separately, that is material to the model&apos;s behavior.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04233 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04233">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">maintenance</rdfs:label>
        <skos:definition xml:lang="en">Describes how a model&apos;s real-world performance and fairness are monitored after deployment, and the process by which the model is updated in response.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/04234 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/04234">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:label xml:lang="en">dataset use</rdfs:label>
        <skos:definition xml:lang="en">Associates a dataset with a model&apos;s development and the dataset&apos;s role in it (e.g. training, testing), or reciprocally associates a model with a dataset it uses.</skos:definition>
    </owl:Class>
    


