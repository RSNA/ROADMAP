        <skos:definition xml:lang="en">An item from the PROBAST+AI guideline for model evaluation.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00632 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00632">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00055"/>
        <rdfs:label xml:lang="es">número de series</rdfs:label>
        <rdfs:label xml:lang="en">series count</rdfs:label>
        <rdfs:label xml:lang="zh">系列计数</rdfs:label>
        <skos:altLabel xml:lang="en">number of series</skos:altLabel>
        <skos:altLabel xml:lang="es">número de series de imágenes</skos:altLabel>
        <skos:definition xml:lang="en">Number of imaging series. An examination comprises one or more imaging series, each of which has one or more images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00633 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00633">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00040"/>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03609"/>
        <rdfs:label xml:lang="es">administrador</rdfs:label>
        <rdfs:label xml:lang="en">administrator</rdfs:label>
        <rdfs:label xml:lang="zh">管理员</rdfs:label>
        <skos:altLabel xml:lang="en">healthcare administrator</skos:altLabel>
        <skos:definition xml:lang="en">A health care administrator.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/308050009"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00634 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00634">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1198/016214506000001437"/>
        <rdfs:label xml:lang="en">Brier skill score</rdfs:label>
        <rdfs:label xml:lang="zh">Brier 技能分数</rdfs:label>
        <rdfs:label xml:lang="es">puntuación de habilidad de Brier</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Brier_score"/>
        <skos:altLabel xml:lang="en">BSS</skos:altLabel>
        <skos:definition xml:lang="en">The Brier skill score is a normalized form of the Brier score that compares the predictive performance of a model to that of a reference forecast, such as the base rate probability. It is calculated as one minus the ratio of the model’s Brier score to the reference Brier score, producing positive values when the model outperforms the reference, zero when performance is equal, and negative values when performance is worse.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00657 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00657">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasGeneralMetadata"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasIndex"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00074"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">AI resource</rdfs:label>
        <skos:altLabel xml:lang="en">AI artefact</skos:altLabel>
        <skos:altLabel xml:lang="en">AI artifact</skos:altLabel>
        <skos:altLabel xml:lang="en">artefact</skos:altLabel>
        <skos:altLabel xml:lang="en">artifact</skos:altLabel>
        <skos:altLabel xml:lang="en">artificial intelligence artifact</skos:altLabel>
        <skos:altLabel xml:lang="en">artificial intelligence resource</skos:altLabel>
        <skos:altLabel xml:lang="en">artificial-intelligence resource</skos:altLabel>
        <skos:altLabel xml:lang="en">resource</skos:altLabel>
        <skos:definition xml:lang="en">An artificial intelligence model, dataset, or project.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00658 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00658">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00001"/>
        <rdfs:label xml:lang="en">information entity</rdfs:label>
        <skos:definition xml:lang="en">A ROADMAP entity that represents information, metadata, descriptors, values, or documentation about an AI resource.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00659 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00659">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00001"/>
        <rdfs:label xml:lang="en">evaluation entity</rdfs:label>
        <skos:definition xml:lang="en">A ROADMAP entity used to describe assessment, measurement, validation, or performance of an AI resource.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00660 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00660">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00001"/>
        <rdfs:label xml:lang="en">governance entity</rdfs:label>
        <skos:definition xml:lang="en">An entity, such as a guideline or ethical principle, used to make decisions about the development, evaluation, and application of AI technologies.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00661 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00661">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00001"/>
        <rdfs:comment xml:lang="en">Mapped to BFO Material entity.</rdfs:comment>
        <rdfs:comment xml:lang="en">Note the &apos;has value&apos; relations:
- AI resource: author, contributor, and organization
- dataset: annotator
- model / model metadata / model user: user</rdfs:comment>
        <rdfs:label xml:lang="en">agent</rdfs:label>
        <skos:definition xml:lang="en">A person, organization, or group that participates in developing, evaluating, deploying, using, or governing an AI resource.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00663 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00663">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03381"/>
        <rdfs:label xml:lang="en">technical entity</rdfs:label>
        <skos:definition xml:lang="en">A ROADMAP entity that represents computational, data-structural, file-format, imaging, or implementation-related concepts.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00664 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00664">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00001"/>
        <rdfs:label xml:lang="en">process</rdfs:label>
        <skos:definition xml:lang="en">A ROADMAP entity that represents an activity, workflow, task, or lifecycle step.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00665 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00665">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00666"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasCount"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00055"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03472"/>
        <rdfs:label xml:lang="en">partition</rdfs:label>
        <skos:definition xml:lang="en">A subdivision of a dataset used for training, validation, testing, demographic characterization, or other analytic purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00666 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00666">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00001"/>
        <rdfs:label xml:lang="en">data entity</rdfs:label>
        <skos:definition xml:lang="en">A ROADMAP entity that represents data or a subdivision of data used with an AI resource.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00669 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00669">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00672"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/confidenceLevel"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.95</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">CI-95</rdfs:comment>
        <rdfs:comment xml:lang="en">Confidence interval at 5% of type I error rate. If the number of observations made is large enough, the sampling distribution can be assumed to be normal, which entails that 95% of the sampling distributions falls within roughly 2 (1.96) standard deviations from the mean.</rdfs:comment>
        <rdfs:label xml:lang="en">95% confidence interval</rdfs:label>
        <skos:altLabel xml:lang="en">95% CI</skos:altLabel>
        <skos:altLabel xml:lang="en">CI 95</skos:altLabel>
        <skos:altLabel xml:lang="en">CI95</skos:altLabel>
        <skos:definition xml:lang="en">A confidence interval which covers 95% of the sampling distribution, meaning that there is a 5% risk of false positive (type I error).</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000231"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00672 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00672">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00666"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/lowerConfidenceLimit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/upperConfidenceLimit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/confidenceLevel"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">confidence interval</rdfs:label>
        <skos:altLabel xml:lang="en">CI</skos:altLabel>
        <skos:definition xml:lang="en">A range of values bounded by lower and upper confidence limits at a specified confidence level. If confidence level is not specified, it typically is 95%.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000196"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01005 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01005">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01021"/>
        <rdfs:comment xml:lang="en">Nationality is an international legal bond between an individual and a sovereign state. It dictates which country offers you diplomatic protection on the global stage and which country is legally required to accept your entry onto its territory. It is usually determined by birth, lineage, or naturalization. [1] (https://www.amacad.org/sites/default/files/academy/multimedia/pdfs/What-is-the-difference-between-nationality-and-citizenship_The-Economist-explains.pdf), [2] (https://www.greencardlink.com/citizenship-vs-nationality-differences/), [3] (https://ec.europa.eu/assets/home/emn-glossary/glossary.html?letters=c&amp;detail=citizenship), [4] (https://www.moneygram.com/blog/nationality-vs-citizenship-whats-the-difference)Citizenship is a narrower domestic political status. It dictates your explicit internal rights and obligations within that country. A citizen is a national who has been granted the full spectrum of local political franchise—such as the right to vote in federal elections, run for public office, or join restricted state civil services. [1] (https://www.henleyglobal.com/newsroom/industry-insights/citizen-vs-permanent-resident), [2] (https://www.amacad.org/sites/default/files/academy/multimedia/pdfs/What-is-the-difference-between-nationality-and-citizenship_The-Economist-explains.pdf), [3] (https://www.moneygram.com/blog/nationality-vs-citizenship-whats-the-difference), [4] (https://bcalawfirm.com/permanent-residence-vs-citizenship-explained/), [5] (https://www.youtube.com/watch?v=dRGmzY59-Wg)Note on Overlap: In most western countries (like France or Germany), everyone who holds nationality is automatically a citizen. However, exceptions exist. For example, individuals born in American Samoa hold US nationality (allowing them to carry a US passport and travel freely) but are not US citizens unless they naturalize, meaning they cannot vote in federal elections.</rdfs:comment>
        <rdfs:label xml:lang="en">nationality</rdfs:label>
        <skos:definition xml:lang="en">Nationality is an international legal bond between an individual and a sovereign state. It dictates which country offers you diplomatic protection on the global stage and which country is legally required to accept your entry onto its territory. It is usually determined by birth, lineage, or naturalization.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01006 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01006">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01021"/>
        <rdfs:comment xml:lang="en">Nationality is an international legal bond between an individual and a sovereign state. It dictates which country offers you diplomatic protection on the global stage and which country is legally required to accept your entry onto its territory. It is usually determined by birth, lineage, or naturalization. [1] (https://www.amacad.org/sites/default/files/academy/multimedia/pdfs/What-is-the-difference-between-nationality-and-citizenship_The-Economist-explains.pdf), [2] (https://www.greencardlink.com/citizenship-vs-nationality-differences/), [3] (https://ec.europa.eu/assets/home/emn-glossary/glossary.html?letters=c&amp;detail=citizenship), [4] (https://www.moneygram.com/blog/nationality-vs-citizenship-whats-the-difference)Citizenship is a narrower domestic political status. It dictates your explicit internal rights and obligations within that country. A citizen is a national who has been granted the full spectrum of local political franchise—such as the right to vote in federal elections, run for public office, or join restricted state civil services. [1] (https://www.henleyglobal.com/newsroom/industry-insights/citizen-vs-permanent-resident), [2] (https://www.amacad.org/sites/default/files/academy/multimedia/pdfs/What-is-the-difference-between-nationality-and-citizenship_The-Economist-explains.pdf), [3] (https://www.moneygram.com/blog/nationality-vs-citizenship-whats-the-difference), [4] (https://bcalawfirm.com/permanent-residence-vs-citizenship-explained/), [5] (https://www.youtube.com/watch?v=dRGmzY59-Wg)Note on Overlap: In most western countries (like France or Germany), everyone who holds nationality is automatically a citizen. However, exceptions exist. For example, individuals born in American Samoa hold US nationality (allowing them to carry a US passport and travel freely) but are not US citizens unless they naturalize, meaning they cannot vote in federal elections.</rdfs:comment>
        <rdfs:label xml:lang="en">citizenship</rdfs:label>
        <skos:definition xml:lang="en">Citizenship is a narrower domestic political status. It dictates your explicit internal rights and obligations within that country. A citizen is a national who has been granted the full spectrum of local political franchise—such as the right to vote in federal elections, run for public office, or join restricted state civil services.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01007 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01007">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01021"/>
        <rdfs:label xml:lang="en">country of birth</rdfs:label>
        <skos:definition xml:lang="en">Country of origin or birth tracks where an individual or their parents were born. This is the most common demographic proxy used across continental Europe to measure migration backgrounds and health disparities without asking for racial identity.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/315354004"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01010 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01010">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01021"/>
        <rdfs:label xml:lang="en">country of origin</rdfs:label>
        <skos:definition xml:lang="en">Country of origin or birth tracks where an individual or their parents were born. This is the most common demographic proxy used across continental Europe to measure migration backgrounds and health disparities without asking for racial identity.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/276205001"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01011 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01011">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03565"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00424"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00549"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00550"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">race and ethnicity information</rdfs:label>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01013 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01013">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01011"/>
        <dcterms:source rdf:resource="https://www.federalregister.gov/d/97-28653"/>
        <rdfs:comment xml:lang="en">Retained alongside :03441 because the two-question format remains in force in USCDI and in essentially all retrospective clinical data. Aggregating 1997 race and ethnicity into the 2024 combined categories is lossy and is not asserted here.</rdfs:comment>
        <rdfs:label xml:lang="en">race</rdfs:label>
        <skos:definition xml:lang="en">Race of the individual as collected separately from ethnicity, per the 1997 OMB Statistical Policy Directive 15. Values are the five CDCREC race categories.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01014 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01014">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01011"/>
        <dcterms:source rdf:resource="https://www.federalregister.gov/d/97-28653"/>
        <rdfs:label xml:lang="en">ethnicity</rdfs:label>
        <skos:definition xml:lang="en">Ethnicity of the individual as collected separately from race, per the 1997 OMB Statistical Policy Directive 15. Values are the two CDCREC ethnicity categories.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01021 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01021">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03565"/>
        <rdfs:label xml:lang="en">nation-related information</rdfs:label>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01030 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01030">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00658"/>
        <rdfs:label xml:lang="en">coding system</rdfs:label>
        <skos:definition xml:lang="en">An ontology or controlled vocabulary.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01039 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01039">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04058"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03759"/>
        <rdfs:label xml:lang="en">classification metric</rdfs:label>
        <skos:definition xml:lang="en">A metric that measures classification performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01040 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01040">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04055"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:label xml:lang="en">macro-averaged classification metric</rdfs:label>
        <skos:definition xml:lang="en">A metric that measures macro-averaged classification performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01041 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01041">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04054"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:label xml:lang="en">micro-averaged classification metric</rdfs:label>
        <skos:definition xml:lang="en">A metric that measures micro-averaged classification performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01042 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01042">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00145"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03759"/>
        <rdfs:label xml:lang="en">clustering metric</rdfs:label>
        <skos:definition xml:lang="en">A metric that measures clustering performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01043 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01043">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04064"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03759"/>
        <rdfs:label xml:lang="en">fairness metric</rdfs:label>
        <skos:definition xml:lang="en">A metric that measures fairness.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01044 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01044">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00138"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03759"/>
        <rdfs:label xml:lang="en">image generation metric</rdfs:label>
        <skos:definition xml:lang="en">A metric that measures image generation performance.</skos:definition>
    </owl:Class>
    


