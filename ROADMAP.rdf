        <skos:definition xml:lang="en">An item from the PROBAST+AI guideline for model development.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00613 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00613">
