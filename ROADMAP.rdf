        <rdfs:comment xml:lang="en">Note that this value differs from the OMB 2024 &quot;Hispanic or Latino&quot; race/ethnicity category.</rdfs:comment>
        <rdfs:label xml:lang="en">Not Hispanic or Latino - ethnicity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01016 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01016">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03441"/>
        <rdfs:comment xml:lang="en">Note that this value is part of the OMB 2024 combined race/ethnicity classification, and may encode different individuals from the &quot;Ethnicity Hispanic or Latino&quot; value from the OMB 1997 two-question classification.</rdfs:comment>
        <rdfs:label xml:lang="en">Hispanic or Latino</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01017 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01017">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03441"/>
        <rdfs:label xml:lang="en">American Indian or Alaska Native</rdfs:label>
        <skos:definition xml:lang="en">A combined race/ethnicity category defined by OMB 2024.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01018 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01018">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03441"/>
        <rdfs:label xml:lang="en">Asian</rdfs:label>
        <skos:definition xml:lang="en">A combined race/ethnicity category defined by OMB 2024.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01019 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01019">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03441"/>
        <rdfs:label xml:lang="en">Black or African American</rdfs:label>
        <skos:definition xml:lang="en">A combined race/ethnicity category defined by OMB 2024.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01020 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01020">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03441"/>
        <rdfs:label xml:lang="en">White</rdfs:label>
        <skos:definition xml:lang="en">A combined race/ethnicity category defined by OMB 2024.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01022 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01022">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03432"/>
        <rdfs:label xml:lang="en">female gender</rdfs:label>
        <skos:definition xml:lang="en">Identifies as female gender.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/446141000124107"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/446141000124107"/>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01023 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01023">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03432"/>
        <rdfs:label xml:lang="en">male gender</rdfs:label>
        <skos:definition xml:lang="en">Identifies as male gender.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/446151000124109"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/446151000124109"/>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01024 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01024">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03432"/>
        <rdfs:label xml:lang="en">non-binary gender</rdfs:label>
        <skos:altLabel xml:lang="en">gender non-binary</skos:altLabel>
        <skos:definition xml:lang="en">Identifies as non-binary gender.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/33791000087105"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/33791000087105"/>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01025 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01025">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03432"/>
        <rdfs:label xml:lang="en">gender non-conforming</rdfs:label>
        <skos:altLabel xml:lang="en">gender queer</skos:altLabel>
        <skos:altLabel xml:lang="en">genderqueer</skos:altLabel>
        <skos:altLabel xml:lang="en">queer</skos:altLabel>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/446131000124102"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/446131000124102"/>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01026 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01026">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03432"/>
        <rdfs:label xml:lang="en">transgender female</rdfs:label>
        <skos:altLabel xml:lang="en">MTF transgender</skos:altLabel>
        <skos:altLabel xml:lang="en">male-to-female transgender</skos:altLabel>
        <skos:altLabel xml:lang="en">trans female</skos:altLabel>
        <skos:altLabel xml:lang="en">trans woman</skos:altLabel>
        <skos:definition xml:lang="en">Transgender female (male-to-female).</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/407376001"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/407376001"/>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01027 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01027">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03432"/>
        <rdfs:label xml:lang="en">transgender male</rdfs:label>
        <skos:altLabel xml:lang="en">FTM transgender</skos:altLabel>
        <skos:altLabel xml:lang="en">female-to-male transgender</skos:altLabel>
        <skos:altLabel xml:lang="en">trans male</skos:altLabel>
        <skos:altLabel xml:lang="en">trans man</skos:altLabel>
        <skos:definition xml:lang="en">Transgender male (female-to-male).</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/407377005"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/407377005"/>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01028 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01028">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03432"/>
        <rdfs:comment xml:lang="en">Value = HL7 Null Flavor OTH.</rdfs:comment>
        <rdfs:label xml:lang="en">additional gender category or other</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01029 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01029">
        <rdf:type rdf:resource="https://rsna.org/roadmap/03432"/>
        <rdfs:comment xml:lang="en">Value = HL7 Null Flavor ASKU (asked but unknown)</rdfs:comment>
        <rdfs:label xml:lang="en">choose not to disclose</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://isp.healthit.gov/uscdi-data/gender-identity"/>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01100 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01100">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://disease-ontology.org/"/>
        <dcterms:source rdf:resource="https://www.ebi.ac.uk/ols4/ontologies/doid"/>
        <rdfs:label xml:lang="en">DO</rdfs:label>
        <skos:altLabel xml:lang="en">DOID</skos:altLabel>
        <skos:altLabel xml:lang="en">Disease Ontology</skos:altLabel>
        <skos:altLabel xml:lang="en">Human Disease Ontology</skos:altLabel>
        <skos:definition xml:lang="en">The Disease Ontology is a standardized, open-source classification system for human diseases organized by etiology (cause), symptoms, and medical vocabulary. Uses unique IDs (like DOID:10652 for Alzheimer&apos;s disease).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01101 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01101">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://bioportal.bioontology.org/ontologies/GAMUTS"/>
        <rdfs:label xml:lang="en">Gamuts</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://gamuts.net/"/>
        <skos:altLabel xml:lang="en">RGO</skos:altLabel>
        <skos:altLabel xml:lang="en">Radiology Gamuts Ontology</skos:altLabel>
        <skos:definition xml:lang="en">The Radiology Gamuts Ontology (RGO) is a knowledge resource for radiology diagnosis. RGO hosts more than 2,000 differential-diagnosis listings for imaging findings in all body systems.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01102 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01102">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://hpo.jax.org/"/>
        <rdfs:label xml:lang="en">HPO</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.ebi.ac.uk/ols4/ontologies/hp"/>
        <skos:altLabel xml:lang="en">Human Phenotype Ontology</skos:altLabel>
        <skos:definition xml:lang="en">The Human Phenotype Ontology (HPO) is a standardized, hierarchical vocabulary of phenotypic abnormalities encountered in human disease, developed to support differential diagnosis, translational research, and computational analysis of phenotype data.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01103 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01103">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://icd.who.int/browse10/2019/en"/>
        <rdfs:label xml:lang="en">ICD-10</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.cdc.gov/nchs/icd/icd-10-cm.htm"/>
        <skos:altLabel xml:lang="en">International Classification of Diseases, 10th Revision</skos:altLabel>
        <skos:definition xml:lang="en">The International Classification of Diseases, 10th Revision (ICD-10) is the World Health Organization&apos;s standard diagnostic classification, used to code diseases, signs and symptoms, and external causes of injury for epidemiology, health management, and clinical purposes.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01104 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01104">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://icd.who.int/en"/>
        <rdfs:label xml:lang="en">ICD-11</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://icd.who.int/browse/2024-01/mms/en"/>
        <skos:altLabel xml:lang="en">International Classification of Diseases, 11th Revision</skos:altLabel>
        <skos:definition xml:lang="en">The International Classification of Diseases, 11th Revision (ICD-11) is the World Health Organization&apos;s current standard diagnostic classification, providing a fully digital, multilingual coding system for mortality, morbidity, and clinical documentation that supersedes ICD-10.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01105 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01105">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://loinc.org/"/>
        <rdfs:label xml:lang="en">LOINC</rdfs:label>
        <skos:definition xml:lang="en">LOINC (Logical Observation Identifiers Names and Codes) is the universal international standard for identifying health measurements, observations, and documents.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01106 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01106">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://www.fda.gov/drugs/drug-approvals-and-databases/national-drug-code-directory"/>
        <rdfs:label xml:lang="en">NDC</rdfs:label>
        <skos:altLabel xml:lang="en">National Drug Code</skos:altLabel>
        <skos:definition xml:lang="en">The National Drug Code (NDC) is the U.S. Food and Drug Administration&apos;s unique, three-segment numeric identifier assigned to every drug product marketed in the United States, identifying its labeler, product, and trade package.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01107 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01107">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://cde.nlm.nih.gov/"/>
        <rdfs:label xml:lang="en">NIH CDE</rdfs:label>
        <skos:altLabel xml:lang="en">NIH Common Data Elements</skos:altLabel>
        <skos:altLabel xml:lang="en">NLM CDE</skos:altLabel>
        <skos:altLabel xml:lang="en">National Institutes of Health Common Data Elements</skos:altLabel>
        <skos:definition xml:lang="en">The U.S. National Institutes of Health (NIH) CDE Repository is hosted and maintained by the National Library of Medicine (NLM). Common Data Elements (CDEs) are data elements (or variables) that are defined and used the same way across multiple studies, to standardize the way data is collected.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01108 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01108">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://radelement.org/"/>
        <rdfs:label xml:lang="en">RadElement</rdfs:label>
        <skos:altLabel xml:lang="en">radiology CDEs</skos:altLabel>
        <skos:altLabel xml:lang="en">radiology common data elements</skos:altLabel>
        <skos:definition>The RadElement.org site offers a catalog of radiology Common Data Elements (CDEs), indexed by title and controlled terms such as SNOMED CT, LOINC, and RadLex. CDEs define the attributes and allowable values of a unit of information, so that information can be collected and stored uniformly across institutions and studies.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01109 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01109">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://radlex.org/"/>
        <rdfs:label xml:lang="en">RadLex</rdfs:label>
        <skos:definition xml:lang="en">RadLex is a comprehensive lexicon of radiology terms developed and maintained by the Radiological Society of North America (RSNA) to provide a standardized vocabulary for indexing, retrieving, and exchanging radiology information, including imaging observations, anatomy, and procedures.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01110 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01110">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://www.nlm.nih.gov/research/umls/rxnorm/index.html"/>
        <rdfs:label xml:lang="en">RxNorm</rdfs:label>
        <skos:definition xml:lang="en">RxNorm is a normalized naming system for generic and branded clinical drugs, produced by the U.S. National Library of Medicine, that provides standardized names and unique identifiers to support interoperability among drug vocabularies used in pharmacy management and drug interaction systems.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01111 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01111">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://www.snomed.org/"/>
        <rdfs:label xml:lang="en">SNOMED CT</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://browser.ihtsdotools.org/"/>
        <skos:altLabel xml:lang="en">Systematized Nomenclature of Medicine Clinical Terms</skos:altLabel>
        <skos:definition xml:lang="en">SNOMED CT (Systematized Nomenclature of Medicine—Clinical Terms) is a comprehensive, multilingual clinical terminology maintained by SNOMED International that provides standardized codes, terms, and definitions for electronic health records, covering clinical findings, procedures, and other health-related concepts.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01112 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01112">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://www.ama-assn.org/practice-management/cpt"/>
        <rdfs:label xml:lang="en">CPT</rdfs:label>
        <skos:altLabel xml:lang="en">Current Procedural Terminology</skos:altLabel>
        <skos:definition xml:lang="en">The Current Procedural Terminology (CPT) code set is a procedural code set developed by the American Medical Association (AMA). The CPT code set describes medical, surgical, and diagnostic services and is designed to communicate uniform information about medical services and procedures among physicians, coders, patients, accreditation organizations, and payers for administrative, financial, and analytical purposes.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01113 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01113">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://bioportal.bioontology.org/ontologies/FMA"/>
        <rdfs:label xml:lang="en">FMA</rdfs:label>
        <skos:altLabel xml:lang="en">Foundational Model of Anatomy</skos:altLabel>
        <skos:definition xml:lang="en">FMA is a domain ontology that represents a coherent body of explicit declarative knowledge about human anatomy.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01114 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01114">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://www.who.int/standards/classifications/other-classifications/international-classification-of-diseases-for-oncology"/>
        <rdfs:label xml:lang="en">ICD-O-3</rdfs:label>
        <skos:altLabel xml:lang="en">International Classification of Diseases for Oncology, 3rd Edition</skos:altLabel>
        <skos:definition xml:lang="en">International Classification of Diseases for Oncology, 3rd Edition (ICD-O-3), is used principally in tumor or cancer registries for coding the site (topography) and the histology (morphology) of neoplasms, usually obtained from a pathology report. ICD-O is a multi-axial classification of the site, morphology, behavior, and grading of neoplasms.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01115 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01115">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://evsexplore.semantics.cancer.gov/evsexplore/welcome?terminology=ncit"/>
        <rdfs:label xml:lang="en">NCIt</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://wiki.nci.nih.gov/x/lAVy"/>
        <skos:altLabel xml:lang="en">NCI Thesaurus</skos:altLabel>
        <skos:altLabel xml:lang="en">National Cancer Institute Thesaurus</skos:altLabel>
        <skos:definition xml:lang="en">NCI Thesaurus (NCIt) provides reference terminology for many NCI and other systems. It covers vocabulary for clinical care, translational and basic research, and public information and administrative activities.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01116 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01116">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01030"/>
        <dcterms:source rdf:resource="https://obophenotype.github.io/uberon/"/>
        <rdfs:label xml:lang="en">UBERON</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <skos:altLabel xml:lang="en">Uber-anatomy Ontology</skos:altLabel>
        <skos:definition xml:lang="en">Uberon is an integrated cross-species anatomy ontology representing a variety of entities classified according to traditional anatomical criteria such as structure, function and developmental lineage. The ontology includes comprehensive relationships to taxon-specific anatomical ontologies, allowing integration of functional, phenotype and expression data.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01117 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01117">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04173"/>
        <dcterms:source rdf:resource="https://profiles.ihe.net/RAD/IRA/"/>
        <rdfs:label xml:lang="en">IRA (Integrated Reporting Applications)</rdfs:label>
        <skos:definition xml:lang="en">The Integrated Reporting Applications (IRA) Profile helps applications that are used together during reporting (e.g., image display, report creator, clinical applications, AI tools, etc.) to share information using a standard called FHIRcast.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01120 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01120">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04123"/>
        <rdfs:label xml:lang="en">claimed performance provenance</rdfs:label>
        <skos:altLabel xml:lang="en">claimed</skos:altLabel>
        <skos:definition xml:lang="en">Claimed: self-reported by the developer, e.g. from internal or external testing.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01121 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01121">
        <rdf:type rdf:resource="https://rsna.org/roadmap/04123"/>
        <rdfs:label xml:lang="en">observed performance provenance</rdfs:label>
        <skos:altLabel xml:lang="en">observed</skos:altLabel>
        <skos:definition xml:lang="en">Observed: derived from real-world, deployed use, e.g. registry-reported concordance.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01124 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01124">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01123"/>
        <rdfs:label xml:lang="en">internal test type</rdfs:label>
        <skos:altLabel xml:lang="en">internal</skos:altLabel>
        <skos:altLabel xml:lang="en">internal testing</skos:altLabel>
        <skos:definition xml:lang="en">Internal: evaluation on data drawn from the same source or sources as the development data and held out from training, such as a random, patient-level or temporal split of a single institution&apos;s cohort.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01125 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01125">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01123"/>
        <rdfs:label xml:lang="en">external test type</rdfs:label>
        <skos:altLabel xml:lang="en">external</skos:altLabel>
        <skos:altLabel xml:lang="en">external testing</skos:altLabel>
        <skos:definition xml:lang="en">External: evaluation on data from one or more sources not used in development — a different institution, region, population or scanner fleet — and not available to the developer during model training or tuning.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01126 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01126">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01123"/>
        <rdfs:label xml:lang="en">local test type</rdfs:label>
        <skos:altLabel xml:lang="en">local</skos:altLabel>
        <skos:altLabel xml:lang="en">local testing</skos:altLabel>
        <skos:altLabel xml:lang="en">site acceptance testing</skos:altLabel>
        <skos:definition xml:lang="en">Local: evaluation performed by a deploying site on data from that site, typically as acceptance testing before deployment or as ongoing monitoring after it.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/01127 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/01127">
        <rdf:type rdf:resource="https://rsna.org/roadmap/01123"/>
        <rdfs:label xml:lang="en">prospective test type</rdfs:label>
        <skos:altLabel xml:lang="en">prospective</skos:altLabel>
        <skos:altLabel xml:lang="en">prospective testing</skos:altLabel>
        <skos:definition xml:lang="en">Prospective: evaluation on data acquired after the model was finalized and collected in the intended clinical workflow, rather than assembled from a retrospective archive.</skos:definition>
    </owl:NamedIndividual>
    


