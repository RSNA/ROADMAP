    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    


    <!-- https://rsna.org/roadmap/evaluatesPerformanceOn -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/evaluatesPerformanceOn">
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03832"/>
        <rdfs:comment xml:lang="en">was :03833</rdfs:comment>
        <rdfs:label xml:lang="en">evaluates performance on</rdfs:label>
        <skos:definition xml:lang="en">References the evaluation dataset used to assess a model&apos;s performance.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/guidelineItemSupportsPrinciple -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/guidelineItemSupportsPrinciple">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/supportsPrinciple"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00177"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03805"/>
        <rdfs:comment xml:lang="en">Not currently used.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03920</rdfs:comment>
        <rdfs:label xml:lang="en">guideline item supports principle</rdfs:label>
        <skos:definition xml:lang="en">A sub-property of &quot;supports&quot; that links a guideline item to an ethical principle: &quot;A manuscript satisfying this item advances this principle.&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasAgeUnit -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasAgeUnit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03423"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03467"/>
        <rdfs:comment xml:lang="en">was :03848</rdfs:comment>
        <rdfs:label xml:lang="en">has age unit</rdfs:label>
        <skos:definition xml:lang="en">Specifies the units for a stated age.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasAxis -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasAxis">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:comment xml:lang="en">was :00159</rdfs:comment>
        <rdfs:label xml:lang="en">has axis</rdfs:label>
        <skos:definition xml:lang="en">Specifies an axis for graphical metrics.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasConfidenceInterval -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasConfidenceInterval">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00672"/>
        <rdfs:comment xml:lang="en">was :03849</rdfs:comment>
        <rdfs:label xml:lang="en">has confidence interval</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasCount -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasCount">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00055"/>
        <rdfs:comment xml:lang="en">was :00130</rdfs:comment>
        <rdfs:label xml:lang="en">has count</rdfs:label>
        <skos:altLabel xml:lang="en">hasCount</skos:altLabel>
        <skos:definition xml:lang="en">Specifies the number of patients, images, etc. for a subset or partition.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasData -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasData">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasPart"/>
        <rdfs:comment xml:lang="en">was :03862</rdfs:comment>
        <rdfs:label xml:lang="en">has data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasDataset -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasDataset">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasPart"/>
        <owl:inverseOf rdf:resource="https://rsna.org/roadmap/isDatasetOf"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00010"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00003"/>
        <rdfs:comment xml:lang="en">was :00115</rdfs:comment>
        <rdfs:label xml:lang="en">has dataset</rdfs:label>
        <skos:definition xml:lang="en">The property that links a Project to its related Dataset(s).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasDatasetProperty -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasDatasetProperty">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasResourceMetadata"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00003"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03381"/>
        <rdfs:comment xml:lang="en">was :03382</rdfs:comment>
        <rdfs:label xml:lang="en">has dataset property</rdfs:label>
        <skos:definition xml:lang="en">Links a dataset to its properties.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasEthicalPrinciple -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasEthicalPrinciple">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasItem"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03809"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00248"/>
        <rdfs:comment xml:lang="en">was :03841</rdfs:comment>
        <rdfs:label xml:lang="en">has ethical principle</rdfs:label>
        <skos:definition xml:lang="en">Links an ethical framework (e.g., FUTURE-AI) to its principles.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasGeneralMetadata -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasGeneralMetadata">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasResourceMetadata"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00657"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00004"/>
        <rdfs:comment xml:lang="en">was :00116</rdfs:comment>
        <rdfs:label xml:lang="en">has general metadata</rdfs:label>
        <skos:altLabel xml:lang="en">has descriptor</skos:altLabel>
        <skos:definition xml:lang="en">Links a model, dataset, or project to its general metadata.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasGuidelineItem -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasGuidelineItem">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasItem"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00174"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00177"/>
        <rdfs:comment xml:lang="en">was :03776</rdfs:comment>
        <rdfs:label xml:lang="en">has guideline item</rdfs:label>
        <skos:definition xml:lang="en">Links a guideline (e.g., CLAIM) to its items.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasIndex -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasIndex">
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00657"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00074"/>
        <rdfs:comment xml:lang="en">was :03831</rdfs:comment>
        <rdfs:label xml:lang="en">has index</rdfs:label>
        <skos:definition xml:lang="en">Links an AI resource to indexing code(s).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasItem -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasItem">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://rsna.org/roadmap/isItemOf"/>
        <rdfs:comment xml:lang="en">was :03840</rdfs:comment>
        <rdfs:label xml:lang="en">has item</rdfs:label>
        <skos:definition xml:lang="en">Links a guideline (e.g., CLAIM) to its items or an ethical framework (e.g., FAIR) to its principles.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasMetric -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasMetric">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03642"/>
        <oboInOwl:hasRelatedSynonym xml:lang="en">has performance</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="en">This property links a model to one or more model performance metrics.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03709</rdfs:comment>
        <rdfs:label xml:lang="en">has metric</rdfs:label>
        <skos:definition xml:lang="en">Defines a relationship between a model and the metrics that describe its performance.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasModel -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasModel">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasPart"/>
        <owl:inverseOf rdf:resource="https://rsna.org/roadmap/isModelOf"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00010"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00002"/>
        <rdfs:comment xml:lang="en">was :00114</rdfs:comment>
        <rdfs:label xml:lang="en">has model</rdfs:label>
        <skos:definition xml:lang="en">The property that links a Project to its related Model(s).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasModelProperty -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasModelProperty">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasResourceMetadata"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00002"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:comment xml:lang="en">was :03350</rdfs:comment>
        <rdfs:label xml:lang="en">has model property</rdfs:label>
        <skos:definition xml:lang="en">Links a model to its properties.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasOutcomeCount -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasOutcomeCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03548"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/04090"/>
        <rdfs:comment xml:lang="en">was :01128</rdfs:comment>
        <rdfs:label xml:lang="en">has outcome count</rdfs:label>
        <skos:definition xml:lang="en">Links a confusion matrix to cell counts (e.g., true positive count), marginal subtotals (e.g., condition positive count), and total outcome count.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasPart -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasPart">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://rsna.org/roadmap/isPartOf"/>
        <rdfs:comment xml:lang="en">The &apos;has dataset&apos; and &apos;has model&apos; relations are subtypes of &quot;has part&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :00201</rdfs:comment>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <skos:altLabel xml:lang="en">hasPart</skos:altLabel>
        <skos:definition xml:lang="en">Links a class to those classes that may comprise it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasResourceMetadata -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasResourceMetadata">
        <rdfs:comment xml:lang="en">was :03865</rdfs:comment>
        <rdfs:label xml:lang="en">has resource metadata</rdfs:label>
        <skos:definition xml:lang="en">Links an AI resource to its metadata.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasRole -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasRole">
        <owl:inverseOf rdf:resource="https://rsna.org/roadmap/isRoleFor"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00003"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00665"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03472"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03763"/>
        <rdfs:comment xml:lang="en">For example, this relation allows &apos;training partition&apos; to be defined as equivalent to a partition that &apos;has role&apos; training.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03769</rdfs:comment>
        <rdfs:label xml:lang="en">has role</rdfs:label>
        <skos:definition xml:lang="en">For a dataset, or partition or subset thereof, this relation Identifies its role in development of an AI model, such as training or testing.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasScalarMetric -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasScalarMetric">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://rsna.org/roadmap/isScalarMetricFor"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03778"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:comment xml:lang="en">was :03645</rdfs:comment>
        <rdfs:label xml:lang="en">has scalar metric</rdfs:label>
        <skos:altLabel xml:lang="en">hasScalarMetric</skos:altLabel>
        <skos:definition xml:lang="en">This property links a graphical metric (e.g., an ROC curve) or a matrix metric to a scalar metric (e.g., AUROC).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasUse -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasUse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00015"/>
        <rdfs:comment xml:lang="en">was :00629</rdfs:comment>
        <rdfs:label xml:lang="en">has use</rdfs:label>
        <skos:altLabel xml:lang="en">hasUse</skos:altLabel>
        <skos:definition xml:lang="en">Specifies a model&apos;s types of intended, out-of-scope, and/or excluded uses.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasUser -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasUser">
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00040"/>
        <rdfs:comment xml:lang="en">was :00630</rdfs:comment>
        <rdfs:label xml:lang="en">has user</rdfs:label>
        <skos:altLabel xml:lang="en">hasUser</skos:altLabel>
        <skos:definition xml:lang="en">Specifies a model&apos;s types of intended, out-of-scope, and/or excluded users.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasValue -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:comment xml:lang="en">was :00631</rdfs:comment>
        <rdfs:label xml:lang="en">has value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasXAxis -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasXAxis">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasAxis"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:comment xml:lang="en">was :00157</rdfs:comment>
        <rdfs:label xml:lang="en">has x-axis</rdfs:label>
        <skos:altLabel xml:lang="en">x-axis</skos:altLabel>
        <skos:definition xml:lang="en">References the x-axis of a graphical metric.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/hasYAxis -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/hasYAxis">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/hasAxis"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:comment xml:lang="en">was :00158</rdfs:comment>
        <rdfs:label xml:lang="en">has y-axis</rdfs:label>
        <skos:altLabel xml:lang="en">y-axis</skos:altLabel>
        <skos:definition xml:lang="en">References the y-axis of a graphical metric.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/isDatasetOf -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/isDatasetOf">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/isPartOf"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00003"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00010"/>
        <rdfs:comment xml:lang="en">was :03863</rdfs:comment>
        <rdfs:label xml:lang="en">is dataset of</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &quot;has dataset&quot;: it links a dataset to its project.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/isItemOf -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/isItemOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment xml:lang="en">was :04089</rdfs:comment>
        <rdfs:label xml:lang="en">is item of</rdfs:label>
        <skos:altLabel xml:lang="en">belongs to</skos:altLabel>
        <skos:altLabel xml:lang="en">belongsTo</skos:altLabel>
        <skos:definition xml:lang="en">Links a guideline item (e.g., CLAIM item 01) to its guideline or an ethical principle to its framework (e.g., findability to FAIR).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/isMeasuredBy -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/isMeasuredBy">
        <owl:inverseOf rdf:resource="https://rsna.org/roadmap/measures"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03642"/>
        <rdfs:comment xml:lang="en">was :03719</rdfs:comment>
        <rdfs:label xml:lang="en">is measured by</rdfs:label>
        <skos:altLabel xml:lang="en">isMeasuredBy</skos:altLabel>
        <skos:definition xml:lang="en">Inverse of &quot;measures&quot; relation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/isModelOf -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/isModelOf">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/isPartOf"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00002"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00010"/>
        <rdfs:comment xml:lang="en">was :03864</rdfs:comment>
        <rdfs:label xml:lang="en">is model of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/isPartOf -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/isPartOf">
        <rdfs:comment xml:lang="en">May be used to indicate the project to which a model or dataset belongs.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03777</rdfs:comment>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &quot;has part&quot; relation. Indicates the target class to which the subject belongs.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/isRoleFor -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/isRoleFor">
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03763"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00003"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00665"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03472"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">was :03770</rdfs:comment>
        <rdfs:label xml:lang="en">is role for</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &quot;has role&quot;: specifies the use (training, testing, etc.) of a dataset or part thereof.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/isScalarMetricFor -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/isScalarMetricFor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03778"/>
        <rdfs:comment xml:lang="en">was :03628</rdfs:comment>
        <rdfs:label xml:lang="en">is scalar metric for</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &quot;has scalar metric&quot; relation: links a scalar metric to associated graphical metric(s) and/or matrix metric(s).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/isSupportedBy -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/isSupportedBy">
        <owl:inverseOf rdf:resource="https://rsna.org/roadmap/supports"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00177"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03805"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00177"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03788"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Indicates a metadata class or guideline-item instance that helps satisfy, operationalize, or support a guideline item or ethical principle.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :00222</rdfs:comment>
        <rdfs:label xml:lang="en">is supported by</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &quot;supports&quot; relation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/measures -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/measures">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03642"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:comment xml:lang="en">Inverse relation &quot;is measured by&quot;</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03648</rdfs:comment>
        <rdfs:label xml:lang="en">measures</rdfs:label>
        <skos:altLabel xml:lang="en">metric for</skos:altLabel>
        <skos:altLabel xml:lang="en">metricFor</skos:altLabel>
        <skos:definition xml:lang="en">Expresses the relationship between a model performance metric and the performance criterion that it measures. For example, Dice coefficient measures image segmentation performance.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/metadataSupportsPrinciple -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/metadataSupportsPrinciple">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/supportsPrinciple"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03788"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03805"/>
        <rdfs:comment xml:lang="en">Not currently used.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03921</rdfs:comment>
        <rdfs:label xml:lang="en">metadata supports principle</rdfs:label>
        <skos:definition xml:lang="en">A sub-property of &quot;supports&quot; that links metadata directly to an ethical principle: &quot;Recording this attribute advances the principle regardless of any manuscript.&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/supports -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/supports">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00177"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03788"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00177"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03805"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Examples: 
- &apos;TRAM-AI item A1&apos; supports findability
- &apos;annotation level&apos; supports &apos;CLAIM item 03&apos;</rdfs:comment>
        <rdfs:comment xml:lang="en">The &quot;supports&quot; relation is expressed two different ways: as ABox triples on guideline-item individuals (item → principle) and as TBox hasValue restrictions on metadata classes (metadata class → item or principle).

Note that this property is *not* transitive: some guideline items are disjunctions (&quot;A or B&quot;). For example, AI resource metadata M may support A while B supports ethical principle P, so it would be incorrect to infer that M supports P.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :00198</rdfs:comment>
        <rdfs:label xml:lang="en">supports</rdfs:label>
        <skos:definition xml:lang="en">Relates a metadata entity or guideline item to a guideline item or ethical principle that it helps satisfy, operationalize, or support.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/supportsGuidelineItem -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/supportsGuidelineItem">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/supports"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03788"/>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/00177"/>
        <rdfs:comment xml:lang="en">Not currently used.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03918</rdfs:comment>
        <rdfs:label xml:lang="en">supports guideline item</rdfs:label>
        <skos:definition xml:lang="en">A sub-property of &quot;supports&quot; that links a metadata entity (an AI resource attribute) to a guideline item: &quot;Recording this artifact attribute supplies the evidence a manuscript needs to satisfy this reporting item.&quot;</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://rsna.org/roadmap/supportsPrinciple -->

    <owl:ObjectProperty rdf:about="https://rsna.org/roadmap/supportsPrinciple">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/supports"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00177"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03788"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://rsna.org/roadmap/03805"/>
        <rdfs:comment xml:lang="en">Not currently used.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03919</rdfs:comment>
        <rdfs:label xml:lang="en">supports principle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2002/07/owl#topDataProperty -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2002/07/owl#topDataProperty"/>
    


    <!-- https://rsna.org/roadmap/ageRangeValues -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/ageRangeValues">
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03462"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">was :03844</rdfs:comment>
        <rdfs:label xml:lang="en">age range values</rdfs:label>
        <skos:definition xml:lang="en">An age range&apos;s lower and upper bounds.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/confidenceIntervalProperty -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/confidenceIntervalProperty">
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00672"/>
        <rdfs:comment xml:lang="en">was :03839</rdfs:comment>
        <rdfs:label xml:lang="en">confidence interval property</rdfs:label>
        <skos:definition xml:lang="en">A confidence interval is defined by a lower limit, upper limit, and confidence level.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/confidenceLevel -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/confidenceLevel">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/confidenceIntervalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00672"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">was :01500</rdfs:comment>
        <rdfs:label xml:lang="en">confidence level</rdfs:label>
        <skos:definition xml:lang="en">The probability that the confidence interval contains the true parameter value, expressed as a proportion. For example, confidence level = 0.95 for the 95% confidence interval.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/hasDateValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/hasDateValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">was :03821</rdfs:comment>
        <rdfs:label xml:lang="en">has date value</rdfs:label>
        <skos:definition xml:lang="en">Specifies a date (and time) value for an entity.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/hasDecimalValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/hasDecimalValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">was :03822</rdfs:comment>
        <rdfs:label xml:lang="en">has decimal value</rdfs:label>
        <skos:definition xml:lang="en">Specifies a decimal value for an entity.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/hasIntegerValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/hasIntegerValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">was :03820</rdfs:comment>
        <rdfs:label xml:lang="en">has integer value</rdfs:label>
        <skos:definition xml:lang="en">Specifies a non-negative integer value for an entity.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/hasStringValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/hasStringValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">was :03795</rdfs:comment>
        <rdfs:label xml:lang="en">has string value</rdfs:label>
        <skos:definition xml:lang="en">Specifies a string value.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/hasURI -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/hasURI">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">was :03819</rdfs:comment>
        <rdfs:label xml:lang="en">has URI</rdfs:label>
        <skos:definition xml:lang="en">Specifies a Uniform Resource Identifier (URI) for an entity.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/lowerAgeValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/lowerAgeValue">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/ageRangeValues"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03462"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">was :03845</rdfs:comment>
        <rdfs:label xml:lang="en">lower age value</rdfs:label>
        <skos:definition xml:lang="en">The lower bound of age range.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/lowerConfidenceLimit -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/lowerConfidenceLimit">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/confidenceIntervalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00672"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">was :03796</rdfs:comment>
        <rdfs:label xml:lang="en">lower confidence limit</rdfs:label>
        <skos:definition xml:lang="en">The lower confidence limit is a data item which is a lowest value bounding a confidence interval.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000315"/>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/maximum -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/maximum">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/scalarMetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <owl:propertyDisjointWith rdf:resource="https://rsna.org/roadmap/minimum"/>
        <rdfs:comment xml:lang="en">This value is provided as a data property (rather than annotation property) of scalar metrics so that it can be queried or used in analyses.</rdfs:comment>
        <rdfs:label xml:lang="en">maximum</rdfs:label>
        <skos:altLabel xml:lang="en">maximal value</skos:altLabel>
        <skos:definition xml:lang="en">The highest value a scalar metric can attain. If not specified, the value is unbounded, that is, equivalent to the xsd:float value +INF.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000666"/>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/metricObservedValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/metricObservedValue">
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:comment xml:lang="en">was :03843</rdfs:comment>
        <rdfs:label xml:lang="en">metric observed value</rdfs:label>
        <skos:definition xml:lang="en">Specifies the observed value of a metric for a model on a specified dataset.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/minimum -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/minimum">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/scalarMetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">This value is provided as a data property (rather than annotation property) of scalar metrics so that it can be queried or used in analyses.</rdfs:comment>
        <rdfs:label xml:lang="en">minimum</rdfs:label>
        <skos:altLabel xml:lang="en">minimal value</skos:altLabel>
        <skos:definition xml:lang="en">The lowest value a scalar metric can attain.  If not specified, the value is unbounded, that is, equivalent to the xsd:float value -INF.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000667"/>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/nonScalarMetricObservedValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/nonScalarMetricObservedValue">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/metricObservedValue"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03871"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">was :03868</rdfs:comment>
        <rdfs:label xml:lang="en">non-scalar metric observed value</rdfs:label>
        <skos:definition xml:lang="en">Specifies the observed value of a non-scalar metric (a graph or matrix) for a model on a specified dataset; that value is a URI that can point to an image, table, or other resource.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/optimum -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/optimum">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/scalarMetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">This property allows one to compare two values to determine which is better. It is provided as a data property (rather than annotation property) of scalar metrics so that it can be queried or used in analyses.</rdfs:comment>
        <rdfs:label xml:lang="en">optimum</rdfs:label>
        <skos:altLabel xml:lang="en">optimal value</skos:altLabel>
        <skos:altLabel xml:lang="en">optimalValue</skos:altLabel>
        <skos:definition xml:lang="en">The &quot;best&quot; value of a scalar metric. For example, the optimal value for accuracy is 1.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/scalarMetricObservedValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/scalarMetricObservedValue">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/metricObservedValue"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03870"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">was :03869</rdfs:comment>
        <rdfs:label xml:lang="en">scalar metric observed value</rdfs:label>
        <skos:definition xml:lang="en">Specifies the observed value (xsd:decimal) of a scalar metric for a model on a specified dataset.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/scalarMetricProperty -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/scalarMetricProperty">
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:comment xml:lang="en">If unbounded (i.e., INF or -INF), the maximum and minimum values are absent. These values are specified as Data Properties (rather than Annotation Properties) so that they can be queried or used in analysis.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03838</rdfs:comment>
        <rdfs:label xml:lang="en">scalar metric property</rdfs:label>
        <skos:definition xml:lang="en">These data properties -- minimum, maximum, and optimum -- specify a scalar metric&apos;s lowest, highest, and &quot;ideal&quot; numerical values, respectively.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/upperAgeValue -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/upperAgeValue">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/ageRangeValues"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/03462"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">was :03846</rdfs:comment>
        <rdfs:label xml:lang="en">upper age value</rdfs:label>
        <skos:definition xml:lang="en">The upper bound of an age range.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://rsna.org/roadmap/upperConfidenceLimit -->

    <owl:DatatypeProperty rdf:about="https://rsna.org/roadmap/upperConfidenceLimit">
        <rdfs:subPropertyOf rdf:resource="https://rsna.org/roadmap/confidenceIntervalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://rsna.org/roadmap/00672"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">was :03797</rdfs:comment>
        <rdfs:label xml:lang="en">upper confidence limit</rdfs:label>
        <skos:definition xml:lang="en">The upper confidence limit is the largest value bounding a confidence interval</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000314"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2002/07/owl#Thing -->

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
    


    <!-- https://rsna.org/roadmap/00001 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00001">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">ROADMAP entity</rdfs:label>
        <rdfs:label xml:lang="zh">ROADMAP 实体</rdfs:label>
        <rdfs:label xml:lang="es">entidad de ontología ROADMAP</rdfs:label>
        <skos:definition xml:lang="en">The top-level class in the ROADMAP ontology.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00002 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00002">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00657"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasModelProperty"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03355"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">model</rdfs:label>
        <rdfs:label xml:lang="es">modelo</rdfs:label>
        <rdfs:label xml:lang="zh">模型</rdfs:label>
        <skos:definition xml:lang="en">An AI model, described by descriptors and model properties.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00003 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00003">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00657"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasDatasetProperty"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03381"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">conjunto de datos</rdfs:label>
        <rdfs:label xml:lang="en">dataset</rdfs:label>
        <rdfs:label xml:lang="zh">数据集</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/IAO_0001000"/>
        <skos:definition xml:lang="en">A collection of data used to train and/or test an AI model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00004 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00004">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03788"/>
        <rdfs:label xml:lang="es">descriptor</rdfs:label>
        <rdfs:label xml:lang="en">general metadata</rdfs:label>
        <rdfs:label xml:lang="zh">描述符</rdfs:label>
        <skos:altLabel xml:lang="en">descriptor</skos:altLabel>
        <skos:altLabel xml:lang="en">detail</skos:altLabel>
        <skos:altLabel xml:lang="en">details</skos:altLabel>
        <skos:altLabel xml:lang="es">detalles</skos:altLabel>
        <skos:altLabel xml:lang="en">generic metadata</skos:altLabel>
        <skos:altLabel xml:lang="en">resource descriptor</skos:altLabel>
        <skos:definition xml:lang="en">Metadata that can be used to describe any AI resource (project, model, or dataset).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00005 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00005">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00003"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03764"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00003"/>
        <rdfs:label xml:lang="es">conjunto de datos de entrenamiento</rdfs:label>
        <rdfs:label xml:lang="en">training dataset</rdfs:label>
        <rdfs:label xml:lang="zh">训练数据集</rdfs:label>
        <skos:altLabel xml:lang="en">training data</skos:altLabel>
        <skos:definition xml:lang="en">The data on which an AI model is trained.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00006 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00006">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00003"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03765"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00003"/>
        <rdfs:label xml:lang="es">conjunto de datos de optimización</rdfs:label>
        <rdfs:label xml:lang="en">optimization dataset</rdfs:label>
        <rdfs:label xml:lang="zh">优化数据集</rdfs:label>
        <skos:altLabel xml:lang="en">optimization data</skos:altLabel>
        <skos:altLabel xml:lang="en">tuning data</skos:altLabel>
        <skos:altLabel xml:lang="en">tuning dataset</skos:altLabel>
        <skos:altLabel xml:lang="en">validation data</skos:altLabel>
        <skos:altLabel xml:lang="en">validation dataset</skos:altLabel>
        <skos:definition xml:lang="en">A dataset used to &quot;tune&quot; or optimize the performance of an AI model. Deep learning systems often use the term &quot;validation,&quot; but in medical applications, it can be confused with clinical validation. Hence, &quot;optimization&quot; is preferred.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00007 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00007">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00003"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03766"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="es">conjunto de datos de prueba</rdfs:label>
        <rdfs:label xml:lang="en">testing dataset</rdfs:label>
        <rdfs:label xml:lang="zh">测试数据集</rdfs:label>
        <skos:altLabel xml:lang="en">testing data</skos:altLabel>
        <skos:definition xml:lang="en">Data on which a model&apos;s performance is assessed. Can be &quot;internal&quot; (a partition of the original dataset) or &quot;external&quot; (from another dataset or institution).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00008 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00008">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00007"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03767"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="es">conjunto de datos de pruebas internas</rdfs:label>
        <rdfs:label xml:lang="en">internal testing dataset</rdfs:label>
        <rdfs:label xml:lang="zh">内部测试数据集</rdfs:label>
        <skos:altLabel xml:lang="en">internal test data</skos:altLabel>
        <skos:altLabel xml:lang="en">internal test dataset</skos:altLabel>
        <skos:altLabel xml:lang="en">internal testing data</skos:altLabel>
        <skos:definition xml:lang="en">Data from the same institution and setting as the training and/or optimization datasets used to evaluate the model&apos;s performance. Often these data are a partition of the original (internal) dataset used to train and optimize a model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00009 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00009">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/00007"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03768"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">The term &quot;external testing&quot; is preferred over &quot;external validation,&quot; as the term &quot;validation&quot; can be ambiguous.</rdfs:comment>
        <rdfs:label xml:lang="es">conjunto de datos de pruebas externas</rdfs:label>
        <rdfs:label xml:lang="en">external testing dataset</rdfs:label>
        <rdfs:label xml:lang="zh">外部测试数据集</rdfs:label>
        <skos:altLabel xml:lang="en">external testing data</skos:altLabel>
        <skos:altLabel xml:lang="en">external validation data</skos:altLabel>
        <skos:altLabel xml:lang="en">external validation dataset</skos:altLabel>
        <skos:definition xml:lang="en">Data on which a model&apos;s performance is assessed; the data should be from another institution or setting.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00010 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00010">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00657"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasDataset"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasModel"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">project</rdfs:label>
        <rdfs:label xml:lang="es">proyecto</rdfs:label>
        <rdfs:label xml:lang="zh">项目</rdfs:label>
        <skos:definition xml:lang="en">A project allows one to aggregate one or more models and one or more datasets.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00011 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00011">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasUse"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00205"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00256"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00281"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00319"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00332"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00334"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00345"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00378"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00423"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00534"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00568"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00588"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00593"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://rsna.org/roadmap/00012"/>
            <rdf:Description rdf:about="https://rsna.org/roadmap/00013"/>
            <rdf:Description rdf:about="https://rsna.org/roadmap/00014"/>
        </owl:disjointUnionOf>
        <rdfs:label xml:lang="en">model use</rdfs:label>
        <rdfs:label xml:lang="es">uso del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">模型用途</rdfs:label>
        <skos:definition xml:lang="en">The ways in which a model is used: can include intended uses, out-of-scope uses, and excluded uses.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00012 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00012">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00011"/>
        <rdfs:label xml:lang="en">intended model use</rdfs:label>
        <rdfs:label xml:lang="es">uso previsto del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">预期模型用途</rdfs:label>
        <skos:definition xml:lang="en">An intended model use is the application of an AI model to tasks, data, or environments for which it has been designed.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00013 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00013">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00011"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00537"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">out-of-scope model use</rdfs:label>
        <rdfs:label xml:lang="es">uso fuera del alcance del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">超出范围的模型使用</rdfs:label>
        <skos:definition xml:lang="en">Out-of-scope model use refers to applying a machine learning model, AI system, or project deliverable to tasks, data, or environments outside its intended design, original requirements, or training distribution.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00014 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00014">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00011"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00537"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">excluded model use</rdfs:label>
        <rdfs:label xml:lang="es">uso excluido del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">排除的模型使用</rdfs:label>
        <skos:definition xml:lang="en">An excluded model use is the application of an AI model to tasks, data, or environments where it should not be used.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00015 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00015">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03631"/>
                    <rdf:Description rdf:about="https://rsna.org/roadmap/03800"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00664"/>
        <rdfs:label xml:lang="en">use</rdfs:label>
        <rdfs:label xml:lang="es">uso</rdfs:label>
        <rdfs:label xml:lang="zh">使用类型</rdfs:label>
        <skos:altLabel xml:lang="en">AI task</skos:altLabel>
        <skos:altLabel xml:lang="en">AI use</skos:altLabel>
        <skos:altLabel xml:lang="en">task</skos:altLabel>
        <skos:altLabel xml:lang="es">tipo de uso</skos:altLabel>
        <skos:altLabel xml:lang="en">use case</skos:altLabel>
        <skos:altLabel xml:lang="en">use type</skos:altLabel>
        <skos:definition xml:lang="en">The type of task to which the AI model is applied, such as image segmentation.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00016 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00016">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="es">evaluación de riesgos</rdfs:label>
        <rdfs:label xml:lang="en">risk assessment</rdfs:label>
        <rdfs:label xml:lang="zh">风险评估</rdfs:label>
        <skos:definition xml:lang="en">Prediction of the likelihood of a specified condition or occurrence.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/225338004"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00017 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00017">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="en">procedure selection</rdfs:label>
        <rdfs:label xml:lang="es">selección del procedimiento</rdfs:label>
        <rdfs:label xml:lang="zh">程序选择</rdfs:label>
        <skos:definition xml:lang="en">Selection of a procedure, notably an imaging procedure, that is most appropriate to answer a clinical question.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00018 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00018">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="en">exam protocol selection</rdfs:label>
        <rdfs:label xml:lang="es">selección del protocolo de examen</rdfs:label>
        <rdfs:label xml:lang="zh">检查方案选择</rdfs:label>
        <skos:altLabel xml:lang="en">protocol selection</skos:altLabel>
        <skos:altLabel xml:lang="en">protocoling</skos:altLabel>
        <skos:definition xml:lang="en">Specification of the details of the examination, such as imaging sequences, type of contrast media, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00019 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00019">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="en">triage</rdfs:label>
        <rdfs:label xml:lang="es">triaje</rdfs:label>
        <rdfs:label xml:lang="zh">分诊</rdfs:label>
        <skos:altLabel xml:lang="en">CADt</skos:altLabel>
        <skos:altLabel xml:lang="en">Computer-aided triage</skos:altLabel>
        <skos:altLabel xml:lang="en">Computer-assisted triage</skos:altLabel>
        <skos:altLabel xml:lang="en">Computer-assisted triage and notification</skos:altLabel>
        <skos:definition xml:lang="en">Use of an AI system to determine the order in which examinations should be performed and/or interpreted.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00020 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00020">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03758"/>
        <rdfs:label xml:lang="es">detección</rdfs:label>
        <rdfs:label xml:lang="en">detection</rdfs:label>
        <rdfs:label xml:lang="zh">检测</rdfs:label>
        <skos:altLabel xml:lang="en">CADe</skos:altLabel>
        <skos:altLabel xml:lang="en">computer-aided detection</skos:altLabel>
        <skos:altLabel xml:lang="en">computer-assisted detection</skos:altLabel>
        <skos:definition xml:lang="en">Use of an AI system to detect one or more disorders or conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00021 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00021">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03758"/>
        <rdfs:label xml:lang="en">diagnosis</rdfs:label>
        <rdfs:label xml:lang="es">diagnóstico</rdfs:label>
        <rdfs:label xml:lang="zh">诊断</rdfs:label>
        <skos:altLabel xml:lang="en">CADx</skos:altLabel>
        <skos:altLabel xml:lang="en">computer-aided diagnosis</skos:altLabel>
        <skos:altLabel xml:lang="en">computer-assisted diagnosis</skos:altLabel>
        <skos:altLabel xml:lang="en">computer-assisted diagnostic</skos:altLabel>
        <skos:definition xml:lang="en">Identification of a single diagnosis or a list of possible diagnoses.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00022 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00022">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="es">apoyo a la toma de decisiones</rdfs:label>
        <rdfs:label xml:lang="en">decision support</rdfs:label>
        <rdfs:label xml:lang="zh">决策支持</rdfs:label>
        <skos:definition xml:lang="en">Use of an AI system to aid in medical decision making.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00023 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00023">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="en">prognosis</rdfs:label>
        <rdfs:label xml:lang="es">pronóstico</rdfs:label>
        <rdfs:label xml:lang="zh">预后</rdfs:label>
        <skos:definition xml:lang="en">A prognosis is a medical prediction of the likely course and outcome of a disease, including recovery chances, symptom improvement, and survival.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00024 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00024">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="en">image processing</rdfs:label>
        <rdfs:label xml:lang="es">procesamiento de imágenes</rdfs:label>
        <rdfs:label xml:lang="zh">图像处理</rdfs:label>
        <skos:definition xml:lang="en">Use of an AI model for image processing, such as image reconstruction, style transfer, or noise reduction.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00025 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00025">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00024"/>
        <rdfs:label xml:lang="en">image reconstruction</rdfs:label>
        <rdfs:label xml:lang="es">reconstrucción de imágenes</rdfs:label>
        <rdfs:label xml:lang="zh">图像重建</rdfs:label>
        <skos:definition xml:lang="en">Image reconstruction refers to the construction of a target domain image from source domain signals, which could be divided into raw-to-image and postprocessing applications.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00026 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00026">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00024"/>
        <rdfs:label xml:lang="en">image style transfer</rdfs:label>
        <rdfs:label xml:lang="es">transferencia de estilo de imagen</rdfs:label>
        <rdfs:label xml:lang="zh">图像风格迁移</rdfs:label>
        <skos:definition xml:lang="en">Style transfer is a deep learning method to transfer the style of an image to another one. It is an image-generation technique that focuses on domain shift. The new image has the style of the first with the content of the second.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00027 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00027">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00024"/>
        <rdfs:label xml:lang="en">noise reduction</rdfs:label>
        <rdfs:label xml:lang="es">reducción de ruido</rdfs:label>
        <rdfs:label xml:lang="zh">降噪</rdfs:label>
        <skos:definition xml:lang="en">Reducing the amount of noise in an exam&apos;s images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00028 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00028">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00024"/>
        <rdfs:label xml:lang="en">artifact reduction</rdfs:label>
        <rdfs:label xml:lang="es">reducción de artefactos</rdfs:label>
        <rdfs:label xml:lang="zh">伪影消除</rdfs:label>
        <skos:definition xml:lang="en">Improving image quality by reducing the effects of artifacts, such as respiratory motion.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00029 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00029">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="en">image segmentation</rdfs:label>
        <rdfs:label xml:lang="es">segmentación de imágenes</rdfs:label>
        <rdfs:label xml:lang="zh">图像分割</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Image_segmentation"/>
        <skos:altLabel xml:lang="en">segmentation</skos:altLabel>
        <skos:definition xml:lang="en">Image segmentation is the process of partitioning a digital image into multiple image segments.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00030 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00030">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="es">procesamiento de textos</rdfs:label>
        <rdfs:label xml:lang="en">text processing</rdfs:label>
        <rdfs:label xml:lang="zh">文本处理</rdfs:label>
        <skos:definition xml:lang="en">Manipulation of textual information, including applications such as translation, summarization, and data extraction.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00031 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00031">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00030"/>
        <rdfs:label xml:lang="es">resumen de textos</rdfs:label>
        <rdfs:label xml:lang="en">text summarization</rdfs:label>
        <rdfs:label xml:lang="zh">文本摘要</rdfs:label>
        <skos:definition xml:lang="en">Processing to distill a large amount of textual data into a concise and relevant summary.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00032 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00032">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00030"/>
        <rdfs:label xml:lang="es">generación de informes</rdfs:label>
        <rdfs:label xml:lang="en">report generation</rdfs:label>
        <rdfs:label xml:lang="zh">报告生成</rdfs:label>
        <skos:definition xml:lang="en">Production of a text report from dictated text or other verbal information (e.g., &quot;ambient&quot; dictation).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00033 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00033">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00030"/>
        <rdfs:label xml:lang="es">generación de impresiones de informes</rdfs:label>
        <rdfs:label xml:lang="en">report impression generation</rdfs:label>
        <rdfs:label xml:lang="zh">报告印象生成</rdfs:label>
        <skos:definition xml:lang="en">Generation of the Impression section of a report from the narrative (findings) text.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00034 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00034">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00030"/>
        <rdfs:label xml:lang="es">extracción de datos de informes</rdfs:label>
        <rdfs:label xml:lang="en">report data extraction</rdfs:label>
        <rdfs:label xml:lang="zh">报告数据提取</rdfs:label>
        <skos:definition xml:lang="en">Extraction of discrete data elements from a textual report.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00035 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00035">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00030"/>
        <rdfs:label xml:lang="en">report translation</rdfs:label>
        <rdfs:label xml:lang="es">traducción de informes</rdfs:label>
        <rdfs:label xml:lang="zh">报告翻译</rdfs:label>
        <skos:definition xml:lang="en">Translation of report text from one language into another, or from the original text into simplified (&quot;lay&quot;) language.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00036 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00036">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasUser"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00205"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00256"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00296"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00319"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00334"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00340"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00384"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00470"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00554"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00568"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00571"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00573"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00585"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://rsna.org/roadmap/00037"/>
            <rdf:Description rdf:about="https://rsna.org/roadmap/00038"/>
            <rdf:Description rdf:about="https://rsna.org/roadmap/00039"/>
        </owl:disjointUnionOf>
        <rdfs:label xml:lang="en">model user</rdfs:label>
        <rdfs:label xml:lang="es">usuario del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">模型用户</rdfs:label>
        <skos:definition xml:lang="en">The types of individuals who might use the model: can include intended, out-of-scope, and excluded users.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00037 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00037">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00036"/>
        <rdfs:label xml:lang="en">intended model user</rdfs:label>
        <rdfs:label xml:lang="es">usuario previsto del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">预期模型用户</rdfs:label>
        <skos:altLabel xml:lang="en">intended user</skos:altLabel>
        <skos:definition xml:lang="en">A user for whom the AI model has been designed, such as healthcare professionals, caregivers, or patients.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00038 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00038">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00036"/>
        <rdfs:label xml:lang="en">out-of-scope model user</rdfs:label>
        <rdfs:label xml:lang="es">usuario fuera del alcance del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">超出范围的模型用户</rdfs:label>
        <skos:definition xml:lang="en">An individual who uses the model, but for whom the model was not intended.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00039 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00039">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00036"/>
        <rdfs:label xml:lang="en">excluded model user</rdfs:label>
        <rdfs:label xml:lang="es">usuario excluido del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">排除的模型用户</rdfs:label>
        <skos:definition xml:lang="en">An individual who should not use the AI model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00040 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00040">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00071"/>
        <rdfs:label xml:lang="es">tipo de usuario</rdfs:label>
        <rdfs:label xml:lang="en">user</rdfs:label>
        <rdfs:label xml:lang="zh">用户类型</rdfs:label>
        <skos:altLabel xml:lang="en">user type</skos:altLabel>
        <skos:definition xml:lang="en">The type of human user(s) of the AI model, such as general medical practitioner.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00041 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00041">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03359"/>
        <rdfs:label xml:lang="es">paciente</rdfs:label>
        <rdfs:label xml:lang="en">patient</rdfs:label>
        <rdfs:label xml:lang="zh">患者</rdfs:label>
        <skos:definition xml:lang="en">A patient receiving care.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00042 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00042">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03491"/>
        <rdfs:label xml:lang="en">radiology technologist</rdfs:label>
        <rdfs:label xml:lang="es">tecnólogo en radiología</rdfs:label>
        <rdfs:label xml:lang="zh">放射技师</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.arrt.org/"/>
        <skos:altLabel xml:lang="en">RT</skos:altLabel>
        <skos:altLabel xml:lang="en">radiographer</skos:altLabel>
        <skos:altLabel xml:lang="en">radiology tech</skos:altLabel>
        <skos:definition xml:lang="en">A radiology professional who operates the imaging devices, performs the imaging examinations, and/or performs image post-processing.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/159016003"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00043 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00043">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00168"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03491"/>
        <rdfs:label xml:lang="es">enfermero/a de radiología</rdfs:label>
        <rdfs:label xml:lang="en">radiology nurse</rdfs:label>
        <rdfs:label xml:lang="zh">放射科护士</rdfs:label>
        <skos:definition xml:lang="en">A radiology nurse is a registered nurse (RN) specializing in patient care before, during, and after diagnostic imaging and minimally invasive, image-guided procedures (Interventional Radiology).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00044 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00044">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00075"/>
        <rdfs:label xml:lang="en">radiologist</rdfs:label>
        <rdfs:label xml:lang="es">radiólogo</rdfs:label>
        <rdfs:label xml:lang="zh">放射科医生</rdfs:label>
        <skos:definition xml:lang="en">A physician specialized in diagnostic and/or interventional radiology.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/66862007"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00045 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00045">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00044"/>
        <rdfs:label xml:lang="en">diagnostic radiologist</rdfs:label>
        <rdfs:label xml:lang="es">radiólogo de diagnóstico</rdfs:label>
        <rdfs:label xml:lang="zh">诊断放射科医生</rdfs:label>
        <skos:definition xml:lang="en">A physician specialized in diagnostic radiology.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/78729002"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00046 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00046">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00045"/>
        <rdfs:label xml:lang="en">general diagnostic radiologist</rdfs:label>
        <rdfs:label xml:lang="es">radiólogo de diagnóstico general</rdfs:label>
        <rdfs:label xml:lang="zh">全科放射诊断医师</rdfs:label>
        <skos:definition xml:lang="en">A general or multi-subspecialty diagnostic radiologist.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00047 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00047">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00045"/>
        <rdfs:label xml:lang="es">radiólogo de diagnóstico subespecialista</rdfs:label>
        <rdfs:label xml:lang="en">subspecialist diagnostic radiologist</rdfs:label>
        <rdfs:label xml:lang="zh">亚专科诊断放射科医生</rdfs:label>
        <skos:definition xml:lang="en">A diagnostic radiologist with expertise and/or certification in a subspecialty, such as neuroradiology.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00048 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00048">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00044"/>
        <rdfs:label xml:lang="en">interventional radiologist</rdfs:label>
        <rdfs:label xml:lang="es">radiólogo intervencionista</rdfs:label>
        <rdfs:label xml:lang="zh">介入放射科医生</rdfs:label>
        <skos:altLabel xml:lang="en">IR physician</skos:altLabel>
        <skos:definition xml:lang="en">A physician specialized in interventional radiology.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00049 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00049">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00075"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00080"/>
        <rdfs:label xml:lang="es">médico remitente</rdfs:label>
        <rdfs:label xml:lang="en">referring physician</rdfs:label>
        <rdfs:label xml:lang="zh">转诊医生</rdfs:label>
        <skos:definition xml:lang="en">The physician who refers a patient for an examination.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00050 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00050">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00040"/>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03609"/>
        <rdfs:label xml:lang="es">investigador</rdfs:label>
        <rdfs:label xml:lang="en">researcher</rdfs:label>
        <rdfs:label xml:lang="zh">研究人员</rdfs:label>
        <skos:definition xml:lang="en">An investigator; one who conducts research.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00051 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00051">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03381"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00216"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00219"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00257"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00290"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00432"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00520"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00556"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00621"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00622"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00643"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00644"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">annotation level</rdfs:label>
        <rdfs:label xml:lang="es">nivel de anotación</rdfs:label>
        <rdfs:label xml:lang="zh">标注级别</rdfs:label>
        <skos:altLabel xml:lang="en">annotation type</skos:altLabel>
        <skos:altLabel xml:lang="en">level of annotation</skos:altLabel>
        <skos:definition xml:lang="en">Defines the level at which annotations were made, such as per patient, per image, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00052 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00052">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00051"/>
        <rdfs:label xml:lang="es">anotación a nivel de imagen</rdfs:label>
        <rdfs:label xml:lang="en">image-level annotation</rdfs:label>
        <rdfs:label xml:lang="zh">图像级标注</rdfs:label>
        <skos:altLabel xml:lang="en">image label</skos:altLabel>
        <skos:altLabel xml:lang="en">image-level label</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to each image.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00053 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00053">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00051"/>
        <rdfs:label xml:lang="es">anotación a nivel de paciente</rdfs:label>
        <rdfs:label xml:lang="en">patient-level annotation</rdfs:label>
        <rdfs:label xml:lang="zh">患者级注释</rdfs:label>
        <skos:altLabel xml:lang="en">patient label</skos:altLabel>
        <skos:altLabel xml:lang="en">patient-level label</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to a patient, which applies to all of that patient&apos;s exams and images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00054 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00054">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00051"/>
        <rdfs:label xml:lang="es">anotación a nivel de examen</rdfs:label>
        <rdfs:label xml:lang="en">examination-level annotation</rdfs:label>
        <rdfs:label xml:lang="zh">检查级别注释</rdfs:label>
        <skos:altLabel xml:lang="en">exam-level annotation</skos:altLabel>
        <skos:altLabel xml:lang="en">study-level annotation</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to the entire examination. If an exam comprises multiple series and/or images, all of them share the exam-level label(s).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00055 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00055">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03381"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00238"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00239"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00306"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00308"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00571"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00625"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00648"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasIntegerValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">count</rdfs:label>
        <rdfs:label xml:lang="es">número</rdfs:label>
        <rdfs:label xml:lang="zh">计数</rdfs:label>
        <skos:altLabel xml:lang="en">number</skos:altLabel>
        <skos:altLabel xml:lang="en">number of items</skos:altLabel>
        <skos:altLabel xml:lang="es">número de artículos</skos:altLabel>
        <skos:definition xml:lang="en">The number of items in a dataset, partition, or subset. Subclasses include counts for exams, images, patients, series, and sites.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/APOLLO_SV_00000032"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000047"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00056 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00056">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00055"/>
        <rdfs:label xml:lang="es">número de pacientes</rdfs:label>
        <rdfs:label xml:lang="en">patient count</rdfs:label>
        <rdfs:label xml:lang="zh">患者数量</rdfs:label>
        <skos:altLabel xml:lang="en">number of distinct patients</skos:altLabel>
        <skos:altLabel xml:lang="en">number of patients</skos:altLabel>
        <skos:altLabel xml:lang="en">number of subjects</skos:altLabel>
        <skos:altLabel xml:lang="en">number of unique patients</skos:altLabel>
        <skos:altLabel xml:lang="es">número de pacientes</skos:altLabel>
        <skos:definition xml:lang="en">The number of distinct patients. Each patient may have one or more examinations, each of which comprises one or more series and one or more images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00057 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00057">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00055"/>
        <rdfs:label xml:lang="en">exam count</rdfs:label>
        <rdfs:label xml:lang="es">número de exámenes</rdfs:label>
        <rdfs:label xml:lang="zh">检查次数</rdfs:label>
        <skos:altLabel xml:lang="en">number of examinations</skos:altLabel>
        <skos:altLabel xml:lang="en">number of exams</skos:altLabel>
        <skos:altLabel xml:lang="en">number of studies</skos:altLabel>
        <skos:altLabel xml:lang="es">número de exámenes</skos:altLabel>
        <skos:altLabel xml:lang="en">study count</skos:altLabel>
        <skos:definition xml:lang="en">Number of imaging examinations. A patient may have more than one exam.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00058 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00058">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00055"/>
        <rdfs:label xml:lang="en">image count</rdfs:label>
        <rdfs:label xml:lang="es">número de imágenes</rdfs:label>
        <rdfs:label xml:lang="zh">图像数量</rdfs:label>
        <skos:altLabel xml:lang="en">number of images</skos:altLabel>
        <skos:altLabel xml:lang="es">número de imágenes</skos:altLabel>
        <skos:altLabel xml:lang="zh">图像数量</skos:altLabel>
        <skos:definition xml:lang="en">The number of images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00059 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00059">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00663"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00184"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00215"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">formato de archivo de imagen</rdfs:label>
        <rdfs:label xml:lang="en">image file format</rdfs:label>
        <rdfs:label xml:lang="zh">图像文件格式</rdfs:label>
        <skos:altLabel xml:lang="en">image format</skos:altLabel>
        <skos:definition xml:lang="en">Describes the imaging standard, such as DICOM or NiFTI, in which images are stored.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00060 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00060">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <dcterms:source rdf:resource="https://dicomstandard.org/"/>
        <rdfs:label xml:lang="en">DICOM</rdfs:label>
        <rdfs:label xml:lang="es">DICOM</rdfs:label>
        <rdfs:label xml:lang="zh">数字成像和通信医学标准</rdfs:label>
        <skos:altLabel xml:lang="en">Digital Imaging Communication in Medicine</skos:altLabel>
        <skos:definition xml:lang="en">The international standard for exchange of medical imaging information.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00061 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00061">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <dcterms:source rdf:resource="https://www.w3.org/TR/png-3/"/>
        <rdfs:label xml:lang="en">PNG</rdfs:label>
        <rdfs:label xml:lang="es">PNG</rdfs:label>
        <rdfs:label xml:lang="zh">PNG</rdfs:label>
        <skos:altLabel xml:lang="en">Portable Network Graphics</skos:altLabel>
        <skos:definition xml:lang="en">A raster-graphics file format that supports lossless data compression, developed as an improved, non-patented replacement for Graphics Interchange Format (GIF).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00062 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00062">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <dcterms:source rdf:resource="https://jpeg.org/"/>
        <rdfs:label xml:lang="en">JPEG</rdfs:label>
        <rdfs:label xml:lang="es">JPEG</rdfs:label>
        <rdfs:label xml:lang="zh">JPEG</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/JPEG"/>
        <skos:altLabel xml:lang="en">JPG</skos:altLabel>
        <skos:altLabel xml:lang="en">Joint Photographic Experts Group</skos:altLabel>
        <skos:definition xml:lang="en">A commonly used method of lossy compression for digital images, particularly for those images produced by digital photography.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00063 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00063">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <dcterms:source rdf:resource="https://nifti.nimh.nih.gov/"/>
        <rdfs:comment xml:lang="en">The National Institute of Mental Health and the National Institute of Neurological Disorders and Stroke are joint sponsors.</rdfs:comment>
        <rdfs:label xml:lang="en">NiFTI</rdfs:label>
        <rdfs:label xml:lang="es">NiFTI</rdfs:label>
        <rdfs:label xml:lang="zh">NiFTI</rdfs:label>
        <skos:altLabel xml:lang="en">Neuroimaging Informatics Technology Initiative</skos:altLabel>
        <skos:definition xml:lang="en">An open file format commonly used to store brain imaging data obtained using MRI. Its primary purpose is to provide coordinated and targeted service, training, and research to speed the development and enhance the utility of informatics tools related to neuroimaging.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00064 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00064">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00071"/>
        <rdfs:comment xml:lang="en">Ideally should link to a unique identifier such as the ORCID identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">author</rdfs:label>
        <rdfs:label xml:lang="es">autor</rdfs:label>
        <rdfs:label xml:lang="zh">作者</rdfs:label>
        <skos:altLabel xml:lang="en">individual author</skos:altLabel>
        <skos:definition xml:lang="en">An individual human who can claim authorship of the model, dataset, or project.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00065 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00065">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00254"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00372"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00497"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasDateValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">date</rdfs:label>
        <rdfs:label xml:lang="es">fecha</rdfs:label>
        <rdfs:label xml:lang="zh">日期</rdfs:label>
        <skos:definition xml:lang="en">The calendar date on which the AI resource has been created, published, or updated.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00066 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00066">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00182"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00254"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00257"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
