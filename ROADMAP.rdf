    <!-- https://rsna.org/roadmap/formula -->

    <owl:AnnotationProperty rdf:about="https://rsna.org/roadmap/formula">
        <rdfs:comment xml:lang="en">was :01003</rdfs:comment>
        <rdfs:label xml:lang="en">formula</rdfs:label>
        <skos:definition xml:lang="en">Mathematical formula by which a metric is derived.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://rsna.org/roadmap/pattern -->

    <owl:AnnotationProperty rdf:about="https://rsna.org/roadmap/pattern">
        <rdfs:comment xml:lang="en">For example, for RadLex codes, the pattern &quot;https://radlex.org/RID/$&quot; would use value &quot;RID123&quot; to generate the URL &quot;https://radlex.org/RID/RID123&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :03626</rdfs:comment>
        <rdfs:label xml:lang="en">pattern</rdfs:label>
        <skos:definition xml:lang="en">Defines the use of a value in a URL.</skos:definition>
        <regex>RID[0-9]+</regex>
    </owl:AnnotationProperty>
    


    <!-- https://rsna.org/roadmap/regex -->

    <owl:AnnotationProperty rdf:about="https://rsna.org/roadmap/regex">
        <rdfs:comment xml:lang="en">Note that no delimiters are used.</rdfs:comment>
        <rdfs:comment xml:lang="en">was :00155</rdfs:comment>
        <rdfs:label xml:lang="en">regex</rdfs:label>
        <skos:definition xml:lang="en">Defines a regular expression (&quot;regex&quot;) to validate an entity&apos;s value. For example, RadLex code&apos;s regex &quot;RID[0-9]+&quot; validates values such as &quot;RID123&quot;.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://rsna.org/roadmap/symbol -->

    <owl:AnnotationProperty rdf:about="https://rsna.org/roadmap/symbol">
        <rdfs:comment xml:lang="en">was :01002</rdfs:comment>
        <rdfs:label xml:lang="en">symbol</rdfs:label>
        <skos:definition xml:lang="en">Symbol for a metric, used to specify in a :formula.</skos:definition>
    </owl:AnnotationProperty>
    


