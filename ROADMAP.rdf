    <!-- https://rsna.org/roadmap/03483 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03483">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03479"/>
        <rdfs:label xml:lang="es">anotación de segmentación</rdfs:label>
        <rdfs:label xml:lang="en">segmentation annotation</rdfs:label>
        <rdfs:label xml:lang="zh">分割标注</rdfs:label>
        <skos:altLabel xml:lang="en">segmentation label</skos:altLabel>
        <skos:definition xml:lang="en">Segmentation annotation involves labeling specific pixels in an image into a specific category or class. Unlike bounding boxes, which simply outline an object, segmentation annotation provides precise boundaries.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03484 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03484">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03389"/>
        <rdfs:label xml:lang="en">text</rdfs:label>
        <rdfs:label xml:lang="es">texto</rdfs:label>
        <rdfs:label xml:lang="zh">文本</rdfs:label>
        <skos:altLabel xml:lang="en">text data</skos:altLabel>
        <skos:altLabel xml:lang="en">textual data</skos:altLabel>
        <skos:definition xml:lang="en">Text data refers to information expressed in written, digital, or printed language. It is a form of unstructured or semi-structured data primarily composed of words, sentences, and paragraphs</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03485 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03485">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03484"/>
        <rdfs:label xml:lang="en">pathology report text</rdfs:label>
        <rdfs:label xml:lang="es">texto del informe de patología</rdfs:label>
        <rdfs:label xml:lang="zh">病理报告文本</rdfs:label>
        <skos:altLabel xml:lang="en">path report</skos:altLabel>
        <skos:altLabel xml:lang="en">pathology report</skos:altLabel>
        <skos:definition xml:lang="en">Textual report of a pathology result.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03486 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03486">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03484"/>
        <rdfs:comment xml:lang="en">This definition excludes radiology and pathology reports.</rdfs:comment>
        <rdfs:label xml:lang="en">electronic health record text</rdfs:label>
        <rdfs:label xml:lang="es">texto del historial clínico electrónico</rdfs:label>
        <rdfs:label xml:lang="zh">电子健康记录文本</rdfs:label>
        <skos:altLabel xml:lang="en">EHR text</skos:altLabel>
        <skos:altLabel xml:lang="en">EMR text</skos:altLabel>
        <skos:altLabel xml:lang="en">electronic medical record text</skos:altLabel>
        <skos:definition xml:lang="en">Text from the patient&apos;s electronic health record, such as progress notes and operative reports.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03487 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03487">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03491"/>
        <rdfs:label xml:lang="es">auxiliar médico de radiología</rdfs:label>
        <rdfs:label xml:lang="en">radiology physician assistant</rdfs:label>
        <rdfs:label xml:lang="zh">放射科医师助理</rdfs:label>
        <skos:altLabel xml:lang="en">RPA</skos:altLabel>
        <skos:altLabel xml:lang="en">radiology practitioner assistant</skos:altLabel>
        <skos:definition xml:lang="en">A Radiology Physician Assistant (PA) or Radiology Practitioner Assistant (RPA) is a licensed, advanced-practice healthcare professional who works under radiologist supervision to enhance patient care in imaging departments. They specialize in conducting patient assessments, performing image-guided interventional procedures, assisting with image interpretation, and managing patient safety (e.g., contrast administration).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03488 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03488">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03491"/>
        <rdfs:label xml:lang="es">auxiliar de radiología</rdfs:label>
        <rdfs:label xml:lang="en">radiology assistant</rdfs:label>
        <rdfs:label xml:lang="zh">放射科助理</rdfs:label>
        <skos:altLabel xml:lang="en">RA</skos:altLabel>
        <skos:definition xml:lang="en">A Radiologist Assistant (RA) is an advanced-practice registered radiologic technologist who works under radiologist supervision to enhance patient care, perform imaging procedures, and manage patient assessments.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03489 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03489">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00075"/>
        <rdfs:label xml:lang="es">oncólogo radioterapeuta</rdfs:label>
        <rdfs:label xml:lang="en">radiation oncologist</rdfs:label>
        <rdfs:label xml:lang="zh">放射肿瘤学家</rdfs:label>
        <skos:altLabel xml:lang="en">radiation therapist</skos:altLabel>
        <skos:definition xml:lang="en">A radiation oncologist is a specialized physician who uses high-energy radiation (such as X-rays, gamma rays, or protons) to treat cancer and some non-cancerous conditions.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/763292005"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03490 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03490">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03599"/>
        <rdfs:label xml:lang="en">dosimetrist</rdfs:label>
        <rdfs:label xml:lang="es">dosimetrista</rdfs:label>
        <rdfs:label xml:lang="zh">剂量师</rdfs:label>
        <skos:definition xml:lang="en">Radiation dosimetrist.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03491 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03491">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03599"/>
        <rdfs:label xml:lang="es">miembro del personal de radiología</rdfs:label>
        <rdfs:label xml:lang="en">radiology staff member</rdfs:label>
        <rdfs:label xml:lang="zh">放射科工作人员</rdfs:label>
        <skos:altLabel xml:lang="en">radiology staff</skos:altLabel>
        <skos:definition xml:lang="en">A non-physician member of the radiology staff.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03492 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03492">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03599"/>
        <rdfs:label xml:lang="es">físico médico</rdfs:label>
        <rdfs:label xml:lang="en">medical physicist</rdfs:label>
        <rdfs:label xml:lang="zh">医学物理学家</rdfs:label>
        <skos:altLabel xml:lang="en">radiation physicist</skos:altLabel>
        <skos:definition xml:lang="en">A Board-certified medical physicist; includes both therapeutic (radiation oncology) and diagnostic medical physicists.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/1254952007"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03493 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03493">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03492"/>
        <rdfs:label xml:lang="en">diagnostic radiology physicist</rdfs:label>
        <rdfs:label xml:lang="es">físico de radiología diagnóstica</rdfs:label>
        <rdfs:label xml:lang="zh">诊断放射物理师</rdfs:label>
        <skos:altLabel xml:lang="en">diagnostic medical physicist</skos:altLabel>
        <skos:definition xml:lang="en">A Board-certified medical physicist working in diagnostic radiology.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03494 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03494">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03492"/>
        <rdfs:label xml:lang="es">físico de radioterapia</rdfs:label>
        <rdfs:label xml:lang="en">radiation therapy physicist</rdfs:label>
        <rdfs:label xml:lang="zh">放射治疗物理学家</rdfs:label>
        <skos:altLabel xml:lang="en">radiation oncology medical physicist</skos:altLabel>
        <skos:altLabel xml:lang="en">radiation oncology physicist</skos:altLabel>
        <skos:altLabel xml:lang="en">radiation therapy medical physicist</skos:altLabel>
        <skos:definition xml:lang="en">A radiation therapy physicist (or radiation oncology physicist) is a specialized healthcare scientist who applies principles of physics to ensure the safe and accurate delivery of high-energy radiation for cancer treatment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03495 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03495">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00075"/>
        <rdfs:label xml:lang="es">médico de medicina nuclear</rdfs:label>
        <rdfs:label xml:lang="en">nuclear medicine physician</rdfs:label>
        <rdfs:label xml:lang="zh">核医学医师</rdfs:label>
        <skos:definition xml:lang="en">A nuclear medicine physician is a medical doctor who uses safe, painless, and cost-effective radioactive tracers (radiopharmaceuticals) to diagnose, manage, and treat various diseases.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03496 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03496">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03391"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasValue"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00120"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasValue"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/00121"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Specific about the type of radiological images are indicated by the imaging modality and imaging procedure elements.</rdfs:comment>
        <rdfs:label xml:lang="es">imagen de radiología</rdfs:label>
        <rdfs:label xml:lang="en">radiology image</rdfs:label>
        <rdfs:label xml:lang="zh">放射影像</rdfs:label>
        <skos:definition xml:lang="en">Imaging data generated by radiology, such as radiography, ultrasound imaging, CT, MRI, or nuclear medicine.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03497 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03497">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03391"/>
        <rdfs:label xml:lang="es">imagen de patología</rdfs:label>
        <rdfs:label xml:lang="en">pathology image</rdfs:label>
        <rdfs:label xml:lang="zh">病理图像</rdfs:label>
        <skos:definition xml:lang="en">Data from pathology images, such histology and anatomic pathology.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03498 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03498">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03391"/>
        <rdfs:label xml:lang="en">other image</rdfs:label>
        <rdfs:label xml:lang="es">otra imagen</rdfs:label>
        <rdfs:label xml:lang="zh">其他图像</rdfs:label>
        <skos:definition xml:lang="en">Imaging data other than the specified types.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03499 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03499">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03392"/>
        <rdfs:comment xml:lang="en">Data should have an associated timestamp.</rdfs:comment>
        <rdfs:label xml:lang="es">datos de laboratorio</rdfs:label>
        <rdfs:label xml:lang="en">laboratory data</rdfs:label>
        <rdfs:label xml:lang="zh">实验室数据</rdfs:label>
        <skos:definition xml:lang="en">Discrete laboratory data, such as a numerical value of a bioassay.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03500 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03500">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03484"/>
        <rdfs:label xml:lang="en">other text data</rdfs:label>
        <rdfs:label xml:lang="es">otros datos de texto</rdfs:label>
        <rdfs:label xml:lang="zh">其他文本数据</rdfs:label>
        <skos:definition xml:lang="en">Textual information other than that found in the patient&apos;s medical record. May include social media or other sources.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03504 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03504">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <dcterms:source rdf:resource="https://doi.org/10.1213/ANE.0000000000003653"/>
        <rdfs:comment xml:lang="en">In survival analysis, time-to-event metrics refer to various statistical methods used to analyze time until an event occurs, such as failure or death. Common metrics include survival functions, hazard functions, and median survival times.</rdfs:comment>
        <rdfs:label xml:lang="es">rendimiento de análisis de tiempo hasta el evento</rdfs:label>
        <rdfs:label xml:lang="en">time-to-event analysis performance</rdfs:label>
        <rdfs:label xml:lang="zh">事件发生时间</rdfs:label>
        <skos:altLabel xml:lang="en">TTE metric</skos:altLabel>
        <skos:altLabel xml:lang="es">análisis de tiempo hasta el evento</skos:altLabel>
        <skos:altLabel xml:lang="en">time to event</skos:altLabel>
        <skos:altLabel xml:lang="en">time-to-event analysis</skos:altLabel>
        <skos:definition xml:lang="en">The performance of an AI model in terms of time-to-event analysis.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03508 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03508">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/12.2254742"/>
        <rdfs:label xml:lang="en">area under the precision-recall curve</rdfs:label>
        <rdfs:label xml:lang="es">área bajo la curva de precisión-exhaustividad</rdfs:label>
        <rdfs:label xml:lang="zh">精确率-召回率曲线下的面积</rdfs:label>
        <skos:altLabel xml:lang="en">AUC_PR</skos:altLabel>
        <skos:altLabel xml:lang="en">AUPRC</skos:altLabel>
        <skos:definition xml:lang="en">The area under the precision-recall curve quantifies a model’s performance by summarizing the relationship between precision and recall across all classification thresholds. It captures the trade-off between identifying relevant positive cases and avoiding false positives, making it particularly informative for binary classification tasks with imbalanced class distributions. This metric is sensitive to the prevalence of the positive class and reflects how well a model maintains precision while maximizing recall.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000691"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03510 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03510">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01056"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/001316446002000104"/>
        <rdfs:label xml:lang="en">Cohen&apos;s kappa</rdfs:label>
        <rdfs:label xml:lang="es">coeficiente kappa de Cohen</rdfs:label>
        <rdfs:label xml:lang="zh">卡帕系数</rdfs:label>
        <skos:altLabel xml:lang="en">Cohen&apos;s κ</skos:altLabel>
        <skos:altLabel xml:lang="en">Kappa</skos:altLabel>
        <skos:altLabel xml:lang="zh">Kappa 系数</skos:altLabel>
        <skos:altLabel xml:lang="en">κ</skos:altLabel>
        <skos:definition xml:lang="en">Cohen’s kappa measures the level of agreement between predicted and reference classifications while accounting for the agreement expected by chance. It provides a normalized score where 1 indicates perfect agreement, 0 indicates agreement equivalent to random chance, and negative values reflect agreement worse than chance. This metric is applicable to binary and multi-class classification and is more robust than simple accuracy in the presence of chance agreement.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000630"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03513 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03513">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03320"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1072064.1072067"/>
        <rdfs:label xml:lang="en">F2 score</rdfs:label>
        <rdfs:label xml:lang="zh">F2 分数</rdfs:label>
        <rdfs:label xml:lang="es">puntaje F2</rdfs:label>
        <skos:altLabel xml:lang="en">F2</skos:altLabel>
        <skos:altLabel xml:lang="en">F2-score</skos:altLabel>
        <skos:definition xml:lang="en">F2 score is a variant of the F(beta) score with β = 2, assigning greater weight to sensitivity than to precision. It is particularly useful in applications where identifying as many positive cases as possible is prioritized over minimizing false positives. This metric is often applied in medical and safety-critical domains where missed detections carry higher consequences.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03514 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03514">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1002/j.1538-7305.1948.tb01338.x"/>
        <dcterms:source rdf:resource="https://doi.org/10.1162/089976603321780272"/>
        <rdfs:label xml:lang="es">información mutua</rdfs:label>
        <rdfs:label xml:lang="en">mutual information</rdfs:label>
        <rdfs:label xml:lang="zh">互信息</rdfs:label>
        <skos:altLabel xml:lang="en">MI</skos:altLabel>
        <skos:definition xml:lang="en">Mutual information is a measure of the statistical dependence between two random variables, quantifying how much knowing one reduces the uncertainty about the other. It is defined in terms of entropy as the reduction in uncertainty of one variable given knowledge of the other, and can also be expressed as the Kullback–Leibler divergence between the joint distribution and the product of the marginals. It is always non-negative, symmetric, and equal to zero only when the variables are independent, making it a fundamental measure of shared information.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03515 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03515">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03514"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.3390/e19110631"/>
        <rdfs:label xml:lang="es">información mutua normalizada</rdfs:label>
        <rdfs:label xml:lang="en">normalized mutual information</rdfs:label>
        <rdfs:label xml:lang="zh">归一化互信息</rdfs:label>
        <skos:altLabel xml:lang="en">NMI</skos:altLabel>
        <skos:definition xml:lang="en">Normalized mutual information is a measure of similarity between two partitions that adjusts mutual information by the entropies of the partitions to ensure comparability. It rescales mutual information to fall between zero and one, where zero indicates no shared information and one indicates identical partitions. Different normalization schemes exist, but all serve to provide a scale-independent and symmetric evaluation of the agreement between clustering results.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03516 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03516">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03314"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0272989x8900900307"/>
        <rdfs:label xml:lang="zh">ROC曲线下的部分面积</rdfs:label>
        <rdfs:label xml:lang="en">partial area under the receiver operating characteristic curve</rdfs:label>
        <rdfs:label xml:lang="es">área parcial bajo la curva ROC</rdfs:label>
        <skos:altLabel xml:lang="en">pAUC</skos:altLabel>
        <skos:altLabel xml:lang="en">partial AUC</skos:altLabel>
        <skos:altLabel xml:lang="en">partial AUROC</skos:altLabel>
        <skos:altLabel xml:lang="en">partial area under the ROC curve</skos:altLabel>
        <skos:definition xml:lang="en">The partial area under the receiver operating characteristic curve measures model performance within a predefined region of the ROC curve, typically corresponding to clinically relevant ranges such as high sensitivity or high specificity. It provides an average measure of sensitivity over a range of specificities or vice versa, offering a focused assessment of discrimination in critical operating conditions rather than across all thresholds. This metric is particularly useful when performance in specific regions is more important than overall discrimination.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000689"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03517 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03517">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.0006-341X.2004.00187.x"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/radiol.2282011860"/>
        <rdfs:label xml:lang="en">percent agreement</rdfs:label>
        <rdfs:label xml:lang="es">porcentaje de concordancia</rdfs:label>
        <rdfs:label xml:lang="zh">一致性百分比</rdfs:label>
        <skos:altLabel xml:lang="en">concordance rate</skos:altLabel>
        <skos:definition xml:lang="en">Percent agreement is the proportion of all evaluated cases in which a new test and a comparator yield the same result, whether both are positive or both are negative. It provides an overall measure of concordance between two methods but does not indicate accuracy relative to truth.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03518 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03518">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03517"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.0006-341X.2004.00187.x"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/radiol.2282011860"/>
        <rdfs:comment xml:lang="en">Positive concordance rate refers to the percentage of cases where two different tests or assessments agree on a positive result. It&apos;s a measure of agreement, specifically focusing on the instances where both methods indicate a positive finding. [Kottler]</rdfs:comment>
        <rdfs:label xml:lang="es">porcentaje de concordancia positiva</rdfs:label>
        <rdfs:label xml:lang="en">positive percent agreement</rdfs:label>
        <rdfs:label xml:lang="zh">阳性一致性百分比</rdfs:label>
        <skos:altLabel xml:lang="en">PCR</skos:altLabel>
        <skos:altLabel xml:lang="en">PPA</skos:altLabel>
        <skos:altLabel xml:lang="en">positive concordance rate</skos:altLabel>
        <skos:definition xml:lang="en">Positive percent agreement is the proportion of comparator-positive cases that are also identified as positive by the new test. It quantifies agreement in the positive subset and is mathematically equivalent to sensitivity but is used specifically when the comparator is not a definitive reference standard.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03519 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03519">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03517"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.0006-341X.2004.00187.x"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/radiol.2282011860"/>
        <rdfs:label xml:lang="en">negative percent agreement</rdfs:label>
        <rdfs:label xml:lang="es">porcentaje de concordancia negativa</rdfs:label>
        <rdfs:label xml:lang="zh">阴性一致百分比</rdfs:label>
        <skos:altLabel xml:lang="en">NPA</skos:altLabel>
        <skos:altLabel xml:lang="en">negative concordance rate</skos:altLabel>
        <skos:definition xml:lang="en">Negative percent agreement is the proportion of comparator-negative cases that are also identified as negative by the new test. It reflects agreement in the negative subset and corresponds mathematically to specificity, though it is distinguished in terminology when no true reference standard is available.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03520 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03520">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1002/1097-0142(1950)3:1%3C32::AID-CNCR2820030106%3E3.0.CO;2-3"/>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0127272"/>
        <rdfs:label xml:lang="en">Youden index</rdfs:label>
        <rdfs:label xml:lang="es">índice de Youden</rdfs:label>
        <rdfs:label xml:lang="zh">约登指数</rdfs:label>
        <skos:altLabel xml:lang="en">informedness</skos:altLabel>
        <skos:definition xml:lang="en">The Youden index is a summary statistic used to evaluate the effectiveness of a diagnostic test by combining its sensitivity and specificity into a single measure. Defined as sensitivity + specificity – 1, it ranges from 0 (no discriminative ability) to 1 (perfect classification). The index is independent of disease prevalence, treats false positives and false negatives equally, and is widely applied to compare tests or to determine the optimal decision threshold on a receiver operating characteristic curve by maximizing the balance between sensitivity and specificity.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03523 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03523">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="http://doi.org/10.1177/1536867X0200200103"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="en">Kendall&apos;s tau coefficient</rdfs:label>
        <rdfs:label xml:lang="es">coeficiente tau de Kendall</rdfs:label>
        <rdfs:label xml:lang="zh">肯德尔等级相关系数</rdfs:label>
        <skos:altLabel xml:lang="en">Kendall&apos;s correlation coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Kendall’s τ</skos:altLabel>
        <skos:altLabel xml:lang="en">Kendall’s τ coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">tau</skos:altLabel>
        <skos:altLabel xml:lang="en">τ</skos:altLabel>
        <skos:altLabel xml:lang="zh">肯德尔 τ 系数</skos:altLabel>
        <skos:definition xml:lang="en">Kendall’s tau coefficient is a non-parametric statistic that measures the ordinal association between two ranked variables. It is calculated from the difference between the number of concordant and discordant observation pairs, with adjustments for tied ranks in some variants, and yields a value between −1 and 1. A value of 1 indicates perfect agreement in rank order, −1 indicates perfect inverse ordering, and 0 indicates no association in the rankings.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000240"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03524 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03524">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1002/(SICI)1097-0258(19960615)15:11%3C1199::AID-SIM218%3E3.0.CO;2-Y"/>
        <rdfs:label xml:lang="en">prediction probability</rdfs:label>
        <rdfs:label xml:lang="es">probabilidad de predicción</rdfs:label>
        <rdfs:label xml:lang="zh">预测概率</rdfs:label>
        <skos:altLabel xml:lang="en">P_K</skos:altLabel>
        <skos:definition xml:lang="en">Prediction probability quantifies the ability of an ordinal predictor to correctly rank cases across distinct outcome states. It represents the probability that, given two observations with different ordinal outcomes, the predictor assigns a higher value to the observation with the higher outcome, plus half the probability of tied predictor values. It generalizes the area under the ROC curve to multi-class ordinal settings without requiring dichotomization.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03525 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03525">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1213/ANE.0000000000002864"/>
        <dcterms:source rdf:resource="https://doi.org/10.2307/1412159"/>
        <rdfs:label xml:lang="en">Spearman&apos;s rho</rdfs:label>
        <rdfs:label xml:lang="es">coeficiente de correlación de Spearman</rdfs:label>
        <rdfs:label xml:lang="zh">斯皮尔曼秩相关系数</rdfs:label>
        <skos:altLabel xml:lang="en">Spearman rank correlation coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Spearman rho</skos:altLabel>
        <skos:altLabel xml:lang="en">Spearman rho coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Spearman&apos;s rank correlation coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">rho</skos:altLabel>
        <skos:altLabel xml:lang="es">ro</skos:altLabel>
        <skos:altLabel xml:lang="en">ρ</skos:altLabel>
        <skos:definition xml:lang="en">Spearman’s rho (ρ) is a nonparametric statistic that quantifies the strength and direction of a monotonic relationship between two variables. It is computed from the ranked values of the data rather than the raw values, making it suitable for ordinal data or continuous data that do not meet assumptions of linearity or normality. The coefficient ranges from –1 to +1, with values near the extremes indicating strong increasing or decreasing monotonic associations and values near zero indicating little to no monotonic correlation.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000201"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03526 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03526">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03307"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-642-41230-1_36"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">precisión entre los n mejores</rdfs:label>
        <rdfs:label xml:lang="en">top-n accuracy</rdfs:label>
        <rdfs:label xml:lang="zh">前 n 名准确率</rdfs:label>
        <skos:definition xml:lang="en">Top-n accuracy measures the proportion of cases where the true answer appears within the first n predicted outputs of a system, regardless of order. It generalizes standard accuracy by treating inclusion within the top-n list as a success, rather than requiring the single top prediction to be correct. This metric is widely used in multi-class classification and question answering, reflecting realistic settings where users often examine several leading predictions rather than relying only on the first.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03527 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03527">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="http://doi.org/10.1142/S0218001411009093"/>
        <rdfs:label xml:lang="es">error absoluto medio</rdfs:label>
        <rdfs:label xml:lang="en">mean absolute error</rdfs:label>
        <rdfs:label xml:lang="zh">平均绝对误差</rdfs:label>
        <skos:altLabel xml:lang="en">MAE</skos:altLabel>
        <skos:definition xml:lang="en">Mean absolute error is a measure of prediction accuracy that calculates the average magnitude of the differences between predicted and true values. It is obtained by taking the absolute value of each individual error and averaging across all observations, which makes it straightforward to interpret since it is expressed in the same units as the target variable. It is commonly used in regression and ordinal classification tasks, providing a simple way to quantify overall error severity while being less sensitive to extreme outliers than squared-error measures.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03528 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03528">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="http://doi.org/10.1142/S0218001411009093"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">error cuadrático medio</rdfs:label>
        <rdfs:label xml:lang="en">mean squared error</rdfs:label>
        <rdfs:label xml:lang="zh">均方误差</rdfs:label>
        <skos:altLabel xml:lang="en">MSE</skos:altLabel>
        <skos:altLabel xml:lang="en">mean square error</skos:altLabel>
        <skos:altLabel xml:lang="en">mean-square error</skos:altLabel>
        <skos:definition xml:lang="en">Mean squared error quantifies the average squared difference between estimated values and their corresponding reference values. It reflects both variance and bias in an estimator, serving as a measure of overall accuracy. Lower values indicate closer alignment between estimates and true values.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03531 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03531">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03637"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/radiol.220182"/>
        <rdfs:label xml:lang="en">alternative free-response receiver operating characteristic analysis</rdfs:label>
        <rdfs:label xml:lang="es">análisis alternativo de la curva ROC de respuesta libre</rdfs:label>
        <rdfs:label xml:lang="zh">替代型自由响应受试者工作特征分析</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://doi.org/10.1001/jamanetworkopen.2019.1095"/>
        <skos:altLabel xml:lang="en">AFROC</skos:altLabel>
        <skos:altLabel xml:lang="en">AFROC analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">AFROC curve</skos:altLabel>
        <skos:altLabel xml:lang="en">alternative free-response ROC</skos:altLabel>
        <skos:altLabel xml:lang="en">alternative free-response ROC analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">alternative free-response operating characteristic analysis</skos:altLabel>
        <skos:definition xml:lang="en">Alternative Free-Response Operating Characteristic (AFROC) analysis is an evaluation method for medical imaging systems, particularly those involving lesion detection. It plots per-lesion sensitivity versus 1 minus the specificity value on a per-image (or per-case) level while changing the threshold, allowing assessment of detection performance without a fixed number of response alternatives.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03532 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03532">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1109/TMI.2010.2072789"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="en">competition performance metric</rdfs:label>
        <rdfs:label xml:lang="es">métrica de rendimiento de la competición</rdfs:label>
        <rdfs:label xml:lang="zh">竞争绩效指标</rdfs:label>
        <skos:altLabel xml:lang="en">CPM</skos:altLabel>
        <skos:definition xml:lang="en">The competition performance metric summarizes the detection performance of a computer-aided detection system by averaging its sensitivities at a set of predefined false positive rates. It is derived from the free response operating characteristic curve, which relates sensitivity to the number of false positives per image. This metric provides a standardized single-value measure that emphasizes performance at low false positive rates, making it suitable for evaluating and comparing detection systems in clinically relevant conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03533 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03533">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03637"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03321"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03537"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.jacr.2009.06.001"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/radiol.220182"/>
        <rdfs:label xml:lang="es">análisis de la curva ROC de respuesta libre</rdfs:label>
        <rdfs:label xml:lang="en">free-response receiver operating characteristic analysis</rdfs:label>
        <rdfs:label xml:lang="zh">自由响应受试者工作特征分析</rdfs:label>
        <skos:altLabel xml:lang="en">FROC</skos:altLabel>
        <skos:altLabel xml:lang="en">FROC analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">FROC curve</skos:altLabel>
        <skos:definition xml:lang="en">Free-Response Operating Characteristic (FROC) analysis evaluates imaging systems by plotting per-lesion sensitivity (true positive rate) against average number of false positives per image (or per case) while changing the threshold. Unlike ROC analysis which sets strict binary decisions at the level of image (or case) without lesion localization, free-response allows observers to indicate multiple potential lesions or findings per image.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03534 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03534">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.1807.01696"/>
        <rdfs:label xml:lang="es">error de recuperación-precisión en la localización</rdfs:label>
        <rdfs:label xml:lang="en">location recall precision error</rdfs:label>
        <rdfs:label xml:lang="zh">位置召回精度误差</rdfs:label>
        <skos:altLabel xml:lang="en">LRP</skos:altLabel>
        <skos:altLabel xml:lang="en">location recall precision</skos:altLabel>
        <skos:altLabel xml:lang="en">location recall precision metric</skos:altLabel>
        <skos:altLabel xml:lang="en">location recall precision score</skos:altLabel>
        <skos:definition xml:lang="en">Localization recall precision is an evaluation metric for object detection that combines localization accuracy with precision and recall into a single interpretable error measure. It decomposes detector performance into three components: the tightness of predicted bounding boxes, the proportion of false positives, and the proportion of false negatives, each normalized to lie between zero and one. The overall score reflects the average per-object error, with lower values indicating better performance, and can be optimized at class-specific thresholds to provide more informative insights than traditional average precision.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03536 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03536">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03328"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/1148170.1148262"/>
        <rdfs:label xml:lang="en">mean average precision</rdfs:label>
        <rdfs:label xml:lang="es">precisión media promedio</rdfs:label>
        <rdfs:label xml:lang="zh">平均精确率均值</rdfs:label>
        <skos:altLabel xml:lang="en">mAP</skos:altLabel>
        <skos:definition xml:lang="en">Mean average precision is an evaluation metric that summarizes the effectiveness of a system across multiple queries or tasks by averaging the average precision values for each. It reflects the ability of a model to retrieve relevant items by considering both the precision and recall at various thresholds for every query, then aggregating these results into a single overall score.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03537 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03537">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:comment xml:lang="en">This measure captures the balance between correctly identifying targets and the burden of spurious detections by linking recall to a fixed false-positive operating level.</rdfs:comment>
        <rdfs:label xml:lang="es">sensibilidad a falsos positivos por imagen</rdfs:label>
        <rdfs:label xml:lang="en">sensitivity at false-positive per image</rdfs:label>
        <rdfs:label xml:lang="zh">每张图像的假阳性率下的灵敏度</rdfs:label>
        <skos:definition xml:lang="en">Sensitivity at false-positives per image is a detection performance measure that quantifies the proportion of true findings correctly localized by a model when evaluated at a specified average number of false detections per image.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03538 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03538">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03343"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12880-015-0068-x"/>
        <rdfs:label xml:lang="en">average Hausdorff distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia de Hausdorff promedio</rdfs:label>
        <rdfs:label xml:lang="zh">平均豪斯多夫距离</rdfs:label>
        <skos:altLabel xml:lang="en">AHD</skos:altLabel>
        <skos:definition xml:lang="en">Average Hausdorff distance computes the mean of directed distances between boundary points of two segmentations, offering a less outlier-sensitive alternative to the standard Hausdorff distance. It captures the overall similarity of boundaries rather than focusing solely on the most discrepant point. This metric is commonly used in segmentation evaluation where global contour alignment is of interest.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03540 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03540">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12880-015-0068-x"/>
        <rdfs:label xml:lang="es">error de consistencia global</rdfs:label>
        <rdfs:label xml:lang="en">global consistency error</rdfs:label>
        <rdfs:label xml:lang="zh">全局一致性误差</rdfs:label>
        <skos:altLabel xml:lang="en">GCE</skos:altLabel>
        <skos:definition xml:lang="en">Global consistency error measures segmentation consistency by aggregating voxel-level refinement errors between two regions. It accounts for hierarchical differences by evaluating whether one segmentation can be interpreted as a refinement of the other. This metric provides a symmetric score that penalizes structural inconsistencies while tolerating permissible refinements.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03541 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03541">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1093/biomet/75.4.731"/>
        <rdfs:label xml:lang="es">coeficiente de correlación entre clases</rdfs:label>
        <rdfs:label xml:lang="en">interclass correlation coefficient</rdfs:label>
        <rdfs:label xml:lang="zh">类间相关系数</rdfs:label>
        <skos:altLabel xml:lang="en">interclass correlation</skos:altLabel>
        <skos:definition xml:lang="en">The interclass correlation coefficient is a statistical measure of resemblance between two related but distinct groups of observations. It quantifies the degree of linear association between paired measurements drawn from different classes, such as one set representing a source group and the other representing a related target group. Unlike the intraclass correlation coefficient, which captures similarity among members within the same class, the interclass correlation coefficient is designed to characterize cross-class relationships, making it particularly relevant in studies of inheritance, paired group comparisons, and other contexts where associations between distinct categories are of interest.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03542 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03542">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12880-015-0068-x"/>
        <rdfs:label xml:lang="en">Mahalanobis distance</rdfs:label>
        <rdfs:label xml:lang="zh">Mahalanobis 距离</rdfs:label>
        <rdfs:label xml:lang="es">distancia de Mahalanobis</rdfs:label>
        <skos:altLabel xml:lang="en">MHD</skos:altLabel>
        <skos:definition xml:lang="en">Mahalanobis Distance evaluates the separation between two sets of points by considering their covariance structure, thus reflecting correlations in the data. It measures the distance between the means of two point sets normalized by their combined variance. This metric is suited for assessing global shape differences in segmentation tasks rather than pointwise errors.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03544 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03544">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-540-45167-9_14"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.jmva.2006.11.013"/>
        <rdfs:label xml:lang="es">variación de la información</rdfs:label>
        <rdfs:label xml:lang="en">variation of information</rdfs:label>
        <rdfs:label xml:lang="zh">信息变异</rdfs:label>
        <skos:altLabel xml:lang="en">VI</skos:altLabel>
        <skos:altLabel xml:lang="en">VOI</skos:altLabel>
        <skos:definition xml:lang="en">The variation of information is an information-theoretic metric used to quantify the difference between two clusterings of the same dataset. It is defined in terms of Shannon entropy and mutual information, and measures the amount of information lost from one clustering and gained in moving to the other. The variation of information is non-negative, symmetric, and satisfies the triangle inequality, making it a true distance metric; it penalizes both over-splitting and merging of clusters, is sensitive to local changes, and allows consistent comparison of clustering solutions across datasets and algorithms.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03545 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03545">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12880-015-0068-x"/>
        <rdfs:comment xml:lang="en">The Rand index is a ratio, related to the notion of accuracy (STATO_0000415), which is used to compare the similarity of two clustering outcomes.</rdfs:comment>
        <rdfs:label xml:lang="en">Rand index</rdfs:label>
        <rdfs:label xml:lang="zh">Rand 指数</rdfs:label>
        <rdfs:label xml:lang="es">índice de Rand</rdfs:label>
        <skos:altLabel xml:lang="en">RI</skos:altLabel>
        <skos:definition xml:lang="en">Rand index quantifies the similarity between two data partitions by evaluating all possible pairs of elements and determining whether they are assigned consistently in both partitions. It considers agreements where pairs are placed in the same group or in different groups across both segmentations. Adjusted versions incorporate a correction for chance agreement, providing a normalized measure of clustering or segmentation consistency.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000592"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03546 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03546">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12880-015-0068-x"/>
        <rdfs:label xml:lang="es">similitud volumétrica</rdfs:label>
        <rdfs:label xml:lang="en">volumetric similarity</rdfs:label>
        <rdfs:label xml:lang="zh">体积相似度</rdfs:label>
        <skos:altLabel xml:lang="en">VS</skos:altLabel>
        <skos:altLabel xml:lang="zh">立体相似度</skos:altLabel>
        <skos:definition xml:lang="en">Volumetric similarity assesses agreement between two segmentations by measuring the absolute difference in their volumes relative to their combined size. It captures size-related discrepancies without considering positional alignment or boundary accuracy. This metric is particularly relevant when accurate volume estimation impacts clinical decision-making, such as tumor burden analysis.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03547 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03547">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/0005-2795(75)90109-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="en">Matthews correlation coefficient</rdfs:label>
        <rdfs:label xml:lang="es">coeficiente de correlación de Matthews</rdfs:label>
        <rdfs:label xml:lang="zh">马修斯相关系数</rdfs:label>
        <skos:altLabel xml:lang="en">MCC</skos:altLabel>
        <skos:altLabel xml:lang="es">coeficiente phi</skos:altLabel>
        <skos:altLabel xml:lang="en">mean square contingency coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">phi</skos:altLabel>
        <skos:altLabel xml:lang="en">phi coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">φ</skos:altLabel>
        <skos:altLabel xml:lang="en">φ coefficient</skos:altLabel>
        <skos:definition xml:lang="en">Matthews correlation coefficient evaluates the correlation between observed and predicted classifications, considering all four confusion matrix components. It provides a single summary score that reflects both correct and incorrect predictions across classes. It is regarded as a balanced metric even in the presence of class imbalance.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000524"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03548 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03548">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03640"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03307"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03320"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03324"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03325"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03326"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03339"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03340"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03342"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03356"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03547"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03707"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04073"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04074"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04080"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04081"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">confusion matrix</rdfs:label>
        <rdfs:label xml:lang="es">matriz de confusión</rdfs:label>
        <rdfs:label xml:lang="zh">混淆矩阵</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Confusion_matrix"/>
        <rdfs:seeAlso rdf:resource="https://es.wikipedia.org/wiki/Matriz_de_confusi%C3%B3n"/>
        <skos:altLabel xml:lang="en">error table</skos:altLabel>
        <skos:altLabel xml:lang="es">matriz de errores</skos:altLabel>
        <skos:altLabel xml:lang="en">table of confusion</skos:altLabel>
        <skos:definition xml:lang="en">A matrix that displays observed vs. predicted classes. Each row in a confusion matrix represents a true (observed) class and each column represents a predicted class. The value of each cell of the matrix is the number of instances of that combination of observed and predicted classes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03549 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03549">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.neucom.2015.12.114"/>
        <rdfs:label xml:lang="es">error porcentual absoluto medio</rdfs:label>
        <rdfs:label xml:lang="en">mean absolute percentage error</rdfs:label>
        <rdfs:label xml:lang="zh">平均绝对百分比误差</rdfs:label>
        <skos:altLabel xml:lang="en">MAPE</skos:altLabel>
        <skos:definition xml:lang="en">Mean absolute percentage error is a regression accuracy measure that quantifies prediction error as a relative percentage. It is defined as the average of the absolute differences between predicted and true values, divided by the corresponding true values. This formulation makes the metric scale-independent but can become unstable when actual values are close to zero.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03550 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03550">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.ijforecast.2006.03.001"/>
        <rdfs:label xml:lang="es">error escalado absoluto medio</rdfs:label>
        <rdfs:label xml:lang="en">mean absolute scaled error</rdfs:label>
        <rdfs:label xml:lang="zh">平均绝对标度误差</rdfs:label>
        <skos:altLabel xml:lang="en">MASE</skos:altLabel>
        <skos:definition xml:lang="en">Mean absolute scaled error is a scale-independent measure of forecast accuracy that compares the mean absolute error of a model to that of a naïve baseline forecast. It is calculated by dividing the average absolute prediction error by the average absolute error from a one-step naïve forecast, with seasonal variants using a seasonal naïve baseline. A value equal to one indicates performance equivalent to the naïve method, values below one reflect improvement, and values above one indicate worse performance, making the metric interpretable, symmetric, and robust across datasets with different scales or containing zeros.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03551 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03551">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2102.01454"/>
        <rdfs:label xml:lang="en">MAUVE</rdfs:label>
        <rdfs:label xml:lang="es">MAUVE</rdfs:label>
        <rdfs:label xml:lang="zh">人机文本分布散度曲线评估指标</rdfs:label>
        <skos:altLabel xml:lang="en">Measure Aggregated from Unsupervised Evaluation</skos:altLabel>
        <skos:definition xml:lang="en">MAUVE measures the similarity between the distribution of machine-generated text and human-written text in open-ended generation tasks. It computes this similarity by embedding both text sets in a contextual space, quantizing them, and comparing their distributions using divergence-based methods. The score reflects how well the generated text aligns with human text in terms of both quality and diversity, with higher values indicating closer distributional alignment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03552 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03552">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.1469-8137.1912.tb05611.x"/>
        <rdfs:label xml:lang="es">intersección sobre unión media</rdfs:label>
        <rdfs:label xml:lang="en">mean intersection over union</rdfs:label>
        <rdfs:label xml:lang="zh">平均交并比</rdfs:label>
        <skos:altLabel xml:lang="en">mean IoU</skos:altLabel>
        <skos:definition xml:lang="en">Mean intersection over union aggregates intersection-over-union values computed across multiple classes or instances into a single average score. It provides a balanced assessment of segmentation performance by accounting for all evaluated categories equally or with specified weights. This metric is standard in multi-class segmentation tasks to summarize overall prediction quality across diverse structures.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03553 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03553">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1080/00031305.1988.10475524"/>
        <dcterms:source rdf:resource="https://doi.org/10.1098/rspl.1895.0041"/>
        <rdfs:label xml:lang="en">Pearson correlation coefficient</rdfs:label>
        <rdfs:label xml:lang="es">coeficiente de correlación de Pearson</rdfs:label>
        <rdfs:label xml:lang="zh">皮尔逊相关系数</rdfs:label>
        <skos:altLabel xml:lang="en">Pearson r coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Pearson&apos;s correlation coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">R</skos:altLabel>
        <skos:altLabel xml:lang="en">r</skos:altLabel>
        <skos:definition xml:lang="en">The Pearson correlation coefficient is a dimensionless statistic that quantifies the strength and direction of a linear relationship between two continuous variables. It is computed by standardizing the covariance of the variables, producing a value between –1 and +1, where the sign indicates the direction of association and the magnitude reflects its strength. Statistical inference for this coefficient commonly assumes that the paired variables are jointly normally distributed, particularly when deriving p-values or confidence intervals.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000280"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03554 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03554">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.7717/peerj-cs.623"/>
        <rdfs:label xml:lang="es">R cuadrado</rdfs:label>
        <rdfs:label xml:lang="en">R-squared</rdfs:label>
        <rdfs:label xml:lang="zh">R方</rdfs:label>
        <skos:altLabel xml:lang="en">R squared</skos:altLabel>
        <skos:altLabel xml:lang="zh">R2</skos:altLabel>
        <skos:altLabel xml:lang="en">R²</skos:altLabel>
        <skos:altLabel xml:lang="en">coefficient of determination</skos:altLabel>
        <skos:altLabel xml:lang="en">r^2</skos:altLabel>
        <skos:altLabel xml:lang="en">r²</skos:altLabel>
        <skos:definition xml:lang="en">The coefficient of determination (R^2), is a statistical measure that expresses the proportion of variance in a dependent variable that is explained by the independent variable(s) in a regression model. It is calculated from the squared Pearson correlation between predicted and observed values and commonly ranges from 0 (no variance explained) to 1 (all variance explained), though values below 0 can occur when the model performs worse than a mean-based prediction. R^2 is widely used to assess the goodness of fit in regression analysis, with higher values indicating greater explanatory power.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03555 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03555">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03549"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/0169-2070(92)90008-W"/>
        <rdfs:label xml:lang="es">error porcentual absoluto medio simétrico</rdfs:label>
        <rdfs:label xml:lang="en">symmetric mean absolute percentage error</rdfs:label>
        <rdfs:label xml:lang="zh">对称平均绝对百分比误差</rdfs:label>
        <skos:altLabel xml:lang="en">sMAPE</skos:altLabel>
        <skos:definition xml:lang="en">Symmetric mean absolute percentage error is a modification of mean absolute percentage error that addresses its asymmetry in penalizing over- and under-predictions. It is defined as the average of the absolute differences between predicted and true values, divided by the mean of their absolute values. This metric is bounded between 0% and 200%, ensuring equal treatment of overestimation and underestimation of the same magnitude.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03556 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03556">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01047"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1002/j.1538-7305.1948.tb01338.x"/>
        <rdfs:label xml:lang="en">entropy</rdfs:label>
        <rdfs:label xml:lang="es">entropía</rdfs:label>
        <rdfs:label xml:lang="zh">熵</rdfs:label>
        <skos:definition xml:lang="en">Entropy is a measure of the average uncertainty or information content associated with a discrete random variable. It quantifies the expected amount of information required to describe the outcome of the variable, based on its probability distribution. Higher entropy corresponds to greater unpredictability in outcomes, while lower entropy reflects more certainty.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03557 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03557">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01053"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0077089"/>
        <rdfs:label xml:lang="es">relación señal-ruido</rdfs:label>
        <rdfs:label xml:lang="en">signal-to-noise ratio</rdfs:label>
        <rdfs:label xml:lang="zh">信噪比</rdfs:label>
        <skos:altLabel xml:lang="en">S-N ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">S/N</skos:altLabel>
        <skos:altLabel xml:lang="en">S/N ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">SNR</skos:altLabel>
        <skos:altLabel xml:lang="en">signal to noise ratio</skos:altLabel>
        <skos:definition xml:lang="en">Signal-to-noise ratio quantifies the relationship between the strength of a signal and the level of background noise in a measurement or image. It is calculated as the ratio of the mean signal intensity to the standard deviation of the noise, indicating how clearly the signal can be distinguished from noise. Higher signal-to-noise ratio values correspond to better image or data quality.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000050"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03558 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03558">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03557"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/QoMEX.2012.6263880"/>
        <rdfs:label xml:lang="en">peak signal-to-noise ratio</rdfs:label>
        <rdfs:label xml:lang="es">relación señal-ruido máxima</rdfs:label>
        <rdfs:label xml:lang="zh">峰值信噪比</rdfs:label>
        <skos:altLabel xml:lang="en">PSNR</skos:altLabel>
        <skos:altLabel xml:lang="en">peak SNR</skos:altLabel>
        <skos:definition xml:lang="en">Peak signal-to-noise ratio evaluates the fidelity of a reconstructed or compressed image compared to its original version. It is based on the mean squared error between corresponding pixels and expressed as a logarithmic ratio relative to the maximum possible signal value. Higher peak signal-to-noise ratio values generally indicate less distortion and better preservation of the original image quality.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03559 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03559">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04061"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04062"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1198/016214506000001437"/>
        <rdfs:label xml:lang="en">multiclass Brier score</rdfs:label>
        <rdfs:label xml:lang="es">puntuación Brier multiclase</rdfs:label>
        <rdfs:label xml:lang="zh">多分类 Brier 分数</rdfs:label>
        <skos:definition xml:lang="en">The multiclass Brier score extends the Brier score to multi-class classification by computing the mean squared difference between the predicted probability distribution over all classes and the true one-hot encoded outcome. It summarizes both calibration and discrimination across all classes into a single value, with lower scores indicating more accurate probabilistic predictions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03561 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03561">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03566"/>
        <rdfs:label xml:lang="en">medical record number</rdfs:label>
        <rdfs:label xml:lang="es">número de historia clínica</rdfs:label>
        <rdfs:label xml:lang="zh">病历号</rdfs:label>
        <skos:altLabel xml:lang="en">MRN</skos:altLabel>
        <skos:definition xml:lang="en">A Medical Record Number (MRN) is a unique identifier assigned by a healthcare organization to a patient or study participant to manage their clinical records within that specific healthcare system.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/398225001"/>
        <skos:exactMatch rdf:resource="http://www.radlex.org/RID/RID13161"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03562 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03562">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03561"/>
        <rdfs:label xml:lang="en">actual medical record number</rdfs:label>
        <rdfs:label xml:lang="es">número real de historia clínica</rdfs:label>
        <rdfs:label xml:lang="zh">实际病历号</rdfs:label>
        <skos:altLabel xml:lang="en">actual MRN</skos:altLabel>
        <skos:definition xml:lang="en">The actual (not de-identified) identifier of a patient or study participant.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03563 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03563">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03561"/>
        <rdfs:label xml:lang="es">número seudonimizado de historia clínica</rdfs:label>
        <rdfs:label xml:lang="en">pseudonymized medical record number</rdfs:label>
        <rdfs:label xml:lang="zh">匿名化病历号</rdfs:label>
        <skos:altLabel xml:lang="en">pseudo MRN</skos:altLabel>
        <skos:definition xml:lang="en">A pseudonymized medical record number (MRN) is an artificial identifier—such as a token, scrambled code, or random number—that replaces a patient&apos;s actual MRN to protect privacy. It allows researchers to link, track, and analyze longitudinal data for the same patient across different systems without accessing direct identifiers,</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03564 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03564">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03565"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00258"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00424"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00551"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">determinante social de la salud</rdfs:label>
        <rdfs:label xml:lang="en">social determinant of health</rdfs:label>
        <rdfs:label xml:lang="zh">健康社会决定因素</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Social_determinants_of_health"/>
        <rdfs:seeAlso rdf:resource="https://odphp.health.gov/healthypeople/priority-areas/social-determinants-health"/>
        <skos:altLabel xml:lang="en">SDOH</skos:altLabel>
        <skos:altLabel xml:lang="en">social determinants of health</skos:altLabel>
        <skos:definition xml:lang="en">A non-medical factor that influences health outcomes, including social conditions in which people are born, live, learn, work, play, worship, and age.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03565 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03565">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03422"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00239"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00253"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00258"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00305"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00309"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00358"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00458"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00583"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00616"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00638"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">demographic descriptor</rdfs:label>
        <rdfs:label xml:lang="es">descriptor demográfico</rdfs:label>
        <rdfs:label xml:lang="zh">人口统计学描述符</rdfs:label>
        <skos:definition xml:lang="en">A patient descriptor, such as age, sex, and race / ethnicity</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03566 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03566">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03422"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00196"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00213"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">identificador único de paciente</rdfs:label>
        <rdfs:label xml:lang="en">unique patient identifier</rdfs:label>
        <rdfs:label xml:lang="zh">唯一患者标识符</rdfs:label>
        <skos:altLabel xml:lang="en">UPI</skos:altLabel>
        <skos:definition xml:lang="en">A Unique Patient Identifier (UPI) is a distinct, non-changing alphanumeric code assigned to a single person to accurately link them to their medical information.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03567 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03567">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00029"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.neucom.2025.129584"/>
        <rdfs:label xml:lang="en">instance segmentation</rdfs:label>
        <rdfs:label xml:lang="es">segmentación de instancias</rdfs:label>
        <rdfs:label xml:lang="zh">实例分割</rdfs:label>
        <skos:definition xml:lang="en">Instance segmentation is an approach that identifies, for every pixel, the specific belonging instance of the object. It detects each distinct object of interest in the image.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03568 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03568">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00029"/>
        <dcterms:source rdf:resource="https://arxiv.org/abs/2302.06378"/>
        <rdfs:label xml:lang="es">segmentación semántica</rdfs:label>
        <rdfs:label xml:lang="en">semantic segmentation</rdfs:label>
        <rdfs:label xml:lang="zh">语义分割</rdfs:label>
        <skos:definition xml:lang="en">Semantic segmentation is a computer vision technique that classifies every pixel in an image into a specific category.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03570 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03570">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03641"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03653"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03654"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/hasScalarMetric"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/03655"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12916-019-1466-7"/>
        <rdfs:label xml:lang="en">calibration curve</rdfs:label>
        <rdfs:label xml:lang="es">curva de calibración</rdfs:label>
        <rdfs:label xml:lang="zh">校准曲线</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Calibration_curve"/>
        <skos:altLabel xml:lang="en">calibration analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">calibration plot</skos:altLabel>
        <skos:definition xml:lang="en">Calibration in statistical modeling refers to the agreement between predicted probabilities and observed outcomes. A well-calibrated model will have predicted probabilities that match the empirical frequencies of events.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000655"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03571 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03571">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0962280214537390"/>
        <rdfs:label xml:lang="es">coeficiente de correlación de concordancia</rdfs:label>
        <rdfs:label xml:lang="en">concordance correlation coefficient</rdfs:label>
        <rdfs:label xml:lang="zh">一致性相关系数</rdfs:label>
        <skos:altLabel xml:lang="en">CCC</skos:altLabel>
        <skos:definition xml:lang="en">The concordance correlation coefficient measures the agreement between two continuous variables by evaluating both their correlation and their deviation from the line of perfect concordance (y = x). It combines precision (strength of linear association) and accuracy (closeness to the 45° line) into a single metric, making it suitable for assessing the closeness of predicted and reference values. Higher values indicate stronger agreement, while lower values reflect greater bias or variability between the two measurements.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03572 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03572">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1186/1471-2288-12-82"/>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2021.0223"/>
        <rdfs:label xml:lang="en">concordance index</rdfs:label>
        <rdfs:label xml:lang="es">índice de concordancia</rdfs:label>
        <rdfs:label xml:lang="zh">一致性指数</rdfs:label>
        <skos:altLabel xml:lang="en">C index</skos:altLabel>
        <skos:altLabel xml:lang="en">C statistic</skos:altLabel>
        <skos:altLabel xml:lang="en">C-index</skos:altLabel>
        <skos:altLabel xml:lang="en">concordance statistic</skos:altLabel>
        <skos:definition xml:lang="en">The concordance index is a rank-based measure of model discrimination that quantifies the probability that, for a randomly chosen pair of subjects with different outcomes, the subject experiencing the event (or an earlier event time) is assigned a higher predicted risk. For binary outcomes, it is mathematically equivalent to the area under the ROC curve. In survival analysis, it generalizes by comparing risk orderings with observed event times while accounting for censoring.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03573 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03573">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/0030-5073(82)90237-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="en">discrimination slope</rdfs:label>
        <rdfs:label xml:lang="es">pendiente de discriminación</rdfs:label>
        <rdfs:label xml:lang="zh">判别斜率</rdfs:label>
        <skos:definition xml:lang="en">Discrimination slope quantifies a model&apos;s ability to distinguish between two outcome classes by comparing predicted probabilities. It is calculated as the difference between the mean predicted likelihood for cases with the outcome and the mean predicted likelihood for cases without the outcome. Higher values indicate better separation between outcome categories.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03574 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03574">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0962280214537390"/>
        <rdfs:label xml:lang="es">coeficiente de correlación intraclase</rdfs:label>
        <rdfs:label xml:lang="en">intraclass correlation coefficient</rdfs:label>
        <rdfs:label xml:lang="zh">组内相关系数</rdfs:label>
        <skos:altLabel xml:lang="en">ICC</skos:altLabel>
        <skos:definition xml:lang="en">Intraclass correlation coefficient evaluates the degree of agreement or consistency between repeated measurements or ratings of the same quantity. It represents the proportion of total variance attributable to differences between subjects rather than measurement error. Higher values denote greater reliability of the estimation process.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03576 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03576">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03528"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1364/oe.16.008150"/>
        <rdfs:label xml:lang="en">ensemble mean square error</rdfs:label>
        <rdfs:label xml:lang="es">error cuadrático medio del conjunto</rdfs:label>
        <rdfs:label xml:lang="zh">集成均方误差</rdfs:label>
        <skos:altLabel xml:lang="en">EMSE</skos:altLabel>
        <skos:definition xml:lang="en">Ensemble mean-square error is the average of mean-square error values computed across a range of reference parameter values. It summarizes an estimator’s performance over its full operating range rather than at a single reference point. This measure is useful for assessing generalizability and robustness.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03577 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03577">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0962280214537390"/>
        <rdfs:label xml:lang="es">coeficiente de repetibilidad</rdfs:label>
        <rdfs:label xml:lang="en">repeatability coefficient</rdfs:label>
        <rdfs:label xml:lang="zh">重复性系数</rdfs:label>
        <skos:altLabel xml:lang="en">RC</skos:altLabel>
        <skos:definition xml:lang="en">Repeatability coefficient represents the smallest difference between two measurements under identical conditions that can be considered statistically significant. It reflects the short-term precision of an estimator when system, operator, and protocol remain constant. Smaller values correspond to greater measurement consistency.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03578 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03578">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0962280214537390"/>
        <rdfs:label xml:lang="es">coeficiente de reproducibilidad</rdfs:label>
        <rdfs:label xml:lang="en">reproducibility coefficient</rdfs:label>
        <rdfs:label xml:lang="zh">可重复性系数</rdfs:label>
        <skos:altLabel xml:lang="en">RDC</skos:altLabel>
        <skos:definition xml:lang="en">Reproducibility coefficient represents the smallest difference between two measurements obtained under varying conditions that can be considered statistically significant. It captures the long-term or multi-setting precision of an estimator, accounting for differences in sites, operators, or equipment. Lower values indicate higher robustness across conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03580 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03580">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1080/02664763.2016.1174195"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0962280214537390"/>
        <rdfs:label xml:lang="en">coefficient of variation</rdfs:label>
        <rdfs:label xml:lang="es">coeficiente de variación</rdfs:label>
        <rdfs:label xml:lang="zh">变异系数</rdfs:label>
        <skos:altLabel xml:lang="en">CV</skos:altLabel>
        <skos:altLabel xml:lang="en">RSD</skos:altLabel>
        <skos:altLabel xml:lang="en">relative standard deviation</skos:altLabel>
        <skos:definition xml:lang="en">The coefficient of variation is a standardized measure of relative variability, defined as the ratio of the standard deviation to the mean of a dataset. It is dimensionless, allowing direct comparison of variability across datasets with different units or scales. While widely used, it becomes unstable when the mean is near zero and is sensitive to outliers, limiting its interpretability in some contexts.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000236"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03584 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03584">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03564"/>
        <rdfs:comment>SOHO:100100001</rdfs:comment>
        <rdfs:label xml:lang="es">acceso y calidad de la educación</rdfs:label>
        <rdfs:label xml:lang="en">education access and quality</rdfs:label>
        <rdfs:label xml:lang="zh">教育机会和质量</rdfs:label>
        <skos:definition xml:lang="en">Education also influences health and well-being. Education factors include early childhood education and development, graduating from high school, receiving higher education, and even English knowledge and literacy.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03585 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03585">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03564"/>
        <rdfs:comment>SOHO:100400001</rdfs:comment>
        <rdfs:label xml:lang="es">entorno vecinal y urbano</rdfs:label>
        <rdfs:label xml:lang="en">neighborhood and built environment</rdfs:label>
        <rdfs:label xml:lang="zh">社区和建筑环境</rdfs:label>
        <skos:definition xml:lang="en">As a social determinant of health, the neighborhood and built environment affect health outcomes through quality of housing, access to transportation, access to healthy foods and clean water, air quality inside and outside, and the impact of crime and violence on people who live in the area.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03586 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03586">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03564"/>
        <rdfs:comment>SOHO:10060001</rdfs:comment>
        <rdfs:label xml:lang="es">contexto social y comunitario</rdfs:label>
        <rdfs:label xml:lang="en">social and community context</rdfs:label>
        <rdfs:label xml:lang="zh">社会和社区背景</rdfs:label>
        <skos:definition xml:lang="en">Social and community context is a social determinant of health, covering the contexts in which people live, study, work, and relax. The sense of belonging to a community, workplace conditions, and discrimination or racism all impact people&apos;s health.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03587 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03587">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03564"/>
        <rdfs:comment xml:lang="en">Healthcare cannot be left out of social determinants of health, of course. Access to healthcare is not equal, and people&apos;s financial and physical access to healthcare, as well as their understanding of health services and their health, is a major social determinant of health. This includes access to primary care, access to specialty care, health insurance coverage, and health literacy. Health literacy is especially salient as a non-medical social factor, for example, whether people know how to prevent painful kidney stones that can be risky to remove surgically by proper diet and staying hydrated—things people know they “should” do. Yet, it’s difficult to attach importance to it without knowing why.</rdfs:comment>
        <rdfs:comment>SOHO:100500001</rdfs:comment>
        <rdfs:label xml:lang="es">acceso y calidad de la atención médica</rdfs:label>
        <rdfs:label xml:lang="en">health care access and quality</rdfs:label>
        <rdfs:label xml:lang="zh">医疗保健的可及性和质量</rdfs:label>
        <skos:definition xml:lang="en">Healthcare access is a social determinant of health. Disparities in healthcare access contribute to inequities in health outcomes among different populations.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03588 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03588">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03564"/>
        <rdfs:comment>SOHO:10090001</rdfs:comment>
        <rdfs:label xml:lang="en">economic stability</rdfs:label>
        <rdfs:label xml:lang="es">estabilidad económica</rdfs:label>
        <rdfs:label xml:lang="zh">经济稳定</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://odphp.health.gov/healthypeople/objectives-and-data/browse-objectives/economic-stability"/>
        <skos:definition xml:lang="en">Economic stability refers to people&apos;s income, socioeconomic status, and cost of living, with factors such as poverty, unemployment or underemployment, food insecurity, and housing instability negatively impacting health.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03589 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03589">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03564"/>
        <rdfs:label xml:lang="en">disability</rdfs:label>
        <rdfs:label xml:lang="es">discapacidad</rdfs:label>
        <rdfs:label xml:lang="zh">残疾</rdfs:label>
        <skos:definition xml:lang="en">Disability is a social determinant of health. Disabled people can face health disparities, including a shortened life expectancy and higher rates of preventable chronic conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03591 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03591">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03565"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00253"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00287"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">descriptor geográfico</rdfs:label>
        <rdfs:label xml:lang="en">geographic descriptor</rdfs:label>
        <rdfs:label xml:lang="zh">地理描述符</rdfs:label>
        <skos:definition xml:lang="en">An index to the geographic area in which a person lives or works, such as postal code.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03592 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03592">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03591"/>
        <rdfs:label xml:lang="es">código postal</rdfs:label>
        <rdfs:label xml:lang="en">postal code</rdfs:label>
        <rdfs:label xml:lang="zh">邮政编码</rdfs:label>
        <skos:altLabel xml:lang="en">PIN code</skos:altLabel>
        <skos:altLabel xml:lang="en">ZIP code</skos:altLabel>
        <skos:altLabel xml:lang="en">post code</skos:altLabel>
        <skos:altLabel xml:lang="en">postcode</skos:altLabel>
        <skos:definition xml:lang="en">A postal code is a series of letters and/or digits added to a postal address to identify a specific geographic area.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/184102003"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/IAO_0000646"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03593 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03593">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.ejmp.2024.104842"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/ryai.230513"/>
        <dcterms:source rdf:resource="https://doi.org/10.2214/AJR.25.34340"/>
        <rdfs:comment xml:lang="en">The number of enhanced detection cases for the task is defined as the number of reference-standard positive cases that were detected by AI (i.e., AI true-positive) but missed by the radiologist (i.e., radiologist false-negative).</rdfs:comment>
        <rdfs:label xml:lang="en">enhanced detection rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de detección mejorada</rdfs:label>
        <rdfs:label xml:lang="zh">提高检测率</rdfs:label>
        <skos:altLabel xml:lang="en">AI-enhanced detection rate</skos:altLabel>
        <skos:altLabel xml:lang="en">EDR</skos:altLabel>
        <skos:definition xml:lang="en">The enhanced detection rate is a metric that quantifies the additional diagnostic value contributed by an artificial intelligence system when combined with a human reader. It is defined as the proportion of true positive cases correctly identified by the artificial intelligence but missed by the radiologist, relative to the number of positive cases detected by the radiologist. This measure reflects the incremental gain in sensitivity provided by artificial intelligence beyond the baseline human performance.

                                         EDR = (the number of AI-positive exams not detected by the human reader) / (the number of human-detected positive exams)</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03595 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03595">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">(Kottler N, personal communication).</rdfs:comment>
        <rdfs:label xml:lang="en">negative discordance rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de discordancia negativa</rdfs:label>
        <rdfs:label xml:lang="zh">阴性不一致率</rdfs:label>
        <skos:altLabel xml:lang="en">NDR</skos:altLabel>
        <skos:definition xml:lang="en">Negative discordance rate = 1 - negative percent agreement</skos:definition>
    </owl:Class>
    


