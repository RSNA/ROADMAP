        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">DECIDE-AI item I - Abstract</rdfs:label>
        <skos:definition xml:lang="en">Provide a structured summary of the study. Consider including: intended use of the AI system, type of underlying algorithm, study setting, number of patients and users included, primary and secondary outcomes, key safety endpoints, human factors evaluated, main results, conclusions.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00568 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00568">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 2 - Intended use</rdfs:label>
        <skos:definition xml:lang="en">a) Describe the targeted medical condition(s) and problem(s), including the current standard practice, and the
intended patient population(s).
b) Describe the intended users of the AI system, its planned integration in the care pathway, and the potential
effect, including patient outcomes, that it is intended to have.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00569 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00569">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <rdfs:label xml:lang="en">DECIDE-AI item II - Objectives</rdfs:label>
        <skos:definition xml:lang="en">State the study objectives.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00570 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00570">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:label xml:lang="en">DECIDE-AI item III - Research governance</rdfs:label>
        <skos:definition xml:lang="en">Provide a reference to any study protocol, study registration number, and ethics approval.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00571 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00571">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 3 - Participants</rdfs:label>
        <skos:definition xml:lang="en">a) Describe how patients were recruited, stating the inclusion and exclusion criteria at both patient and data level, and how the number of recruited patients was decided.
b) Describe how users were recruited, stating the inclusion and exclusion criteria, and how the intended number of recruited users was decided.
c) Describe steps taken to familiarize the users with the AI system, including any training received before the study.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00572 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00572">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 4 - AI system</rdfs:label>
        <skos:definition xml:lang="en">a) Briefly describe the AI system, specifying its version and type of underlying algorithm used. Describe, or provide a direct reference to, the characteristics of the patient population on which the algorithm was trained and its performance in preclinical development/validation studies.
b) Identify the data used as inputs. Describe how the data were acquired, the process needed to enter the input data, the pre-processing applied, and how missing/low-quality data were handled.
c) Describe the AI system outputs and how they were presented to the users (an image may be useful).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00573 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00573">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 5 - Implementation</rdfs:label>
        <skos:definition xml:lang="en">a) Describe the settings in which the AI system was evaluated.
b) Describe the clinical workflow/care pathway in which the AI system was evaluated, the timing of its use, and how the final supported decision was reached and by whom.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00574 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00574">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">DECIDE-AI item IV - Outcomes</rdfs:label>
        <skos:definition xml:lang="en">Specify the primary and secondary outcomes measured.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00575 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00575">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 6 - Safety and errors</rdfs:label>
        <skos:definition xml:lang="en">a) Provide a description of how significant errors/malfunctions were defined and identified.
b) Describe how any risks to patient safety or instances of harm were identified, analyzed, and minimized.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00576 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00576">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 7 - Human factors</rdfs:label>
        <skos:definition xml:lang="en">Describe the human factors tools, methods or frameworks used, the use cases considered, and the users involved.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00577 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00577">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">DECIDE-AI item V - Analysis</rdfs:label>
        <skos:definition xml:lang="en">Describe the statistical methods by which the primary and secondary outcomes were analysed, as well as any prespecified additional analyses, including subgroup analyses and their rationale.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00578 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00578">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 8 - Ethics</rdfs:label>
        <skos:definition xml:lang="en">Describe whether specific methodologies were utilised to fulfil an ethics-related goal (such as algorithmic fairness) and their rationale.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00579 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00579">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">DECIDE-AI item VI - Patient involvement</rdfs:label>
        <skos:definition xml:lang="en">State how patients were involved in any aspect of: the development of the research question, the study design, and the conduct of the study.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00580 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00580">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 9 - Participants</rdfs:label>
        <skos:definition xml:lang="en">a) Describe the baseline characteristics of the patients included in the study, and report on input data missingness.
b) Describe the baseline characteristics of the users included in the study.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00581 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00581">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 10 - Implementation</rdfs:label>
        <skos:definition xml:lang="en">a) Report on the user exposure to the AI system, on the number of instances the AI system was used, and on the users’ adherence to the intended implementation.
b) Report any significant changes to the clinical workflow or care pathway caused by the AI system.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00582 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00582">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">DECIDE-AI item VII - Main results</rdfs:label>
        <skos:definition xml:lang="en">Report on the prespecified outcomes, including outcomes for any comparison group if applicable.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00583 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00583">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">DECIDE-AI item VIII - Subgroups analysis</rdfs:label>
        <skos:definition xml:lang="en">Report on the differences in the main outcomes according to the prespecified subgroups.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00584 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00584">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 11 - Modifications</rdfs:label>
        <skos:definition xml:lang="en">Report any changes made to the AI system or its hardware platform during the study. Report the timing of these modifications, the rationale for each, and any changes in outcomes observed after each of them.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00585 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00585">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 12 - Human-computer agreement</rdfs:label>
        <skos:definition xml:lang="en">Report on the user agreement with the AI system. Describe any instances of and reasons for user variation from the AI system’s recommendations and, if applicable, users changing their mind based on the AI system’s recommendations.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00586 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00586">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 13 - Safety and errors</rdfs:label>
        <skos:definition xml:lang="en">a) List any significant errors/malfunctions related to: AI system recommendations, supporting software/hardware, or users. Include details of: (i) rate of occurrence, (ii) apparent causes, (iii) whether they could be corrected, and (iv) any significant potential effects on patient care.
b) Report on any risks to patient safety or observed instances of harm (including indirect harm) identified during the study.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00587 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00587">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 14 - Human factors</rdfs:label>
        <skos:definition xml:lang="en">a) Report on the usability evaluation, according to recognized standards or frameworks.
b) Report on the user learning curves evaluation.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00588 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00588">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 15 - Support for intended use</rdfs:label>
        <skos:definition xml:lang="en">Discuss whether the results obtained support the intended use of the AI system in clinical settings.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00589 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00589">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 16 - Safety and errors</rdfs:label>
        <skos:definition xml:lang="en">Discuss what the results indicate about the safety profile of the AI system. Discuss any observed errors/malfunctions and instances of harm, their implications for patient care, and whether/how they can be mitigated.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00590 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00590">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <rdfs:label xml:lang="en">DECIDE-AI item IX - Strengths and limitations</rdfs:label>
        <skos:definition xml:lang="en">Discuss the strengths and limitations of the study.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00591 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00591">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:label xml:lang="en">DECIDE-AI item 17 - Data availability</rdfs:label>
        <skos:definition xml:lang="en">Disclose if and how data and relevant code are available.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00592 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00592">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00490"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:label xml:lang="en">DECIDE-AI item X - Conflicts of interest</rdfs:label>
        <skos:definition xml:lang="en">Disclose any relevant conflicts of interest, including the source of funding for the study, the role of funders, any other roles played by commercial companies, and personal conflicts of interest for each author.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00593 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00593">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 01</rdfs:label>
        <skos:definition xml:lang="en">The clinical problem in which the model will be employed is clearly detailed in the paper.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00594 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00594">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 02</rdfs:label>
        <skos:definition xml:lang="en">The research question is clearly stated.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00595 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00595">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 03</rdfs:label>
        <skos:definition xml:lang="en">The characteristics of the cohorts (training and test sets) are detailed in the text.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00596 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00596">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 04</rdfs:label>
        <skos:definition xml:lang="en">The cohorts (training and test sets) are shown to be representative of real-world clinical settings.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00597 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00597">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 05</rdfs:label>
        <skos:definition xml:lang="en">The state-of-the-art solution used as a baseline for comparison has been identified and detailed.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00598 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00598">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 06</rdfs:label>
        <skos:definition xml:lang="en">The origin of the data is described and the original format is detailed in the paper.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00599 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00599">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 07</rdfs:label>
        <skos:definition xml:lang="en">Transformations of the data before it is applied to the proposed model are described.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00600 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00600">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 08</rdfs:label>
        <skos:definition xml:lang="en">The independence between training and test sets has been proven in the paper.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00601 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00601">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 09</rdfs:label>
        <skos:definition xml:lang="en">Details on the models that were evaluated and the code developed to select the best model are provided.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00602 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00602">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 10</rdfs:label>
        <skos:definition xml:lang="en">Is the input data type structured or unstructured?</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00603 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00603">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 11</rdfs:label>
        <skos:definition xml:lang="en">The primary metric selected to evaluate algorithm performance (e.g., AUC, F-score, etc.), including the justification for selection, has been clearly stated.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00604 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00604">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 12</rdfs:label>
        <skos:definition xml:lang="en">The primary metric selected to evaluate the clinical utility of the model (e.g., PPV, NNT, etc.), including the justification for selection, has been clearly stated.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00605 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00605">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 13</rdfs:label>
        <skos:definition xml:lang="en">The performance comparison between baseline and proposed model is presented with the appropriate statistical significance.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00606 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00606">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 14</rdfs:label>
        <skos:definition xml:lang="en">Examination technique 1. Common examination approaches based on study type: for studies involving exclusively structured data, coefficients and sensitivity analysis are often appropriate; for studies involving unstructured data in the domains of image analysis or natural language processing, saliency maps (or equivalents) and sensitivity analyses are often appropriate.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00607 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00607">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 15</rdfs:label>
        <skos:definition xml:lang="en">Examination technique 2. Common examination approaches based on study type: for studies involving exclusively structured data, coefficients and sensitivity analysis are often appropriate; for studies involving unstructured data in the domains of image analysis or natural language processing, saliency maps (or equivalents) and sensitivity analyses are often appropriate.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00608 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00608">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 16</rdfs:label>
        <skos:definition xml:lang="en">A discussion of the relevance of the examination results with respect to model/algorithm performance is presented.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00609 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00609">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 17</rdfs:label>
        <skos:definition xml:lang="en">A discussion of the feasibility and significance of model interpretability at the case level if examination methods are uninterpretable is presented.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00610 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00610">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">MI-CLAIM item 18</rdfs:label>
        <skos:definition xml:lang="en">A discussion of the reliability and robustness of the model as the underlying data distribution shifts is included.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00611 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00611">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00492"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:comment xml:lang="en">Tier 1: complete sharing of the code
Tier 2: allow a third party to evaluate the code for accuracy/fairness; share the results of this evaluation
Tier 3: release of a virtual machine (binary) for running the code on new data without sharing its details
Tier 4: no sharing</rdfs:comment>
        <rdfs:label xml:lang="en">MI-CLAIM item 19</rdfs:label>
        <skos:definition xml:lang="en">Reproducibility: choose appropriate tier of transparency.</skos:definition>
    </owl:NamedIndividual>
    


