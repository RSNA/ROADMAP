        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00652"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00653"/>
        <dcterms:source rdf:resource="https://doi.org/10.1136/bmj-2024-082505"/>
        <rdfs:label xml:lang="en">PROBAST+AI</rdfs:label>
        <skos:altLabel xml:lang="en">PROBAST-AI</skos:altLabel>
        <skos:altLabel xml:lang="en">Prediction model Risk Of Bias ASsessment Tool for Artificial Intelligence</skos:altLabel>
        <skos:definition xml:lang="en">PROBAST+AI (Prediction model Risk Of Bias ASsessment Tool for Artificial Intelligence) is an international methodological initiative that extends the original PROBAST framework. It provides structured guidance for evaluating risk of bias and applicability in studies that develop or validate AI-based prediction models, particularly in health research.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00489 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00489">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00174"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41591-021-01517-0"/>
        <dcterms:source rdf:resource="https://doi.org/10.2196/58202"/>
        <rdfs:comment xml:lang="en">No guideline items are provided: the QUADAS-AI guideline is in development (as of 2026-06-01).</rdfs:comment>
        <rdfs:comment xml:lang="en">Placeholder entry. Items not specified in ROADMAP.</rdfs:comment>
        <rdfs:label xml:lang="en">QUADAS-AI</rdfs:label>
        <skos:altLabel xml:lang="en">Quality Assessment of Diagnostic Accuracy Studies - AI extension</skos:altLabel>
        <skos:altLabel xml:lang="en">Quality Assessment of Diagnostic Accuracy Studies using Artificial Intelligence</skos:altLabel>
        <skos:altLabel xml:lang="en">artificial intelligence–specific quality assessment of diagnostic accuracy studies</skos:altLabel>
        <skos:definition xml:lang="en">QUADAS-AI is an extension of the Quality Assessment of Diagnostic Accuracy Studies (QUADAS) tool, specifically designed to evaluate bias and applicability in studies involving artificial intelligence (AI)–based diagnostic systems. It provides a structured, standardized approach to assess methodological quality when machine learning is used for clinical diagnosis or image interpretation.</skos:definition>
    </owl:NamedIndividual>
    


