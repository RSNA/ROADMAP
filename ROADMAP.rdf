            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">resumen</rdfs:label>
        <rdfs:label xml:lang="en">summary</rdfs:label>
        <skos:definition xml:lang="en">Textual summary of an AI resource.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00168 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00168">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03599"/>
        <rdfs:label xml:lang="es">enfermero/a</rdfs:label>
        <rdfs:label xml:lang="en">nurse</rdfs:label>
        <skos:altLabel xml:lang="es">enfermera</skos:altLabel>
        <skos:altLabel xml:lang="es">enfermero</skos:altLabel>
        <skos:definition xml:lang="en">A nurse is a licensed healthcare professional trained to care for the sick, injured, or elderly, promoting health and providing care, often working alongside physicians.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00169 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00169">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03805"/>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/00249"/>
        <rdfs:label xml:lang="en">FAIR principle</rdfs:label>
        <skos:definition xml:lang="en">One of the FAIR principles.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00174 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00174">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00660"/>
        <rdfs:label xml:lang="en">guideline</rdfs:label>
        <skos:altLabel xml:lang="en">AI checklist</skos:altLabel>
        <skos:altLabel xml:lang="en">AI guideline</skos:altLabel>
        <skos:altLabel xml:lang="en">AI reporting checklist</skos:altLabel>
        <skos:altLabel xml:lang="en">AI reporting guideline</skos:altLabel>
        <skos:altLabel xml:lang="en">checklist</skos:altLabel>
        <skos:altLabel xml:lang="en">reporting checklist</skos:altLabel>
        <skos:altLabel xml:lang="en">reporting guideline</skos:altLabel>
        <skos:altLabel xml:lang="en">reporting standard</skos:altLabel>
        <skos:definition xml:lang="en">An AI guideline is a structured, consensus-driven framework—typically formatted as a standardized checklist—designed to ensure transparency and reproducibility in scientific research. Guidelines may specify scientific reporting standards, help assess risk of bias, assure transparency of published datasets, or aid in quality assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00177 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00177">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00660"/>
        <rdfs:label xml:lang="en">guideline item</rdfs:label>
        <skos:definition xml:lang="en">An item of an AI reporting guideline, such as CLAIM or TRAM-AI. Note that these guideline items generally apply to scientific manuscripts (journal articles), rather than the descriptions of the AI models or datasets themselves.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00178 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00178">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00177"/>
        <rdfs:comment xml:lang="en">A - Access and Persistence
B - Technical Interoperability
C - Metadata and Reproducibility
D - Ethical, Legal, and Maintenance</rdfs:comment>
        <rdfs:label xml:lang="en">TRAM-AI item</rdfs:label>
        <skos:definition xml:lang="en">An item from the TRAM-AI (Transparency in Reporting of Medical Imaging datasets for Artificial Intelligence) checklist.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00191 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00191">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03342"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.1469-8137.1912.tb05611.x"/>
        <rdfs:label xml:lang="es">intersección de máscara sobre unión &gt; 0</rdfs:label>
        <rdfs:label xml:lang="en">mask intersection over union &gt; 0</rdfs:label>
        <rdfs:label xml:lang="zh">掩码交并比 &gt; 0</rdfs:label>
        <skos:altLabel xml:lang="en">mask IoU &gt; 0</skos:altLabel>
        <skos:definition xml:lang="en">Mask intersection over union &gt; 0 determines whether a predicted region shares at least one pixel with the reference region. It operates as a binary localization criterion, indicating only the presence or absence of spatial overlap. This metric provides an extremely permissive threshold for detection tasks where coarse positional matching is sufficient.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00199 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00199">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <rdfs:label xml:lang="en">SVS</rdfs:label>
        <skos:altLabel xml:lang="en">Slide and Viewable Storage</skos:altLabel>
        <skos:definition xml:lang="en">SVS (Slide and Viewable Storage) is a high-resolution image format used primarily in digital pathology to store scanned microscope slides.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00200 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00200">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <rdfs:label xml:lang="en">NDPI</rdfs:label>
        <skos:altLabel xml:lang="en">NanoZoomer Digital Pathology Image</skos:altLabel>
        <skos:definition xml:lang="en">A format for digital pathology images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00202 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00202">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00177"/>
        <rdfs:label xml:lang="en">CLAIM item</rdfs:label>
        <skos:definition xml:lang="en">An item from the CLAIM (Checklist for Artificial Intelligence in Medicine Imaging) guideline.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00248 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00248">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00660"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://rsna.org/roadmap/03805"/>
            <rdf:Description rdf:about="https://rsna.org/roadmap/03806"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">Examples include the FAIR principles and the FUTURE-AI principles.</rdfs:comment>
        <rdfs:comment xml:lang="en">The OECD and WHO principles are general and are to be considered as a whole. The FAIR and FUTURE-AI principles are specific; the &apos;supports&apos; relation indicates those metadata entities and guideline items that support them.</rdfs:comment>
        <rdfs:label xml:lang="en">ethical principle</rdfs:label>
        <skos:altLabel xml:lang="en">guiding principle</skos:altLabel>
        <skos:altLabel xml:lang="en">principle</skos:altLabel>
        <skos:definition xml:lang="en">An ethical principle is a statement of a duty or a responsibility in the context of the development, deployment and continuing assessment of AI technologies for health. They apply directly to AI models and datasets, and apply indirectly to scientific reporting of AI resources.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00249 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00249">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03805"/>
        <rdfs:label xml:lang="en">FUTURE-AI principle</rdfs:label>
        <skos:definition xml:lang="en">One of the FUTURE-AI principles.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00250 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00250">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00232"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00240"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00241"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">uncertainty</rdfs:label>
        <skos:definition xml:lang="en">How unsure an algorithm is about its predictions due to noise and/or incomplete modeling or data.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00251 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00251">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00250"/>
        <rdfs:comment xml:lang="en">Aleatoric Uncertainty: The &quot;inherent randomness.&quot; It comes from unresolvable noise or inherent variability in the data itself (e.g., poor lighting in a self-driving car&apos;s camera feed). This type of uncertainty cannot be reduced by adding more data.</rdfs:comment>
        <rdfs:label xml:lang="en">aleatoric uncertainty</rdfs:label>
        <skos:definition xml:lang="en">Aleatoric uncertainty is the unavoidable randomness, noise, or ambiguities present in the raw data itself (e.g., a blurry image).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00252 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00252">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00250"/>
        <rdfs:comment xml:lang="en">Epistemic uncertainty generally can be reduced by feeding the model more data or refining its algorithms.</rdfs:comment>
        <rdfs:label xml:lang="en">epistemic uncertainty</rdfs:label>
        <skos:definition xml:lang="en">Epistemic uncertainty is the uncertainty stemming from a lack of sufficient training data or limitations in the model itself (which can be reduced by gathering more data).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00278 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00278">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00177"/>
        <rdfs:label xml:lang="en">STARD-AI item</rdfs:label>
        <skos:definition xml:lang="en">An item of the STARD-AI reporting guideline.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00327 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00327">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://arxiv.org/abs/2603.06183"/>
        <rdfs:label xml:lang="en">CRIMSON</rdfs:label>
        <skos:definition xml:lang="en">CRIMSON is a clinically grounded evaluation framework for chest X-ray report generation that assesses reports based on diagnostic correctness, contextual relevance, and patient safety.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00329 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00329">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00177"/>
        <rdfs:label xml:lang="en">CONSORT-AI item</rdfs:label>
