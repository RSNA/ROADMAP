        <rdfs:label xml:lang="zh">其他用户</rdfs:label>
        <skos:altLabel xml:lang="es">otra usuaria</skos:altLabel>
        <skos:definition xml:lang="en">Indicates a user type other than a predefined subclass of User type; should be recorded as text.</skos:definition>
