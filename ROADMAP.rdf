    <!-- https://rsna.org/roadmap/03376 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03376">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00504"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Neither FAIR nor FUTURE-AI defines a sustainability principle. Sustainability metadata supports traceability (inherited from AI resource metadata), but is deliberately not mapped to any other ethical principle.</rdfs:comment>
        <rdfs:label xml:lang="es">sostenibilidad</rdfs:label>
        <rdfs:label xml:lang="en">sustainability</rdfs:label>
        <rdfs:label xml:lang="zh">可持续性</rdfs:label>
        <skos:definition xml:lang="en">Describes parameters associated with use of the AI model related to energy consumption, running time, and other factors.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03377 -->

