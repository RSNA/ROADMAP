        <rdfs:label xml:lang="en">date last updated</rdfs:label>
        <rdfs:label xml:lang="es">fecha de última actualización</rdfs:label>
        <rdfs:label xml:lang="zh">上次更新日期</rdfs:label>
        <skos:altLabel xml:lang="en">date of last update</skos:altLabel>
