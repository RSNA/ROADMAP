    <!-- https://rsna.org/roadmap/01122 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01122">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:label xml:lang="en">performance testing agent</rdfs:label>
        <skos:altLabel xml:lang="en">model performance testing party</skos:altLabel>
        <skos:altLabel xml:lang="en">testing agent</skos:altLabel>
        <skos:altLabel xml:lang="en">testing party</skos:altLabel>
        <skos:definition xml:lang="en">The party that conducted and reported external testing of the AI model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01123 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01123">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03808"/>
        <rdfs:label xml:lang="en">performance test type</rdfs:label>
        <skos:altLabel xml:lang="en">evaluation test type</skos:altLabel>
        <skos:altLabel xml:lang="en">test type</skos:altLabel>
        <skos:definition xml:lang="en">The relationship between the data used to evaluate an AI model and the data used to develop it, together with the point in the model&apos;s lifecycle at which the evaluation was performed.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/01140 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/01140">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Jaro similarity</rdfs:label>
        <skos:definition xml:lang="en">Jaro similarity is a measure designed for record linkage that accounts for insertions, deletions, replacements, and transpositions of characters. It assigns a prorated weight based on the degree of character agreement between two strings, with higher values indicating greater similarity; its normalized form is widely used for matching names and short text fields.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/02866 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/02866">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <dcterms:source rdf:resource="https://bids.neuroimaging.io/"/>
        <rdfs:label xml:lang="en">BIDS</rdfs:label>
        <skos:altLabel xml:lang="en">Brain Imaging Data Structure</skos:altLabel>
        <skos:definition xml:lang="en">BIDS is a set of guidelines for naming and organizing neural and associated files that is intended to standardize many processes in neuroscience research and foster a data ecosystem that makes collaboration and data sharing easy.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03217 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03217">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03307"/>
        <dcterms:source rdf:resource="https://doi.org/10.1186/s12859-015-0564-6"/>
        <rdfs:label xml:lang="en">lenient accuracy</rdfs:label>
        <rdfs:label xml:lang="es">precisión flexible</rdfs:label>
        <rdfs:label xml:lang="zh">宽松的准确性</rdfs:label>
        <skos:altLabel xml:lang="en">LACC</skos:altLabel>
        <skos:definition xml:lang="en">Lenient accuracy is a relaxed evaluation metric that considers a response correct if any of the system’s returned answers matches one of the acceptable gold-standard answers. Unlike strict accuracy, it allows for synonyms, equivalent expressions, or alternative correct forms, making it more tolerant in domains where multiple valid answer variants exist. It is frequently used in factoid question answering to avoid penalizing systems for producing correct but differently worded outputs.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03218 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03218">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1080/02664763.2016.1174195"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/0962280214537390"/>
        <rdfs:label xml:lang="es">coeficiente de variación de segundo orden</rdfs:label>
        <rdfs:label xml:lang="en">second-order coefficient of variation</rdfs:label>
        <rdfs:label xml:lang="zh">二阶变异系数</rdfs:label>
        <skos:altLabel xml:lang="en">CV2</skos:altLabel>
        <skos:altLabel xml:lang="en">CV_2</skos:altLabel>
        <skos:altLabel xml:lang="en">V2</skos:altLabel>
        <skos:altLabel xml:lang="en">V_2</skos:altLabel>
        <skos:altLabel xml:lang="en">normalized coefficient of variation</skos:altLabel>
        <skos:definition xml:lang="en">The second-order coefficient of variation is an alternative formulation that expresses relative variability as the ratio of the standard deviation to the square root of the second raw moment. Unlike the classical coefficient of variation, it is always defined for real-valued data, bounded between 0 and 1, and less sensitive to extreme values. Its bounded range and geometric interpretation as a ratio of distances make it a more robust and interpretable measure of dispersion.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03219 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03219">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01052"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.4103/crst.crst_283_23"/>
        <rdfs:label xml:lang="es">error estándar relativo</rdfs:label>
        <rdfs:label xml:lang="en">relative standard error</rdfs:label>
        <rdfs:label xml:lang="zh">相对标准误差</rdfs:label>
        <skos:altLabel xml:lang="en">RSE</skos:altLabel>
        <skos:definition xml:lang="en">The relative standard error is a percentage-based measure of the reliability of an estimate, defined as the standard error divided by the estimate itself and multiplied by 100. It expresses the precision of the estimate relative to its magnitude, with smaller values indicating greater reliability. Estimates with large RSE values are often considered too unstable for reporting and may be flagged, suppressed, or presented with cautionary notes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03220 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03220">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="http://dx.doi.org/10.1016/j.acra.2014.07.004"/>
        <dcterms:source rdf:resource="https://doi.org/10.1080/10543400701329489"/>
        <rdfs:label xml:lang="en">individual equivalence index</rdfs:label>
        <rdfs:label xml:lang="es">índice de equivalencia individual</rdfs:label>
        <rdfs:label xml:lang="zh">个体等效指数</rdfs:label>
        <skos:altLabel xml:lang="en">IEC</skos:altLabel>
        <skos:altLabel xml:lang="en">IEI</skos:altLabel>
        <skos:altLabel xml:lang="en">individual equivalence coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">interchangeability metric</skos:altLabel>
        <skos:definition xml:lang="en">The individual equivalence index is a statistical measure used to determine whether a new diagnostic method can be considered interchangeable with a reference method. It is defined as the probability that the new test and the reference test provide the same result, relative to the probability that two independent replicates of the reference agree with each other. Values close to one indicate that the new test agrees with the reference to the same degree as the reference agrees with itself, making the index a tool for formally assessing interchangeability in diagnostic imaging and related settings.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03221 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03221">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04053"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1109/TIT.2005.844059"/>
        <rdfs:label xml:lang="es">distancia de compresión normalizada</rdfs:label>
        <rdfs:label xml:lang="en">normalized compression distance</rdfs:label>
        <rdfs:label xml:lang="zh">归一化压缩距离</rdfs:label>
        <skos:altLabel xml:lang="en">NCD</skos:altLabel>
        <skos:definition xml:lang="en">Normalized compression distance is a practical approximation of normalized information distance that replaces Kolmogorov complexity with the length of compressed data produced by a real-world compression algorithm. It measures the relative similarity of two objects by comparing the compression of each individually with the compression of their concatenation, yielding values close to zero for highly similar objects and close to one for dissimilar ones. While dependent on the choice of compressor and only approximately metric, it provides a widely usable, domain-independent method for quantifying similarity across diverse data types.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03222 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03222">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03314"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.0006-341X.2000.00337.x"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.0006-341X.2005.030814.x"/>
        <rdfs:label xml:lang="en">time-dependent area under the receiver operating characteristic curve</rdfs:label>
        <rdfs:label xml:lang="es">área bajo la curva ROC dependiente del tiempo</rdfs:label>
        <rdfs:label xml:lang="zh">时间依赖性受试者工作特征曲线下面积</rdfs:label>
        <skos:altLabel xml:lang="en">AUC at time (t)</skos:altLabel>
        <skos:altLabel xml:lang="en">AUC(t)</skos:altLabel>
        <skos:altLabel xml:lang="en">area under the receiver operating curve at time (t)</skos:altLabel>
        <skos:altLabel xml:lang="en">time-dependent AUC</skos:altLabel>
        <skos:altLabel xml:lang="en">time-specific AUC</skos:altLabel>
        <skos:altLabel xml:lang="en">time-specific area under the receiver operating characteristic curve</skos:altLabel>
        <skos:definition xml:lang="en">The time-dependent area under the receiver operating characteristic curve is a measure of a prognostic marker’s or model’s ability to discriminate between individuals who will experience an event by a specified time and those who will remain event-free. It generalizes the classical area under the curve to survival data by defining cases and controls dynamically over time and computing the probability that a subject with an event has a higher predicted risk than one without an event at time t. This metric provides a time-specific summary of discriminatory accuracy in the presence of censoring and evolving event status.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03223 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03223">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01055"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.3348/kjr.2021.0223"/>
        <rdfs:label xml:lang="en">integrated time-dependent area under the ROC curve</rdfs:label>
        <rdfs:label xml:lang="es">área bajo la curva ROC integrada dependiente del tiempo</rdfs:label>
        <rdfs:label xml:lang="zh">集成时间依赖性ROC曲线下面积</rdfs:label>
        <skos:altLabel xml:lang="en">iAUC</skos:altLabel>
        <skos:altLabel xml:lang="en">integrated time-dependent AUC</skos:altLabel>
        <skos:definition xml:lang="en">An integrated AUC (iAUC) is a mathematical integration of multiple time-dependent AUC values across the follow-up period, and it can be expressed as follows: iAUC= ∫AUC(t)·w(t)dt, where t = time and w = weight. Heagerty and Zheng suggested that w(t) should be proportional to the marginal density of survival time multiplied by the survival function, which makes the iAUC equivalent to ‘concordance,’ which is the probability that the order of deaths in randomly chosen two patients agrees with the order predicted by the model. In other words, iAUC is a weighted sum or a global average of time-dependent AUC values from time-dependent ROC analyses across the follow-up duration. 
                                         - from Park SY, et al. KJR 2021.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03224 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03224">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00021"/>
        <rdfs:label xml:lang="en">autonomous diagnosis</rdfs:label>
        <rdfs:label xml:lang="es">diagnóstico autónomo</rdfs:label>
        <rdfs:label xml:lang="zh">自主诊断</rdfs:label>
        <skos:altLabel xml:lang="en">CADa</skos:altLabel>
        <skos:definition xml:lang="en">Diagnosis performed by computer without human interaction.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03225 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03225">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01043"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/IRI62200.2024.00065"/>
        <dcterms:source xml:lang="en">D. Pessach and E. Shmueli, “Algorithmic fairness,” in Machine Learning for Data Science Handbook, pp. 867–886, Springer International Publishing, 2023.</dcterms:source>
        <rdfs:comment xml:lang="en">Group fairness, also known as statistical or demographic fairness, requires that predictive outcomes are independent of specific sensitive attributes such as race, gender, or age.</rdfs:comment>
        <rdfs:label xml:lang="es">equidad grupal</rdfs:label>
        <rdfs:label xml:lang="en">group fairness</rdfs:label>
        <rdfs:label xml:lang="zh">群体公平性</rdfs:label>
        <skos:altLabel xml:lang="en">demographic fairness</skos:altLabel>
        <skos:altLabel xml:lang="en">statistical fairness</skos:altLabel>
        <skos:definition xml:lang="en">Assuming ˆ Y is the predicted outcome and D is the sensitive attribute with a given value d, then group fairness can be expressed as: 
                                         P( ˆ Y = 1|D = d) = P( ˆ Y = 1|D &lt;&gt; d)</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03226 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03226">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01043"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/IRI62200.2024.00065"/>
        <rdfs:label xml:lang="es">equidad individual</rdfs:label>
        <rdfs:label xml:lang="en">individual fairness</rdfs:label>
        <rdfs:label xml:lang="zh">个体公平性</rdfs:label>
        <skos:definition xml:lang="en">Individual fairness mandates that similar individuals should receive similar predictions. It can be mathematically formalized using a distance metric d(·), which measures the similarity between individuals: d( ˆ Yi, ˆ Yj) ≤ D(xi, xj) ∀i, j</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03227 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03227">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01043"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/IRI62200.2024.00065"/>
        <rdfs:label xml:lang="en">equality of opportunity</rdfs:label>
        <rdfs:label xml:lang="es">igualdad de oportunidades</rdfs:label>
        <rdfs:label xml:lang="zh">机会平等</rdfs:label>
        <skos:definition xml:lang="en">Equality of opportunity, an extension of group fairness, states that groups should have equal true positive rates. This metric is defined as:
                                         P( ˆ Y = 1|D = d, Y = 1) = P( ˆ Y = 1|D &lt;&gt; d, Y = 1)</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03228 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03228">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01043"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/IRI62200.2024.00065"/>
        <rdfs:label xml:lang="en">demographic parity</rdfs:label>
        <rdfs:label xml:lang="es">paridad demográfica</rdfs:label>
        <rdfs:label xml:lang="zh">人口统计学平等</rdfs:label>
        <skos:altLabel xml:lang="en">statistical parity</skos:altLabel>
        <skos:definition xml:lang="en">Demographic parity, also known as statistical parity, requires the decision outcomes to be independent of the sensitive attributes. It aims for the probability of a positive prediction to be the same across different groups defined by the sensitive attribute. It is defined as:
                                         P( ˆ Y = 1|D = d) = P( ˆ Y = 1|D &lt;&gt; d)</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03229 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03229">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01043"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/IRI62200.2024.00065"/>
        <rdfs:label xml:lang="en">equalized odds</rdfs:label>
        <rdfs:label xml:lang="es">probabilidades igualadas</rdfs:label>
        <rdfs:label xml:lang="zh">均衡几率</rdfs:label>
        <skos:definition xml:lang="en">Equalized odds require that the model’s true positive rate and false positive rate be the same across groups, defined as: 
                                         P( ˆ Y = 1|D = d, Y = y) = P( ˆ Y = 1|D &lt;&gt; d, Y = y) for all y in {0, 1}</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03302 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03302">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03760"/>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03778"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41598-024-56706-x"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="es">métrica escalar del rendimiento del modelo</rdfs:label>
        <rdfs:label xml:lang="en">scalar metric</rdfs:label>
        <rdfs:label xml:lang="zh">模型性能的标量指标</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.midrc.org/performance-metrics-decision-tree"/>
        <skos:altLabel xml:lang="en">scalar metric of model performance</skos:altLabel>
        <skos:altLabel xml:lang="en">scalar model performance data</skos:altLabel>
        <skos:altLabel xml:lang="en">scalar model performance metric</skos:altLabel>
        <skos:altLabel xml:lang="en">scalar performance metric</skos:altLabel>
        <skos:definition xml:lang="en">Model performance information presented as a single numerical (scalar) value.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03307 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03307">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.aci.2018.08.003"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="en">accuracy</rdfs:label>
        <rdfs:label xml:lang="es">exactitud</rdfs:label>
        <rdfs:label xml:lang="zh">准确性</rdfs:label>
        <skos:definition xml:lang="en">Accuracy quantifies the proportion of correct predictions made by a model across all classes. It is calculated as the number of true positives and true negatives divided by the total number of predictions. Accuracy is sensitive to class imbalance and may not reflect performance adequately in imbalanced datasets.

                                         Accuracy = (TP + TN) / (TP + TN + FP + FN)</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000415"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03308 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03308">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01040"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03307"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.aci.2018.08.003"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="en">balanced accuracy</rdfs:label>
        <rdfs:label xml:lang="es">exactitud balanceada</rdfs:label>
        <rdfs:label xml:lang="zh">平衡准确率</rdfs:label>
        <skos:altLabel xml:lang="en">BA</skos:altLabel>
        <skos:altLabel xml:lang="en">BCR</skos:altLabel>
        <skos:altLabel xml:lang="en">balanced classification rate</skos:altLabel>
        <skos:definition xml:lang="en">Balanced accuracy measures the average proportion of correct predictions across all classes, accounting for class imbalance. In binary classification, it is defined as the mean of sensitivity (true positive rate) and specificity (true negative rate). In multi-class settings, it is calculated as the average of class-wise sensitivities, giving equal weight to each class regardless of prevalence. Balanced accuracy can be considered as the macro-averaged accuracy.

                                         BA = (TPR + TNR) / 2</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03309 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03309">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01058"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1001/jama.295.20.2374"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="es">costo esperado</rdfs:label>
        <rdfs:label xml:lang="en">expected cost</rdfs:label>
        <rdfs:label xml:lang="zh">预期成本</rdfs:label>
        <skos:altLabel xml:lang="en">EC</skos:altLabel>
        <skos:altLabel xml:lang="en">expected loss</skos:altLabel>
        <skos:altLabel xml:lang="en">expected prediction error</skos:altLabel>
        <skos:altLabel xml:lang="en">normalized cost</skos:altLabel>
        <skos:definition xml:lang="en">Expected cost quantifies the average penalty associated with prediction errors, incorporating predefined cost values for false positives and false negatives. It generalizes accuracy by weighting error types according to their impact. This metric supports applications where decision costs vary among outcomes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03311 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03311">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03510"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1177/001316446002000104"/>
        <rdfs:label xml:lang="es">Kappa de Cohen ponderado</rdfs:label>
        <rdfs:label xml:lang="en">weighted Cohen&apos;s kappa</rdfs:label>
        <rdfs:label xml:lang="zh">加权科恩κ系数</rdfs:label>
        <skos:altLabel xml:lang="en">WCK</skos:altLabel>
        <skos:altLabel xml:lang="en">weighted kappa</skos:altLabel>
        <skos:altLabel xml:lang="zh">加权科恩卡帕系数</skos:altLabel>
        <skos:definition xml:lang="en">Weighted Cohen’s kappa extends Cohen’s kappa by incorporating a weighting scheme that reflects the severity or cost of different types of misclassification. It is particularly suited for ordinal or multi-class problems, where misclassifications between distant classes can be penalized more heavily than near-misses. Like Cohen’s Kappa, its value ranges from -1 to 1, with higher scores indicating better agreement beyond chance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03314 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03314">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/radiology.143.1.7063747"/>
        <rdfs:label xml:lang="en">area under the receiver operating characteristic curve</rdfs:label>
        <rdfs:label xml:lang="es">área bajo la curva característica operativa del receptor</rdfs:label>
        <rdfs:label xml:lang="zh">接收者操作特征曲线下的面积</rdfs:label>
        <skos:altLabel xml:lang="en">AUC</skos:altLabel>
        <skos:altLabel xml:lang="en">AUC score</skos:altLabel>
        <skos:altLabel xml:lang="en">AUC-ROC</skos:altLabel>
        <skos:altLabel xml:lang="en">AUROC</skos:altLabel>
        <skos:altLabel xml:lang="en">AUROC score</skos:altLabel>
        <skos:altLabel xml:lang="en">ROC-AUC</skos:altLabel>
        <skos:altLabel xml:lang="en">area under TPR-FPR curve</skos:altLabel>
        <skos:altLabel xml:lang="en">area under the ROC curve</skos:altLabel>
        <skos:definition xml:lang="en">The area under the receiver operating characteristic curve measures how well a model distinguishes between positive and negative classes across all possible thresholds. It represents the probability that a randomly chosen positive instance will receive a higher predicted score than a randomly chosen negative instance. This metric provides a threshold-independent assessment of a model’s discriminative ability.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000608"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03319 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03319">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03320"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1072064.1072067"/>
        <rdfs:label xml:lang="en">F1 score</rdfs:label>
        <rdfs:label xml:lang="zh">F1 分数</rdfs:label>
        <rdfs:label xml:lang="es">puntaje F1</rdfs:label>
        <skos:altLabel xml:lang="en">F1</skos:altLabel>
        <skos:altLabel xml:lang="en">F1-score</skos:altLabel>
        <skos:definition xml:lang="en">F1 score is a specific case of the F(beta) score with β = 1, giving equal weight to precision and sensitivity. It is commonly used when both metrics are considered equally important for model evaluation. This score is widely adopted in tasks requiring balanced performance between completeness and correctness of predictions.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000628"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03320 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03320">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.3115/1072064.1072067"/>
        <rdfs:label xml:lang="en">F(beta) score</rdfs:label>
        <rdfs:label xml:lang="zh">F(β) 分数</rdfs:label>
        <rdfs:label xml:lang="es">puntaje F(beta)</rdfs:label>
        <skos:altLabel xml:lang="en">F beta</skos:altLabel>
        <skos:altLabel xml:lang="en">F(β)</skos:altLabel>
        <skos:altLabel xml:lang="en">F(β) score</skos:altLabel>
        <skos:altLabel xml:lang="en">F-beta</skos:altLabel>
        <skos:altLabel xml:lang="en">F-beta score</skos:altLabel>
        <skos:altLabel xml:lang="en">F-β</skos:altLabel>
        <skos:altLabel xml:lang="en">F_β</skos:altLabel>
        <skos:altLabel xml:lang="en">Fβ</skos:altLabel>
        <skos:definition xml:lang="en">F(beta) score calculates the weighted harmonic mean of precision and sensitivity, where the parameter β controls the relative weight given to sensitivity. It provides a single measure that balances the trade-off between detecting positive cases and avoiding false positives. Larger β values place more emphasis on sensitivity, while smaller values emphasize precision.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000663"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03321 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03321">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.media.2010.05.005"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="en">free-response receiver operating characteristic score</rdfs:label>
        <rdfs:label xml:lang="es">puntuación de la curva ROC de respuesta libre</rdfs:label>
        <rdfs:label xml:lang="zh">自由响应受试者工作特征分数</rdfs:label>
        <skos:altLabel xml:lang="en">FROC score</skos:altLabel>
        <skos:definition xml:lang="en">The free-response receiver operating characteristic score is a performance measure that summarizes the trade-off between sensitivity and the average number of false positives per image in object-level detection tasks. It is typically derived from the free-response receiver operating characteristic curve, which plots sensitivity across a range of false positive rates per image, and can be computed either as the area under this curve or as the average sensitivity at predetermined false positive thresholds. This score accounts for both the accuracy of identifying true findings and the burden of false alarms.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03322 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03322">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41598-024-56706-x"/>
        <rdfs:label xml:lang="en">false positive rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de falsos positivos</rdfs:label>
        <rdfs:label xml:lang="zh">假阳性率</rdfs:label>
        <skos:altLabel xml:lang="en">FPR</skos:altLabel>
        <skos:altLabel xml:lang="en">alpha</skos:altLabel>
        <skos:altLabel xml:lang="es">error tipo 1</skos:altLabel>
        <skos:altLabel xml:lang="en">fall-out</skos:altLabel>
        <skos:altLabel xml:lang="en">fall-out rate</skos:altLabel>
        <skos:altLabel xml:lang="en">fallout</skos:altLabel>
        <skos:altLabel xml:lang="en">fallout rate</skos:altLabel>
        <skos:altLabel xml:lang="en">significance level</skos:altLabel>
        <skos:altLabel xml:lang="en">type 1 error rate</skos:altLabel>
        <skos:altLabel xml:lang="en">type I error rate</skos:altLabel>
        <skos:altLabel xml:lang="en">α</skos:altLabel>
        <skos:definition xml:lang="en">The false positive rate is the proportion of actual negative cases that are incorrectly classified as positive by a diagnostic test or predictive model. It is calculated as the number of false positives divided by the sum of false positives and true negatives, making it the complement of specificity. FPR indicates how often non-existent conditions are mistakenly detected and serves as the x-axis dimension in receiver operating characteristic (ROC) analysis.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000053"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03323 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03323">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.1541-0420.2008.01049.x"/>
        <rdfs:label xml:lang="en">false positives per image</rdfs:label>
        <rdfs:label xml:lang="es">falsos positivos por imagen</rdfs:label>
        <rdfs:label xml:lang="zh">每张图像的假阳性数</rdfs:label>
        <skos:altLabel xml:lang="en">FPPI</skos:altLabel>
        <skos:definition xml:lang="en">The false positives per image metric quantifies the average number of incorrect positive detections produced per image in an evaluation dataset. It is unbounded above and increases as a system generates more false alarms, making lower values preferable. It is most informative when reported alongside sensitivity, as in free-response ROC analysis, where it serves as the x-axis variable to indicate the trade-off between detection sensitivity and the frequency of false detections.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03324 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03324">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.aci.2018.08.003"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:comment xml:lang="en">PPV = TP / (TP + FP)</rdfs:comment>
        <rdfs:label xml:lang="en">positive predictive value</rdfs:label>
        <rdfs:label xml:lang="es">valor predictivo positivo</rdfs:label>
        <rdfs:label xml:lang="zh">阳性预测值</rdfs:label>
        <skos:altLabel xml:lang="en">PPV</skos:altLabel>
        <skos:altLabel xml:lang="en">precision</skos:altLabel>
        <skos:altLabel xml:lang="es">precisión</skos:altLabel>
        <skos:altLabel xml:lang="zh">精确率</skos:altLabel>
        <skos:definition xml:lang="en">Positive predictive value is the proportion of correctly identified positive cases among all cases predicted as positive by a model or test. It represents the probability that a positive prediction corresponds to a true positive outcome, and its value depends on the prevalence of the condition being tested as well as the model’s specificity and sensitivity.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000416"/>
        <formula>TP / (TP + FP)</formula>
        <symbol>PPV</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03325 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03325">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.aci.2018.08.003"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:comment xml:lang="en">NPV = TN / (TN + FN)</rdfs:comment>
        <rdfs:label xml:lang="en">negative predictive value</rdfs:label>
        <rdfs:label xml:lang="es">valor predictivo negativo</rdfs:label>
        <rdfs:label xml:lang="zh">阴性预测值</rdfs:label>
        <skos:altLabel xml:lang="en">NPV</skos:altLabel>
        <skos:definition xml:lang="en">Negative predictive value denotes the proportion of negative predictions that correspond to actual negative cases. It reflects the reliability of negative results and depends on both test performance and outcome prevalence. It is often reported alongside sensitivity and specificity.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000619"/>
        <formula>TN / (TN + FN)</formula>
        <symbol>NPV</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03326 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03326">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03357"/>
        <dcterms:source rdf:resource="https://doi.org/10.1002/9780470317082"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="en">positive likelihood ratio</rdfs:label>
        <rdfs:label xml:lang="es">razón de verosimilitud positiva</rdfs:label>
        <rdfs:label xml:lang="zh">阳性似然比</rdfs:label>
        <skos:altLabel xml:lang="en">LR+</skos:altLabel>
        <skos:altLabel xml:lang="en">PLR</skos:altLabel>
        <skos:altLabel xml:lang="en">positive LR</skos:altLabel>
        <skos:definition xml:lang="en">Positive Likelihood Ratio expresses how much more likely a positive test result is in individuals with the condition compared to those without it. It is calculated as the ratio of sensitivity to one minus specificity. Higher values indicate stronger evidence for the presence of the condition.

                                         LR+ = sensitivity / (1-specificity)</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000411"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03327 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03327">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/CVPR.2019.00963"/>
        <rdfs:label xml:lang="es">calidad panóptica</rdfs:label>
        <rdfs:label xml:lang="en">panoptic quality</rdfs:label>
        <rdfs:label xml:lang="zh">全景质量</rdfs:label>
        <skos:altLabel xml:lang="en">PQ</skos:altLabel>
        <skos:definition xml:lang="en">Panoptic quality evaluates panoptic segmentation by integrating instance detection accuracy with segmentation precision into a single metric. It calculates the sum of intersection-over-union values for correctly matched segments, normalized by the total number of matches and weighted penalties for false positives and false negatives. This metric provides a class-balanced measure of overall scene understanding, decomposable into segmentation quality and recognition quality components.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03328 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03328">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/1148170.1148262"/>
        <rdfs:label xml:lang="en">average precision</rdfs:label>
        <rdfs:label xml:lang="es">precisión promedio</rdfs:label>
        <rdfs:label xml:lang="zh">平均精度</rdfs:label>
        <skos:altLabel xml:lang="en">AP</skos:altLabel>
        <skos:definition xml:lang="en">Average precision summarizes the precision-recall curve as a single value, representing the area under this curve through an interpolated integration. It reflects how well a model maintains high precision while increasing recall across different decision thresholds, making it especially useful for imbalanced datasets where true negatives dominate. Unlike metrics based on the receiver operating characteristic curve, average precision focuses exclusively on the relationship between precision and recall, ignoring true negatives to emphasize performance on positive cases.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03329 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03329">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1198/016214506000001437"/>
        <rdfs:label xml:lang="en">Brier score</rdfs:label>
        <rdfs:label xml:lang="zh">Brier 分数</rdfs:label>
        <rdfs:label xml:lang="es">puntuación de Brier</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Brier_score"/>
        <skos:altLabel xml:lang="en">BS</skos:altLabel>
        <skos:definition xml:lang="en">The Brier score quantifies the accuracy of probabilistic predictions by computing the mean squared difference between predicted probabilities and the actual binary outcomes. It captures both the ability of a model to discriminate between events and non-events and the degree to which predicted probabilities reflect observed frequencies. Scores range from 0 for perfect predictions to higher values for less accurate forecasts.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03330 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03330">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://dl.acm.org/doi/abs/10.5555/954544"/>
        <rdfs:label xml:lang="en">class error</rdfs:label>
        <rdfs:label xml:lang="es">error de clase</rdfs:label>
        <rdfs:label xml:lang="zh">分类错误</rdfs:label>
        <skos:altLabel xml:lang="en">classification error</skos:altLabel>
        <skos:definition xml:lang="en">Classification error quantifies the proportion of samples incorrectly assigned to a class by a classifier. It is calculated as the number of misclassified samples divided by the total number of samples evaluated, representing the complement of accuracy. Lower values indicate better classification performance, while higher values signify more frequent misclassifications.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03331 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03331">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.1910.12656"/>
        <rdfs:label xml:lang="en">class-wise calibration error</rdfs:label>
        <rdfs:label xml:lang="es">error de calibración por clase</rdfs:label>
        <rdfs:label xml:lang="zh">按类别划分的校准误差</rdfs:label>
        <skos:altLabel xml:lang="en">CWCE</skos:altLabel>
        <skos:definition xml:lang="en">Class-wise calibration error measures the alignment between predicted probabilities and observed outcomes for each class individually. It calculates the difference between confidence and accuracy across bins per class and aggregates these differences, optionally applying class-specific weights. Lower values indicate better marginal calibration across classes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03332 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03332">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1609/aaai.v29i1.9602"/>
        <rdfs:label xml:lang="es">error de calibración esperado</rdfs:label>
        <rdfs:label xml:lang="en">expected calibration error</rdfs:label>
        <rdfs:label xml:lang="zh">预期校准误差</rdfs:label>
        <skos:altLabel xml:lang="en">ECE</skos:altLabel>
        <skos:definition xml:lang="en">Expected calibration error estimates the average discrepancy between predicted confidence and actual accuracy for the predicted top class. It partitions predictions into bins and computes a weighted average of the differences between predicted and observed values, summarizing top-label calibration. Lower values reflect better overall calibration.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03333 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03333">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://dl.acm.org/doi/abs/10.5555/3454287.3455385"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="es">error de calibración de kernel</rdfs:label>
        <rdfs:label xml:lang="en">kernel calibration error</rdfs:label>
        <rdfs:label xml:lang="zh">核校准误差</rdfs:label>
        <skos:altLabel xml:lang="en">KCE</skos:altLabel>
        <skos:definition xml:lang="en">Kernel calibration error is a measure of canonical calibration error based on the maximum mean discrepancy between predicted probability distributions and true outcomes. It uses a matrix-valued kernel to capture differences across the entire probability space and provides an unbiased estimator of this discrepancy. This metric is primarily used for comparative calibration assessment, especially in settings with many classes or limited sample sizes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03334 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03334">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/measures"/>
                <owl:someValuesFrom rdf:resource="https://rsna.org/roadmap/04061"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-1-4612-1524-0"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="es">logaritmo de verosimilitud negativo</rdfs:label>
        <rdfs:label xml:lang="en">negative log likelihood</rdfs:label>
        <rdfs:label xml:lang="zh">负对数似然</rdfs:label>
        <skos:altLabel xml:lang="en">NLL</skos:altLabel>
        <skos:definition xml:lang="en">Negative log likelihood quantifies the quality of probabilistic predictions by penalizing the log probability assigned to the correct class. It is a proper scoring rule that combines calibration and discrimination into a single metric, assigning larger penalties to overconfident incorrect predictions. Lower values correspond to more accurate and well-calibrated probability estimates.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03335 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03335">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1002/sim.3517"/>
        <rdfs:label xml:lang="en">observed-to-expected ratio</rdfs:label>
        <rdfs:label xml:lang="es">razón observado-esperado</rdfs:label>
        <rdfs:label xml:lang="zh">观测值与预期值之比</rdfs:label>
        <skos:altLabel xml:lang="en">E/O ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">O/E ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">O:E ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">observed:expected ratio</skos:altLabel>
        <skos:definition xml:lang="en">The observed-to-expected ratio evaluates calibration by comparing the total number of observed events to the number of events predicted by a model within a specified time frame. A value of one indicates perfect calibration, while ratios greater than one suggest underprediction and values less than one indicate overprediction. This metric is widely used in risk prediction and survival analysis, often requiring adjustments for censoring to produce unbiased estimates.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03336 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03336">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01049"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.4142</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://dl.acm.org/doi/abs/10.5555/3600270.3600897"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:label xml:lang="es">puntuación de Brier raíz</rdfs:label>
        <rdfs:label xml:lang="en">root Brier score</rdfs:label>
        <rdfs:label xml:lang="zh">均方根布里尔分数</rdfs:label>
        <skos:altLabel xml:lang="en">RBS</skos:altLabel>
        <skos:definition xml:lang="en">The root Brier score is the square root of the Brier score, applicable in both binary and multiclass settings. It expresses the average magnitude of probabilistic prediction error on the same scale as the predicted probabilities, providing an interpretable measure of calibration and accuracy where lower values reflect better performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03337 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03337">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.2307/1932409"/>
        <rdfs:label xml:lang="en">Dice similarity coefficient</rdfs:label>
        <rdfs:label xml:lang="zh">Dice相似系数</rdfs:label>
        <rdfs:label xml:lang="es">coeficiente de similitud de Dice</rdfs:label>
        <skos:altLabel xml:lang="en">DSC</skos:altLabel>
        <skos:altLabel xml:lang="zh">DSC</skos:altLabel>
        <skos:altLabel xml:lang="zh">DSC（Dice 相似系数）</skos:altLabel>
        <skos:altLabel xml:lang="en">Dice</skos:altLabel>
        <skos:altLabel xml:lang="en">Dice coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Dice index</skos:altLabel>
        <skos:altLabel xml:lang="en">Dice score</skos:altLabel>
        <skos:altLabel xml:lang="zh">Dice 相似度</skos:altLabel>
        <skos:altLabel xml:lang="zh">Dice 相似指数</skos:altLabel>
        <skos:altLabel xml:lang="zh">Dice 系数</skos:altLabel>
        <skos:altLabel xml:lang="zh">Dice 重叠度</skos:altLabel>
        <skos:altLabel xml:lang="zh">Dice 重叠系数</skos:altLabel>
        <skos:altLabel xml:lang="en">Dice–Sørensen coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Dice–Sørensen score</skos:altLabel>
        <skos:altLabel xml:lang="zh">Sørensen-Dice 系数</skos:altLabel>
        <skos:altLabel xml:lang="en">Sørensen–Dice coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Sørensen–Dice score</skos:altLabel>
        <skos:altLabel xml:lang="zh">Sørensen–Dice 系数</skos:altLabel>
        <skos:altLabel xml:lang="en">coincidence index</skos:altLabel>
        <skos:altLabel xml:lang="zh">索伦森–戴斯系数</skos:altLabel>
        <skos:altLabel xml:lang="zh">索伦森–迪斯系数</skos:altLabel>
        <skos:altLabel xml:lang="zh">索伦森系数</skos:altLabel>
        <skos:definition xml:lang="en">The Dice similarity coefficient quantifies the spatial overlap between two sets, such as predicted and reference segmentations, by calculating twice the size of their intersection divided by the sum of their sizes. It is mathematically equivalent to the F1 score when applied at the pixel level and ranges from 0 (no overlap) to 1 (perfect overlap). DSC is widely used in image segmentation evaluation to measure volumetric agreement and is closely related to the Jaccard index, with which it has a one-to-one correspondence.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03338 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03338">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03337"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/CVPR46437.2021.01629"/>
        <rdfs:label xml:lang="en">centerline Dice similarity coefficient</rdfs:label>
        <rdfs:label xml:lang="es">coeficiente de similitud de Dice de la línea central</rdfs:label>
        <rdfs:label xml:lang="zh">中心线 Dice 相似系数</rdfs:label>
        <skos:altLabel xml:lang="en">centerline DSC</skos:altLabel>
        <skos:altLabel xml:lang="en">clDSC</skos:altLabel>
        <skos:definition xml:lang="en">The centerline Dice similarity coefficient adapts the Dice formulation to assess segmentation quality for tubular or curvilinear structures by comparing the skeletons of the predicted and reference masks. It computes the harmonic mean of topology precision (fraction of predicted skeleton within the reference mask) and topology sensitivity (fraction of reference skeleton within the predicted mask), yielding a score between 0 and 1. It is designed to reflect both volumetric accuracy and preservation of structural connectivity.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03339 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03339">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.aci.2018.08.003"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:comment xml:lang="en">TPR = TP / (TP + FN)</rdfs:comment>
        <rdfs:label xml:lang="es">tasa de verdaderos positivos</rdfs:label>
        <rdfs:label xml:lang="en">true positive rate</rdfs:label>
        <rdfs:label xml:lang="zh">真阳性率</rdfs:label>
        <skos:altLabel xml:lang="en">Se</skos:altLabel>
        <skos:altLabel xml:lang="en">Sens</skos:altLabel>
        <skos:altLabel xml:lang="en">TPF</skos:altLabel>
        <skos:altLabel xml:lang="en">TPR</skos:altLabel>
        <skos:altLabel xml:lang="es">exhaustividad</skos:altLabel>
        <skos:altLabel xml:lang="en">hit rate</skos:altLabel>
        <skos:altLabel xml:lang="es">potencia</skos:altLabel>
        <skos:altLabel xml:lang="es">probabilidad de detección</skos:altLabel>
        <skos:altLabel xml:lang="en">recall</skos:altLabel>
        <skos:altLabel xml:lang="es">sensibilidad</skos:altLabel>
        <skos:altLabel xml:lang="en">sensitivity</skos:altLabel>
        <skos:altLabel xml:lang="es">tasa de aciertos</skos:altLabel>
        <skos:altLabel xml:lang="en">true positive fraction</skos:altLabel>
        <skos:altLabel xml:lang="zh">召回率</skos:altLabel>
        <skos:altLabel xml:lang="zh">灵敏度</skos:altLabel>
        <skos:definition xml:lang="en">The true positive rate is the proportion of actual positive cases that a classifier or test correctly identifies as positive. It is calculated as the number of true positives divided by the sum of true positives and false negatives. This measure reflects how effectively a system detects the presence of the condition or class of interest.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000233"/>
        <formula>TP / (TP + FN)</formula>
        <symbol>TPR</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03340 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03340">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.aci.2018.08.003"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <rdfs:comment xml:lang="en">TNR = TN / (TN + FP)</rdfs:comment>
        <rdfs:label xml:lang="es">tasa de verdaderos negativos</rdfs:label>
        <rdfs:label xml:lang="en">true negative rate</rdfs:label>
        <rdfs:label xml:lang="zh">真阴性率</rdfs:label>
        <skos:altLabel xml:lang="en">Sp</skos:altLabel>
        <skos:altLabel xml:lang="en">Spec</skos:altLabel>
        <skos:altLabel xml:lang="en">TNF</skos:altLabel>
        <skos:altLabel xml:lang="en">TNR</skos:altLabel>
        <skos:altLabel xml:lang="es">especificidad</skos:altLabel>
        <skos:altLabel xml:lang="en">selectivity</skos:altLabel>
        <skos:altLabel xml:lang="en">specificity</skos:altLabel>
        <skos:altLabel xml:lang="en">true negative fraction</skos:altLabel>
        <skos:altLabel xml:lang="zh">特异性</skos:altLabel>
        <skos:definition xml:lang="en">The true negative rate is the proportion of actual negative cases that are correctly identified as negative by a test or classifier. It quantifies a system’s ability to avoid false alarms by distinguishing true negatives from false positives. This measure is independent of disease or class prevalence and complements the true positive rate by capturing classification accuracy for the negative class.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000134"/>
        <formula>TN / (TN + FP)</formula>
        <symbol>TNR</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03341 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03341">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="en">average symmetric surface distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia superficial simétrica promedio</rdfs:label>
        <rdfs:label xml:lang="zh">平均对称表面距离</rdfs:label>
        <skos:altLabel xml:lang="en">ASSD</skos:altLabel>
        <skos:altLabel xml:lang="en">weighted bilateral mean contour distance</skos:altLabel>
        <skos:definition xml:lang="en">Average Symmetric Surface Distance calculates the mean of all shortest distances between boundary points of two segmentations, considering both directions equally. It evaluates the overall agreement of contour locations and provides a balanced view of segmentation accuracy. This metric is useful for applications where consistent boundary alignment is clinically important.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03342 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03342">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01046"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.1469-8137.1912.tb05611.x"/>
        <rdfs:comment xml:lang="en">IoU = TP / (TP + FN + FP)</rdfs:comment>
        <rdfs:label xml:lang="es">intersección sobre unión</rdfs:label>
        <rdfs:label xml:lang="en">intersection over union</rdfs:label>
        <rdfs:label xml:lang="zh">交并比</rdfs:label>
        <skos:altLabel xml:lang="en">CSI</skos:altLabel>
        <skos:altLabel xml:lang="en">Intersection over Union score</skos:altLabel>
        <skos:altLabel xml:lang="en">IoU</skos:altLabel>
        <skos:altLabel xml:lang="en">IoU coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">IoU score</skos:altLabel>
        <skos:altLabel xml:lang="en">Jaccard coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Jaccard index</skos:altLabel>
        <skos:altLabel xml:lang="en">Jaccard similarity coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Jaccard similarity coefficient score</skos:altLabel>
        <skos:altLabel xml:lang="en">TS</skos:altLabel>
        <skos:altLabel xml:lang="en">Tanimoto coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">critical success index</skos:altLabel>
        <skos:altLabel xml:lang="en">threat score</skos:altLabel>
        <skos:altLabel xml:lang="es">índice de Jaccard</skos:altLabel>
        <skos:altLabel xml:lang="es">índice de amenaza</skos:altLabel>
        <skos:altLabel xml:lang="es">índice de éxito crítico</skos:altLabel>
        <skos:definition xml:lang="en">Intersection over union quantifies the overlap between two regions by dividing the intersection by the union of the predicted and reference sets. It captures both false positives and false negatives by considering all pixels in either region. This metric is widely applied in segmentation and detection tasks to measure how comprehensively two regions coincide spatially.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03343 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03343">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03341"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/34.232073"/>
        <rdfs:label xml:lang="en">Hausdorff distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia de Hausdorff</rdfs:label>
        <rdfs:label xml:lang="zh">豪斯多夫距离</rdfs:label>
        <skos:altLabel xml:lang="en">HD</skos:altLabel>
        <skos:altLabel xml:lang="en">Hausdorff metric</skos:altLabel>
        <skos:altLabel xml:lang="en">Pompeiu-Hausdorff distance</skos:altLabel>
        <skos:altLabel xml:lang="en">maximum symmetric surface distance</skos:altLabel>
        <skos:definition xml:lang="en">Hausdorff distance quantifies the maximum boundary discrepancy between two sets of points by measuring the greatest distance from any point on one boundary to its closest point on the other boundary. It is commonly used to assess segmentation accuracy by focusing on worst-case spatial deviations. This metric is sensitive to outliers because a single distant point can dominate the result.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03345 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03345">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03669"/>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.2196/26151"/>
        <rdfs:label xml:lang="es">distancia de superficie normalizada</rdfs:label>
        <rdfs:label xml:lang="en">normalized surface distance</rdfs:label>
        <rdfs:label xml:lang="zh">归一化表面距离</rdfs:label>
        <skos:altLabel xml:lang="en">NSD</skos:altLabel>
        <skos:definition xml:lang="en">Normalized surface distance assesses segmentation quality by computing the proportion of surface points on both boundaries that lie within a specified tolerance distance from each other. It accounts for boundary uncertainty and allows user-defined flexibility through the tolerance parameter. This metric is particularly useful when annotation imprecision or clinically acceptable deviations need to be incorporated.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03346 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03346">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/CVPR46437.2021.01508"/>
        <rdfs:label xml:lang="en">boundary intersection over union</rdfs:label>
        <rdfs:label xml:lang="es">intersección de límites sobre unión</rdfs:label>
        <rdfs:label xml:lang="zh">边界交并比</rdfs:label>
        <skos:altLabel xml:lang="en">boundary IoU</skos:altLabel>
        <skos:altLabel xml:lang="en">boundary intersection-over-union</skos:altLabel>
        <skos:definition xml:lang="en">Boundary intersection over union measures alignment between predicted and reference regions by considering only pixels located within a fixed distance from their respective contours. It focuses exclusively on boundary accuracy and disregards interior areas beyond the defined margin. This metric is designed for tasks where precise delineation of edges or margins is critical.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03347 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03347">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.1469-8137.1912.tb05611.x"/>
        <rdfs:label xml:lang="es">intersección de máscara sobre unión</rdfs:label>
        <rdfs:label xml:lang="en">mask intersection over union</rdfs:label>
        <rdfs:label xml:lang="zh">掩码交并比</rdfs:label>
        <skos:altLabel xml:lang="en">mask IoU</skos:altLabel>
        <skos:definition xml:lang="en">Mask intersection over union evaluates the overlap between two segmentation masks by comparing their shared area to the total area covered by either mask. It considers the entire region within both masks, providing a comprehensive measure of spatial agreement. This metric is commonly used in semantic and instance segmentation where pixel-level accuracy across the full object is important.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03348 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03348">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.1469-8137.1912.tb05611.x"/>
        <rdfs:label xml:lang="en">box intersection over union</rdfs:label>
        <rdfs:label xml:lang="es">intersección de cajas delimitadoras sobre unión</rdfs:label>
        <rdfs:label xml:lang="zh">框交并比</rdfs:label>
        <skos:altLabel xml:lang="en">box IoU</skos:altLabel>
        <skos:altLabel xml:lang="en">box intersection-over-union</skos:altLabel>
        <skos:definition xml:lang="en">Box intersection over union quantifies the spatial overlap between two axis-aligned or oriented bounding boxes based on the ratio of their intersection to their union. It is applied in object detection to determine how well a predicted bounding box encloses the target structure. This metric reflects positional and scale accuracy without assessing fine object shape details.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03351 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03351">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00225"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00255"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00257"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00295"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00449"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00513"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00653"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">decision threshold</rdfs:label>
        <rdfs:label xml:lang="es">umbral de decisión</rdfs:label>
        <rdfs:label xml:lang="zh">决策阈值</rdfs:label>
        <skos:definition xml:lang="en">A decision threshold is the point at which a classification algorithm or model decides whether a case (or pixel) belongs to a certain category based on its rating or score</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03352 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03352">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00320"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00448"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00540"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00578"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">consideración ética</rdfs:label>
        <rdfs:label xml:lang="en">ethical consideration</rdfs:label>
        <rdfs:label xml:lang="zh">伦理考量</rdfs:label>
        <skos:definition xml:lang="en">The set of moral principles, guidelines, and techniques used to ensure that artificial intelligence is developed, deployed, and used in ways that are fair, transparent, accountable, and beneficial to society.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03354 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03354">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00319"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00534"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00588"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">recomendación</rdfs:label>
        <rdfs:label xml:lang="en">recommendation</rdfs:label>
        <rdfs:label xml:lang="zh">建议</rdfs:label>
        <skos:definition xml:lang="en">Text information to guide overall use of the AI model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03355 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03355">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03788"/>
        <rdfs:label xml:lang="en">model property</rdfs:label>
        <rdfs:label xml:lang="es">propiedad del modelo</rdfs:label>
        <rdfs:label xml:lang="zh">模型属性</rdfs:label>
        <skos:altLabel xml:lang="en">model metadata</skos:altLabel>
        <skos:definition xml:lang="en">Specifies the characteristics of an AI model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03356 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03356">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03357"/>
        <dcterms:source rdf:resource="https://doi.org/10.1002/9780470317082"/>
        <dcterms:source rdf:resource="https://doi.org/10.1117/1.JMI.11.2.024504"/>
        <rdfs:label xml:lang="en">negative likelihood ratio</rdfs:label>
        <rdfs:label xml:lang="es">razón de verosimilitud negativa</rdfs:label>
        <rdfs:label xml:lang="zh">阴性似然比</rdfs:label>
        <skos:altLabel xml:lang="en">LR-</skos:altLabel>
        <skos:altLabel xml:lang="en">NLR</skos:altLabel>
        <skos:altLabel xml:lang="en">negative LR</skos:altLabel>
        <skos:definition xml:lang="en">Negative Likelihood Ratio expresses how much less likely a negative test result is in individuals with the condition compared to those without it. It is calculated as the ratio of one minus sensitivity to specificity. Lower values indicate stronger evidence for the absence of the condition.

                                         LR- = (1-sensitivity) / specificity</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000410"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03357 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03357">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1002/9780470317082"/>
        <rdfs:label xml:lang="en">likelihood ratio</rdfs:label>
        <rdfs:label xml:lang="es">razón de verosimilitud</rdfs:label>
        <rdfs:label xml:lang="zh">似然比</rdfs:label>
        <skos:altLabel xml:lang="en">LR</skos:altLabel>
        <skos:definition xml:lang="en">Likelihood ratio quantifies how much a diagnostic test result changes the odds of having a condition. It compares the probability of a given test result in individuals with the condition to the probability of the same result in those without it. This measure is independent of disease prevalence and can be computed for both positive and negative results.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000409"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03358 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03358">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00055"/>
        <rdfs:comment xml:lang="en">Not body sites.</rdfs:comment>
        <rdfs:label xml:lang="es">número de sitios</rdfs:label>
        <rdfs:label xml:lang="en">site count</rdfs:label>
        <rdfs:label xml:lang="zh">站点计数</rdfs:label>
        <skos:altLabel xml:lang="en">facility count</skos:altLabel>
        <skos:altLabel xml:lang="en">number of facilities</skos:altLabel>
        <skos:altLabel xml:lang="en">number of imaging facilities</skos:altLabel>
        <skos:altLabel xml:lang="en">number of sites</skos:altLabel>
        <skos:definition xml:lang="en">Number of distinct imaging sites, i.e., imaging facilities.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03359 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03359">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00040"/>
        <owl:disjointWith rdf:resource="https://rsna.org/roadmap/03609"/>
        <rdfs:label xml:lang="en">layperson</rdfs:label>
        <rdfs:label xml:lang="es">personal común</rdfs:label>
        <rdfs:label xml:lang="zh">非专业人士</rdfs:label>
        <skos:definition xml:lang="en">Nonmedical individual.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03360 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03360">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03359"/>
        <rdfs:label xml:lang="en">family member</rdfs:label>
        <rdfs:label xml:lang="es">miembro de la familia</rdfs:label>
        <rdfs:label xml:lang="zh">家庭成员</rdfs:label>
        <skos:definition xml:lang="en">A member of the patient&apos;s family.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03362 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03362">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00052"/>
        <rdfs:label xml:lang="en">2D image label</rdfs:label>
        <rdfs:label xml:lang="zh">2D图像标签</rdfs:label>
        <rdfs:label xml:lang="es">etiqueta de imagen 2D</rdfs:label>
        <skos:altLabel xml:lang="en">2D image annotation</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to two-dimensional (planar) images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03363 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03363">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00052"/>
        <rdfs:label xml:lang="en">3D image label</rdfs:label>
        <rdfs:label xml:lang="zh">3D图像标签</rdfs:label>
        <rdfs:label xml:lang="es">etiqueta de imagen 3D</rdfs:label>
        <skos:altLabel xml:lang="en">3D image annotation</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to three-dimensional image volume.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03364 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03364">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03479"/>
        <rdfs:comment xml:lang="en">Examples of regions of interest:
                                         * 1D dataset: a time or frequency interval on a waveform
                                         * 2D dataset: the boundaries of an object on an image
                                         * 3D dataset: the contours or surfaces outlining an object (sometimes known as the Volume of Interest (VOI)) in a volume
                                         * 4D dataset: the outline of an object at or during a particular time interval in a time-volume</rdfs:comment>
        <rdfs:label xml:lang="es">anotación de la región de interés</rdfs:label>
        <rdfs:label xml:lang="en">region-of-interest annotation</rdfs:label>
        <rdfs:label xml:lang="zh">感兴趣区域标注</rdfs:label>
        <skos:altLabel xml:lang="en">ROI annotation</skos:altLabel>
        <skos:altLabel xml:lang="en">ROI label</skos:altLabel>
        <skos:altLabel xml:lang="en">region of interest annotation</skos:altLabel>
        <skos:altLabel xml:lang="en">region of interest label</skos:altLabel>
        <skos:altLabel xml:lang="en">region-of-interest label</skos:altLabel>
        <skos:definition xml:lang="en">Annotation applied to a subset of a planar image or image volume.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03365 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03365">
