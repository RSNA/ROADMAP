    <!-- https://rsna.org/roadmap/00170 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00170">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00169"/>
        <rdfs:comment xml:lang="en">A1 : (Meta)data are retrievable by their identifier using a standardized communications protocol.
A1.1 : The protocol is open, free, and universally implementable.
A1.2 : The protocol allows for an authentication and authorization procedure, where necessary.
A2 : Metadata are accessible, even when the data are no longer available.</rdfs:comment>
        <rdfs:comment xml:lang="en">The A in FAIR: data and metadata are retrievable by their identifier using standardised protocols.</rdfs:comment>
        <rdfs:label xml:lang="en">accessibility</rdfs:label>
        <skos:altLabel xml:lang="en">FAIR-A</skos:altLabel>
        <skos:altLabel xml:lang="en">accessibility principle</skos:altLabel>
        <skos:altLabel xml:lang="en">accessible</skos:altLabel>
        <skos:definition xml:lang="en">Accessible: Once users finds the required data, they need to know how the data can be accessed, possibly including authentication and authorisation.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00171 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00171">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00169"/>
        <rdfs:comment xml:lang="en">F1 : (Meta)data are assigned a globally unique and persistent identifier.
F2 : Data are described with rich metadata (defined by R1).
F3 : Metadata clearly and explicitly include the identifier of the data they describe.
F4 : (Meta)data are registered or indexed in a searchable resource.</rdfs:comment>
        <rdfs:comment xml:lang="en">The F in FAIR: data and metadata are assigned globally unique and persistent identifiers.</rdfs:comment>
        <rdfs:label xml:lang="en">findability</rdfs:label>
        <skos:altLabel xml:lang="en">FAIR-F</skos:altLabel>
        <skos:altLabel xml:lang="en">findability principle</skos:altLabel>
        <skos:altLabel xml:lang="en">findable</skos:altLabel>
        <skos:definition xml:lang="en">Findable: The first step in (re)using data is to find them. Metadata and data should be easy to find for both humans and computers. Machine-readable metadata are essential for automatic discovery of datasets and services.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00172 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00172">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00169"/>
        <rdfs:comment xml:lang="en">I1 : (Meta)data use a formal, accessible, shared, and broadly applicable language for knowledge representation.
I2 : (Meta)data use vocabularies that follow FAIR principles.
I3 : (Meta)data include qualified references to other (meta)data.</rdfs:comment>
        <rdfs:comment xml:lang="en">The I in FAIR: data and metadata use a formal, accessible, shared, and broadly applicable language for knowledge representation.</rdfs:comment>
        <rdfs:label xml:lang="en">interoperability</rdfs:label>
        <skos:altLabel xml:lang="en">FAIR-I</skos:altLabel>
        <skos:altLabel xml:lang="en">interoperability principle</skos:altLabel>
        <skos:altLabel xml:lang="en">interoperable</skos:altLabel>
        <skos:definition xml:lang="en">Interoperable: Data should be able to integrate and work alongside other data systems. This means using shared, standard languages (like JSON or XML) and formal vocabularies so systems can exchange information seamlessly.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00173 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00173">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00169"/>
        <rdfs:comment xml:lang="en">R1 : (Meta)data are richly described with a plurality of accurate and relevant attributes.
R1.1 : (Meta)data are released with a clear and accessible data usage license.
R1.2 : (Meta)data are associated with detailed provenance.
R1.3 : (Meta)data meet domain-relevant community standards.</rdfs:comment>
        <rdfs:comment xml:lang="en">The R in FAIR: data and metadata are richly described with a plurality of accurate and relevant attributes.</rdfs:comment>
        <rdfs:label xml:lang="en">reusability</rdfs:label>
        <skos:altLabel xml:lang="en">FAIR-R</skos:altLabel>
        <skos:altLabel xml:lang="en">reusability principle</skos:altLabel>
        <skos:altLabel xml:lang="en">reusable</skos:altLabel>
        <skos:altLabel xml:lang="en">reuse</skos:altLabel>
        <skos:definition xml:lang="en">Reusable: The ultimate goal of FAIR. To optimize data for future use and replication, datasets must include clear usage licenses, detailed provenance (origin history), and adhere to domain-specific community standards.</skos:definition>
    </owl:NamedIndividual>
    


