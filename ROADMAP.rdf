        <skos:altLabel xml:lang="en">Transparency in Reporting of Medical Imaging datasets for AI</skos:altLabel>
        <skos:altLabel xml:lang="en">Transparency in Reporting of Medical Imaging datasets for Artificial Intelligence</skos:altLabel>
        <skos:definition xml:lang="en">A guideline to assure availability of datasets made &quot;publicly available.&quot;</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00180 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00180">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00178"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:comment xml:lang="en">Prevents &quot;link rot&quot; and data decay.</rdfs:comment>
        <rdfs:label xml:lang="en">TRAM-AI item A1</rdfs:label>
        <skos:altLabel xml:lang="en">A1</skos:altLabel>
        <skos:altLabel xml:lang="en">A1 - Trusted Repository</skos:altLabel>
        <skos:altLabel xml:lang="en">Trusted Repository</skos:altLabel>
        <skos:definition xml:lang="en">Dataset is hosted on a recognized, third-party repository (e.g., Zenodo, TCIA, PhysioNet), not personal websites.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00181 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00181">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00178"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:comment xml:lang="en">Ensures findability and citability.</rdfs:comment>
        <rdfs:label xml:lang="en">TRAM-AI item A2</rdfs:label>
        <skos:altLabel xml:lang="en">A2</skos:altLabel>
        <skos:altLabel xml:lang="en">A2 - Persistent Identifier</skos:altLabel>
        <skos:altLabel xml:lang="en">Persistent Identifier</skos:altLabel>
        <skos:definition xml:lang="en">Dataset is assigned a DOI or stable accession number.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00182 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00182">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00178"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:comment xml:lang="en">Ensures reproducibility if dataset updated.</rdfs:comment>
        <rdfs:label xml:lang="en">TRAM-AI item A3</rdfs:label>
        <skos:altLabel xml:lang="en">A3</skos:altLabel>
        <skos:altLabel xml:lang="en">A3 - Version Control</skos:altLabel>
        <skos:altLabel xml:lang="en">Version Control</skos:altLabel>
        <skos:definition xml:lang="en">Repository supports explicit versioning; specific version cited in manuscript.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00184 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00184">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00178"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:comment xml:lang="en">Prevents vendor lock-in.</rdfs:comment>
        <rdfs:label xml:lang="en">TRAM-AI item B1</rdfs:label>
        <skos:altLabel xml:lang="en">B1</skos:altLabel>
        <skos:altLabel xml:lang="en">B1 - Standardized Formats</skos:altLabel>
        <skos:altLabel xml:lang="en">Standardized Formats</skos:altLabel>
        <skos:definition xml:lang="en">Non-proprietary formats (DICOM, nifti). Preprocessing documented or raw data stated.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00185 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00185">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00178"/>
        <supports rdf:resource="https://rsna.org/roadmap/00170"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:comment xml:lang="en">Verify download integrity.</rdfs:comment>
        <rdfs:label xml:lang="en">TRAM-AI item B2</rdfs:label>
        <skos:altLabel xml:lang="en">B2</skos:altLabel>
        <skos:altLabel xml:lang="en">B2 - File Integrity</skos:altLabel>
        <skos:altLabel xml:lang="en">File Integrity</skos:altLabel>
        <skos:definition xml:lang="en">Cryptographic hashes (MD5/SHA-256) provided.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00186 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00186">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00178"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:comment xml:lang="en">Prevents data dump phenomenon.</rdfs:comment>
        <rdfs:label xml:lang="en">TRAM-AI item B3</rdfs:label>
        <skos:altLabel xml:lang="en">B3</skos:altLabel>
        <skos:altLabel xml:lang="en">B3 - Directory Structure</skos:altLabel>
        <skos:altLabel xml:lang="en">Directory Structure</skos:altLabel>
        <skos:definition xml:lang="en">Folder hierarchy documented.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00187 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00187">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00178"/>
