        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00460"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00461"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00462"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00464"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00465"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00466"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00467"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00468"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00469"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00470"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00471"/>
        <hasGuidelineItem rdf:resource="https://rsna.org/roadmap/00472"/>
        <dcterms:source rdf:resource="https://doi.org/10.1136/bmj-2023-078378"/>
        <rdfs:comment xml:lang="en">TRIPOD+AI aims to assist authors in the complete reporting of their study and help peer reviewers, editors, policymakers, end users, and patients understand the data, methods, findings and conclusions of AI driven research. The new checklist supersedes the TRIPOD 2015 checklist, which should no longer be used.</rdfs:comment>
        <rdfs:label xml:lang="en">TRIPOD+AI</rdfs:label>
        <skos:altLabel xml:lang="en">TRIPOD-AI</skos:altLabel>
        <skos:altLabel xml:lang="en">Transparent Reporting of a multivariable prediction model for Individual Prognosis Or Diagnosis plus Artificial Intelligence</skos:altLabel>
        <skos:definition xml:lang="en">TRIPOD+AI provides harmonized guidance for reporting prediction model studies, irrespective of whether regression modelling or machine learning methods have been used.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00279 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00279">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <rdfs:label xml:lang="en">STARD-AI item 01</rdfs:label>
        <skos:definition xml:lang="en">Identification as a study reporting AI-centered diagnostic accuracy and reporting at least one measure of accuracy within title or abstract.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00280 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00280">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <rdfs:label xml:lang="en">STARD-AI item 02</rdfs:label>
        <skos:definition xml:lang="en">Structured summary of study design, methods, results and conclusions (for specific guidance, please see STARD for Abstracts).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00281 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00281">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">STARD-AI item 03</rdfs:label>
        <skos:definition xml:lang="en">Scientific and clinical background, including the intended use of the index test, whether it is novel or an established index test, and its integration into an existing or new workflow, if applicable</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00282 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00282">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00171"/>
        <rdfs:label xml:lang="en">STARD-AI item 04</rdfs:label>
        <skos:definition xml:lang="en">Study objectives and hypotheses.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00283 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00283">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <rdfs:label xml:lang="en">STARD-AI item 05</rdfs:label>
        <skos:definition xml:lang="en">Whether data collection was planned before the index test and reference standard were performed (prospective study) or after (retrospective study).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00284 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00284">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:label xml:lang="en">STARD-AI item 06</rdfs:label>
        <skos:definition xml:lang="en">Formal approval from an ethics committee. If not required, justify why.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00285 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00285">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 07</rdfs:label>
        <skos:definition xml:lang="en">Eligibility criteria: listing separate inclusion and exclusion criteria in the order that they are applied at both participant level and data level.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00286 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00286">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <rdfs:label xml:lang="en">STARD-AI item 08</rdfs:label>
        <skos:definition xml:lang="en">On what basis potentially eligible participants were identified (such as symptoms, results from previous tests, inclusion in registry).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00287 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00287">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <rdfs:label xml:lang="en">STARD-AI item 09</rdfs:label>
        <skos:definition xml:lang="en">Where and when potentially eligible participants were identified (setting, location, and dates).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00288 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00288">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 10</rdfs:label>
        <skos:definition xml:lang="en">Whether participants formed a consecutive, random, or convenience series.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00289 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00289">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <rdfs:label xml:lang="en">STARD-AI item 11</rdfs:label>
        <skos:definition xml:lang="en">Source of the data and whether it has been routinely collected, specifically collected for the purpose of the study or acquired from an open-source repository.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00290 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00290">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:label xml:lang="en">STARD-AI item 12</rdfs:label>
        <skos:definition xml:lang="en">Who undertook the annotations for the dataset (including experience levels and background) and how (within the same clinical context or in a post-hoc fashion), if applicable.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00291 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00291">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00254"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 13</rdfs:label>
        <skos:definition xml:lang="en">Devices (manufacturer, model) that were used to capture data; software (with version number) used to engineer the index test, highlighting the intended use.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00292 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00292">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 14</rdfs:label>
        <skos:definition xml:lang="en">Data acquisition protocols (e.g. contrast protocol or reconstruction method for medical images) and details of data pre-processing in sufficient detail to allow replication.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00293 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00293">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <rdfs:label xml:lang="en">STARD-AI item 15a</rdfs:label>
        <skos:definition xml:lang="en">Index test, in sufficient detail to allow replication.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00294 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00294">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 15b</rdfs:label>
        <skos:definition xml:lang="en">How the index test was developed, including any training, validation, testing and external evaluation, detailing sample sizes, when applicable.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00295 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00295">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 15c</rdfs:label>
        <skos:definition xml:lang="en">Definition of and rationale for test positivity cut-offs or result categories of the index test, distinguishing pre-specified from exploratory.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00296 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00296">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">STARD-AI item 15d</rdfs:label>
        <skos:definition xml:lang="en">The specified end user of the index test and the level of expertise required of users.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00297 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00297">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00172"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:label xml:lang="en">STARD-AI item 16a</rdfs:label>
        <skos:definition xml:lang="en">Reference standard, in sufficient detail to allow replication.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00298 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00298">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <rdfs:label xml:lang="en">STARD-AI item 16b</rdfs:label>
        <skos:definition xml:lang="en">Rationale for choosing the reference standard (if alternatives exist).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00299 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00299">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <rdfs:label xml:lang="en">STARD-AI item 16c</rdfs:label>
        <skos:definition xml:lang="en">Definition of and rationale for test positivity cut-offs or result categories of the reference standard, distinguishing pre-specified from exploratory.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00300 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00300">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <rdfs:label xml:lang="en">STARD-AI item 17a</rdfs:label>
        <skos:definition xml:lang="en">Whether clinical information and reference standard results were available to the performers or readers of the index test.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00301 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00301">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <rdfs:label xml:lang="en">STARD-AI item 17b</rdfs:label>
        <skos:definition xml:lang="en">Whether clinical information and index test results were available to the assessors of the reference standard.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00302 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00302">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <rdfs:label xml:lang="en">STARD-AI item 18</rdfs:label>
        <skos:definition xml:lang="en">Methods for estimating or comparing measures of diagnostic accuracy.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00303 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00303">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 19</rdfs:label>
        <skos:definition xml:lang="en">How indeterminate index test or reference standard results were handled.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00304 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00304">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 20</rdfs:label>
        <skos:definition xml:lang="en">How missing data on the index test and reference standard were handled.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00305 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00305">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 21</rdfs:label>
        <skos:definition xml:lang="en">Any analyses of variability in diagnostic accuracy, distinguishing pre-specified from exploratory.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00306 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00306">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 22</rdfs:label>
        <skos:definition xml:lang="en">Intended sample size and how it was determined.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00307 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00307">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 23</rdfs:label>
        <skos:definition xml:lang="en">Details of any performance error analysis, and algorithmic bias and fairness assessments if undertaken.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00308 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00308">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <rdfs:label xml:lang="en">STARD-AI item 24</rdfs:label>
        <skos:definition xml:lang="en">Flow of participants, using a diagram.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00309 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00309">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00173"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 25</rdfs:label>
        <skos:definition xml:lang="en">Baseline demographic, clinical and technical characteristics of training, validation and test set, if applicable.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00310 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00310">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 26a</rdfs:label>
        <skos:definition xml:lang="en">Distribution of severity of disease in those with the target condition.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00311 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00311">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 26b</rdfs:label>
        <skos:definition xml:lang="en">Distribution of alternative diagnoses in those without the target condition.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00312 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00312">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <rdfs:label xml:lang="en">STARD-AI item 27</rdfs:label>
        <skos:definition xml:lang="en">Time interval and any clinical interventions between index test and reference standard.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00313 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00313">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 28</rdfs:label>
        <skos:definition xml:lang="en">Whether the datasets represent the distribution of the target condition that one would expect from the intended use population.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00314 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00314">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 29</rdfs:label>
        <skos:definition xml:lang="en">For external evaluation on an independent dataset, an assessment of how this differs from the training, validation and test sets.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00315 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00315">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <rdfs:label xml:lang="en">STARD-AI item 30</rdfs:label>
        <skos:definition xml:lang="en">Cross tabulation of the index test results (or their distribution) by the results of the reference standard.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00316 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00316">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 31</rdfs:label>
        <skos:definition xml:lang="en">Estimates of diagnostic accuracy and their precision (such as 95% confidence intervals).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00317 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00317">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 32</rdfs:label>
        <skos:definition xml:lang="en">Any adverse events from performing the index test or the reference standard.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00318 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00318">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00253"/>
        <supports rdf:resource="https://rsna.org/roadmap/00255"/>
        <supports rdf:resource="https://rsna.org/roadmap/00257"/>
        <rdfs:label xml:lang="en">STARD-AI item 33</rdfs:label>
        <skos:definition xml:lang="en">Study limitations, including sources of potential bias, statistical uncertainty, and generalisability.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00319 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00319">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00256"/>
        <rdfs:label xml:lang="en">STARD-AI item 34</rdfs:label>
        <skos:definition xml:lang="en">Implications for practice, including the intended use and clinical role of the index test.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00320 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00320">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
        <supports rdf:resource="https://rsna.org/roadmap/00258"/>
        <rdfs:label xml:lang="en">STARD-AI item 35</rdfs:label>
        <skos:definition xml:lang="en">Ethical considerations and adherence to ethical standards associated with the use of the index test and issues of fairness.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://rsna.org/roadmap/00321 -->

    <owl:NamedIndividual rdf:about="https://rsna.org/roadmap/00321">
        <rdf:type rdf:resource="https://rsna.org/roadmap/00278"/>
