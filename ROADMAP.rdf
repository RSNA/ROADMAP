        <rdfs:label xml:lang="en">intersex</rdfs:label>
        <skos:altLabel xml:lang="en">disorder of sex development</skos:altLabel>
        <skos:definition xml:lang="en">A sex value for an individual born with physical or genetic characteristics that are not exclusively male or female.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/32570691000036108"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/32570691000036108"/>
