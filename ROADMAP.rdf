        <rdfs:label xml:lang="en">comments</rdfs:label>
        <rdfs:label xml:lang="zh">评论</rdfs:label>
        <skos:altLabel xml:lang="en">comment</skos:altLabel>
        <skos:definition xml:lang="en">Textual comments about the model, dataset, or project.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00071 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00071">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00661"/>
        <rdfs:label xml:lang="en">person</rdfs:label>
        <rdfs:label xml:lang="es">persona</rdfs:label>
        <rdfs:label xml:lang="zh">人员</rdfs:label>
        <skos:definition xml:lang="en">A human author, contributor, or user.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00072 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00072">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00661"/>
        <rdfs:comment xml:lang="en">May link to the organization&apos;s URI.</rdfs:comment>
        <rdfs:label xml:lang="es">organización</rdfs:label>
        <rdfs:label xml:lang="en">organization</rdfs:label>
        <rdfs:label xml:lang="zh">组织</rdfs:label>
        <skos:altLabel xml:lang="en">organisation</skos:altLabel>
        <skos:definition xml:lang="en">An organizational entity that developed and/or supported the resource.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00073 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00073">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00074"/>
        <dcterms:source rdf:resource="https://archive.rsna.org/2019/Specialty%20Content%20Codes.pdf"/>
        <rdfs:label xml:lang="en">content code</rdfs:label>
        <rdfs:label xml:lang="es">código de contenido</rdfs:label>
        <rdfs:label xml:lang="zh">内容代码</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.radlex.org/RID/RID50607"/>
        <skos:definition xml:lang="en">An RSNA subspecialty content code, each of which has a 2-letter abbreviation, such as CT or GI.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00074 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00074">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00658"/>
        <rdfs:label xml:lang="es">código de indexación</rdfs:label>
        <rdfs:label xml:lang="en">indexing code</rdfs:label>
        <rdfs:label xml:lang="zh">索引代码</rdfs:label>
        <skos:altLabel xml:lang="en">index code</skos:altLabel>
        <skos:definition xml:lang="en">An indexing code is a term from a related ontology, such as RadLex, SNOMED Clinical Terms, or the RSNA 2-letter subspecialty content codes.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00075 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00075">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03599"/>
        <rdfs:label xml:lang="es">médico</rdfs:label>
        <rdfs:label xml:lang="en">physician</rdfs:label>
        <rdfs:label xml:lang="zh">医生</rdfs:label>
        <skos:definition xml:lang="en">A health care provider with a medical degree.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/309343006"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00076 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00076">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00079"/>
        <rdfs:label xml:lang="en">advanced practice provider</rdfs:label>
        <rdfs:label xml:lang="es">proveedor de práctica avanzada</rdfs:label>
        <rdfs:label xml:lang="zh">高级执业医护人员</rdfs:label>
        <skos:altLabel xml:lang="en">APP</skos:altLabel>
        <skos:definition xml:lang="en">Advanced practice providers (APPs)—primarily nurse practitioners (NPs) and physician assistants (PAs)—are licensed healthcare professionals who provide comprehensive care, including diagnosing, treating, and prescribing medication.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00077 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00077">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00076"/>
        <rdfs:label xml:lang="es">enfermero/a especializado/a</rdfs:label>
        <rdfs:label xml:lang="en">nurse practitioner</rdfs:label>
        <rdfs:label xml:lang="zh">执业护士</rdfs:label>
        <skos:altLabel xml:lang="en">NP</skos:altLabel>
        <skos:definition xml:lang="en">A nurse practitioner (NP) is an advanced practice registered nurse and a type of mid-level practitioner.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/224571005"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00078 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00078">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00076"/>
        <rdfs:label xml:lang="es">asistente médico/a</rdfs:label>
        <rdfs:label xml:lang="en">physician assistant</rdfs:label>
        <rdfs:label xml:lang="zh">医师助理</rdfs:label>
        <skos:altLabel xml:lang="en">PA</skos:altLabel>
        <skos:definition xml:lang="en">A physician assistant (PA) is a type of non-physician practitioner.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/449161006"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00079 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00079">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00080"/>
        <rdfs:label xml:lang="en">non-physician provider</rdfs:label>
        <rdfs:label xml:lang="es">proveedor/a no médico/a</rdfs:label>
        <rdfs:label xml:lang="zh">非医师执业人员</rdfs:label>
        <skos:definition xml:lang="en">A healthcare provider who is not a physician, such as a nurse practitioner or physician assistant.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00080 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00080">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03599"/>
        <rdfs:label xml:lang="es">proveedor/a referente</rdfs:label>
        <rdfs:label xml:lang="en">referring provider</rdfs:label>
        <rdfs:label xml:lang="zh">转诊提供者</rdfs:label>
        <skos:definition xml:lang="en">The healthcare provider who refers the patient for a procedure.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00087 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00087">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1007/s11547-024-01886-9"/>
        <dcterms:source rdf:resource="https://doi.org/10.1148/radiol.2018180009"/>
        <rdfs:label xml:lang="en">false referral rate</rdfs:label>
        <rdfs:label xml:lang="es">tasa de derivación falsa</rdfs:label>
        <rdfs:label xml:lang="zh">错误转诊率</rdfs:label>
        <skos:altLabel xml:lang="en">FRR</skos:altLabel>
        <skos:definition xml:lang="en">False referral rate measures the proportion of patients without the disease who are incorrectly flagged for further confirmatory evaluation by the test. It is computed as the number of false positive results divided by the total number of individuals examined. This metric complements diagnostic yield by indicating the potential burden of unnecessary follow-up procedures and associated harms.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00113 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00113">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1038/s41592-023-02151-z"/>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.1469-8137.1912.tb05611.x"/>
        <rdfs:label xml:lang="en">approximate intersection over union</rdfs:label>
        <rdfs:label xml:lang="es">intersección aproximada sobre unión</rdfs:label>
        <rdfs:label xml:lang="zh">近似交并比</rdfs:label>
        <skos:altLabel xml:lang="en">approx IoU</skos:altLabel>
        <skos:altLabel xml:lang="en">approx intersection over union</skos:altLabel>
        <skos:altLabel xml:lang="en">approximate IoU</skos:altLabel>
        <skos:definition xml:lang="en">Approximate intersection over union calculates overlap between simplified geometric representations of structures, such as ellipses or convex hulls, by comparing their intersection with their union. It provides a generalized measure for evaluating predictions that use approximations instead of precise pixel masks. This metric is used in scenarios where an approximate shape suffices for the intended task or computational constraints.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00117 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00117">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00074"/>
        <dcterms:source rdf:resource="https://radlex.org/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.radlex.org/RID/RID0"/>
        <rdfs:label xml:lang="en">RadLex code</rdfs:label>
        <rdfs:label xml:lang="zh">RadLex 代码</rdfs:label>
        <rdfs:label xml:lang="es">código de RadLex</rdfs:label>
        <skos:altLabel xml:lang="en">RadLex indexing code</skos:altLabel>
        <skos:altLabel xml:lang="es">código RadLex</skos:altLabel>
        <skos:definition xml:lang="en">A code from the RadLex ontology (e.g., RID58) used to index an AI resource.</skos:definition>
        <pattern>https://radlex.org/RID/$</pattern>
        <regex>RID[0-9]+</regex>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00118 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00118">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="es">deriva del modelo</rdfs:label>
        <rdfs:label xml:lang="en">model drift</rdfs:label>
        <rdfs:label xml:lang="zh">模型漂移</rdfs:label>
        <skos:altLabel xml:lang="en">model performance drift</skos:altLabel>
        <skos:altLabel xml:lang="en">performance drift</skos:altLabel>
        <skos:definition xml:lang="en">Model drift is the change of an AI model’s performance over time due to changing data, features or relationships.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00119 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00119">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01048"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-031-43898-1_32"/>
        <rdfs:label xml:lang="es">concordancia multimodal</rdfs:label>
        <rdfs:label xml:lang="en">multi-modal concordance</rdfs:label>
        <rdfs:label xml:lang="zh">多模态一致性</rdfs:label>
        <skos:altLabel xml:lang="en">MMC</skos:altLabel>
        <skos:altLabel xml:lang="en">multi-modal concordance index</skos:altLabel>
        <skos:definition xml:lang="en">Multi-modal concordance (MMC) aggregates metrics from various sources to assess overall data drift without assuming access to reference-standard &quot;truth&quot; labels needed to monitor model performance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00120 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00120">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00663"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00172"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00215"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00253"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00291"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00617"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00639"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">imaging modality</rdfs:label>
        <rdfs:label xml:lang="es">modalidad de imagen</rdfs:label>
        <rdfs:label xml:lang="zh">成像方式</rdfs:label>
        <skos:altLabel xml:lang="en">modality</skos:altLabel>
        <skos:definition xml:lang="en">The type of device used to obtain the images, such as CT.</skos:definition>
        <skos:exactMatch rdf:resource="http://www.radlex.org/RID/RID10311"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00121 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00121">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00663"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00172"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00215"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00253"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00291"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00292"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00617"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00639"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">imaging procedure</rdfs:label>
        <rdfs:label xml:lang="es">procedimiento de imagen</rdfs:label>
        <rdfs:label xml:lang="zh">成像程序</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://loinc.org/kb/users-guide/loinc-rsna-radiology-playbook-user-guide/"/>
        <skos:definition xml:lang="en">An imaging procedure, specified using its LOINC/RSNA Radiology Playbook identifier, RadLex Playbook ID (RPID), and/or text name. For example, LOINC code 36813-4, RadLex RPID145, procedure name &quot;CT Abdomen and Pelvis W contrast IV&quot;.</skos:definition>
        <skos:exactMatch rdf:resource="http://www.radlex.org/RID/RID13060"/>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00122 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00122">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00663"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00215"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00291"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00292"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00309"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00617"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00639"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">característica de la imagen</rdfs:label>
        <rdfs:label xml:lang="en">image characteristic</rdfs:label>
        <rdfs:label xml:lang="zh">图像特征</rdfs:label>
        <skos:definition xml:lang="en">Information about a dataset&apos;s images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00123 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00123">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00122"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00184"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">resolución</rdfs:label>
        <rdfs:label xml:lang="en">resolution</rdfs:label>
        <rdfs:label xml:lang="zh">分辨率</rdfs:label>
        <skos:altLabel xml:lang="en">image resolution</skos:altLabel>
        <skos:definition xml:lang="en">Describes whether the dataset used original or down-sampled images.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00124 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00124">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00123"/>
        <rdfs:label xml:lang="en">original resolution</rdfs:label>
        <rdfs:label xml:lang="es">resolución original</rdfs:label>
        <rdfs:label xml:lang="zh">原始分辨率</rdfs:label>
        <skos:definition xml:lang="en">Image information that has not been downsampled.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00125 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00125">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00123"/>
        <rdfs:label xml:lang="en">downsampled resolution</rdfs:label>
        <rdfs:label xml:lang="es">resolución submuestreada</rdfs:label>
        <rdfs:label xml:lang="zh">下采样分辨率</rdfs:label>
        <skos:definition xml:lang="en">Downsampling reduces the resolution of the image without increasing the physical size of the image.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00126 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00126">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00122"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00184"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00211"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00292"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00572"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00599"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00618"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00640"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">pre-processing</rdfs:label>
        <rdfs:label xml:lang="es">preprocesamiento</rdfs:label>
        <rdfs:label xml:lang="zh">预处理</rdfs:label>
        <skos:altLabel xml:lang="en">preprocessing</skos:altLabel>
        <skos:definition xml:lang="en">Describes the type(s) of pre-processing applied to a dataset&apos;s images, such as histogram equalization or standard normalization.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00127 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00127">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00126"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00599"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">normalización estándar</rdfs:label>
        <rdfs:label xml:lang="en">standard normalization</rdfs:label>
        <rdfs:label xml:lang="zh">标准归一化</rdfs:label>
        <skos:altLabel xml:lang="en">Z-score normalization</skos:altLabel>
        <skos:altLabel xml:lang="en">standardization</skos:altLabel>
        <skos:definition xml:lang="en">Standard normalization, or standardization, is a data preprocessing technique that transforms features to have a mean of 0 and a standard deviation of 1, resulting in a distribution with unit variance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00128 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00128">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00126"/>
        <rdfs:label xml:lang="en">histogram normalization</rdfs:label>
        <rdfs:label xml:lang="es">normalización del histograma</rdfs:label>
        <rdfs:label xml:lang="zh">直方图归一化</rdfs:label>
        <skos:altLabel xml:lang="en">histogram equalization</skos:altLabel>
        <skos:definition xml:lang="en">Histogram equalization is a method in image processing of contrast adjustment using the image&apos;s histogram.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00129 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00129">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00122"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00196"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00213"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://rsna.org/roadmap/03369"/>
            <rdf:Description rdf:about="https://rsna.org/roadmap/03370"/>
            <rdf:Description rdf:about="https://rsna.org/roadmap/03371"/>
        </owl:disjointUnionOf>
        <rdfs:label xml:lang="es">información sanitaria protegida</rdfs:label>
        <rdfs:label xml:lang="en">protected health information</rdfs:label>
        <rdfs:label xml:lang="zh">受保护的健康信息</rdfs:label>
        <skos:altLabel xml:lang="en">PHI</skos:altLabel>
        <skos:definition xml:lang="en">According to the Health Insurance Portability and Accountability Act (HIPAA), protected health information (PHI) is any health information that can identify an individual that relates to a patient&apos;s past, present, or future health.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00131 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00131">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <dcterms:source rdf:resource="https://www.mpeg.org/standards/"/>
        <rdfs:label xml:lang="en">MPEG</rdfs:label>
        <rdfs:label xml:lang="es">MPEG</rdfs:label>
        <rdfs:label xml:lang="zh">MPEG</rdfs:label>
        <skos:altLabel xml:lang="en">Moving Picture Experts Group</skos:altLabel>
        <skos:definition xml:lang="en">The Moving Picture Experts Group (MPEG) standards support compression, decompression, processing, and coded representation of moving pictures, audio, 3G graphics, and haptics.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00132 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00132">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00119"/>
        <dcterms:source rdf:resource="https://doi.org/10.48550/arXiv.2410.13174"/>
        <rdfs:label xml:lang="es">concordancia multimodal mejorada</rdfs:label>
        <rdfs:label xml:lang="en">enhanced multi-modal concordance</rdfs:label>
        <rdfs:label xml:lang="zh">增强的多模态一致性</rdfs:label>
        <skos:altLabel xml:lang="en">MMC+</skos:altLabel>
        <skos:altLabel xml:lang="en">enhanced multi-modal concordance index</skos:altLabel>
        <skos:definition xml:lang="en">MMC+, an enhanced framework for scalable drift monitoring, builds upon the CheXstray framework that introduced real-time drift detection for medical imaging AI models using multi-modal data concordance.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00133 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00133">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <rdfs:label xml:lang="en">NRRD</rdfs:label>
        <rdfs:label xml:lang="es">NRRD</rdfs:label>
        <rdfs:label xml:lang="zh">NRRD</rdfs:label>
        <skos:altLabel xml:lang="en">Nearly Raw Raster Data</skos:altLabel>
        <skos:definition xml:lang="en">A flexible 3D/4D format often favored for segmentation tasks because it handles multidimensional arrays without the overhead of DICOM.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00134 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00134">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <rdfs:label xml:lang="en">WSI</rdfs:label>
        <rdfs:label xml:lang="es">WSI</rdfs:label>
        <rdfs:label xml:lang="zh">WSI</rdfs:label>
        <skos:altLabel xml:lang="en">Whole Slide Imaging</skos:altLabel>
        <skos:definition xml:lang="en">Specifically for digital pathology, formats such as .svs or .tif store high-resolution tissue scans in a &quot;pyramidal&quot; structure to allow access at various zoom levels.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00135 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00135">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00059"/>
        <dcterms:source rdf:resource="https://www.bic.mni.mcgill.ca/software/minc/"/>
        <rdfs:comment xml:lang="en">Based on HDF5, this format is highly efficient for very large, complex medical datasets often used in academic brain research.</rdfs:comment>
        <rdfs:label xml:lang="en">MINC</rdfs:label>
        <rdfs:label xml:lang="es">MINC</rdfs:label>
        <rdfs:label xml:lang="zh">MINC</rdfs:label>
        <skos:definition xml:lang="en">Medical Imaging NetCDF (MINC) is a medical imaging data format and also an associated set of tools and libraries.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00136 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00136">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01044"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://arxiv.org/abs/1706.08500"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.cviu.2021.103329"/>
        <rdfs:label xml:lang="en">Fréchet inception distance</rdfs:label>
        <rdfs:label xml:lang="es">distancia de inicio de Fréchet</rdfs:label>
        <skos:altLabel xml:lang="en">FID</skos:altLabel>
        <skos:altLabel xml:lang="en">Frechet inception distance</skos:altLabel>
        <skos:altLabel xml:lang="zh">弗雷歇起始距离</skos:altLabel>
        <skos:definition xml:lang="en">Fréchet inception distance compares the distribution of generated images with the distribution of a set of real images. Rather than comparing individual images, mean and covariance statistics of many images generated by the model are compared with the same statistics generated from images in the reference set.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00137 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00137">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01044"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.cviu.2021.103329"/>
        <rdfs:label xml:lang="zh">Inception 分数</rdfs:label>
        <rdfs:label xml:lang="en">inception score</rdfs:label>
        <rdfs:label xml:lang="es">puntuación de inicio</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Inception_score"/>
        <skos:altLabel xml:lang="en">IS</skos:altLabel>
        <skos:definition xml:lang="en">An algorithm used to assess the quality of images created by a generative image model such as a generative adversarial network (GAN).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00138 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00138">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="es">generación de imágenes</rdfs:label>
        <rdfs:label xml:lang="en">image generation performance</rdfs:label>
        <rdfs:label xml:lang="zh">图像生成</rdfs:label>
        <skos:altLabel xml:lang="en">image generation</skos:altLabel>
        <skos:definition xml:lang="en">A measure of the quality of image generation.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00139 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00139">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01044"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.cviu.2021.103329"/>
        <rdfs:label xml:lang="es">longitud del camino perceptivo</rdfs:label>
        <rdfs:label xml:lang="en">perceptual path length</rdfs:label>
        <skos:altLabel xml:lang="en">PPL</skos:altLabel>
        <skos:definition xml:lang="en">Perceptual Path Length (PPL) evaluates the smoothness and consistency of image interpolations.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00142 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00142">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01054"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://arxiv.org/abs/2106.11520"/>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.ejrai.2025.100030"/>
        <rdfs:comment xml:lang="en">When comparing outputs using the official code from the BARTScore GitHub Repository, a higher score (closer to 0) indicates a better quality generation.</rdfs:comment>
        <rdfs:label xml:lang="en">BARTScore</rdfs:label>
        <rdfs:label xml:lang="es">BARTScore</rdfs:label>
        <rdfs:label xml:lang="zh">BART评分</rdfs:label>
        <skos:altLabel xml:lang="en">BART Score</skos:altLabel>
        <skos:altLabel xml:lang="en">BART-Score</skos:altLabel>
        <skos:definition xml:lang="en">BARTScore is a text-generation evaluation metric that treats model evaluation as a text-generation task</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00143 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00143">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">adjusted Rand index</rdfs:label>
        <rdfs:label xml:lang="es">Índice de Rand ajustado</rdfs:label>
        <skos:altLabel xml:lang="en">ARI</skos:altLabel>
        <skos:definition xml:lang="en">The Adjusted Rand Index (ARI) is a cluster validation metric measuring similarity between two data clusterings by evaluating all pair-wise sample assignments, corrected for chance. Ranging from -1 to 1, an ARI of 1 indicates perfect agreement, 0 represents random labeling, and negative values indicate worse-than-random performance</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00144 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00144">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1109/TPAMI.1979.4766909"/>
        <rdfs:label xml:lang="en">Davies-Bouldin index</rdfs:label>
        <rdfs:label xml:lang="zh">Davies-Bouldin 指数</rdfs:label>
        <rdfs:label xml:lang="es">índice de Davies-Bouldin</rdfs:label>
        <skos:altLabel xml:lang="en">DBI</skos:altLabel>
        <skos:definition xml:lang="en">The Davies–Bouldin index (DBI) is a metric for evaluating clustering algorithms, where the validation of how well the clustering has been done is made using quantities and features inherent to the dataset.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00145 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00145">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">clustering performance</rdfs:label>
        <rdfs:label xml:lang="es">rendimiento de agrupación</rdfs:label>
        <rdfs:label xml:lang="zh">聚类</rdfs:label>
        <skos:altLabel xml:lang="es">agrupación</skos:altLabel>
        <skos:altLabel xml:lang="en">clustering</skos:altLabel>
        <skos:definition xml:lang="en">The assessment of an AI system&apos;s clustering.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00146 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00146">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.1016/0377-0427(87)90125-7"/>
        <rdfs:label xml:lang="es">coeficiente de silueta</rdfs:label>
        <rdfs:label xml:lang="en">silhouette coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Silhouette_(clustering)"/>
        <rdfs:seeAlso rdf:resource="https://es.wikipedia.org/wiki/Silhouette_(clustering)"/>
        <skos:altLabel xml:lang="en">silhouette</skos:altLabel>
        <skos:altLabel xml:lang="es">valor de la silueta</skos:altLabel>
        <skos:definition xml:lang="en">The silhouette value is a measure of how similar an object is to its own cluster (cohesion) compared to other clusters (separation). The silhouette value ranges from −1 to +1, where a high value indicates that the object is well matched to its own cluster and poorly matched to neighboring clusters.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00147 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00147">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1080/03610927408827101"/>
        <rdfs:label xml:lang="zh">Calinski-Harabasz 指数</rdfs:label>
        <rdfs:label xml:lang="en">variance ratio criterion</rdfs:label>
        <rdfs:label xml:lang="es">índice de Calinski-Harabasz</rdfs:label>
        <skos:altLabel xml:lang="en">CHI</skos:altLabel>
        <skos:altLabel xml:lang="en">Calinski-Harabasz index</skos:altLabel>
        <skos:altLabel xml:lang="en">VRC</skos:altLabel>
        <skos:definition xml:lang="en">The Calinski–Harabasz index (CHI), also known as the Variance Ratio Criterion (VRC), is an internal metric for evaluating clustering algorithms, where the assessment of the clustering quality is based solely on the dataset and the clustering results, and not on external, ground-truth labels.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00148 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00148">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://arxiv.org/abs/2210.11997"/>
        <dcterms:source rdf:resource="https://doi.org/10.54364/AAIML.2023.1161"/>
        <rdfs:comment xml:lang="en">P4 = 4 / (1/precision + 1/recall + 1/specificity + 1/NPV)</rdfs:comment>
        <rdfs:label xml:lang="en">P4 metric</rdfs:label>
        <rdfs:label xml:lang="zh">P4 指标</rdfs:label>
        <rdfs:label xml:lang="es">métrica P4</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/P4-metric"/>
        <skos:altLabel xml:lang="en">FS</skos:altLabel>
        <skos:altLabel xml:lang="en">P4</skos:altLabel>
        <skos:altLabel xml:lang="en">P4-metric</skos:altLabel>
        <skos:altLabel xml:lang="en">symmetric F</skos:altLabel>
        <skos:definition xml:lang="en">The P4 metric, also known as FS or Symmetric F, enables performance evaluation of a binary classifier: it is calculated from precision, recall, specificity, and negative predictive value.</skos:definition>
        <formula>4 / (1/PPV + 1/TPR + 1/TNR + 1/NPV)</formula>
        <symbol>P4</symbol>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00149 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00149">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1080/01969727308546046"/>
        <rdfs:label xml:lang="en">Dunn index</rdfs:label>
        <rdfs:label xml:lang="zh">Dunn 指数</rdfs:label>
        <rdfs:label xml:lang="es">índice de Dunn</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Dunn_index"/>
        <skos:definition xml:lang="en">The Dunn index, a metric for evaluating clustering algorithms, is part of a group of validity indices including the Davies–Bouldin index or Silhouette index, in that it is an internal evaluation scheme, where the result is based on the clustered data itself.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00150 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00150">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The Hopkins statistic (introduced by Brian Hopkins and John Gordon Skellam) is a way of measuring the cluster tendency of a data set. It belongs to the family of sparse sampling tests. It acts as a statistical hypothesis test where the null hypothesis is that the data is generated by a Poisson point process and are thus uniformly randomly distributed. If individuals are aggregated, then its value approaches 1, and if they are randomly distributed along the value tends to 0.5. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">Hopkins statistic</rdfs:label>
        <rdfs:label xml:lang="es">estadístico de Hopkins</rdfs:label>
        <rdfs:label xml:lang="zh">霍普金斯统计量</rdfs:label>
        <skos:definition xml:lang="en">The Hopkins statistic is a way of measuring the cluster tendency of a data set.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00151 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00151">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01042"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1137/1.9781611973440.96"/>
        <rdfs:label xml:lang="en">density-based clustering validation</rdfs:label>
        <rdfs:label xml:lang="es">validación de agrupación basada en densidad</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Density-based_clustering_validation"/>
        <skos:altLabel xml:lang="en">DBCV</skos:altLabel>
        <skos:definition xml:lang="en">Density-Based Clustering Validation (DBCV) is a metric designed to assess the quality of clustering solutions, particularly for density-based clustering algorithms like DBSCAN, Mean shift, and OPTICS. This metric is particularly suited for identifying concave and nested clusters, where traditional metrics such as the Silhouette coefficient, Davies–Bouldin index, or Calinski–Harabasz index often struggle to provide meaningful evaluations.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00152 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00152">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.2214/AJR.25.34340"/>
        <rdfs:label xml:lang="en">number needed to benefit</rdfs:label>
        <rdfs:label xml:lang="es">número de casos necesarios para obtener un beneficio</rdfs:label>
        <skos:altLabel xml:lang="en">NNB</skos:altLabel>
        <skos:definition xml:lang="en">The number needed to benefit (NNB) is defined as the reciprocal of the absolute enhanced detection rate (i.e., total number of cases needed to review to achieve one AI true-positive that the radiologist alone would miss). The number of positive cases needed to benefit is defined as the reciprocal of the relative enhanced detection rate (i.e., number of radiologist true-positives needed to achieve one AI true-positive that the radiologist alone would miss).These two metrics are analogous to the number needed to treat metric used in clinical decision making.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00153 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00153">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.2214/AJR.25.34340"/>
        <rdfs:comment xml:lang="en">GPR serves as a measure of a model’s net benefit by comparing the gain from additional reference-standard positive cases detected with AI assistance to the so-called “pain” from AI false-positives.</rdfs:comment>
        <rdfs:label xml:lang="en">gain-to-pain ratio</rdfs:label>
        <rdfs:label xml:lang="es">relación beneficio-dolor</rdfs:label>
        <skos:altLabel xml:lang="en">GPR</skos:altLabel>
        <skos:altLabel xml:lang="en">gain to pain ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">gain-to-pain</skos:altLabel>
        <skos:definition xml:lang="en">The gain-to-pain ratio (GPR) is defined as the ratio between the number of enhanced detection cases and number of AI false-positive cases.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00154 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00154">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01039"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://doi.org/10.2214/AJR.25.34340"/>
        <rdfs:label xml:lang="en">number of positive cases needed to benefit</rdfs:label>
        <rdfs:label xml:lang="es">número de casos positivos necesarios para obtener un beneficio</rdfs:label>
        <skos:definition xml:lang="en">The number of positive cases needed to benefit is defined as the reciprocal of the relative enhanced detection rate (i.e., number of radiologist true-positives needed to achieve one AI true-positive that the radiologist alone would miss).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00156 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00156">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01051"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">nivel de dificultad de lectura</rdfs:label>
        <rdfs:label xml:lang="en">reading difficulty level</rdfs:label>
        <skos:altLabel xml:lang="en">grade reading level</skos:altLabel>
        <skos:definition xml:lang="en">The grade reading level (or reading difficulty level) is calculated by the average number of sentences (y-axis) and syllables (x-axis) per hundred words.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00160 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00160">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/04043"/>
        <rdfs:label xml:lang="en">ranking performance</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Ranking_(information_retrieval)"/>
        <skos:altLabel xml:lang="en">ranking</skos:altLabel>
        <skos:definition xml:lang="en">Ranking is one of the fundamental problems in information retrieval (IR). Given a query q and a collection D of documents that match the query, the problem is to rank, that is, sort, the documents in D according to some criterion so that the &quot;best&quot; results appear early in the result list displayed to the user.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00161 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00161">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01050"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://proceedings.mlr.press/v30/Wang13.html"/>
        <rdfs:label xml:lang="en">discounted cumulative gain</rdfs:label>
        <rdfs:label xml:lang="es">ganancia acumulada descontada</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Discounted_cumulative_gain"/>
        <skos:altLabel xml:lang="en">DCG</skos:altLabel>
        <skos:definition xml:lang="en">Discounted cumulative gain (DCG) is a measure of ranking quality in information retrieval.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00162 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00162">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01050"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <dcterms:source rdf:resource="https://doi.org/10.1145/582415.582418"/>
        <dcterms:source rdf:resource="https://proceedings.mlr.press/v30/Wang13.html"/>
        <rdfs:label xml:lang="en">cumulative gain</rdfs:label>
        <rdfs:label xml:lang="es">ganancia acumulada</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Discounted_cumulative_gain"/>
        <skos:altLabel xml:lang="en">CG</skos:altLabel>
        <skos:definition xml:lang="en">Cumulative Gain is the sum of the graded relevance values of all results in a search result list. CG does not take into account the rank (position) of a result in the result list.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00163 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00163">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/01050"/>
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/maximum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/minimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/optimum"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://proceedings.mlr.press/v30/Wang13.html"/>
        <rdfs:label xml:lang="es">ganancia acumulada descontada normalizada</rdfs:label>
        <rdfs:label xml:lang="en">normalized discounted cumulative gain</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Discounted_cumulative_gain"/>
        <skos:altLabel xml:lang="en">NDCG</skos:altLabel>
        <skos:altLabel xml:lang="en">nDCG</skos:altLabel>
        <skos:altLabel xml:lang="en">normalised DCG</skos:altLabel>
        <skos:altLabel xml:lang="en">normalised discounted cumulative gain</skos:altLabel>
        <skos:altLabel xml:lang="en">normalized DCG</skos:altLabel>
        <skos:definition xml:lang="en">Normalized discounted cumulative gain (NDCG) measures the performance of a recommendation system based on the graded relevance of the recommended entities. It varies from 0.0 to 1.0, with 1.0 representing the ideal ranking of the entities. This metric is commonly used in information retrieval and to evaluate the performance of web search engines.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00164 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00164">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00163"/>
        <rdfs:label xml:lang="es">ganancia acumulada descontada normalizada en k entradas</rdfs:label>
        <rdfs:label xml:lang="en">normalized discounted cumulative gain at k</rdfs:label>
        <skos:altLabel xml:lang="en">NDCG@k</skos:altLabel>
        <skos:altLabel xml:lang="en">normalized discounted cumulative gain @ k entries</skos:altLabel>
        <skos:definition xml:lang="en">Normalized discounted cumulative gain (NDCG) measures the performance of a recommendation system based on the graded relevance of the recommended entities. For the &quot;NDCG at k&quot; metric, only the top k ranked results are scored.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00165 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00165">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03426"/>
        <rdfs:label xml:lang="en">legal sex</rdfs:label>
        <rdfs:label xml:lang="es">sexo legal</rdfs:label>
        <skos:altLabel xml:lang="en">legal sex or gender</skos:altLabel>
        <skos:altLabel xml:lang="en">legal sex/gender</skos:altLabel>
        <skos:definition xml:lang="en">The marker of the patient&apos;s sex on official documents (birth certificate, driver&apos;s license).</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00166 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00166">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03426"/>
        <rdfs:label xml:lang="en">administrative sex</rdfs:label>
        <rdfs:label xml:lang="es">sexo administrativo</rdfs:label>
        <skos:altLabel xml:lang="en">administrative gender</skos:altLabel>
        <skos:altLabel xml:lang="en">administrative gender/sex</skos:altLabel>
        <skos:definition xml:lang="en">Administrative Gender/Sex: Categories used for systems management, such as insurance or records.</skos:definition>
    </owl:Class>
    


