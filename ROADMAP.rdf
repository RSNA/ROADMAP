        <skos:definition xml:lang="en">An item from the PROBAST+AI guideline.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00496 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00496">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/00177"/>
        <rdfs:label xml:lang="en">REFINE item</rdfs:label>
