        <rdfs:label xml:lang="en">DECIDE-AI item</rdfs:label>
        <skos:definition xml:lang="en">An item from the DECIDE-AI guideline.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00491 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00491">
