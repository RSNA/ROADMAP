                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00581"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">instrucciones de uso</rdfs:label>
        <rdfs:label xml:lang="en">instructions for use</rdfs:label>
        <rdfs:label xml:lang="zh">使用说明</rdfs:label>
        <skos:definition xml:lang="en">Directions and recommendations for optimal use of the model.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03602 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03602">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00254"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rsna.org/roadmap/supports"/>
                <owl:hasValue rdf:resource="https://rsna.org/roadmap/00540"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="https://www.fda.gov/media/184856/download"/>
        <rdfs:label xml:lang="es">información reglamentaria</rdfs:label>
        <rdfs:label xml:lang="en">regulatory information</rdfs:label>
        <rdfs:label xml:lang="zh">监管信息</rdfs:label>
        <skos:definition xml:lang="en">Information used to support or document regulatory review.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03603 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03603">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:comment xml:lang="en">Possible value set:

+ Authorized
+ Submitted / under review
+ Not submitted
+ Research use only
+ Withdrawn
+ Suspended
+ Expired
+ Not available

&apos;Not submitted&apos; and &apos;Research use only&apos; are positive assertions and should be used in preference to omitting the record. &apos;Not available&apos; mirrors the ONC convention at 45 CFR 170.315(b)(11)(v)(A)(2).</rdfs:comment>
        <rdfs:label xml:lang="es">estado de la autorización reglamentaria</rdfs:label>
        <rdfs:label xml:lang="en">regulatory authorization status</rdfs:label>
        <rdfs:label xml:lang="zh">监管授权状态</rdfs:label>
        <skos:altLabel xml:lang="en">status</skos:altLabel>
        <skos:definition xml:lang="en">Describes the regulatory status of the AI model, such as Cleared, Application submitted, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03604 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03604">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03602"/>
        <rdfs:label xml:lang="es">número de expediente reglamentario</rdfs:label>
        <rdfs:label xml:lang="en">regulatory identifier</rdfs:label>
        <rdfs:label xml:lang="zh">监管文件编号</rdfs:label>
        <skos:altLabel xml:lang="en">regulatory file number</skos:altLabel>
        <skos:definition xml:lang="en">Identifies the AI model&apos;s application number related to its regulatory authorization.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03605 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03605">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="es">tratamiento</rdfs:label>
        <rdfs:label xml:lang="en">treatment</rdfs:label>
        <rdfs:label xml:lang="zh">治疗</rdfs:label>
        <skos:definition xml:lang="en">Medical treatment is the management, care, and application of measures (such as drugs, surgery, or therapies) to combat, cure, prevent, or ameliorate a disease, injury, or health condition. It involves actions taken by healthcare providers to improve a patient&apos;s health or manage symptoms.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03606 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03606">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="es">cura</rdfs:label>
        <rdfs:label xml:lang="en">cure</rdfs:label>
        <rdfs:label xml:lang="zh">治愈</rdfs:label>
        <skos:definition xml:lang="en">A cure is a method, medicine, or treatment that restores health by eliminating a disease or illness,</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03607 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03607">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="es">mitigación</rdfs:label>
        <rdfs:label xml:lang="en">mitigation</rdfs:label>
        <rdfs:label xml:lang="zh">缓解</rdfs:label>
        <skos:altLabel xml:lang="en">risk mitigation</skos:altLabel>
        <skos:definition xml:lang="en">Mitigation in health refers to actions taken to reduce the severity, pain, or harmful effects of illnesses, injuries, or hazards before or during an event. It involves identifying and managing risks to improve patient safety, minimize disease spread (e.g., social distancing), and prevent long-term damage.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03608 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03608">
        <rdfs:subClassOf rdf:resource="https://rsna.org/roadmap/03800"/>
        <rdfs:label xml:lang="es">prevención</rdfs:label>
        <rdfs:label xml:lang="en">prevention</rdfs:label>
        <rdfs:label xml:lang="zh">预防</rdfs:label>
        <skos:definition xml:lang="en">Prevention in health refers to actions, policies, and interventions aimed at reducing the risk of disease, injury, and disability, as well as minimizing their burden.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/03609 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/03609">
