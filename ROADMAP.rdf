        <rdfs:comment xml:lang="en">In premature infants, values for both Days of life and Days of gestation may be relevant.</rdfs:comment>
        <rdfs:label xml:lang="en">days</rdfs:label>
        <rdfs:label xml:lang="es">días</rdfs:label>
        <rdfs:label xml:lang="zh">天数</rdfs:label>
        <skos:altLabel xml:lang="en">DOL</skos:altLabel>
        <skos:altLabel xml:lang="en">days of life</skos:altLabel>
