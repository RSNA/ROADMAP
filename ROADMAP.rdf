        <rdfs:label xml:lang="en">MI-CLAIM item</rdfs:label>
        <skos:definition xml:lang="en">An item from the MI-CLAIM guideline.</skos:definition>
    </owl:Class>
    


    <!-- https://rsna.org/roadmap/00493 -->

    <owl:Class rdf:about="https://rsna.org/roadmap/00493">
